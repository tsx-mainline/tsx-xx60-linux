# tsx-mainline + dtschema for dt_binding_check / dtbs_check
FROM tsx-mainline
USER root
RUN apt-get update && apt-get install -y --no-install-recommends swig python3-dev python3-venv python3-pip && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/dt && /opt/dt/bin/pip install --no-cache-dir dtschema yamllint
ENV PATH=/opt/dt/bin:$PATH
