#!/system/bin/sh
# tsx-install-usb: ONE command from a USB stick built by `mkpayload --usb`,
# run from a root shell -- Crestron's patched sshd (rootsh), the UART
# console, or an existing mainline/rescue shell. busybox and Android
# toolbox sh compatible (no bash-only syntax).
#
#   sh /mnt/media_rw/<stick>/tsx-install-usb [--dry-run]
#
# What it does: verifies the stick's sha256sums, arms the USB recovery boot
# path (installer/emmc/tsx-usb-recovery enable, copied onto the stick), sets
# DataRecoveryDone=1, and reboots. It does NOT install anything itself: the
# install runs on the NEXT power cycle, when U-Boot's stock jabil_factory
# hook (now able to see the stick: docs/boot.md "U-Boot USB needs VBUS held
# before enumeration") boots the stage-2 image from this stick and
# tsx-autoinstall does the rest, with progress on the panel screen. Leave
# the stick in until that finishes; tsx-autoinstall renames jabil.txt when
# it is done, so a stick left in afterwards does not reinstall again.
set -e
HERE=$(cd "$(dirname "$0")" && pwd)
DRY=0
case "${1:-}" in
--dry-run) DRY=1 ;;
-h|--help) sed -n '2,17p' "$0"; exit 0 ;;
"") : ;;
*) echo "tsx-install-usb: unknown option $1" >&2; exit 2 ;;
esac
die() { echo "tsx-install-usb: ERROR: $*" >&2; exit 1; }
say() { echo "tsx-install-usb: $*"; }
# tsx_fw_bound CMD ARGS...: bound a fw_printenv/fw_setenv call (TSX_FWENV_TIMEOUT
# seconds, default 10). u-boot-tools' fw_env.c read loop spins at 100% CPU
# forever on a config/file size mismatch instead of erroring out (confirmed on
# both uboot-tools 2026.07 and Alpine's 2026.04; see docs/boot.md
# "fw_printenv can hang"). No `timeout` binary dependency: this runs on
# whatever shell it was invoked from (Android root shell or a mainline/rescue
# shell), so it is a background job polled once a second instead.
tsx_fw_bound() {
	"$@" &
	fwb_pid=$!
	fwb_n=0
	while kill -0 "$fwb_pid" 2>/dev/null; do
		if [ "$fwb_n" -ge "${TSX_FWENV_TIMEOUT:-10}" ]; then
			kill -9 "$fwb_pid" 2>/dev/null; wait "$fwb_pid" 2>/dev/null
			echo "tsx-install-usb: fw_printenv/fw_setenv timed out after ${TSX_FWENV_TIMEOUT:-10}s: $*" >&2
			return 137
		fi
		sleep 1; fwb_n=$((fwb_n + 1))
	done
	wait "$fwb_pid"
}

[ "$(id -u 2>/dev/null)" = 0 ] || die "not root (ssh -tt admin@<panel> then rootsh, or a UART root console)"
SUMS=$HERE/tsx-install/SHA256SUMS
[ -f "$SUMS" ] || die "$HERE is not a tsx-install stick (no tsx-install/SHA256SUMS); run mkpayload --usb to build one"

say "verifying the stick payload (sha256; this can take a minute)"
if ! ( cd "$HERE" && sha256sum -c tsx-install/SHA256SUMS >/tmp/tsx-install-usb.sums 2>&1 ); then
	grep -v ': OK$' /tmp/tsx-install-usb.sums | head -n 5
	die "stick payload corrupt (sha256 mismatch above); do not proceed"
fi
say "stick payload OK"

RECOVERY=$HERE/tsx-usb-recovery
[ -x "$RECOVERY" ] || RECOVERY=$HERE/tsx-install/tsx-usb-recovery
[ -x "$RECOVERY" ] || die "tsx-usb-recovery not found on the stick (expected next to tsx-install-usb; rebuild the stick with mkpayload --usb)"

if [ "$DRY" = 1 ]; then
	say "[dry-run] would run: sh $RECOVERY enable"
	say "[dry-run] would set DataRecoveryDone=1 (if not already) and reboot"
	exit 0
fi

say "arming the USB recovery boot path"
sh "$RECOVERY" enable || die "tsx-usb-recovery enable failed; the stick will not be seen by jabil_factory yet. See the message above."

FWP=$(command -v fw_printenv 2>/dev/null || echo /system/bin/fw_printenv)
FWS=$(command -v fw_setenv 2>/dev/null || echo /system/bin/fw_setenv)
[ -x "$FWS" ] || die "no fw_setenv (in PATH or at /system/bin)"
if [ "$(tsx_fw_bound "$FWP" -n DataRecoveryDone 2>/dev/null)" != "1" ]; then
	tsx_fw_bound "$FWS" DataRecoveryDone 1 || die "fw_setenv DataRecoveryDone 1 failed or timed out"
	say "DataRecoveryDone=1 set"
else
	say "DataRecoveryDone already 1"
fi

say "armed. Leave the stick in. Rebooting now; the next power cycle installs from this stick (progress on the panel screen)."
sync
sleep 2
if command -v busybox >/dev/null 2>&1; then busybox reboot -f
elif command -v reboot >/dev/null 2>&1; then reboot -f 2>/dev/null || reboot
else echo 1 > /proc/sys/kernel/sysrq 2>/dev/null; echo b > /proc/sysrq-trigger
fi
