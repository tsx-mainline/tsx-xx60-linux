#!/bin/sh
# tsx-rescue-status: ASCII splash + a live status screen for the v2 rescue,
# on /dev/tty0 (the panel's own LCD, via fbcon: CONFIG_FRAMEBUFFER_CONSOLE +
# CONFIG_DRM_FBDEV_EMULATION are on and "console=tty0" is already on the
# kernel cmdline for this board -- see docs/recovery.md "The v2 splash and
# status screen") and mirrored line-by-line to the serial console via
# /dev/kmsg (kernel-timestamped, also reaches ttyAML0). busybox ash only.
#
#   tsx-rescue-status loop    redraws every ~2s until killed (the ::respawn
#                              inittab entry restarts it if it ever exits)
#   tsx-rescue-status once    prints one frame and exits (scripts/tests)
#
# Reads (never writes, except its own scratch files under $RUN):
#   /run/tsx-install-state    free text, written by installer/steps/tsx-rescue-install
#   /run/tsx-progress         "POS_BYTES OFF_BYTES LEN_BYTES NAME...", written by pr_dd (installer/lib/tsx-rescue.sh)
#   /run/rescue-reason        why the rescue was entered (rootfs/initramfs/overlay/init)
#   /run/tsx-eth0-mac-src     uboot|random (installer/rescue/overlay/etc/init.d/rcS)
#   the U-Boot env (product_name, ethaddr) via tsx-lib.sh, already on the rescue at
#   /usr/share/tsx/tsx-lib.sh
set -u
RUN=${TSX_RUN:-/run}
TTY=${TSX_STATUS_TTY:-/dev/tty0}
VERFILE=/etc/tsx/rescue-version
. /usr/share/tsx/tsx-lib.sh 2>/dev/null || true

# ---- splash: shown once at the top of every frame, tasteful and small enough
# for an 80x25 console; the LCD (1280x800) just shows it smaller/top-left with
# the default fbcon font, which is fine here (this is a repair screen, not a
# logo screen). Tux: the classic public-domain ASCII penguin.
splash() {
	cat <<'EOF'
    .--.
   |o_o |      ___________  __    _  ___  ______ ___
   |:_/ |     /_  __/ __/ |/_/___| |/_/ |/_/ __// _ \
  //   \ \     / / _\ \_>  </___/>  <_>  </ _ \/ // /
 (|     | )   /_/ /___/_/|_|   /_/|_/_/|_|\___/\___/
/'\_   _/`\
\___)=(___/   mainline rescue -- TSW-760 / TSW-1060 / TSS-10
EOF
}

kmsg_line() { echo "tsx-rescue-status: $1" > /dev/kmsg 2>/dev/null || true; }

frame() {
	local ip method mac macsrc model rver kver state prog progline pname punit reason
	ip=$(ip -4 -o addr show eth0 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
	case " $(cat /proc/cmdline 2>/dev/null) " in *" tsx.ip="*) method=static;; *) method=dhcp;; esac
	mac=$(cat /sys/class/net/eth0/address 2>/dev/null)
	macsrc=$(cat "$RUN/tsx-eth0-mac-src" 2>/dev/null || echo unknown)
	reason=$(cat "$RUN/rescue-reason" 2>/dev/null || echo "(unknown)")
	rver="v2 unknown build"; [ -f "$VERFILE" ] && rver=$(head -n 1 "$VERFILE")
	kver=$(uname -r 2>/dev/null || echo unknown)

	pname=; punit=
	if command -v tsx_find_disk >/dev/null 2>&1 || type tsx_find_disk >/dev/null 2>&1; then
		if tsx_find_disk 2>/dev/null; then
			# fw_env.config wants hex offset/size (see installer/steps/tsx-rescue-arm.sh for why)
			printf '%s 0x%x 0x%x\n' "$WHOLE" "${TSX_ENV_OFFSET:-1048576}" "${TSX_ENV_SIZE:-65536}" > "$RUN/tsx-status-env.cfg" 2>/dev/null
			FWCFG=$RUN/tsx-status-env.cfg
			tsx_pick_fwenv 2>/dev/null
			pname=$(tsx_env product_name 2>/dev/null || true)
			punit=$(tsx_unit_id 2>/dev/null || true)
		fi
	fi

	state=$(cat "$RUN/tsx-install-state" 2>/dev/null || echo "idle: waiting for the installer to connect")
	progline=
	if [ -f "$RUN/tsx-progress" ]; then
		# "POS OFF LEN NAME..." (the name may contain spaces, so it comes last)
		progline=$(awk '$1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ {
			d = ($1 - $2) / 1048576; if (d < 0) d = 0; len = $3 / 1048576
			name = $4; for (i = 5; i <= NF; i++) name = name " " $i
			if (len > 0) printf "%s: %.0f/%.0f MiB (%.0f%%)", name, d, len, d * 100 / len
			else printf "%s: %.0f MiB written", name, d
		}' "$RUN/tsx-progress" 2>/dev/null)
	fi

	# Build the frame first; redraw only when it changed, and without `clear`
	# (cursor home + overwrite + clear-to-end-of-line), so the LCD never blanks.
	txt=$({
	splash
	echo "-----------------------------------------------------------------"
	echo "reason for rescue : $reason"
	echo "model             : ${pname:-unknown}${punit:+   unit $punit}"
	echo "rescue / kernel   : $rver / $kver"
	echo "network           : eth0 ${ip:-(no address yet)} ($method, MAC $mac${macsrc:+, $macsrc})"
	if [ -n "$ip" ]; then echo "repair shell      : ssh root@$ip   (password: tsx)"
	else echo "repair shell      : ssh root@<ip once DHCP/static assigns one>  (password: tsx)"; fi
	echo "status            : $state${progline:+ -- $progline}"
	echo "-----------------------------------------------------------------"
	echo "what next: this screen refreshes itself. An installer driver on the"
	echo "network normally finds this unit and finishes the install for you."
	echo "If nothing happens: power-cycle the panel ONCE without doing"
	echo "anything else -- it falls back to stock Android on its own (no"
	echo "UART needed). To look around by hand: ssh in, then 'tsx-rescue"
	echo "status' or 'tsx-rescue done && reboot -f' once repairs are done."
	})
	if [ "$txt" != "${LAST_TXT:-}" ]; then
		LAST_TXT=$txt
		{
		printf '\033[?25l\033[H'
		printf '%s\n' "$txt" | awk '{ printf "%s\033[K\n", $0 }'
		printf '\033[J'
		} > "$TTY" 2>/dev/null || true
	fi
	kline="$reason | net eth0 ${ip:-none} ($method) | $state${progline:+ -- $progline}"
	if [ "$kline" != "${LAST_KLINE:-}" ]; then LAST_KLINE=$kline; kmsg_line "$kline"; fi
}

case "${1:-loop}" in
once) printf '\033[2J' > "$TTY" 2>/dev/null; frame;;
loop) printf '\033[2J' > "$TTY" 2>/dev/null; while :; do frame; sleep 2; done;;
*) echo "usage: tsx-rescue-status once|loop" >&2; exit 2;;
esac
