#!/usr/bin/env bash
# Full factory restore driver: restore a xx60 unit (SD card AND eMMC) from
# the mainline rescue system, hands off. NO BACKUP NEEDED: the only inputs are the
# Crestron .puf and the unit's own U-Boot env, which is read live from the card
# (1 MiB) in the rescue system (it holds the identity: MAC, tsid, model).
#
#   tsx-restore-factory PANEL_IP [--puf FILE] [options]      (no backup)
#   tsx-restore-factory --bundle DIR PANEL_IP [options]       (prebuilt bundle,
#        e.g. mkbundle.sh --emmc-raw/--boot0 from a backup of that unit)
#
# Without a backup the eMMC regions stock Android does not use (recovery, misc,
# data, alignment gaps) are zeroed and cache gets an empty ext4 (mkbundle.sh); the
# card gets empty factory p5..p8 as always. Crestron's /data (account, settings)
# is factory-fresh: create the admin account in the web UI (https://PANEL/) or let
# tsx-android-to-card do it.
#
# Steps (each logged with timestamps to --results, default
# results/tsx-restore-factory-<date>.txt; --from-step N resumes):
#   1  inputs: bundle SHA256SUMS, uboot-check.txt (U-Boot is never written),
#      helper scripts present; UART mode (see --uart below) also needs the
#      serial logger running
#   2  get the panel into the RESCUE system: from the kiosk, copy p1:boot.img
#      (the mainline rescue in the golden slot) to p1:tsxboot.img, verify, remove
#      p1:tsxboot.off, arm tsx_once=1 if the hook is the v2 once guard, reboot;
#      wait for ssh with /etc/tsx/rescue-image. (If the panel is already in the
#      rescue, nothing to do. If nothing answers: stop, this driver never PoE-cycles.)
#      UART mode reads the rescue's DHCP-leased IP from the serial banner
#      'tsx-rescue: network: eth0 <ip>'. Network-only mode records the panel's
#      eth0 MAC over ssh before rebooting, tries the kiosk's own IP first, then
#      every ~10s for up to 300s sweeps the workstation's own /24 (fping, or a
#      bounded parallel ping -c1 -W1 loop) and matches the MAC in `ip neigh`,
#      accepting an IP once it answers ssh root@IP test -f /etc/tsx/rescue-image
#      (password $RPW). The rescue runs eth0 with a RANDOM MAC (hw 2026-09-27), so
#      the fallback tries only the neighbours whose ssh banner is dropbear and
#      accepts the one with the rescue flag whose card env (1 MiB) has
#      ethaddr = the recorded MAC; --rescue-ip IP overrides discovery in either mode.
#   3  payload: without --bundle, first read the live env from the card in the rescue
#      (results/env-live-<unit>-<date>.bin, CRC + MAC checked; --env FILE overrides)
#      and build the bundle (mkbundle.sh, no backup) in out/bundle-<unit>-<date>;
#      then HTTP server on the bundle's parent dir, wget every file of SHA256SUMS into
#      the rescue's /tmp/b (RAM; needs ~750 MiB free), sha256sum -c on the panel
#   4  check: tsx-emmc-restore check + tsx-factory-restore check (nothing written)
#   5  run (gate: type FACTORY unless --yes): tsx-emmc-restore run (boot, system,
#      recovery, cache, data, misc, logo verify), then tsx-factory-restore run
#      (card table, p2, p1 golden, p5..p8, env last, hook removed)
#   6  reboot -f. UART mode waits on the serial log for the stock Android root
#      prompt. Network-only mode waits for the rescue's ssh to go away, then
#      polls https://PANEL/ (the unit keeps its own IP; 200/301/302) for up to
#      420s; if that never answers it falls back to the same MAC lookup as
#      step 2 and logs the IP it finds.
#   7  UART mode verifies over the root console: p5 mounted, no fs_mgr error,
#      wait for Crestron's one-time golden re-install if it runs (fwUpgrade=0 and
#      the image dir gone), sys.boot_completed=1, then a stability watch of
#      --stable-min minutes (default 9: the half-boot self-reset comes at ~8.5) with
#      no new U-Boot banner. Network-only mode cannot check fwUpgrade/boot_completed/p5
#      (no root without the UART on a factory unit) and logs that they are skipped;
#      it polls the web UI for reachability, then runs a weaker stability watch
#      (poll every 30s for --stable-min minutes, fail on >90s straight unreachable).
#      Both modes then check the Crestron account state: a factory-fresh /data has
#      none (the web UI redirects to /createUser.html: expected); if one exists, the
#      Crestron SSH console (admin, $TSX_ADMIN_PW) must answer `ver`
#
# Options: --puf FILE (required unless --bundle is given; also $TSX_PUF; sha256
#          checked against the known pristine package, see dl/README.txt)
#          --env FILE (64 KiB env block instead of the live one)  --bundle DIR
#          --results FILE  --from-step N  --to-step N  --yes  --rescue-ip IP (overrides
#          rescue-IP discovery in both UART and network-only mode)  --dry-run
#          --port N (HTTP, 8081)  --ws-ip IP  --stable-min N  --rescue-pw PW (default tsx)
#          --uart auto|yes|no (default auto: UART mode is used only if the serial
#          logger is running and uc.sh exists; otherwise steps 2/6/7 fall back to the
#          network-only checks described above; --uart yes/no forces the mode)
#          Root over ssh is ON by default: mkbundle.sh adds a `rootsh` branch to the
#          sshShell.sh inside the .puf's own system.img, so `ssh -tt $TSX_ADMIN_USER@panel
#          rootsh` gets root right after the restore with no UART (the Crestron console is
#          unchanged). It needs the pristine .puf; a modified image is refused in step 3.
#          --sshshell FILE (bake your own sshShell.sh in as is instead; also $SSHSHELL)
#          --stock-sshshell (opt out: system.img byte-identical to the .puf). --root-ssh is
#          accepted and is the default. Only used in step 3 when a bundle is built here (no
#          --bundle); with --bundle, mkbundle.sh has already run and these are ignored
# Needs: sshpass ssh python3 sha256sum ip awk curl; in UART mode (see --uart) also
# ../../tools/bench/serlog.py running (logging to ../../tools/bench/boot-2200.log) and
# ../../tools/bench/uc.sh. Network-only mode's rescue-IP sweep prefers fping if installed.
# Panel commands are the allowlisted form
#   sshpass -p tsx ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@IP '...'
set -euo pipefail
HERE=$(cd "$(dirname "$0")" && pwd); WORK=$(cd "$HERE/.." && pwd)
SERIALDIR=$WORK/../tools/bench; UC=$SERIALDIR/uc.sh; SERLOG=${TSX_SERIAL_LOG:-$SERIALDIR/boot-2200.log}
BUNDLE= PANEL= RESULTS= FROM_STEP=1 TO_STEP=7 YES=0 DRYRUN=0 PORT=8081 WSIP= STABLE_MIN=9 RPW=tsx RIP= UART=auto
PUF=${TSX_PUF:-} ENVFILE=
ROOTSSH=1 ROOTSSH_SET=0 SSHSHELL=${SSHSHELL:-}   # rootsh patch by default
PRISTINE_PUF_SHA=96438108e3175b66c09f1df284ded5fe155593ba06e069e154688b04f395e40b   # dl/README.txt
ADMIN_PW=${TSX_ADMIN_PW:-}   # required before step 7 checks the Crestron console; see below
ADMIN_USER=${TSX_ADMIN_USER:-admin}
ENVPY="python3 $HERE/sdcard/tsx-env.py"
usage() { sed -n '2,78p' "$0" >&2; }
while [ $# -gt 0 ]; do case "$1" in
	--bundle) BUNDLE=$2; shift 2;; --puf) PUF=$2; shift 2;; --env) ENVFILE=$2; shift 2;; --results) RESULTS=$2; shift 2;; --from-step) FROM_STEP=$2; shift 2;; --to-step) TO_STEP=$2; shift 2;;
	--yes) YES=1; shift;; --dry-run) DRYRUN=1; shift;; --port) PORT=$2; shift 2;; --ws-ip) WSIP=$2; shift 2;;
	--stable-min) STABLE_MIN=$2; shift 2;; --rescue-ip) RIP=$2; shift 2;; --rescue-pw) RPW=$2; shift 2;; --uart) UART=$2; shift 2;;
	--root-ssh) ROOTSSH=1; ROOTSSH_SET=1; shift;; --sshshell) ROOTSSH=1; ROOTSSH_SET=1; SSHSHELL=$2; shift 2;; --stock-sshshell) ROOTSSH=0; SSHSHELL=; shift;; -h|--help) usage; exit 0;;
	--*) echo "unknown option $1" >&2; usage; exit 2;; *) [ -z "$PANEL" ] || { echo "extra argument $1" >&2; exit 2; }; PANEL=$1; shift;; esac; done
[ -n "$PANEL" ] || { usage; exit 2; }
case "$UART" in auto|yes|no) ;; *) echo "--uart must be auto, yes, or no" >&2; exit 2;; esac
[ -n "$RESULTS" ] || RESULTS=$HERE/results/tsx-restore-factory-$(date +%Y%m%d-%H%M).txt
mkdir -p "$(dirname "$RESULTS")"
log() { printf '[%s] %s\n' "$(date '+%F %T')" "$*" | tee -a "$RESULTS" >&2; }
logblock() { log "-- $1 --"; printf '%s\n' "$2" | while IFS= read -r l; do log "  $l"; done; log "-- end $1 --"; }
die() { log "ERROR: $*"; exit 1; }
# stream a long-running remote command's output live (via log, so it also lands
# in $RESULTS as it happens) instead of capturing it silently until the ssh
# session returns; leaves the full text in $out for any caller that still needs
# to grep it, and returns the remote command's own exit status. Relies on
# `set -o pipefail` (already on via set -euo pipefail): the if-condition below
# reflects $SSH's status, not tee/while's, so this is safe under `set -e` too.
run_stream() {  # CMD
	local cmd=$1 tmp rc
	tmp=$(mktemp "$RESULTS.XXXXXX")
	if $SSH "$cmd" 2>&1 | tee "$tmp" | while IFS= read -r l; do log "  $l"; done; then rc=0; else rc=$?; fi
	out=$(cat "$tmp"); rm -f "$tmp"
	return $rc
}
if [ "$ROOTSSH" = 1 ]; then
	if [ -n "$BUNDLE" ]; then [ "$ROOTSSH_SET" = 0 ] || log "  WARNING: --root-ssh/--sshshell ignored: --bundle was already built (its system.img is whatever mkbundle.sh made)"; ROOTSSH=0
	elif [ -n "$SSHSHELL" ]; then [ -f "$SSHSHELL" ] || die "--sshshell $SSHSHELL: no such file"
	fi
fi
RHOST=$PANEL
ANDROID_IP=$PANEL
set_rhost() { RHOST=$1; SSH="sshpass -p $RPW ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=8 root@$RHOST"; }
set_rhost "$PANEL"
rescue_ip_from_log() { tr -d '\0' < "$SERLOG" | grep -a -o 'tsx-rescue: network: eth0 [0-9.]*' | tail -n 1 | awk '{print $NF}'; }
ssh_ok() { $SSH true >/dev/null 2>&1; }
in_rescue() { $SSH 'test -f /etc/tsx/rescue-image' >/dev/null 2>&1; }
# --- network-only (no UART) rescue-IP discovery -----------------------------
ssh_test_rescue() { sshpass -p "$RPW" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=3 "root@$1" 'test -f /etc/tsx/rescue-image' >/dev/null 2>&1; }
find_rescue_by_mac() {  # MAC PREFIX: echo an IP in PREFIX.0/24 whose neighbor MAC matches (ip neigh, case-insensitive), or nothing
	local mac=$1 prefix=$2
	if command -v fping >/dev/null 2>&1; then fping -a -q -r0 -t200 -g "${prefix}.1" "${prefix}.254" >/dev/null 2>&1 || true
	else seq 1 254 | xargs -P 64 -I{} ping -c1 -W1 -q "${prefix}.{}" >/dev/null 2>&1 || true
	fi
	ip neigh | awk -v m="$mac" 'BEGIN{m=tolower(m)} tolower($0) ~ m {print $1; exit}'
}
ssh_banner() { timeout 2 bash -c "exec 3<>/dev/tcp/$1/22 && head -c 64 <&3" 2>/dev/null | tr -d '\r\0' | head -n 1; }
find_rescue_by_env() {  # MAC PREFIX: the rescue runs eth0 with a RANDOM MAC (only the kiosk sets the U-Boot ethaddr),
	# so match the unit by the ethaddr in the card's env at 1 MiB instead; only dropbear hosts (the rescue's sshd) are tried
	local mac=$1 prefix=$2 ip e
	for ip in $(ip neigh | awk -v p="$prefix." 'index($1, p) == 1 && $0 ~ /lladdr/ {print $1}'); do
		case "$(ssh_banner "$ip")" in *dropbear*) ;; *) continue;; esac
		e=$(sshpass -p "$RPW" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=3 "root@$ip" \
			'test -f /etc/tsx/rescue-image && dd if=/dev/mmcblk0 bs=65536 skip=16 count=1 2>/dev/null | tr "\0" "\n" | sed -n "s/^ethaddr=//p"' 2>/dev/null | head -n 1)
		[ -n "$e" ] && [ "$(echo "$e" | tr 'A-F' 'a-f')" = "$(echo "$mac" | tr 'A-F' 'a-f')" ] && { echo "$ip"; return 0; }
	done
}
find_rescue_ip_network() {  # MAC: sets RHOST/RIP to the rescue's ip via set_rhost, or dies after ~300s
	local mac=$1 prefix w=0 cand
	prefix=$(echo "$WSIP" | cut -d. -f1-3)
	if ssh_test_rescue "$PANEL"; then set_rhost "$PANEL"; RIP=$PANEL; log "  rescue answers at the kiosk's own IP $PANEL"; return 0; fi
	while [ $w -lt 300 ]; do
		cand=$(find_rescue_by_mac "$mac" "$prefix")
		if [ -n "$cand" ] && ssh_test_rescue "$cand"; then set_rhost "$cand"; RIP=$cand; log "  rescue IP found (network-only, MAC): $cand"; return 0; fi
		cand=$(find_rescue_by_env "$mac" "$prefix")
		if [ -n "$cand" ]; then set_rhost "$cand"; RIP=$cand; log "  rescue IP found (network-only, dropbear + card env ethaddr $mac): $cand"; return 0; fi
		sleep 10; w=$((w + 10))
		[ $((w % 30)) -eq 0 ] && log "  still searching for the rescue's IP (MAC $mac) on ${prefix}.0/24: $w/300 s"
	done
	die "network-only: could not find the rescue's IP within 300s (MAC $mac, swept ${prefix}.0/24; try --rescue-ip)"
}
uart() { local w=4; if [ "$1" = -w ]; then w=$2; shift 2; fi; [ ${#1} -le 80 ] || die "UART command >80 chars: $1"; "$UC" -w "$w" "$1"; }
uart_last() {  # uart_last CMD REGEX: the last line matching REGEX in the answer, echo excluded
	uart "$1" | grep -v '^>>> ' | grep -E -- "$2" | tail -n 1 || true
}
serial_lines() { if [ -f "$SERLOG" ]; then wc -l < "$SERLOG"; else echo 0; fi; }   # no serial log without the UART
wait_serial() {  # PATTERN TIMEOUT_S FROMLINE [ABORT...]: waits for PATTERN in log lines after FROMLINE
	local pat=$1 t=$2 from=$3; shift 3; local w=0 new a
	log "  waiting up to ${t}s on the serial log for: $pat"
	while [ $w -lt "$t" ]; do
		new=$(tail -n +$((from + 1)) "$SERLOG" | tr -d '\0')
		for a in "$@"; do grep -qF -- "$a" <<<"$new" && die "serial log shows '$a'"; done
		grep -qF -- "$pat" <<<"$new" && { log "  ok: '$pat' at $(date +%T)"; return 0; }
		sleep 5; w=$((w + 5))
		[ $((w % 30)) -eq 0 ] && log "  still waiting for '$pat': $w/${t} s"
	done
	die "timeout after ${t}s waiting for '$pat' on the serial log"
}
log "== tsx-restore-factory: PANEL=$PANEL BUNDLE=$BUNDLE from-step=$FROM_STEP dry-run=$DRYRUN results=$RESULTS"

# ---------------------------------------------------------------- step 1 --
log "== step 1: inputs"
for c in sshpass ssh python3 sha256sum ip awk curl; do command -v $c >/dev/null || die "missing $c"; done
check_bundle() {
	[ -f "$BUNDLE/factory.manifest" ] && [ -f "$BUNDLE/emmc.manifest" ] && [ -f "$BUNDLE/SHA256SUMS" ] || die "$BUNDLE is not a factory-restore bundle"
	(cd "$BUNDLE" && sha256sum -c --quiet SHA256SUMS) || die "bundle SHA256SUMS mismatch"
	log "  bundle OK: unit $(sed -n 's/^unit=//p' "$BUNDLE/factory.manifest"), fw $(sed -n 's/^firmware_version=//p' "$BUNDLE/factory.manifest"), $(grep -c '^region ' "$BUNDLE/emmc.manifest") eMMC regions, eMMC backup: $(grep -q '^boot0_sha256=any$' "$BUNDLE/emmc.manifest" && echo none || echo used)"
	logblock "uboot-check.txt" "$(cat "$BUNDLE/uboot-check.txt")"
	grep -q '^identity_and_hw=identical$' "$BUNDLE/env-identity.txt" || die "env-identity.txt: identity not identical"
}
if [ -n "$BUNDLE" ]; then check_bundle
else
	[ -n "$PUF" ] || die "no .puf given (--puf FILE or \$TSX_PUF)"
	[ -f "$PUF" ] || die "no .puf at $PUF (--puf)"
	command -v mke2fs >/dev/null && command -v e2fsck >/dev/null || die "mke2fs/e2fsck (e2fsprogs) needed to build the bundle"
	PUFSHA=$(sha256sum < "$PUF" | cut -d' ' -f1)
	if [ "$PUFSHA" = "$PRISTINE_PUF_SHA" ]; then log "  .puf $PUF: pristine 3.002.1061.001 ($PUFSHA)"
	else log "  WARNING: .puf $PUF sha256 $PUFSHA is not the known pristine package (dl/README.txt)$([ "$ROOTSSH" = 1 ] && [ -z "$SSHSHELL" ] && echo "; the rootsh patch (default) refuses a modified sshShell.sh in step 3: use the pristine .puf, --sshshell FILE or --stock-sshshell")"; fi
	[ -z "$ENVFILE" ] || { [ -f "$ENVFILE" ] || die "--env $ENVFILE: no such file"; }
	log "  no bundle given: it is built in step 3 from the .puf + the unit's ${ENVFILE:-live} env (no backup)"
fi
case "$UART" in
	yes) UART_ON=1;;
	no) UART_ON=0;;
	auto) if pgrep -f '^python3 .*serlog\.py' >/dev/null 2>&1 && [ -x "$UC" ]; then UART_ON=1; else UART_ON=0; fi
		log "  --uart auto -> $([ "$UART_ON" = 1 ] && echo yes || echo no)";;
esac
if [ "$UART_ON" = 1 ]; then
	pgrep -f '^python3 .*serlog\.py' >/dev/null || die "serial logger (serlog.py) is not running (--uart $UART)"
	[ -x "$UC" ] || die "$UC missing (--uart $UART)"
	log "  UART mode: serial logger running, log $SERLOG ($(serial_lines) lines)"
else
	log "  network-only mode (--uart $UART): step 2/6/7 use ssh/curl/MAC-based checks instead of the serial log/UART console"
fi
set_bundle_paths() { BUNDLEABS=$(cd "$BUNDLE" && pwd); PARENT=$(dirname "$BUNDLEABS"); BNAME=$(basename "$BUNDLEABS"); BASEURL="http://$WSIP:$PORT/$BNAME"; }
if [ -z "$WSIP" ]; then WSIP=$(ip route get "$PANEL" | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}'); fi
[ -n "$WSIP" ] || die "no workstation IP towards $PANEL (--ws-ip)"
[ -z "$BUNDLE" ] || set_bundle_paths
HTTP_PID=; stop_http() { [ -n "$HTTP_PID" ] && kill "$HTTP_PID" 2>/dev/null && log "  HTTP server stopped"; HTTP_PID=; }
trap stop_http EXIT
if [ "$DRYRUN" = 1 ]; then
	log "[dry-run] step 2: ssh root@$PANEL: if kiosk (no /etc/tsx/rescue-image): mount p1, cp boot.img tsxboot.img, sha check, rm tsxboot.off, tsx_once=1 if the hook is the once guard, umount, reboot; wait for ssh + rescue flag (300 s)"
	if [ "$UART_ON" = 1 ]; then
		log "[dry-run] step 2 (UART): rescue IP read from the serial banner 'tsx-rescue: network: eth0 <ip>'"
	else
		log "[dry-run] step 2 (network-only): record eth0 MAC over ssh before reboot; try the kiosk's own IP $PANEL first, then every ~10s up to 300s sweep \$WSIP's /24 (fping or bounded parallel ping -c1 -W1) and match the MAC in 'ip neigh'; accept once ssh root@IP test -f /etc/tsx/rescue-image succeeds; --rescue-ip overrides"
	fi
	[ -n "$BUNDLE" ] || log "[dry-run] step 3a: rescue: dd if=/dev/mmcblk0 bs=65536 skip=16 count=1 > results/env-live-<unit>-<date>.bin (or --env); tsx-env.py unit (CRC, ethaddr); mkbundle.sh --puf $PUF --env <env> --out out/bundle-<unit>-<date>$(if [ "$ROOTSSH" = 1 ]; then echo "${SSHSHELL:+ --sshshell $SSHSHELL} (rootsh patch)"; else echo " --stock-sshshell"; fi)"
	log "[dry-run] step 3: python3 -m http.server $PORT --directory <bundle parent>; on the panel: mkdir /tmp/b; wget every file of SHA256SUMS + SHA256SUMS; sha256sum -c SHA256SUMS"
	log "[dry-run] step 4: sh /tmp/b/tsx-emmc-restore check /tmp/b; TSX_SHARE=/usr/share/tsx sh /tmp/b/tsx-factory-restore check /tmp/b"
	log "[dry-run] step 5: gate FACTORY; sh /tmp/b/tsx-emmc-restore run /tmp/b --yes; TSX_SHARE=/usr/share/tsx sh /tmp/b/tsx-factory-restore run /tmp/b --yes"
	if [ "$UART_ON" = 1 ]; then
		log "[dry-run] step 6 (UART): reboot -f; wait_serial 'root@Crestron Touchpanel:/ #' 420 (abort: fs_mgr_mount_all returned unexpected error, Kernel panic, TSX RESCUE SYSTEM, tsx: booting tsxboot.img)"
		log "[dry-run] step 7 (UART): mount|grep mmcblk0p5, fw_printenv fwUpgrade, ls image dir, getprop sys.boot_completed; stability ${STABLE_MIN} min; https://$PANEL/index_device.html -> createUser.html (no account, expected) or ssh -tt $ADMIN_USER@$PANEL ver"
	else
		log "[dry-run] step 6 (network-only): reboot -f; wait for rescue ssh to go away, then poll https://$PANEL/ (200/301/302) up to 420s; beyond that, MAC lookup as in step 2 and log the IP found"
		log "[dry-run] step 7 (network-only): fwUpgrade/boot_completed/p5 checks SKIPPED (no root without UART; with the rootsh patch (default) the load driver gets root over ssh once an account exists); poll web UI reachable, then stability watch every 30s for ${STABLE_MIN} min (fail on >90s down straight); https://$PANEL/index_device.html -> createUser.html (no account, expected) or ssh -tt $ADMIN_USER@$PANEL ver"
	fi
	log "== dry-run done"; exit 0
fi

# ---------------------------------------------------------------- step 2 --
if [ "$FROM_STEP" -le 2 ] && [ "$TO_STEP" -ge 2 ]; then
	log "== step 2: rescue system"
	ssh_ok || die "ssh root@$PANEL does not answer: the panel must be on mainline (kiosk or rescue); no PoE cycle by this driver"
	if in_rescue; then log "  already in the rescue system"; else
		from=$(serial_lines)
		if [ "$UART_ON" != 1 ]; then
			mac=$($SSH 'cat /sys/class/net/eth0/address' 2>/dev/null) || die "could not read the panel's eth0 MAC before reboot (needed for network-only rescue-IP discovery)"
			log "  panel MAC (for network-only rescue-IP discovery): $mac"
		fi
		# The hook only boots p1:tsxboot.img when p1:tsxboot.off is absent, and
		# with the v2 `once` guard only when tsx_once=1 (docs/boot.md "The v2 env
		# state machine"). An eMMC-layout kiosk installed by tsx-rescue-install
		# has tsxboot.off, and with the `once` guard tsx_once=0: without clearing
		# both, the reboot just lands on the kiosk again. tsx_once=1 is one
		# verified single-variable env write; U-Boot clears it on the next boot.
		out=$($SSH 'set -e; mkdir -p /mnt/p1; mount -t vfat /dev/mmcblk0p1 /mnt/p1; g=$(sha256sum < /mnt/p1/boot.img | cut -d" " -f1); t=; [ -f /mnt/p1/tsxboot.img ] && t=$(sha256sum < /mnt/p1/tsxboot.img | cut -d" " -f1); if [ "$t" = "$g" ]; then echo "p1:tsxboot.img is already the rescue (no copy needed)"; else free=$(df -k /mnt/p1 | awk "NR==2{print \$4}"); need=$(( $(stat -c %s /mnt/p1/boot.img) / 1024 + 256 )); if [ "$free" -gt "$need" ]; then cp /mnt/p1/boot.img /mnt/p1/tsxboot.new; sync; [ "$(sha256sum < /mnt/p1/tsxboot.new | cut -d" " -f1)" = "$g" ] || { rm -f /mnt/p1/tsxboot.new; umount /mnt/p1; echo copy corrupt; exit 1; }; mv /mnt/p1/tsxboot.new /mnt/p1/tsxboot.img; else tfree=$(( free + $( [ -f /mnt/p1/tsxboot.img ] && stat -c %s /mnt/p1/tsxboot.img || echo 0 ) / 1024 )); [ "$tfree" -gt "$need" ] || { echo "no room on p1: free ${free}K (+ tsxboot.img) need ${need}K"; umount /mnt/p1; exit 1; }; echo "p1: no room for a side copy (free ${free}K): replacing tsxboot.img in place"; rm -f /mnt/p1/tsxboot.img; sync; cp /mnt/p1/boot.img /mnt/p1/tsxboot.img; sync; [ "$(sha256sum < /mnt/p1/tsxboot.img | cut -d" " -f1)" = "$g" ] || { rm -f /mnt/p1/tsxboot.img; umount /mnt/p1; echo copy corrupt; exit 1; }; fi; fi; echo "/dev/mmcblk0 0x100000 0x10000" > /run/tsx-rf-env.cfg; sw=$(fw_printenv -c /run/tsx-rf-env.cfg -n switch_bootmode 2>/dev/null) || { umount /mnt/p1; echo "cannot read the U-Boot env"; exit 1; }; case "$sw" in *tsx_boot*) ;; *) umount /mnt/p1; echo "the U-Boot hook (tsx_boot) is not installed: the reboot would not reach the rescue"; exit 1;; esac; if [ -f /mnt/p1/tsxboot.off ]; then rm -f /mnt/p1/tsxboot.off; echo "p1:tsxboot.off removed (hook re-enabled)"; fi; case "$sw" in *tsx_once*) fw_setenv -c /run/tsx-rf-env.cfg tsx_once 1; [ "$(fw_printenv -c /run/tsx-rf-env.cfg -n tsx_once 2>/dev/null)" = 1 ] || { umount /mnt/p1; echo "tsx_once=1 did not take"; exit 1; }; echo "tsx_once=1 armed (one rescue boot)";; *) echo "hook: boot_retry=$(fw_printenv -c /run/tsx-rf-env.cfg -n boot_retry 2>/dev/null) (runs tsx_boot while < 6)";; esac; sync; echo 3 > /proc/sys/vm/drop_caches; echo "p1:tsxboot.img = rescue $g"; ls -l /mnt/p1; umount /mnt/p1; echo REBOOTING; (sleep 2; reboot) >/dev/null 2>&1 &' 2>&1) || die "p1 rescue copy failed: $out"
		logblock "p1 rescue copy" "$out"
		grep -q REBOOTING <<<"$out" || die "no reboot"
		if [ "$UART_ON" = 1 ]; then
			wait_serial "TSX RESCUE SYSTEM" 300 "$from" "Kernel panic" "root@Crestron Touchpanel"
			ip=$(tail -n +$((from + 1)) "$SERLOG" | tr -d '\0' | grep -a -o 'tsx-rescue: network: eth0 [0-9.]*' | tail -n 1 | awk '{print $NF}')
			[ -n "$ip" ] && set_rhost "$ip"; log "  rescue IP from the banner: ${ip:-none (using $RHOST)}"
		elif [ -n "$RIP" ]; then
			set_rhost "$RIP"; log "  network-only: using --rescue-ip $RIP"
		else
			log "  network-only: looking for the rescue's IP (kiosk IP first, then MAC $mac sweep, up to 300s)"
			find_rescue_ip_network "$mac"
		fi
		w=0; until in_rescue; do sleep 5; w=$((w + 5)); [ $((w % 30)) -eq 0 ] && log "  still waiting for the rescue flag at $RHOST: $w/180 s"; [ $w -lt 180 ] || die "rescue flag not seen over ssh at $RHOST"; done
		log "  rescue reachable over ssh at $RHOST"
	fi
else
	if [ "$UART_ON" = 1 ]; then [ -n "$RIP" ] || RIP=$(rescue_ip_from_log); fi
	[ -n "$RIP" ] && set_rhost "$RIP"; log "== step 2 skipped; rescue host $RHOST"
fi
if [ "$FROM_STEP" -le 2 ] && [ "$TO_STEP" -ge 2 ]; then
	[ -n "$RIP" ] && set_rhost "$RIP"
	logblock "rescue status" "$($SSH 'uname -r; free -m | sed -n 2p; cat /proc/partitions | grep mmcblk; tsx-rescue status 2>&1 | head -20' 2>&1)"
fi

# ---------------------------------------------------------------- step 3 --
if [ "$FROM_STEP" -le 3 ] && [ "$TO_STEP" -ge 3 ]; then
	log "== step 3: payload -> rescue /tmp/b"
	in_rescue || die "panel at $RHOST is not in the rescue system (--rescue-ip?)"
	if [ -z "$BUNDLE" ]; then
		if [ -n "$ENVFILE" ]; then ENVSRC=$ENVFILE; log "  env from $ENVFILE (--env)"
		else
			ENVSRC=$HERE/results/env-live-$(date +%Y%m%d-%H%M%S).bin
			$SSH 'dd if=/dev/mmcblk0 bs=65536 skip=16 count=1 2>/dev/null' > "$ENVSRC" || die "reading the env from the card failed"
			[ "$(stat -c %s "$ENVSRC")" = 65536 ] || die "live env read: $(stat -c %s "$ENVSRC") bytes, want 65536"
			log "  live env read from the card at 1 MiB -> $ENVSRC ($(sha256sum < "$ENVSRC" | cut -c1-16)...)"
		fi
		chk=$($ENVPY check "$ENVSRC" 2>&1 || true); logblock "env check (tsx-env.py check)" "$chk"
		grep -q 'CRC ok' <<<"$chk" || die "the env at 1 MiB has a bad CRC (U-Boot would run on its default env): pass a saved one with --env (p1:tsxenv.bak, an installer env-0x100000.bin)"
		unit=$($ENVPY unit "$ENVSRC" 2>&1) || die "the env is not usable (bad CRC?): $unit; pass a saved one with --env (p1:tsxenv.bak, an installer env-0x100000.bin)"
		logblock "env identity (tsx-env.py unit)" "$unit"
		eth=$($ENVPY show "$ENVSRC" ethaddr | sed -n 's/^ethaddr=//p'); [ -n "$eth" ] || die "the env has no ethaddr: the unit's identity is missing (--env)"
		BUNDLE=$HERE/out/bundle-$(echo "$eth" | tr -d ':' | tr 'A-F' 'a-f')-$(date +%Y%m%d-%H%M)
		MKARGS=(--puf "$PUF" --env "$ENVSRC" --out "$BUNDLE"); if [ "$ROOTSSH" != 1 ]; then MKARGS+=(--stock-sshshell); elif [ -n "$SSHSHELL" ]; then MKARGS+=(--sshshell "$SSHSHELL"); fi
		log "  building the bundle (no backup$(if [ "$ROOTSSH" = 1 ]; then echo ", rootsh patch${SSHSHELL:+ from --sshshell $SSHSHELL}"; else echo ", --stock-sshshell"; fi)): $BUNDLE"
		out=$("$HERE/factory/mkbundle.sh" "${MKARGS[@]}" 2>&1) || { logblock "mkbundle" "$out"; die "mkbundle.sh failed"; }
		logblock "mkbundle (tail)" "$(printf '%s\n' "$out" | tail -n 25)"
		check_bundle; set_bundle_paths
	fi
	FILES="$(awk '{print $2}' "$BUNDLE/SHA256SUMS" | tr '\n' ' ')SHA256SUMS"
	log "  HTTP $BASEURL, files: $FILES"
	freek=$($SSH "awk '/MemAvailable/{print \$2}' /proc/meminfo"); [ "$freek" -gt 800000 ] || die "only ${freek} KiB available in the rescue, need > 800000"
	( cd "$PARENT"; python3 -m http.server "$PORT" --bind 0.0.0.0 >/dev/null 2>&1 & echo $! > "$HERE/results/.http.pid" )   # $! must be python's own pid
	HTTP_PID=$(cat "$HERE/results/.http.pid"); sleep 1; kill -0 "$HTTP_PID" || die "http.server did not start"
	log "  HTTP server pid $HTTP_PID serving $PARENT"
	t0=$(date +%s)
	log "  fetching payload (streaming live):"
	run_stream "set -e; mkdir -p /tmp/b; cd /tmp/b; for f in $FILES; do wget -q -O \$f $BASEURL/\$f && echo \"fetched \$f\" || { echo \"wget \$f FAILED\"; exit 1; }; done; sha256sum -c SHA256SUMS 2>&1 | grep -vc ': OK' | grep -qx 0 && echo 'all files OK' || { sha256sum -c SHA256SUMS | grep -v ': OK'; exit 1; }; chmod +x tsx-emmc-restore tsx-factory-restore; ls -l /tmp/b | wc -l; free -m | sed -n 2p" || die "payload failed (see output above)"
	log "  payload done in $(( $(date +%s) - t0 )) s"
	stop_http
fi

# ---------------------------------------------------------------- step 4 --
if [ "$FROM_STEP" -le 4 ] && [ "$TO_STEP" -ge 4 ]; then
	log "== step 4: check (nothing written)"
	log "  emmc check (streaming live):"
	run_stream 'sh /tmp/b/tsx-emmc-restore check /tmp/b 2>&1' || die "tsx-emmc-restore check failed (see output above)"
	log "  card check (streaming live):"
	run_stream 'TSX_SHARE=/usr/share/tsx sh /tmp/b/tsx-factory-restore check /tmp/b 2>&1' || die "tsx-factory-restore check failed (see output above)"
fi

# ---------------------------------------------------------------- step 5 --
if [ "$FROM_STEP" -le 5 ] && [ "$TO_STEP" -ge 5 ]; then
	log "== step 5: RUN"
	if [ "$YES" != 1 ]; then read -r -p "Rewrite the eMMC regions and the whole SD card of $PANEL to factory (U-Boot untouched)? Type FACTORY: " a </dev/tty; [ "$a" = FACTORY ] || die "not confirmed"; fi
	t0=$(date +%s)
	log "  emmc run (streaming live; this is the ~40 min step):"
	run_stream 'sh /tmp/b/tsx-emmc-restore run /tmp/b --yes 2>&1' || die "tsx-emmc-restore run FAILED (the rescue is still reachable over ssh at $RHOST: read the output above, re-run step 5 after fixing; U-Boot areas are never written)"
	log "  emmc run done in $(( $(date +%s) - t0 )) s"
	t0=$(date +%s)
	log "  card run (streaming live):"
	run_stream 'TSX_SHARE=/usr/share/tsx sh /tmp/b/tsx-factory-restore run /tmp/b --yes 2>&1' || die "tsx-factory-restore run FAILED (rescue still running in RAM)"
	log "  card run done in $(( $(date +%s) - t0 )) s"
	logblock "card after" "$($SSH 'cat /proc/partitions | grep mmcblk0; for p in 1 2 5 6 7 8; do echo "p$p: $(blkid /dev/mmcblk0p$p 2>/dev/null | cut -d: -f2-)"; done; echo "/tmp/b/env.bin 0x0 0x10000" > /run/b.cfg; fw_printenv -c /run/b.cfg boot_retry fwUpgrade switch_bootmode tsx_once 2>&1; echo "/dev/mmcblk0 0x100000 0x10000" > /run/c.cfg; fw_printenv -c /run/c.cfg boot_retry fwUpgrade DataRecoveryDone switch_bootmode tsx_boot tsx_once ethaddr tsid product_name 2>&1' 2>&1)"
	# tsx-env.py unhook (run inside mkbundle.sh when the bundle's env.bin was built)
	# already resets switch_bootmode to the byte-exact stock value, which has no
	# tsx-usb-recovery VBUS prefix: the factory restore disables USB recovery as
	# a side effect of unhooking, with no separate env write needed. Confirm it
	# (non-fatal: the card is already fully restored either way).
	SW=$($SSH 'echo "/dev/mmcblk0 0x100000 0x10000" > /run/c2.cfg; fw_printenv -c /run/c2.cfg -n switch_bootmode' 2>/dev/null) || SW="(check failed)"
	case "$SW" in "gset GPIOX_18"*) log "  WARNING: switch_bootmode still has the tsx-usb-recovery VBUS prefix after the factory restore: $SW";; *) log "  tsx-usb-recovery: disabled (switch_bootmode is the stock value, no VBUS prefix): $SW";; esac
fi

# ---------------------------------------------------------------- step 6 --
if [ "$FROM_STEP" -le 6 ] && [ "$TO_STEP" -ge 6 ]; then
	log "== step 6: reboot into stock Android"
	from=$(serial_lines)
	[ "$UART_ON" = 1 ] || [ -n "${mac:-}" ] || mac=$($SSH 'dd if=/dev/mmcblk0 bs=65536 skip=16 count=1 2>/dev/null | tr "\0" "\n" | sed -n "s/^ethaddr=//p"' 2>/dev/null | head -n 1 || true)   # not eth0: the rescue's MAC is random
	$SSH '(sleep 1; reboot -f) >/dev/null 2>&1 &' >/dev/null 2>&1 || true
	if [ "$UART_ON" = 1 ]; then
		wait_serial "root@Crestron Touchpanel:/ #" 420 "$from" "fs_mgr_mount_all returned unexpected error" "Kernel panic" "TSX RESCUE SYSTEM" "tsx: booting tsxboot.img"
	else
		log "  network-only: waiting for the rescue ssh to go away, then the web UI to answer at $PANEL (the unit keeps its own IP)"
		w=0; while ssh_ok && [ $w -lt 60 ]; do sleep 5; w=$((w + 5)); done
		w=0; ok=0; code=000
		while [ $w -lt 420 ]; do
			code=$(curl -sk -m 8 -o /dev/null -w '%{http_code}' "https://$PANEL/" 2>/dev/null || true); code=${code:-000}
			case "$code" in 200|301|302) ok=1; break;; esac
			sleep 10; w=$((w + 10))
			[ $((w % 30)) -eq 0 ] && log "  still waiting for the web UI at $PANEL: $w/420 s (last http $code)"
		done
		if [ "$ok" = 1 ]; then
			ANDROID_IP=$PANEL; log "  ok: web UI answers at $PANEL (http $code)"
		else
			log "  $PANEL did not answer within 420s; falling back to the MAC-based lookup"
			[ -n "${mac:-}" ] || die "stock Android did not answer at $PANEL within 420s and no MAC was captured for a fallback lookup"
			prefix=$(echo "$WSIP" | cut -d. -f1-3)
			cand=$(find_rescue_by_mac "$mac" "$prefix")
			[ -n "$cand" ] || die "stock Android did not come up: no https answer at $PANEL and no MAC match found on ${prefix}.0/24"
			ANDROID_IP=$cand
			log "  Android found at $ANDROID_IP via MAC lookup (unit did not keep $PANEL's address)"
		fi
	fi
	BOOT_FROM=$from
fi

# ---------------------------------------------------------------- step 7 --
if [ "$FROM_STEP" -le 7 ] && [ "$TO_STEP" -ge 7 ]; then
	log "== step 7: verify stock Android"
	if [ "$UART_ON" = 1 ]; then
	[ -n "${BOOT_FROM:-}" ] || BOOT_FROM=$(( $(serial_lines) - 400 )); [ "$BOOT_FROM" -gt 0 ] || BOOT_FROM=0
	# Crestron's one-time golden re-install (fresh sdcard): wait for fwUpgrade=0 + image dir gone + boot completed, tolerating a self-reboot
	w=0; last_banner=$(tail -n +$((BOOT_FROM + 1)) "$SERLOG" | tr -d '\0' | grep -c 'U-boot-0' || true)   # the boot itself
	while :; do
		new=$(tail -n +$((BOOT_FROM + 1)) "$SERLOG" | tr -d '\0')
		nb=$(printf '%s\n' "$new" | grep -c 'U-boot-0' || true)
		if [ "$nb" -gt "$last_banner" ]; then log "  U-Boot banner #$nb seen (reboot); waiting for the prompt again"; last_banner=$nb; wait_serial "root@Crestron Touchpanel:/ #" 420 "$(( $(serial_lines) - 50 ))" "fs_mgr_mount_all returned unexpected error"; fi
		fw=$(uart_last 'fw_printenv fwUpgrade' '^fwUpgrade=')
		img=$(uart_last 'ls /mnt/sdcard/ROMDISK/romdisk/user/system/image' 'No such|image')
		bc=$(uart_last 'getprop sys.boot_completed' '^[01]$')
		p5=$(uart_last 'mount | grep mmcblk0p5' 'mmcblk0p5 ')
		log "  fwUpgrade: ${fw:-?} | image dir: ${img:-?} | boot_completed: ${bc:-?} | p5: ${p5:-not mounted}"
		if [ "$fw" = "fwUpgrade=0" ] && grep -q 'No such' <<<"$img" && [ "$bc" = 1 ] && [ -n "$p5" ]; then break; fi
		w=$((w + 30)); [ $w -lt 900 ] || die "Android did not reach a stable full boot in 900 s"
		sleep 20
	done
	log "  Android fully booted (p5 mounted, fwUpgrade=0, boot_completed=1)"
	logblock "UART root console" "$(uart -w 3 'id; cat /proc/version' | grep -v '^>>> '; uart -w 3 'fw_printenv product_name updater_version boot_retry DataRecoveryDone' | grep -v '^>>> ')"
	logblock "mounts" "$(uart -w 3 'mount | grep mmcblk0' | grep -v '^>>> ')"
	grep -q 'fs_mgr_mount_all returned unexpected error' <<<"$new" && die "fs_mgr_mount_all error in the boot log"
	log "  stability watch: $STABLE_MIN min without a new U-Boot banner"
	n0=$(serial_lines); t0=$(date +%s); i=0
	while [ $(( $(date +%s) - t0 )) -lt $((STABLE_MIN * 60)) ]; do
		tail -n +$((n0 + 1)) "$SERLOG" | grep -q 'U-boot-0' && die "the panel rebooted during the stability watch (half-boot self-reset?)"
		i=$((i + 1)); [ $((i % 4)) -eq 0 ] && log "  stability watch: $(( $(date +%s) - t0 ))/$((STABLE_MIN * 60)) s elapsed, no reboot seen"
		sleep 15
	done
	log "  ok: no reboot in $STABLE_MIN min; uptime: $(uart_last 'cat /proc/uptime' '^[0-9]')"
	else
		log "  network-only (--uart $UART): fwUpgrade / boot_completed / p5-mounted checks are SKIPPED (no root console on a factory unit without the UART); with the rootsh patch (default) in system.img, the load driver (steps/tsx-android-to-card) gets root over 'ssh -tt $ADMIN_USER@panel rootsh' as soon as a Crestron account exists, no UART needed"
		w=0; ok=0; code=000
		while [ $w -lt 300 ]; do
			code=$(curl -sk -m 8 -o /dev/null -w '%{http_code}' "https://$ANDROID_IP/" 2>/dev/null || true); code=${code:-000}
			case "$code" in 200|301|302) ok=1; break;; esac
			sleep 10; w=$((w + 10))
			[ $((w % 30)) -eq 0 ] && log "  still waiting for the web UI at $ANDROID_IP: $w/300 s (last http $code)"
		done
		[ "$ok" = 1 ] || die "web UI at $ANDROID_IP never answered in step 7"
		log "  ok: web UI answers at $ANDROID_IP (http $code)"
		log "  network-only stability watch (weaker than the UART U-Boot-banner check): polling every 30s for $STABLE_MIN min, failing on >90s straight unreachable"
		t0=$(date +%s); down_since=; i=0
		while [ $(( $(date +%s) - t0 )) -lt $((STABLE_MIN * 60)) ]; do
			code=$(curl -sk -m 8 -o /dev/null -w '%{http_code}' "https://$ANDROID_IP/" 2>/dev/null || true)
			case "$code" in
			200|301|302) down_since=;;
			*)	if [ -z "$down_since" ]; then down_since=$(date +%s)
				elif [ $(( $(date +%s) - down_since )) -gt 90 ]; then die "web UI at $ANDROID_IP stopped answering for > 90s during the stability watch (reboot?)"
				fi;;
			esac
			i=$((i + 1)); [ $((i % 2)) -eq 0 ] && log "  stability watch: $(( $(date +%s) - t0 ))/$((STABLE_MIN * 60)) s elapsed (last http $code)"
			sleep 30
		done
		log "  ok: web UI kept answering through the $STABLE_MIN min stability watch"
	fi
	loc=$(curl -sk -m 15 -o /dev/null -w '%{redirect_url}' "https://$ANDROID_IP/index_device.html" || true)
	case "$loc" in
	*createUser.html) log "  ok: web UI up, no Crestron account (factory-fresh /data): create one at https://$ANDROID_IP/ or let tsx-android-to-card do it";;
	*)	[ -n "$ADMIN_PW" ] || die "a Crestron account already exists: set TSX_ADMIN_PW to its password to verify the console (step 7)"
		out=$(printf 'ver\r\nbye\r\n' | timeout 30 sshpass -p "$ADMIN_PW" ssh -tt -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR "$ADMIN_USER@$ANDROID_IP" 2>&1 | tr -d '\r' || true)
		logblock "Crestron SSH console (admin, 'ver'; web UI redirect: ${loc:-none})" "$out"
		grep -qiE 'TSW|TSS|\[v3\.' <<<"$out" && log "  ok: Crestron SSH console answers" || log "  WARNING: Crestron SSH console did not answer as expected (password '$ADMIN_PW'?)";;
	esac
fi
log "== done"
