#!/usr/bin/env bash
# Full factory restore driver. It restores a xx60 unit (SD card and eMMC) from
# the mainline rescue system, hands off. NO BACKUP NEEDED. The only inputs are
# the Crestron .puf and the U-Boot env of the unit. The rescue system reads that
# env live from the card (1 MiB). It holds the identity: MAC, tsid, model.
#
#   tsx-restore-factory PANEL_IP [--puf FILE] [options]      (no backup)
#   tsx-restore-factory --bundle DIR PANEL_IP [options]       (prebuilt bundle,
#        for example mkbundle.sh --emmc-raw/--boot0 from a backup of that unit)
#
# Without a backup, the driver zeroes the eMMC regions that stock Android does
# not use (recovery, misc, data, alignment gaps). Cache gets an empty ext4
# (mkbundle.sh). The card gets empty factory p5..p8 as always. Crestron /data
# (account, settings) is factory-fresh. Create the admin account in the web UI
# (https://PANEL/) or let steps/legacy/tsx-android-to-card do it.
#
# Steps. The driver logs each step with timestamps to --results (default
# results/tsx-restore-factory-<date>.txt). --from-step N resumes.
#   1  inputs: bundle SHA256SUMS, uboot-check.txt (U-Boot is never written),
#      helper scripts present. UART mode (see --uart below) also needs the
#      serial logger to run.
#   2  get the panel into the RESCUE system. From the kiosk, copy p1:boot.img
#      (the mainline rescue in the golden slot) to p1:tsxboot.img and verify
#      it. Remove p1:tsxboot.off. Arm tsx_once=1 if the hook is the v2 once
#      guard. Reboot. Wait for ssh with /etc/tsx/rescue-image. If the panel is
#      already in the rescue, there is nothing to do. If nothing answers, stop.
#      This driver never PoE-cycles.
#      UART mode reads the DHCP-leased IP of the rescue from the serial banner
#      'tsx-rescue: network: eth0 <ip>'.
#      Network-only mode records the eth0 MAC of the panel over ssh before the
#      reboot. Then it tries the IP of the kiosk every ~10 s for up to 300 s.
#      The rescue sets the MAC of eth0 from the U-Boot env, so a DHCP
#      reservation gives it the same address. If the /24 of the panel is
#      on-link from this host, the driver also sweeps that /24 (fping, or a
#      bounded parallel ping -c1 -W1 loop). It matches the MAC in `ip neigh`
#      (lib/tsx-rescue.sh wait_for_rescue). It accepts an IP once that IP
#      answers ssh root@IP test -f /etc/tsx/rescue-image (password $RPW).
#      An older rescue uses a random eth0 MAC. For that case the driver also
#      tries the dropbear hosts on that /24 whose card env (1 MiB) has
#      ethaddr = the recorded MAC.
#      --rescue-ip IP overrides discovery in both modes.
#   3  payload. Without --bundle, first read the live env from the card in the
#      rescue (results/env-live-<unit>-<date>.bin, CRC and MAC checked, --env
#      FILE overrides). Then build the bundle (mkbundle.sh, no backup) in
#      out/bundle-<unit>-<date>. Then push every file of SHA256SUMS into /tmp/b
#      of the rescue as one tar stream over ssh (lib/tsx-rescue.sh
#      tsx_push_bundle, live progress). /tmp/b is RAM, so the rescue needs the
#      size of the bundle plus 64 MiB free (about 750 MiB in total). The rescue
#      runs sha256sum -c before it uses the files. This host opens the ssh
#      connection: the panel never connects to this host (docs/install.md
#      "Network requirements").
#   4  check: tsx-emmc-restore check + tsx-factory-restore check (nothing
#      written)
#   5  run (gate: type FACTORY unless --yes). First tsx-emmc-restore run (boot,
#      system, recovery, cache, data, misc, logo verify). Then
#      tsx-factory-restore run (card table, p2, p1 golden, p5..p8, env last,
#      hook removed).
#   6  reboot -f.
#      UART mode waits on the serial log for the stock Android root prompt.
#      Network-only mode waits until the ssh of the rescue goes away. Then it
#      polls https://PANEL/ for up to 420 s (the unit keeps its own IP, and the
#      answer is 200, 301 or 302). If that never answers, it falls back to the
#      same MAC lookup as step 2 and logs the IP it finds.
#   7  UART mode verifies over the root console:
#      - p5 is mounted and there is no fs_mgr error
#      - if the one-time golden re-install of Crestron runs, wait for it
#        (fwUpgrade=0 and the image dir gone)
#      - sys.boot_completed=1
#      - a stability watch of --stable-min minutes (default 9, because the
#        half-boot self-reset comes at ~8.5) with no new U-Boot banner
#      Network-only mode cannot check fwUpgrade, boot_completed and p5. A
#      factory unit has no root without the UART. The driver logs that it
#      skips them. It polls the web UI for reachability. Then it runs a weaker
#      stability watch (poll every 30 s for --stable-min minutes, fail on more
#      than 90 s of straight unreachable).
#      Both modes then check the Crestron account state (steps/crestron-admin
#      --status, the /Device/Authentication page of the web UI). A factory-fresh
#      /data has no account (expected). If an account exists, the Crestron SSH
#      console must answer `ver` with the login of ADMIN_USER and
#      ADMIN_PASSWORD. They have no default. Without them, step 7
#      asks on a terminal, else it stops with an error that names them.
#
# Options:
#   --puf FILE  the Crestron firmware package (also $TSX_PUF). The default is
#          the copy that rootfs/vendor-fetch.sh downloads and sha256-pins into
#          rootfs/vendor-cache/, if present. --bundle does not need it. The
#          driver compares its sha256 with that pinned pristine package. It uses
#          a different file, with a warning.
#   --env FILE  a 64 KiB env block instead of the live one
#   --bundle DIR  --results FILE  --from-step N  --to-step N  --yes  --dry-run
#   --rescue-ip IP  overrides the rescue-IP discovery in UART and network-only mode
#   --ws-ip IP  --stable-min N
#   --check-requirements  check this host for the given options and exit
#   --install-config FILE  the install config file of tsx-install-mainline
#          (KEY=VALUE, installer/tsx-install.conf.example). This script uses
#          PANEL, PUF, UART, SSHSHELL, SSH_CIPHERS, ADMIN_USER, ADMIN_PASSWORD
#          and RESCUE_PASSWORD, and it ignores the other keys.
#   --rescue-password PW (or --rescue-pw PW, TSX_RESCUE_PW, RESCUE_PASSWORD)
#          the rescue login. The default is your ssh key.
#   --admin-user USER  --admin-password PW (or TSX_ADMIN_USER, TSX_ADMIN_PW,
#          ADMIN_USER, ADMIN_PASSWORD)  the Crestron login for step 7
#   --port N  ignored. The old HTTP download is gone: the bundle goes over ssh.
#   --ssh-ciphers LIST (or TSX_SSH_CIPHERS)  the ssh cipher list for the push
#          (lib/tsx-rescue.sh)
#   An option wins over its environment variable, and the variable wins over
#   the install config file. The logins have no default. A password on the
#   command line shows in the process list: the install config file (mode 600)
#   is the safe place.
#   --uart auto|yes|no  the default is auto. UART mode runs only if the serial
#          logger runs and uc.sh exists. Otherwise steps 2, 6 and 7 fall back to
#          the network-only checks described above. --uart yes or no forces
#          the mode.
#   Root over ssh is ON by default. mkbundle.sh adds a `rootsh` branch to the
#          sshShell.sh inside the system.img of the .puf. Then
#          `ssh -tt <admin-user>@panel rootsh` gets root right after the
#          restore with no UART. The Crestron console does not change. This
#          needs the pristine .puf. Step 3 refuses a modified image.
#   --sshshell FILE  bake your own sshShell.sh in as it is (also $SSHSHELL)
#   --stock-sshshell  opt out. The system.img stays byte-identical to the .puf.
#   --root-ssh  accepted, and the default. Step 3 uses these three options only
#          when it builds a bundle here (no --bundle). With --bundle,
#          mkbundle.sh has already run and the driver ignores them.
# CHECK THE HOST (docs/recovery.md "Restore stock Android without a backup",
# docs/install.md "Requirements on the host"): before the driver contacts the
# panel or writes a file, lib/tsx-preflight.sh checks the commands that this
# run needs. Always: sshpass, ssh, python3, curl, ip, tar and the standard
# tools. To build the bundle (no --bundle), also unzip, mke2fs, e2fsck, cmp,
# diff, and debugfs for the rootsh patch (e2fsprogs; on Debian they are in
# /sbin, so add that folder to PATH). It names ALL that are missing in one
# message, with package names, and exits with code 3. --check-requirements
# runs only this check and exits (0 ready, 3 not ready). UART mode (see
# --uart) also needs tools/bench/serlog.py to run (logging to
# tools/bench/boot-2200.log, or $TSX_SERIAL_LOG) and tools/bench/uc.sh. The
# rescue-IP sweep of network-only mode prefers fping if it is installed.
# Panel commands use this form (sshpass -e reads the password from SSHPASS, so
# it is not on a command line):
#   SSHPASS=PASSWORD sshpass -e ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@IP '...'
# The rescue has no fixed password (docs/recovery.md "Rescue login"):
# RESCUE_PASSWORD is the one-time password on the panel screen, or the
# panel's root password. With none, the script uses your SSH key.
set -euo pipefail
HERE=$(cd "$(dirname "$0")" && pwd); WORK=$(cd "$HERE/.." && pwd)
. "$HERE/lib/tsx-preflight.sh"   # first: it checks the bash version
SERIALDIR=$WORK/tools/bench; UC=$SERIALDIR/uc.sh; SERLOG=${TSX_SERIAL_LOG:-$SERIALDIR/boot-2200.log}
BUNDLE= PANEL= RESULTS= FROM_STEP=1 TO_STEP=7 YES=0 DRYRUN=0 WSIP= STABLE_MIN=9 RPW= RIP= UART= ICFILE=
PUF= ENVFILE= CHECKREQ=0
ROOTSSH=1 ROOTSSH_SET=0 SSHSHELL_OPT=   # rootsh patch by default
PRISTINE_PUF_SHA=96438108e3175b66c09f1df284ded5fe155593ba06e069e154688b04f395e40b   # rootfs/vendor-fetch.sh TFA_PUF_SHA256
PUF_CACHED=$WORK/rootfs/vendor-cache/tsw-xx60_3.002.1061.001.puf   # where rootfs/vendor-fetch.sh keeps it
ENVPY="python3 $HERE/sdcard/tsx-env.py"
. "$HERE/lib/tsx-rescue.sh"   # is_crestron_sshd (its discovery helpers are redefined below)
usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d' >&2; echo >&2; tsx_creds_help >&2; }   # the whole header comment
. "$HERE/lib/tsx-creds.sh"   # the logins: option, environment, prompt
while [ $# -gt 0 ]; do case "$1" in
	--bundle) BUNDLE=$2; shift 2;; --puf) PUF=$2; shift 2;; --env) ENVFILE=$2; shift 2;; --results) RESULTS=$2; shift 2;; --from-step) FROM_STEP=$2; shift 2;; --to-step) TO_STEP=$2; shift 2;;
	--yes) YES=1; shift;; --dry-run) DRYRUN=1; shift;; --port) echo "note: --port is ignored: the bundle goes over ssh, with no HTTP server" >&2; shift 2;; --ws-ip) WSIP=$2; shift 2;;
	--stable-min) STABLE_MIN=$2; shift 2;; --rescue-ip) RIP=$2; shift 2;; --rescue-pw) RPW=$2; shift 2;; --ssh-ciphers) export TSX_SSH_CIPHERS=$2; shift 2;; --uart) UART=$2; shift 2;;
	--root-ssh) ROOTSSH=1; ROOTSSH_SET=1; shift;; --sshshell) ROOTSSH=1; ROOTSSH_SET=1; SSHSHELL_OPT=$2; shift 2;; --stock-sshshell) ROOTSSH=0; SSHSHELL_OPT=-; shift;; -h|--help) usage; exit 0;;
	--rescue-password|--rescue-password-file) tsx_creds_opt "$@"; RPW=$TSX_RESCUE_PW; shift 2;;
	--install-config) ICFILE=$2; shift 2;; --check-requirements) CHECKREQ=1; shift;;
	--*) if tsx_creds_opt "$@"; then shift "$TSX_CREDS_SHIFT"; else echo "unknown option $1" >&2; usage; exit 2; fi;; *) [ -z "$PANEL" ] || { echo "extra argument $1" >&2; exit 2; }; PANEL=$1; shift;; esac; done
# option > environment variable > install config file (lib/tsx-creds.sh)
RPW=${RPW:-${TSX_RESCUE_PW:-}} PUF=${PUF:-${TSX_PUF:-}}
case "$SSHSHELL_OPT" in -) SSHSHELL=;; '') SSHSHELL=${SSHSHELL:-};; *) SSHSHELL=$SSHSHELL_OPT;; esac
if [ -n "$ICFILE" ]; then
	tsx_install_config_load "$ICFILE"
	tsx_install_config_logins
	PANEL=${PANEL:-$IC_PANEL} PUF=${PUF:-$IC_PUF} UART=${UART:-$IC_UART} RPW=${RPW:-$IC_RESCUE_PASSWORD}
	[ "$SSHSHELL_OPT" = - ] || SSHSHELL=${SSHSHELL:-$IC_SSHSHELL}
	[ -n "${TSX_SSH_CIPHERS:-}" ] || [ -z "$IC_SSH_CIPHERS" ] || export TSX_SSH_CIPHERS=$IC_SSH_CIPHERS
fi
UART=${UART:-auto}
# The check of the host (lib/tsx-preflight.sh): before any file and any contact
# with the panel. With no --bundle, this run builds the bundle here.
PF_ARGS=(uart="$UART")
[ -n "$BUNDLE" ] || PF_ARGS+=(build=1)
[ "$ROOTSSH" != 1 ] || PF_ARGS+=(rootssh=1)
[ -z "$WSIP" ] || PF_ARGS+=(wsip=1)
if [ "$CHECKREQ" = 1 ]; then tsx_preflight restore "${PF_ARGS[@]}" check=1 panel="${PANEL:-none}" || exit $?; exit 0; fi
tsx_preflight restore "${PF_ARGS[@]}" panel="${PANEL:-none}" || exit $?
[ -n "$PANEL" ] || { echo "tsx-restore-factory: the panel address is missing: give PANEL_IP, or PANEL in the install config file" >&2; usage; exit 2; }
case "$UART" in auto|yes|no) ;; *) echo "--uart must be auto, yes, or no" >&2; exit 2;; esac
[ -n "$RESULTS" ] || RESULTS=$HERE/results/tsx-restore-factory-$(date +%Y%m%d-%H%M).txt
mkdir -p "$(dirname "$RESULTS")" "$HERE/results"   # results/ also holds the live env
log() { printf '[%s] %s\n' "$(date '+%F %T')" "$*" | tee -a "$RESULTS" >&2; }
logblock() { log "-- $1 --"; printf '%s\n' "$2" | while IFS= read -r l; do log "  $l"; done; log "-- end $1 --"; }
die() { log "ERROR: $*"; exit 1; }
# Stream the output of a long remote command live, through log. It also lands
# in $RESULTS as it happens. The alternative is to capture it silently until
# the ssh session returns. The function leaves the full text in $out for a
# caller that needs to grep it. It returns the exit status of the remote
# command. It relies on `set -o pipefail` (already on through set -euo
# pipefail). The if-condition below reflects the status of $SSH, not of
# tee or while, so it is also safe under `set -e`.
run_stream() {  # CMD
	local cmd=$1 tmp rc
	tmp=$(mktemp "$RESULTS.XXXXXX")
	if $SSH "$cmd" 2>&1 | tee "$tmp" | while IFS= read -r l; do log "  $l"; done; then rc=0; else rc=$?; fi
	out=$(cat "$tmp"); rm -f "$tmp"
	return $rc
}
run_stream_cmd() {  # CMD...: run a host command (a function too), stream its output the same way
	local tmp rc
	tmp=$(mktemp "$RESULTS.XXXXXX")
	if "$@" 2>&1 | tee "$tmp" | while IFS= read -r l; do log "  $l"; done; then rc=0; else rc=$?; fi
	out=$(cat "$tmp"); rm -f "$tmp"
	return $rc
}
if [ "$ROOTSSH" = 1 ]; then
	if [ -n "$BUNDLE" ]; then [ "$ROOTSSH_SET" = 0 ] || log "  WARNING: --root-ssh/--sshshell ignored: --bundle was already built (its system.img is whatever mkbundle.sh made)"; ROOTSSH=0
	elif [ -n "$SSHSHELL" ]; then [ -f "$SSHSHELL" ] || die "--sshshell $SSHSHELL: no such file"
	fi
fi
RHOST=$PANEL
ANDROID_IP=$PANEL
SSH_CIPHERS=${TSX_SSH_CIPHERS:-$TSX_SSH_CIPHERS_DEFAULT}
set_rhost() { RHOST=$1; RESCUE_SSH_PW=$RPW; SSH="tsx_rescue_ssh_cur -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=8 -o ServerAliveInterval=10 -o ServerAliveCountMax=6 -o Ciphers=$SSH_CIPHERS root@$RHOST"; }
set_rhost "$PANEL"
rescue_ip_from_log() { tr -d '\0' < "$SERLOG" | grep -a -o 'tsx-rescue: network: eth0 [0-9.]*' | tail -n 1 | awk '{print $NF}'; }
ssh_ok() { is_crestron_sshd "$RHOST" && return 1; $SSH true >/dev/null 2>&1; }
in_rescue() { is_crestron_sshd "$RHOST" && return 1; $SSH 'test -f /etc/tsx/rescue-image' >/dev/null 2>&1; }
# --- network-only (no UART) rescue-IP discovery -----------------------------
# lib/tsx-rescue.sh (sourced above) has the discovery helpers that the install
# driver also uses: ssh_test_rescue, find_rescue_by_mac/_by_env and
# wait_for_rescue. wait_for_rescue tries the kiosk IP every ~10 s. It also
# sweeps the /24 of the PANEL by MAC when that /24 is on-link.
find_rescue_ip_network() {  # MAC: sets RHOST/RIP to the IP of the rescue through set_rhost, or dies after ~300 s
	local mac=$1 cand
	cand=$(wait_for_rescue "$PANEL" "$mac" "$WSIP" "$RPW" 300 2> >(while IFS= read -r l; do log "$l"; done)) ||
		die "network-only: could not find the rescue within 300s (ssh at $PANEL, MAC $mac). Try --rescue-ip"
	set_rhost "$cand"; RIP=$cand; log "  rescue found (network-only): $cand"
}
uart() { local w=4; if [ "$1" = -w ]; then w=$2; shift 2; fi; [ ${#1} -le 80 ] || die "UART command >80 chars: $1"; "$UC" -w "$w" "$1"; }
uart_last() {  # uart_last CMD REGEX: print the last line of the answer that matches REGEX (without the echo)
	uart "$1" | grep -v '^>>> ' | grep -E -- "$2" | tail -n 1 || true
}
serial_lines() { if [ -f "$SERLOG" ]; then wc -l < "$SERLOG"; else echo 0; fi; }   # no serial log without the UART
wait_serial() {  # PATTERN TIMEOUT_S FROMLINE [ABORT...]: wait for PATTERN in the log lines after FROMLINE
	local pat=$1 t=$2 from=$3; shift 3; local w=0 new a
	log "  waiting up to ${t}s on the serial log for: $pat"
	while [ $w -lt "$t" ]; do
		new=$(tail -n +$((from + 1)) "$SERLOG" | tr -d '\0')
		for a in "$@"; do grep -qF -- "$a" <<<"$new" && die "serial log shows '$a'"; done
		grep -qF -- "$pat" <<<"$new" && { log "  ok: '$pat' at $(date +%T)"; return 0; }
		sleep 5; w=$((w + 5))
		[ $((w % 30)) -eq 0 ] && log "  still waiting for '$pat': $w/${t} s"
	done
	die "timeout after ${t}s waiting for '$pat' on the serial log"
}
log "== tsx-restore-factory: PANEL=$PANEL BUNDLE=$BUNDLE from-step=$FROM_STEP dry-run=$DRYRUN results=$RESULTS"

# ---------------------------------------------------------------- step 1 --
log "== step 1: inputs"
check_bundle() {
	[ -f "$BUNDLE/factory.manifest" ] && [ -f "$BUNDLE/emmc.manifest" ] && [ -f "$BUNDLE/SHA256SUMS" ] || die "$BUNDLE is not a factory-restore bundle"
	(cd "$BUNDLE" && sha256sum -c SHA256SUMS >/dev/null) || die "bundle SHA256SUMS mismatch"
	log "  bundle OK: unit $(sed -n 's/^unit=//p' "$BUNDLE/factory.manifest"), fw $(sed -n 's/^firmware_version=//p' "$BUNDLE/factory.manifest"), $(grep -c '^region ' "$BUNDLE/emmc.manifest") eMMC regions, eMMC backup: $(grep -q '^boot0_sha256=any$' "$BUNDLE/emmc.manifest" && echo none || echo used)"
	logblock "uboot-check.txt" "$(cat "$BUNDLE/uboot-check.txt")"
	grep -q '^identity_and_hw=identical$' "$BUNDLE/env-identity.txt" || die "env-identity.txt: identity not identical"
}
if [ -n "$BUNDLE" ]; then check_bundle
else
	if [ -z "$PUF" ] && [ -f "$PUF_CACHED" ]; then PUF=$PUF_CACHED; log "  no --puf: using the copy rootfs/vendor-fetch.sh downloaded: $PUF"; fi
	[ -n "$PUF" ] || die "no .puf given (--puf FILE or \$TSX_PUF), and none in rootfs/vendor-cache/. Run rootfs/vendor-fetch.sh once. It downloads the public Crestron tsw-xx60_3.002.1061.001.puf and checks its sha256. Or pass --puf"
	[ -f "$PUF" ] || die "no .puf at $PUF (--puf)"
	PUFSHA=$(sha256sum < "$PUF" | cut -d' ' -f1)
	if [ "$PUFSHA" = "$PRISTINE_PUF_SHA" ]; then log "  .puf $PUF: pristine 3.002.1061.001 ($PUFSHA)"
	else log "  WARNING: .puf $PUF sha256 $PUFSHA is not the known pristine package (rootfs/vendor-fetch.sh)$([ "$ROOTSSH" = 1 ] && [ -z "$SSHSHELL" ] && echo ". The rootsh patch (default) refuses a modified sshShell.sh in step 3. Use the pristine .puf, --sshshell FILE or --stock-sshshell")"; fi
	[ -z "$ENVFILE" ] || { [ -f "$ENVFILE" ] || die "--env $ENVFILE: no such file"; }
	log "  no bundle given: it is built in step 3 from the .puf + the unit's ${ENVFILE:-live} env (no backup)"
fi
case "$UART" in
	yes) UART_ON=1;;
	no) UART_ON=0;;
	auto) if pgrep -f '^python3 .*serlog\.py' >/dev/null 2>&1 && [ -x "$UC" ]; then UART_ON=1; else UART_ON=0; fi
		log "  --uart auto -> $([ "$UART_ON" = 1 ] && echo yes || echo no)";;
esac
if [ "$UART_ON" = 1 ]; then
	pgrep -f '^python3 .*serlog\.py' >/dev/null || die "serial logger (serlog.py) is not running (--uart $UART)"
	[ -x "$UC" ] || die "$UC missing (--uart $UART)"
	log "  UART mode: serial logger running, log $SERLOG ($(serial_lines) lines)"
else
	log "  network-only mode (--uart $UART): steps 2, 6 and 7 use ssh, curl and MAC-based checks instead of the serial log and the UART console"
fi
if [ -z "$WSIP" ]; then WSIP=$(ip route get "$PANEL" | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}'); fi
[ -n "$WSIP" ] || die "no workstation IP towards $PANEL (--ws-ip)"
if [ "$DRYRUN" = 1 ]; then
	log "[dry-run] step 2: ssh root@$PANEL: if kiosk (no /etc/tsx/rescue-image): mount p1, cp boot.img tsxboot.img, sha check, rm tsxboot.off, tsx_once=1 if the hook is the once guard, umount, reboot. Wait for ssh + rescue flag (300 s)"
	if [ "$UART_ON" = 1 ]; then
		log "[dry-run] step 2 (UART): rescue IP read from the serial banner 'tsx-rescue: network: eth0 <ip>'"
	else
		log "[dry-run] step 2 (network-only): record eth0 MAC over ssh before reboot. Every ~10s up to 300s: ssh at the kiosk's own IP $PANEL, plus a MAC sweep of its /24 when that is on-link from $WSIP (lib/tsx-rescue.sh wait_for_rescue). Accept once ssh root@IP test -f /etc/tsx/rescue-image succeeds; --rescue-ip overrides"
	fi
	[ -n "$BUNDLE" ] || log "[dry-run] step 3a: rescue: dd if=/dev/mmcblk0 bs=65536 skip=16 count=1 > results/env-live-<unit>-<date>.bin (or --env). tsx-env.py unit (CRC, ethaddr). mkbundle.sh --puf $PUF --env <env> --out out/bundle-<unit>-<date>$(if [ "$ROOTSSH" = 1 ]; then echo "${SSHSHELL:+ --sshshell $SSHSHELL} (rootsh patch)"; else echo " --stock-sshshell"; fi)"
	log "[dry-run] step 3: rm -rf /tmp/b in the rescue, check MemAvailable >= bundle + 64 MiB. Push every file of SHA256SUMS + SHA256SUMS to /tmp/b as one tar stream over ssh (tsx_push_bundle, ciphers $SSH_CIPHERS, live progress). sha256sum -c SHA256SUMS in the rescue. The panel opens no connection to this host"
	log "[dry-run] step 4: sh /tmp/b/tsx-emmc-restore check /tmp/b. TSX_SHARE=/usr/share/tsx sh /tmp/b/tsx-factory-restore check /tmp/b"
	log "[dry-run] step 5: gate FACTORY. sh /tmp/b/tsx-emmc-restore run /tmp/b --yes. TSX_SHARE=/usr/share/tsx sh /tmp/b/tsx-factory-restore run /tmp/b --yes"
	if [ "$UART_ON" = 1 ]; then
		log "[dry-run] step 6 (UART): reboot -f. wait_serial 'root@Crestron Touchpanel:/ #' 420 (abort: fs_mgr_mount_all returned unexpected error, Kernel panic, TSX RESCUE SYSTEM, tsx: booting tsxboot.img)"
		log "[dry-run] step 7 (UART): mount|grep mmcblk0p5, fw_printenv fwUpgrade, ls image dir, getprop sys.boot_completed. Stability ${STABLE_MIN} min. steps/crestron-admin --status $PANEL: none (no account, expected) or ssh -tt <admin-user>@$PANEL ver"
	else
		log "[dry-run] step 6 (network-only): reboot -f. Wait for rescue ssh to go away, then poll https://$PANEL/ (200/301/302) up to 420s. Beyond that, MAC lookup as in step 2 and log the IP found"
		log "[dry-run] step 7 (network-only): fwUpgrade/boot_completed/p5 checks SKIPPED (no root without UART). With the rootsh patch (default), the load driver gets root over ssh once an account exists. Poll web UI reachable, then stability watch every 30s for ${STABLE_MIN} min (fail on >90s down straight). steps/crestron-admin --status $PANEL: none (no account, expected) or ssh -tt <admin-user>@$PANEL ver"
	fi
	log "== dry-run done"; exit 0
fi

# ---------------------------------------------------------------- step 2 --
if [ "$FROM_STEP" -le 2 ] && [ "$TO_STEP" -ge 2 ]; then
	log "== step 2: rescue system"
	ssh_ok || die "ssh root@$PANEL does not answer: the panel must be on mainline (kiosk or rescue). No PoE cycle by this driver"
	if in_rescue; then log "  already in the rescue system"; else
		from=$(serial_lines)
		if [ "$UART_ON" != 1 ]; then
			mac=$($SSH 'cat /sys/class/net/eth0/address' 2>/dev/null) || die "could not read the panel's eth0 MAC before reboot (needed for network-only rescue-IP discovery)"
			log "  panel MAC (for network-only rescue-IP discovery): $mac"
		fi
		# The hook boots p1:tsxboot.img only when p1:tsxboot.off is absent. With
		# the v2 `once` guard it also needs tsx_once=1 (docs/boot.md "The v2 env
		# state machine"). lib/tsx-arm-from-mainline.sh does all of this. The
		# reinstall path of tsx-install-mainline shares it. It copies the golden
		# rescue to p1:tsxboot.img, clears tsxboot.off, arms tsx_once=1 (verified)
		# and reboots.
		out=$($SSH 'cat > /run/tsx-arm-from-mainline.sh && sh /run/tsx-arm-from-mainline.sh' < "$HERE/lib/tsx-arm-from-mainline.sh" 2>&1) || die "p1 rescue copy failed: $out"
		logblock "p1 rescue copy" "$out"
		grep -q REBOOTING <<<"$out" || die "no reboot"
		if [ "$UART_ON" = 1 ]; then
			wait_serial "TSX RESCUE SYSTEM" 300 "$from" "Kernel panic" "root@Crestron Touchpanel"
			ip=$(tail -n +$((from + 1)) "$SERLOG" | tr -d '\0' | grep -a -o 'tsx-rescue: network: eth0 [0-9.]*' | tail -n 1 | awk '{print $NF}')
			[ -n "$ip" ] && set_rhost "$ip"; log "  rescue IP from the banner: ${ip:-none (using $RHOST)}"
		elif [ -n "$RIP" ]; then
			set_rhost "$RIP"; log "  network-only: using --rescue-ip $RIP"
		else
			log "  network-only: looking for the rescue's IP (kiosk IP first, then MAC $mac sweep, up to 300s)"
			find_rescue_ip_network "$mac"
		fi
		w=0; until in_rescue; do sleep 5; w=$((w + 5)); [ $((w % 30)) -eq 0 ] && log "  still waiting for the rescue flag at $RHOST: $w/180 s"; [ $w -lt 180 ] || die "rescue flag not seen over ssh at $RHOST"; done
		log "  rescue reachable over ssh at $RHOST"
	fi
else
	if [ "$UART_ON" = 1 ]; then [ -n "$RIP" ] || RIP=$(rescue_ip_from_log); fi
	[ -n "$RIP" ] && set_rhost "$RIP"; log "== step 2 skipped. Rescue host $RHOST"
fi
if [ "$FROM_STEP" -le 2 ] && [ "$TO_STEP" -ge 2 ]; then
	[ -n "$RIP" ] && set_rhost "$RIP"
	logblock "rescue status" "$($SSH 'uname -r; free -m | sed -n 2p; cat /proc/partitions | grep mmcblk; tsx-rescue status 2>&1 | head -20' 2>&1)"
fi

# ---------------------------------------------------------------- step 3 --
if [ "$FROM_STEP" -le 3 ] && [ "$TO_STEP" -ge 3 ]; then
	log "== step 3: payload -> rescue /tmp/b"
	in_rescue || die "panel at $RHOST is not in the rescue system (--rescue-ip?)"
	if [ -z "$BUNDLE" ]; then
		if [ -n "$ENVFILE" ]; then ENVSRC=$ENVFILE; log "  env from $ENVFILE (--env)"
		else
			ENVSRC=$HERE/results/env-live-$(date +%Y%m%d-%H%M%S).bin
			$SSH 'dd if=/dev/mmcblk0 bs=65536 skip=16 count=1 2>/dev/null' > "$ENVSRC" || die "reading the env from the card failed"
			[ "$(stat -c %s "$ENVSRC")" = 65536 ] || die "live env read: $(stat -c %s "$ENVSRC") bytes, want 65536"
			log "  live env read from the card at 1 MiB -> $ENVSRC ($(sha256sum < "$ENVSRC" | cut -c1-16)...)"
		fi
		chk=$($ENVPY check "$ENVSRC" 2>&1 || true); logblock "env check (tsx-env.py check)" "$chk"
		grep -q 'CRC ok' <<<"$chk" || die "the env at 1 MiB has a bad CRC, so U-Boot would run on its default env. Pass a saved env with --env (p1:tsxenv.bak or an installer env-0x100000.bin)"
		unit=$($ENVPY unit "$ENVSRC" 2>&1) || die "the env is not usable (bad CRC?): $unit. Pass a saved one with --env (p1:tsxenv.bak, an installer env-0x100000.bin)"
		logblock "env identity (tsx-env.py unit)" "$unit"
		eth=$($ENVPY show "$ENVSRC" ethaddr | sed -n 's/^ethaddr=//p'); [ -n "$eth" ] || die "the env has no ethaddr: the unit's identity is missing (--env)"
		BUNDLE=$HERE/out/bundle-$(echo "$eth" | tr -d ':' | tr 'A-F' 'a-f')-$(date +%Y%m%d-%H%M)
		MKARGS=(--puf "$PUF" --env "$ENVSRC" --out "$BUNDLE"); if [ "$ROOTSSH" != 1 ]; then MKARGS+=(--stock-sshshell); elif [ -n "$SSHSHELL" ]; then MKARGS+=(--sshshell "$SSHSHELL"); fi
		log "  building the bundle (no backup$(if [ "$ROOTSSH" = 1 ]; then echo ", rootsh patch${SSHSHELL:+ from --sshshell $SSHSHELL}"; else echo ", --stock-sshshell"; fi)): $BUNDLE"
		out=$("$HERE/factory/mkbundle.sh" "${MKARGS[@]}" 2>&1) || { logblock "mkbundle" "$out"; die "mkbundle.sh failed"; }
		logblock "mkbundle (tail)" "$(printf '%s\n' "$out" | tail -n 25)"
		check_bundle
	fi
	FILES="$(awk '{print $2}' "$BUNDLE/SHA256SUMS" | tr '\n' ' ')SHA256SUMS"
	NEEDK=$(( $(cd "$BUNDLE" && awk '{print $2}' SHA256SUMS | xargs du -kL | awk '{s += $1} END {print s + 0}') + 65536 ))
	# An earlier attempt left its bundle in /tmp/b (RAM): remove it before the memory check.
	$SSH 'rm -rf /tmp/b /tmp/b.new' </dev/null || die "could not clear /tmp/b in the rescue"
	freek=$($SSH "awk '/MemAvailable/{print \$2}' /proc/meminfo" </dev/null); [ "${freek:-0}" -ge "$NEEDK" ] || die "only ${freek:-?} KiB available in the rescue, the bundle needs $NEEDK KiB (its size plus 64 MiB)"
	log "  pushing the bundle to /tmp/b of the rescue over ssh ($(( NEEDK / 1024 - 64 )) MiB, ${freek} KiB available). Files: $FILES"
	t0=$(date +%s)
	TSX_PUSH_OP="factory restore" TSX_PUSH_LABEL="the factory bundle" run_stream_cmd tsx_push_bundle "$BUNDLE" /tmp/b $SSH </dev/null || die "pushing the bundle failed (see the output above). The rescue is still up: run step 3 again (--from-step 3)"
	run_stream 'chmod +x /tmp/b/tsx-emmc-restore /tmp/b/tsx-factory-restore; echo "files in /tmp/b: $(ls /tmp/b | wc -l)"; free -m | sed -n 2p' </dev/null || die "the bundle in /tmp/b is not complete"
	log "  payload done in $(( $(date +%s) - t0 )) s"
fi

# ---------------------------------------------------------------- step 4 --
if [ "$FROM_STEP" -le 4 ] && [ "$TO_STEP" -ge 4 ]; then
	log "== step 4: check (nothing written)"
	log "  emmc check (streaming live):"
	run_stream 'sh /tmp/b/tsx-emmc-restore check /tmp/b 2>&1' || die "tsx-emmc-restore check failed (see output above)"
	log "  card check (streaming live):"
	run_stream 'TSX_SHARE=/usr/share/tsx sh /tmp/b/tsx-factory-restore check /tmp/b 2>&1' || die "tsx-factory-restore check failed (see output above)"
fi

# ---------------------------------------------------------------- step 5 --
if [ "$FROM_STEP" -le 5 ] && [ "$TO_STEP" -ge 5 ]; then
	log "== step 5: RUN"
	if [ "$YES" != 1 ]; then read -r -p "Rewrite the eMMC regions and the whole SD card of $PANEL to factory (U-Boot untouched)? Type FACTORY: " a </dev/tty; [ "$a" = FACTORY ] || die "not confirmed"; fi
	t0=$(date +%s)
	log "  emmc run (streaming live. This is the ~40 min step):"
	run_stream 'sh /tmp/b/tsx-emmc-restore run /tmp/b --yes 2>&1' || die "tsx-emmc-restore run FAILED (the rescue is still reachable over ssh at $RHOST: read the output above, re-run step 5 after fixing. U-Boot areas are never written)"
	log "  emmc run done in $(( $(date +%s) - t0 )) s"
	t0=$(date +%s)
	log "  card run (streaming live):"
	run_stream 'TSX_SHARE=/usr/share/tsx sh /tmp/b/tsx-factory-restore run /tmp/b --yes 2>&1' || die "tsx-factory-restore run FAILED (rescue still running in RAM)"
	log "  card run done in $(( $(date +%s) - t0 )) s"
	logblock "card after" "$($SSH 'cat /proc/partitions | grep mmcblk0; for p in 1 2 5 6 7 8; do echo "p$p: $(blkid /dev/mmcblk0p$p 2>/dev/null | cut -d: -f2-)"; done; echo "/tmp/b/env.bin 0x0 0x10000" > /run/b.cfg; fw_printenv -c /run/b.cfg boot_retry fwUpgrade switch_bootmode tsx_once 2>&1; echo "/dev/mmcblk0 0x100000 0x10000" > /run/c.cfg; fw_printenv -c /run/c.cfg boot_retry fwUpgrade DataRecoveryDone switch_bootmode tsx_boot tsx_once ethaddr tsid product_name 2>&1' 2>&1)"
	# tsx-env.py unhook (mkbundle.sh runs it when it builds env.bin of the bundle)
	# already resets switch_bootmode to the byte-exact stock value. That value
	# has no tsx-usb-recovery VBUS prefix. So the unhook also disables USB
	# recovery, and the factory restore needs no separate env write. Confirm it.
	# A failure here is not fatal, because the card is fully restored either way.
	SW=$($SSH 'echo "/dev/mmcblk0 0x100000 0x10000" > /run/c2.cfg; fw_printenv -c /run/c2.cfg -n switch_bootmode' 2>/dev/null) || SW="(check failed)"
	case "$SW" in "gset GPIOX_18"*) log "  WARNING: switch_bootmode still has the tsx-usb-recovery VBUS prefix after the factory restore: $SW";; *) log "  tsx-usb-recovery: disabled (switch_bootmode is the stock value, no VBUS prefix): $SW";; esac
fi

# ---------------------------------------------------------------- step 6 --
if [ "$FROM_STEP" -le 6 ] && [ "$TO_STEP" -ge 6 ]; then
	log "== step 6: reboot into stock Android"
	from=$(serial_lines)
	[ "$UART_ON" = 1 ] || [ -n "${mac:-}" ] || mac=$($SSH 'dd if=/dev/mmcblk0 bs=65536 skip=16 count=1 2>/dev/null | tr "\0" "\n" | sed -n "s/^ethaddr=//p"' 2>/dev/null | head -n 1 || true)   # not eth0: the rescue's MAC is random
	$SSH '(sleep 1; reboot -f) >/dev/null 2>&1 &' >/dev/null 2>&1 || true
	if [ "$UART_ON" = 1 ]; then
		wait_serial "root@Crestron Touchpanel:/ #" 420 "$from" "fs_mgr_mount_all returned unexpected error" "Kernel panic" "TSX RESCUE SYSTEM" "tsx: booting tsxboot.img"
	else
		log "  network-only: waiting for the rescue ssh to go away, then the web UI to answer at $PANEL (the unit keeps its own IP)"
		w=0; while ssh_ok && [ $w -lt 60 ]; do sleep 5; w=$((w + 5)); done
		w=0; ok=0; code=000
		while [ $w -lt 420 ]; do
			code=$(curl -sk -m 8 -o /dev/null -w '%{http_code}' "https://$PANEL/" 2>/dev/null || true); code=${code:-000}
			case "$code" in 200|301|302) ok=1; break;; esac
			sleep 10; w=$((w + 10))
			[ $((w % 30)) -eq 0 ] && log "  still waiting for the web UI at $PANEL: $w/420 s (last http $code)"
		done
		if [ "$ok" = 1 ]; then
			ANDROID_IP=$PANEL; log "  ok: web UI answers at $PANEL (http $code)"
		else
			log "  $PANEL did not answer within 420s. Falling back to the MAC-based lookup"
			[ -n "${mac:-}" ] || die "stock Android did not answer at $PANEL within 420s and no MAC was captured for a fallback lookup"
			prefix=$(echo "$PANEL" | cut -d. -f1-3)
			cand=$(find_rescue_by_mac "$mac" "$prefix")
			[ -n "$cand" ] || die "stock Android did not come up: no https answer at $PANEL and no MAC match found on ${prefix}.0/24"
			ANDROID_IP=$cand
			log "  Android found at $ANDROID_IP via MAC lookup (unit did not keep $PANEL's address)"
		fi
	fi
	BOOT_FROM=$from
fi

# ---------------------------------------------------------------- step 7 --
if [ "$FROM_STEP" -le 7 ] && [ "$TO_STEP" -ge 7 ]; then
	log "== step 7: verify stock Android"
	if [ "$UART_ON" = 1 ]; then
	[ -n "${BOOT_FROM:-}" ] || BOOT_FROM=$(( $(serial_lines) - 400 )); [ "$BOOT_FROM" -gt 0 ] || BOOT_FROM=0
	# Crestron runs a one-time golden re-install (fresh sdcard). Wait for fwUpgrade=0, the image dir gone and boot completed. Allow a self-reboot.
	w=0; last_banner=$(tail -n +$((BOOT_FROM + 1)) "$SERLOG" | tr -d '\0' | grep -c 'U-boot-0' || true)   # the boot itself
	while :; do
		new=$(tail -n +$((BOOT_FROM + 1)) "$SERLOG" | tr -d '\0')
		nb=$(printf '%s\n' "$new" | grep -c 'U-boot-0' || true)
		if [ "$nb" -gt "$last_banner" ]; then log "  U-Boot banner #$nb seen (reboot). Waiting for the prompt again"; last_banner=$nb; wait_serial "root@Crestron Touchpanel:/ #" 420 "$(( $(serial_lines) - 50 ))" "fs_mgr_mount_all returned unexpected error"; fi
		fw=$(uart_last 'fw_printenv fwUpgrade' '^fwUpgrade=')
		img=$(uart_last 'ls /mnt/sdcard/ROMDISK/romdisk/user/system/image' 'No such|image')
		bc=$(uart_last 'getprop sys.boot_completed' '^[01]$')
		p5=$(uart_last 'mount | grep mmcblk0p5' 'mmcblk0p5 ')
		log "  fwUpgrade: ${fw:-?} | image dir: ${img:-?} | boot_completed: ${bc:-?} | p5: ${p5:-not mounted}"
		if [ "$fw" = "fwUpgrade=0" ] && grep -q 'No such' <<<"$img" && [ "$bc" = 1 ] && [ -n "$p5" ]; then break; fi
		w=$((w + 30)); [ $w -lt 900 ] || die "Android did not reach a stable full boot in 900 s"
		sleep 20
	done
	log "  Android fully booted (p5 mounted, fwUpgrade=0, boot_completed=1)"
	logblock "UART root console" "$(uart -w 3 'id; cat /proc/version' | grep -v '^>>> '; uart -w 3 'fw_printenv product_name updater_version boot_retry DataRecoveryDone' | grep -v '^>>> ')"
	logblock "mounts" "$(uart -w 3 'mount | grep mmcblk0' | grep -v '^>>> ')"
	grep -q 'fs_mgr_mount_all returned unexpected error' <<<"$new" && die "fs_mgr_mount_all error in the boot log"
	log "  stability watch: $STABLE_MIN min without a new U-Boot banner"
	n0=$(serial_lines); t0=$(date +%s); i=0
	while [ $(( $(date +%s) - t0 )) -lt $((STABLE_MIN * 60)) ]; do
		tail -n +$((n0 + 1)) "$SERLOG" | grep -q 'U-boot-0' && die "the panel rebooted during the stability watch (half-boot self-reset?)"
		i=$((i + 1)); [ $((i % 4)) -eq 0 ] && log "  stability watch: $(( $(date +%s) - t0 ))/$((STABLE_MIN * 60)) s elapsed, no reboot seen"
		sleep 15
	done
	log "  ok: no reboot in $STABLE_MIN min. uptime: $(uart_last 'cat /proc/uptime' '^[0-9]')"
	else
		log "  network-only (--uart $UART): the fwUpgrade, boot_completed and p5-mounted checks are SKIPPED, because a factory unit has no root console without the UART. With the rootsh patch (the default) in system.img, a Crestron account is enough. The load driver (steps/tsx-android-to-card) then gets root over 'ssh -tt <admin-user>@panel rootsh' and needs no UART"
		w=0; ok=0; code=000
		while [ $w -lt 300 ]; do
			code=$(curl -sk -m 8 -o /dev/null -w '%{http_code}' "https://$ANDROID_IP/" 2>/dev/null || true); code=${code:-000}
			case "$code" in 200|301|302) ok=1; break;; esac
			sleep 10; w=$((w + 10))
			[ $((w % 30)) -eq 0 ] && log "  still waiting for the web UI at $ANDROID_IP: $w/300 s (last http $code)"
		done
		[ "$ok" = 1 ] || die "web UI at $ANDROID_IP never answered in step 7"
		log "  ok: web UI answers at $ANDROID_IP (http $code)"
		log "  network-only stability watch (weaker than the UART U-Boot-banner check): polling every 30s for $STABLE_MIN min, failing on >90s straight unreachable"
		t0=$(date +%s); down_since=; i=0
		while [ $(( $(date +%s) - t0 )) -lt $((STABLE_MIN * 60)) ]; do
			code=$(curl -sk -m 8 -o /dev/null -w '%{http_code}' "https://$ANDROID_IP/" 2>/dev/null || true)
			case "$code" in
			200|301|302) down_since=;;
			*)	if [ -z "$down_since" ]; then down_since=$(date +%s)
				elif [ $(( $(date +%s) - down_since )) -gt 90 ]; then die "web UI at $ANDROID_IP stopped answering for > 90s during the stability watch (reboot?)"
				fi;;
			esac
			i=$((i + 1)); [ $((i % 2)) -eq 0 ] && log "  stability watch: $(( $(date +%s) - t0 ))/$((STABLE_MIN * 60)) s elapsed (last http $code)"
			sleep 30
		done
		log "  ok: web UI kept answering through the $STABLE_MIN min stability watch"
	fi
	acct=$("$HERE/steps/crestron-admin" --status "$ANDROID_IP" 2>/dev/null || true)
	case "$acct" in
	none) log "  ok: web UI up, no Crestron account (factory-fresh /data): create one at https://$ANDROID_IP/ or with installer/steps/crestron-admin (tsx-install-mainline does it)"
		log "  NOTE: the Crestron auto update is ON, and the restored panel reports PUF: Unknown. With internet access it installs the same firmware again at its AUTIME (about 15 min, with a reboot): do not power it off then. tsx-install-mainline turns the auto update off (AUENABLE OFF) and waits for an update that runs. By hand: create the account, then AUENABLE OFF on the Crestron console";;
	*)	tsx_creds_need_admin 1 || die "a Crestron account already exists, and step 7 needs its login to check the console"
		out=$(printf 'ver\r\nbye\r\n' | SSHPASS=$TSX_ADMIN_PW timeout 30 sshpass -e ssh -tt -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR "$TSX_ADMIN_USER@$ANDROID_IP" 2>&1 | tr -d '\r' || true)
		logblock "Crestron SSH console ($TSX_ADMIN_USER, 'ver', account state: ${acct:-web UI did not answer})" "$out"
		grep -qiE 'TSW|TSS|\[v3\.' <<<"$out" && log "  ok: Crestron SSH console answers" || log "  WARNING: Crestron SSH console did not answer as expected (wrong user or password?)";;
	esac
fi
log "== done"
