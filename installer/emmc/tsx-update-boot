#!/bin/sh
# ON THE PANEL (running kiosk system): replace the mainline boot image.
#   tsx-update-boot IMG SHA256          card layout: p1:tsxboot.img only, same steps as
#                                       rootfs/install.sh step 2 (golden boot.img untouched,
#                                       verified before/after)
#   tsx-update-boot --emmc IMG SHA256   eMMC layout: raw write into the eMMC boot partition
#                                       (mmcblk1p7, 32 MiB); the previous partition content is
#                                       saved first to /data/tsxboot-emmc.prev.img (+ .sha256),
#                                       readback verified; a bad readback restores the old image.
#                                       Roll back: tsx-update-boot --emmc /data/tsxboot-emmc.prev.img
#                                       $(cat /data/tsxboot-emmc.prev.img.sha256)
#   tsx-update-boot --help
set -eu
case "${1:-}" in -h|--help) sed -n '2,12p' "$0"; exit 0;; esac
EMMC=0; [ "${1:-}" = --emmc ] && { EMMC=1; shift; }
IMG=${1:?IMG}; SHA=${2:?SHA256}; P1=/dev/mmcblk0p1 M=/media/bootfat
[ "$(sha256sum < "$IMG" | cut -d' ' -f1)" = "$SHA" ] || { echo "image sha mismatch"; exit 1; }

if [ "$EMMC" = 1 ]; then
	BOOT=/dev/mmcblk1p7 PREV=/data/tsxboot-emmc.prev.img
	sz=$(stat -c %s "$IMG")
	psz=$(cat /sys/class/block/mmcblk1p7/size 2>/dev/null || echo 0)
	[ "$psz" = 65536 ] || { echo "$BOOT is not the 32 MiB eMMC boot partition (size $psz sectors)"; exit 1; }
	[ "$sz" -le $((psz * 512)) ] || { echo "image ($sz bytes) larger than $BOOT"; exit 1; }
	grep -q " /data " /proc/mounts || { echo "/data is not mounted (needed for the backup)"; exit 1; }
	grep -q "^$BOOT " /proc/mounts && { echo "$BOOT is mounted"; exit 1; }
	# read back LEN bytes of the partition, sha256
	part_sha() { dd if=$BOOT bs=1M count=$(( ($1 + 1048575) / 1048576 )) 2>/dev/null | head -c "$1" | sha256sum | cut -d' ' -f1; }
	# a roll back (IMG is the backup itself): keep a copy, the backup below replaces it
	if [ "$IMG" -ef "$PREV" ]; then cp "$IMG" /data/tsxboot-emmc.rollback.img; IMG=/data/tsxboot-emmc.rollback.img; fi
	echo "--- saving the current $BOOT (32 MiB) to $PREV"
	dd if=$BOOT of=$PREV.new bs=1M conv=fsync 2>&1 | tail -1
	psha=$(sha256sum < $PREV.new | cut -d' ' -f1)
	[ "$(part_sha $((psz * 512)))" = "$psha" ] || { rm -f $PREV.new; echo "backup readback mismatch"; exit 1; }
	mv $PREV.new $PREV; echo "$psha" > $PREV.sha256; sync
	echo "previous boot partition sha256 (32 MiB): $psha"
	echo "--- writing $IMG ($sz bytes) into $BOOT"
	dd if="$IMG" of=$BOOT bs=1M conv=fsync 2>&1 | tail -1
	sync; echo 3 > /proc/sys/vm/drop_caches
	got=$(part_sha "$sz")
	if [ "$got" = "$SHA" ]; then
		echo "boot partition verified ($got)"
		rm -f /data/tsxboot-emmc.rollback.img
		[ -f /etc/tsx/emmc-root.info ] && sed -i "s#^boot_partition=.*#boot_partition=$BOOT image_sha256=$SHA updated=$(date -Iseconds)#" /etc/tsx/emmc-root.info
		echo "done: reboot to start the new kernel; roll back with: tsx-update-boot --emmc $PREV $psha"
		exit 0
	fi
	echo "BOOT READBACK MISMATCH ($got): restoring the previous image"
	dd if=$PREV of=$BOOT bs=1M conv=fsync 2>&1 | tail -1
	sync; echo 3 > /proc/sys/vm/drop_caches
	[ "$(part_sha $((psz * 512)))" = "$psha" ] && echo "previous image restored and verified" || echo "WARNING: restore readback mismatch too; do NOT reboot; boot the rescue system if needed"
	exit 1
fi

mkdir -p $M; mount -t vfat $P1 $M
trap 'umount $M 2>/dev/null || true' EXIT
[ -f $M/boot.img ] || { echo "no golden boot.img on $P1"; exit 1; }
echo "--- p1 before"; ls -l $M; df -k $M | tail -1
gsha=$(sha256sum < $M/boot.img | cut -d' ' -f1); echo "golden boot.img sha256 before: $gsha"
[ -f $M/tsxboot.img ] && echo "old tsxboot.img sha256: $(sha256sum < $M/tsxboot.img | cut -d' ' -f1)"
need=$(( $(stat -c %s "$IMG") / 1024 + 1024 )); free=$(df -k $M | awk 'NR==2{print $4}')
old=0; [ -f $M/tsxboot.img ] && old=$(( $(stat -c %s $M/tsxboot.img) / 1024 ))
[ $((free + old)) -gt $need ] || { echo "not enough space"; exit 1; }
if [ "$free" -le "$need" ] && [ "$old" -gt 0 ]; then echo "no room side by side: removing old tsxboot.img first"; rm -f $M/tsxboot.img; sync; fi
cp "$IMG" $M/tsxboot.new && sync
[ "$(sha256sum < $M/tsxboot.new | cut -d' ' -f1)" = "$SHA" ] || { rm -f $M/tsxboot.new; echo "copy corrupt"; exit 1; }
mv $M/tsxboot.new $M/tsxboot.img; sync
echo 3 > /proc/sys/vm/drop_caches
echo "--- p1 after"; ls -l $M
echo "tsxboot.img sha256 after (re-read): $(sha256sum < $M/tsxboot.img | cut -d' ' -f1)"
g2=$(sha256sum < $M/boot.img | cut -d' ' -f1); echo "golden boot.img sha256 after: $g2"
[ "$g2" = "$gsha" ] && echo "golden unchanged: OK" || { echo "WARNING golden changed"; exit 1; }
