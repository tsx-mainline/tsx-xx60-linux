#!/bin/sh
# tsx-usb-recovery enable|disable|status
#
# ON THE PANEL: from the Android root shell (stock, over Crestron's patched
# sshd), the mainline rescue system, or the mainline kiosk -- wherever
# fw_printenv/fw_setenv and a POSIX sh are available (busybox or Android
# toolbox). No tsx-lib.sh dependency: this is copied onto the panel and run
# standalone (scp/wget it, or paste it from a root console).
#
# U-Boot's stock switch_bootmode runs "usb start 0" before checking for
# jabil.txt, but on every logged boot (0/51) the external USB-A port has no
# VBUS yet at that point, so U-Boot never sees a stick (docs/boot.md "U-Boot
# USB needs VBUS held before enumeration"). The fix, found at the U-Boot
# prompt: "gset GPIOX_18 out high; msleep 500;" before "usb start 0".
#
# enable   prepends that to switch_bootmode (idempotent: does nothing if
#          already there)
# disable  removes exactly that prefix (idempotent)
# status   prints enabled/disabled/foreign (foreign = switch_bootmode does
#          not start with "usb start 0;": not touched)
#
# Edits the U-Boot env on the SD card at 1 MiB (64 KiB, CRC32), the same way
# and with the same read-back-and-verify discipline as
# /usr/local/sbin/tsx-boot-ok: one env write at most, read back and checked
# before this script reports success.
#
# Env overrides (host tests only; never set these on a panel):
#   TSX_SYSBLOCK   glob/dir of /sys/block entries to scan (default: real /sys/block)
#   TSX_DEVDIR     dir of the block device nodes (default: autodetected, see below)
#   TSX_RUN        scratch dir for the fw_env.config file (default /run)
#   TSX_ENV_DEV    skip disk discovery and the block-device check entirely; use this
#                  file/device directly (a bare 64 KiB env fixture, for host tests)
set -eu
MODE=${1:-}
case "$MODE" in
enable|disable|status) ;;
-h|--help) sed -n '2,7p' "$0"; exit 0 ;;
*) sed -n '2,7p' "$0" >&2; exit 2 ;;
esac
RUN=${TSX_RUN:-/run}; mkdir -p "$RUN" 2>/dev/null || RUN=/tmp
die() { echo "tsx-usb-recovery: ERROR: $*" >&2; exit 1; }
PREFIX='gset GPIOX_18 out high; msleep 500; '

if [ -n "${TSX_ENV_DEV:-}" ]; then
	DEV=$TSX_ENV_DEV
	[ -e "$DEV" ] || die "TSX_ENV_DEV=$DEV: no such file"
else
	# ---- find the SD-class boot disk: p1 at sector 81920, p2 at 206849 (true of
	# both the stock Crestron layout and the card-stage layout the installer
	# converts every unit to; see installer/android/tsx-lib.sh TSX_LAYOUT_STOCK/CARD)
	DISK=
	for d in ${TSX_SYSBLOCK:-/sys/block/mmcblk[0-9]*}; do
		[ -e "$d" ] || continue
		n=${d##*/}
		[ -e "$d/${n}p1" ] && [ -e "$d/${n}p2" ] || continue
		[ "$(cat "$d/${n}p1/start" 2>/dev/null)" = 81920 ] || continue
		[ "$(cat "$d/${n}p2/start" 2>/dev/null)" = 206849 ] || continue
		DISK=$n; break
	done
	[ -n "$DISK" ] || die "no SD-class disk with the Crestron/card-stage partition layout found"
	if [ -n "${TSX_DEVDIR:-}" ]; then DEV=$TSX_DEVDIR/$DISK
	elif [ -b "/dev/block/$DISK" ]; then DEV=/dev/block/$DISK
	else DEV=/dev/$DISK
	fi
	[ -b "$DEV" ] || die "$DEV is not a block device"
fi

FWP=$(command -v fw_printenv 2>/dev/null || echo /system/bin/fw_printenv); [ -x "$FWP" ] || die "no fw_printenv in PATH or at /system/bin"
FWS=$(command -v fw_setenv 2>/dev/null || echo /system/bin/fw_setenv); [ -x "$FWS" ] || die "no fw_setenv in PATH or at /system/bin"
CFG=$RUN/tsx-usb-recovery.cfg
OFF=0x100000; [ -n "${TSX_ENV_DEV:-}" ] && OFF=0x0   # TSX_ENV_DEV fixtures are a bare 64 KiB block, not a whole disk
echo "$DEV $OFF 0x10000" > "$CFG"
CUR=$("$FWP" -c "$CFG" -l "$RUN" 2>&1) || die "fw_printenv failed: $CUR"
echo "$CUR" | grep -qi 'bad crc' && die "env CRC bad at $DEV 0x100000: refusing to touch it"
CURSW=$(echo "$CUR" | sed -n 's/^switch_bootmode=//p')

state() {
	case "$CURSW" in
	"$PREFIX"*) echo enabled;;
	"usb start 0;"*) echo disabled;;
	*) echo foreign;;
	esac
}
ST=$(state)

if [ "$MODE" = status ]; then
	echo "tsx-usb-recovery: $ST (disk $DEV, switch_bootmode=${CURSW:-<unset>})"
	[ "$ST" = foreign ] && exit 1 || exit 0
fi

case "$MODE:$ST" in
enable:enabled) echo "tsx-usb-recovery: already enabled on $DEV"; exit 0;;
disable:disabled) echo "tsx-usb-recovery: already disabled on $DEV"; exit 0;;
enable:foreign|disable:foreign) die "switch_bootmode does not start with 'usb start 0;' (foreign hook?): $CURSW";;
esac

if [ "$MODE" = enable ]; then NEW="$PREFIX$CURSW"
else NEW=${CURSW#"$PREFIX"}
fi
"$FWS" -c "$CFG" -l "$RUN" switch_bootmode "$NEW" || die "fw_setenv failed"
GOT=$("$FWP" -c "$CFG" -l "$RUN" -n switch_bootmode 2>/dev/null) || die "fw_printenv readback failed"
[ "$GOT" = "$NEW" ] || die "readback mismatch after the write: got '$GOT', wanted '$NEW' (env may now be inconsistent: re-run 'status')"
echo "tsx-usb-recovery: $MODE done and verified on $DEV (switch_bootmode=$NEW)"
