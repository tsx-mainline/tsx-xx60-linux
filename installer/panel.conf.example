# installer/panel.conf.example: xx60 panel configuration (tsx-config).
#
# Copy this file and fill in the values that you want to set ahead of time.
# Pass it to the installer with --config FILE (tsx-install-mainline, or
# mkpayload --usb --config FILE for the USB method). It becomes
# /data/tsx/panel.conf on the panel. A key that you leave out keeps its
# built-in default (see docs/rootfs.md "Panel configuration"). --config FILE
# skips the interactive prompts of the installer entirely.
#
# This is the same file format that tsx-config reads and writes on the panel
# (KEY="value", one setting per line, '#' comments). Edit it by hand, or build
# it with, for example:
#   TSX_CONF=./my-panel.conf tsx-config set KIOSK_URL https://ha.example.org
# Never source this file with `.`. Only the own parser of tsx-config (get, set,
# show, apply) reads it, on the host or on the panel.

# The name in Home Assistant and ESPHome, the sendspin player list and the voice
# satellite. It also becomes the hostname of the panel. Default: <model>-<last 6
# hex digits of the MAC>, e.g. TSS-10-ABCDEF.
#PANEL_NAME=

# The Home Assistant dashboard URL that the kiosk opens.
KIOSK_URL=https://ha.example.org/

# How the kiosk logs in with no keyboard. "token" seeds HA_TOKEN below into the
# browser profile at first start. "trusted" relies on a Home Assistant
# trusted_networks auth provider for the IP of the panel instead (no token needed).
# Unset = the panel shows the login form of Home Assistant.
HA_LOGIN_METHOD=trusted
# A Home Assistant long-lived access token (Profile > Long-Lived Access
# Tokens). It is used only when HA_LOGIN_METHOD=token. It is a secret, so keep
# the permissions of this file closed (tsx-config always writes it with mode 600).
#HA_TOKEN=

# Time zone (a name under /usr/share/zoneinfo).
TZ_NAME=America/Denver

# How the panel hangs on the wall, seen from the front. landscape is the default
# (the front keys are right of the screen). portrait is turned 90 degrees
# clockwise (keys below). landscape-flipped has the keys left. portrait-flipped
# has the keys above. The kiosk turns at once. The boot splash follows from the
# root mount on. See docs/rootfs.md "Orientation".
#ORIENTATION=landscape

# The Home Assistant Assist voice satellite (docs/ha.md): on or off. When it is
# on, WAKE_WORD sets the on-device wake word. A panel without a microphone
# (U-Boot government=1, the TSW-760-NC) keeps the satellite off, also with on.
VOICE=off
#WAKE_WORD=okay_nabu

# How the panel presents itself to Home Assistant (docs/ha.md "One Home
# Assistant device"). esphome (default) is one zero-config device over the
# ESPHome native API, with no broker. The voice satellite serves it when
# VOICE=on, and tsx-esphome serves it when VOICE=off. mqtt uses only the
# tsx-mqtt bridge below. both uses whichever of the two you configured.
#HA_TRANSPORT=esphome

# The encryption key of the ESPHome API, exactly like `api: encryption: key:` on
# an ESPHome device: 32 random bytes, base64 (make one with
#   head -c 32 /dev/urandom | base64
# ). Paste the same text into Home Assistant when it asks for the encryption key
# of the device. Empty (default) = no encryption. Then anyone on the LAN who can
# reach the API can reboot the panel or change its dashboard URL (docs/ha.md
# "Security"). The installer offers to generate a key.
#HA_API_KEY=

# Defense in depth on top of HA_API_KEY (and the only protection without a key).
# A comma list of IPv4/IPv6 addresses or CIDRs that may use the ESPHome API.
# Normally this is just the own LAN address of your Home Assistant host. Do NOT
# use the host of the dashboard URL if a reverse proxy sits in front of Home
# Assistant. Empty (default) = allow any host.
#HA_ALLOW_FROM=

# MQTT bridge to Home Assistant (tsx-mqtt). It is used only when HA_TRANSPORT is
# mqtt or both. Leave MQTT_HOST empty (the default) to keep it off.
#MQTT_HOST=
#MQTT_PORT=1883
#MQTT_USER=
#MQTT_PASSWORD=

# The kernel flavor that this panel tracks: lts (default, for users and
# releases) or stable (docs/kernel.md).
KERNEL_FLAVOR=lts

# The base URL of the project apk repository (tsx-aports). The panel lists
# <APK_URL>/<alpine-branch>/common and .../xx60 first in /etc/apk/repositories.
# Unset = the URL that the rootfs was built with
# (https://tsx-aports.unexceptional.net). A LAN mirror or a local directory
# works too. "off" leaves the two repositories out (Alpine only).
#APK_URL=

# Seconds without input before the screen goes dark (0 = never, at most 86400).
# Unset = BLANK_TIMEOUT of /etc/kiosk.conf (300). This is also the "Blank
# timeout" number in Home Assistant, which writes this key.
#BLANK_TIMEOUT=

# 1 = show kernel and boot text on the LCD instead of the boot splash, from the
# next boot on (for debugging a boot). The serial console always has the text.
# Unset or 0 = the splash. See docs/boot.md "Boot splash".
#BOOT_VERBOSE=

# The Bluetooth proxy for Home Assistant (docs/ha.md "Bluetooth proxy"): on,
# off, or empty. When it is on, the panel starts its Bluetooth chip and passes
# the BLE advertisements that it hears to Home Assistant over the ESPHome API.
# Empty (default) = the default of the panel type: off on the xx60.
# A panel without a Bluetooth module (government=1) keeps it off, also with on.
#BT_PROXY=off
# Active connections of the Bluetooth proxy: on or off. With BT_PROXY=on and
# BT_ACTIVE=on, Home Assistant can also connect to BLE devices through the
# panel (read, write and notifications). Up to 3 links at a time. With off,
# the panel never connects to a Bluetooth device. Default: off.
#BT_ACTIVE=off
# The Bluetooth address of the panel. Empty (default) = the eth0 MAC. The
# vendor firmware uses the same value.
#BT_MAC=

# The camera for Home Assistant (docs/ha.md "Camera"): off, snapshot or live.
# off (default): no camera entities, and nothing opens the camera.
# snapshot: a Camera entity, a "Take snapshot" button and a "Last snapshot"
# time. The camera opens only for one image at each press.
# live: a Camera entity with a new image for each Home Assistant request.
# on is the old name of live. Home Assistant cannot change this key.
# A panel without a camera (government=1) keeps it off.
#CAMERA=off

# on = the backlight follows the ambient light sensor (tsx-als, the curve in
# /etc/tsx/als.conf). Default on. Also the "Auto brightness" switch in Home
# Assistant, which writes this key.
#AUTO_BRIGHTNESS=on
# The light sensor sits behind the front window, which passes only part of
# the light. Lux = sensor lux x ALS_SCALE (0.01-1000). Unset = 1.
#ALS_SCALE=

# Root login. A public image has no root password, and the installer stops unless this
# file has ROOT_PASSWORD_HASH or SSH_AUTHORIZED_KEY (or both). ROOT_PASSWORD_HASH is a
# crypt(3) hash (e.g. `openssl passwd -6`, or `mkpasswd -m sha-512`), never a plain
# password. The panel applies it at the first boot, and a hash that it has applied once
# is not applied again, so a password that someone sets later on the panel stays.
# With a key and no hash, the root password is locked: ssh takes the key, and the login
# on the panel screen opens after you run passwd over ssh. SSH_AUTHORIZED_KEY is one
# "ssh-ed25519 AAAA... comment" line. Setting it only ADDS a key. panel.conf
# never removes the existing keys on the panel. The rescue system uses the same two
# values (docs/recovery.md).
#ROOT_PASSWORD_HASH=
#SSH_AUTHORIZED_KEY=
