# installer/panel.conf.example: xx60 panel configuration (tsx-config).
#
# Copy this file, fill in the values you want to set ahead of time, and pass
# it to the installer with --config FILE (tsx-install-mainline, or mkpayload
# --usb --config FILE for the USB method); it becomes /data/tsx/panel.conf
# on the panel. Any key you leave out keeps its built-in default (see
# docs/rootfs.md "Panel configuration"). --config FILE skips the installer's
# interactive prompts entirely.
#
# This is the same file format tsx-config reads/writes on the panel itself
# (KEY="value", one setting per line, '#' comments) -- edit it by hand, or
# build it with, e.g.:
#   TSX_CONF=./my-panel.conf tsx-config set KIOSK_URL https://ha.example.org
# Never `.` source this file: it is only ever read by tsx-config's own
# parser (get/set/show/apply), on the host or on the panel.

# Shown in Home Assistant / ESPHome, the sendspin player list and the voice
# satellite; also becomes the panel's hostname. Default: <model>-<last 6 hex
# of the MAC>, e.g. TSS-10-ABCDEF.
#PANEL_NAME=

# Home Assistant dashboard URL the kiosk opens.
KIOSK_URL=https://ha.example.org/

# How the kiosk logs in with no keyboard: "token" seeds HA_TOKEN below into
# the browser profile at first start; "trusted" relies on a Home Assistant
# trusted_networks auth provider for the panel's IP instead (no token needed).
HA_LOGIN_METHOD=trusted
# A Home Assistant long-lived access token (Profile > Long-Lived Access
# Tokens). Only used when HA_LOGIN_METHOD=token. Secret: keep this file's
# permissions closed (tsx-config always writes it mode 600).
#HA_TOKEN=

# Time zone (a name under /usr/share/zoneinfo).
TZ_NAME=America/Denver

# Home Assistant Assist voice satellite (docs/ha.md): on/off, and the
# on-device wake word when it is on.
VOICE=off
#WAKE_WORD=okay_nabu

# How the panel presents itself to Home Assistant (docs/ha.md "One Home
# Assistant device"): esphome (default) = one zero-config device over the
# ESPHome native API, no broker -- the voice satellite serves it when
# VOICE=on, tsx-esphome when VOICE=off; mqtt = the tsx-mqtt bridge below
# only; both = whichever of the two are configured.
#HA_TRANSPORT=esphome

# ESPHome API encryption key, exactly like `api: encryption: key:` on an
# ESPHome device: 32 random bytes, base64 (make one with
#   head -c 32 /dev/urandom | base64
# ). Paste the same text into Home Assistant when it asks for the device's
# encryption key. Empty (default) = no encryption: anyone on the LAN who can
# reach the API can reboot the panel or change its dashboard URL
# (docs/ha.md "Security"). The installer offers to generate one.
#HA_API_KEY=

# Defence in depth on top of HA_API_KEY (and the only protection without
# one): comma list of IPv4/IPv6 addresses or CIDRs allowed to use the ESPHome
# API -- normally just your Home Assistant host's own LAN address (NOT the
# dashboard URL's host if that is a reverse proxy in front of it). Empty
# (default) = allow any host.
#HA_ALLOW_FROM=

# MQTT bridge to Home Assistant (tsx-mqtt): only used when HA_TRANSPORT is
# mqtt or both; leave MQTT_HOST empty (the default) to keep it off.
#MQTT_HOST=
#MQTT_PORT=1883
#MQTT_USER=
#MQTT_PASSWORD=

# Which kernel flavor this panel tracks: lts (default, for users/releases)
# or stable (docs/kernel.md).
KERNEL_FLAVOR=lts

# Base URL of the project apk repository (tsx-aports): the panel lists
# <APK_URL>/<alpine-branch>/common and .../xx60 first in
# /etc/apk/repositories. Unset = the URL the rootfs was built with
# (https://tsx-aports.unexceptional.net). A LAN mirror or a local directory
# works too; "off" leaves the two repositories out (Alpine only).
#APK_URL=

# Seconds without input before the screen goes dark (0 = never, at most
# 86400). Unset = BLANK_TIMEOUT of /etc/kiosk.conf (300). Also the "Blank
# timeout" number in Home Assistant, which writes this key.
#BLANK_TIMEOUT=

# Root login. ROOT_PASSWORD_HASH is a crypt(3) hash (e.g. `openssl passwd
# -6`, or `mkpasswd -m sha-512`), never a plain password. SSH_AUTHORIZED_KEY
# is one "ssh-ed25519 AAAA... comment" line; setting it only ADDS a key
# (existing keys on the panel are kept, never removed by panel.conf).
#ROOT_PASSWORD_HASH=
#SSH_AUTHORIZED_KEY=
