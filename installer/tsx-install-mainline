#!/usr/bin/env bash
# Install mainline on a stock Android panel, or reinstall it on a mainline panel.
# The kiosk goes on the eMMC and a rescue image runs first (v2). This script
# replaces the old card-stage driver: steps/tsx-android-to-card and
# steps/tsx-card-to-emmc. Both are now in installer/steps/legacy/. Only the
# card stage of the USB install method still uses them (see docs/install.md).
# It is one host command and needs no USB stick.
#
#   1. steps/tsx-ensure-root: make sure PANEL_IP is stock Android and settled.
#      Also make sure root over the Crestron sshd (steps/rootsh) works.
#   2. steps/tsx-rescue-arm.sh: the host copies it, with the rescue image, over
#      the root shell (steps/rootsh --put) and runs it over steps/rootsh. It
#      writes only the rescue image to card p1. That
#      slot is both the golden slot and the one-shot hook target. It arms
#      tsx_once=1 for exactly one rescue boot (a true one-shot, not a
#      boot_retry count). Then it reboots. If the rescue never checks in, the
#      panel falls back to stock Android after one power cycle. See
#      docs/boot.md "The v2 env state machine" for the env states.
#   3. Find the rescue on the network (installer/lib/tsx-rescue.sh). Try the
#      IP of the kiosk first, then sweep by MAC. Step 2 records the panel MAC
#      before the reboot, because the reboot loses the Android eth0 state.
#      Then drive the rescue:
#      - push the install bundle with the eMMC boot image as one tar stream
#        over ssh (tsx_push_dir), then stream the root image into
#        installer/steps/tsx-rescue-install over ssh (live progress). The
#        rescue reads every image back and the host compares the sha256
#      - push the TFA9890 DSP files and the PSR file the same way, only if
#        the panel has none (below)
#      - fold the card (p5..p8 -> p4 tsxdata)
#      - write the final env (tsx-usb-recovery enabled, p1:tsxboot.off)
#      - reboot
#   4. Wait for the ssh of the mainline kiosk. Verify that root is eMMC p8.
#      Print a summary.
#
# REINSTALL / UPDATE (docs/install.md "Reinstalling or updating a mainline
# panel"): if PANEL_IP already answers as the mainline kiosk (root on eMMC
# p8), steps 1-2 run on the kiosk instead of Android. This needs no Crestron
# account and no rootsh. The script copies rescue.img over the ssh of the
# kiosk. Then lib/tsx-arm-from-mainline.sh (shared with tsx-restore-factory)
# puts it in p1:tsxboot.img, removes p1:tsxboot.off and arms tsx_once=1. The
# panel reboots into the rescue. Steps 3-4 stay the same, with one change: the
# script keeps the tsxdata of the card if it is a clean tsxdata file system
# (tsx-rescue-install --keep-data). tsxdata holds /data: the browser profile
# and login, logs, panel.conf and sendspin state. --wipe-data formats it as a
# first install does. Then only panel.conf carries over. After the new rescue
# boots, the script also copies it into the golden slot (p1:boot.img).
#
#   tsx-install-mainline PANEL_IP --payload DIR --kernel lts|stable
#                        [--admin-user USER --admin-password-file FILE]
#                        [--mainline-password-file FILE]
#                        [--rescue-password-file FILE]
#                        [--uart auto|yes|no] [--kiosk-url URL] [--sshshell FILE]
#                        [--config FILE] [--wipe-data] [--yes] [--dry-run]
#                        [--tfa-source auto|panel|puf|none]
#                        [--psr-source auto|panel|puf|none]
#                        [--stage auto|yes|no] [--fetch TAG|URL]
#                        [--release-url URL] [--stage-wait SECONDS]
#                        [--ssh-ciphers LIST] [--common DIR]
#
# REQUIREMENT (stock Android with no UART, docs/install.md "Root over the
# Crestron sshd"): the panel must have the rootsh method. Then
# `ssh -tt <user>@<panel> rootsh` gives a root shell: the interactive (tty)
# branch of the /system/bin/sshShell.sh of the panel starts a root shell for
# the command rootsh. A panel as Crestron ships it does not have the method.
# This installer does not set it up over the network. The other way in is the
# UART (--uart yes --sshshell FILE). Without the method, step 1 stops with an
# error that names the docs section.
#
# OPTIONS AND ENVIRONMENT VARIABLES: an option wins over its environment
# variable. The environment variables are for automation. The logins have no
# default value (see "Logins" at the end of this text).
#
# DOWNLOAD THE RELEASE ON THE PANEL (docs/install.md "Download the release on
# the panel"), --fetch TAG: a reinstall of a mainline panel without a payload
# on this host. The kiosk downloads the release TAG of tsx-xx60-linux from
# GitHub itself (steps/tsx-netinstall, curl), checks the signature of its
# SHA256SUMS with the project key in /etc/apk/keys, and makes the stage of
# --stage. This host sends only the scripts, panel.conf and the commands.
# TAG can also be the full download URL of a release (a fork or a mirror).
# --release-url URL (or TSX_RELEASE_URL) sets the URL of the releases (default
# https://github.com/tsx-mainline/tsx-xx60-linux/releases/download).
# --stage-wait SECONDS (or TSX_STAGE_WAIT_S, default 2400) is the time that
# this host waits for a staged install.
#
# STAGE ON THE PANEL FIRST (docs/install.md "Stage on the panel first"),
# --stage (default auto): before the rescue boot, while Android or the kiosk
# still runs, copy the install bundle and a gzip of root.img onto the card of
# the panel (lib/tsx-stage.sh): card p5 on stock Android, /data on a mainline
# panel. The rescue then installs from that copy by itself
# (steps/tsx-rescue-staged) and needs no network. This host only watches. A
# lost link or a network move during the rescue no longer stops the install.
# auto: stage when the payload's rescue image can run a stage and the card has
# room, else push the images over ssh during the rescue (as with --stage no).
# yes: stop when the stage is not possible. If the staged run fails in the
# rescue, the host pushes the images over ssh if it can reach the rescue.
#
# PANEL CONFIGURATION (docs/rootfs.md "Panel configuration"): without
# --config, and unless --yes is also given, the script prompts for panel.conf
# (installer/panel.conf.example). The prompts cover the HA URL and login, time
# zone, voice, MQTT, an ssh key and more. If the panel already answers as a
# mainline kiosk (a reinstall), the script first reads its /data/tsx/panel.conf
# over ssh and uses it for the prompt defaults. --config FILE uses that file
# as it is and skips the prompts (scripted and multi-panel installs). --yes
# with no --config also skips the prompts. It keeps only the legacy
# --kiosk-url behavior and writes no panel.conf. On a reinstall the panel
# keeps its own panel.conf: it stays on the kept tsxdata, or the script copies
# it over with --wipe-data. The resulting file becomes /data/tsx/panel.conf on
# the panel (installer/steps/tsx-rescue-install writes it onto tsxdata).
#
# ROOT LOGIN (docs/rootfs.md "Root login"): the install stops unless the
# panel.conf has a root password hash (ROOT_PASSWORD_HASH) or an SSH public key
# (SSH_AUTHORIZED_KEY). This holds for --config, for the prompts and for --yes.
# With --yes and no --config, only a reinstall of a mainline panel passes, and
# only when that panel's own panel.conf has one of them. With a key and no
# password, root has a locked password: ssh takes the key. The login on the
# panel screen opens after you set a password over ssh. A test build with
# TSX_DEV_ROOT_HASH has its own password: give it with --mainline-password-file
# FILE (or TSX_MAINLINE_PW) and the check is skipped.
#
# PAYLOAD DIR: build it ahead of time (see installer/emmc/mk-tsxroot-emmc.sh,
# installer/emmc/mk-v2-bundle.sh and installer/rescue-v2/mkrescue-v2.sh).
#   rescue.img (+.sha256)          the v2 rescue image (golden slot / one-shot target)
#   <flavor>/manifest,root.img,boot.img,SHA256SUMS   per kernel flavor (lts, stable)
#
# TFA9890 DSP FILES (docs/install.md "TFA9890 speaker DSP tuning"), step 3,
# --tfa-source (default auto): the rescue first looks for the files on the
# panel itself. This search is read-only and runs before the rescue writes
# anything (installer/lib/tsx-tfa.sh). It checks the current mainline root (a
# reinstall), then the stock Android boot image on the eMMC. Those files never
# leave the panel. If the panel has no valid set, rootfs/vendor-fetch.sh
# downloads the Crestron firmware package (.puf, 357 MB) on THIS machine. The
# script then pushes the files to the rescue.
#   panel = the panel only. puf = the download only. none = no DSP files.
# A missing DSP set never stops the install. The speakers work without the
# vendor EQ and volume presets.
#
# BLUETOOTH PSR FILE (docs/install.md "Bluetooth PSR file"), step 3b,
# --psr-source (default auto): the rescue looks for PSR-CSR8811.psr on the
# panel in the same read-only way (installer/lib/tsx-psr.sh): the current
# mainline root, else the stock Android system partition. If the panel has no
# valid file, rootfs/vendor-fetch.sh --psr takes it from the same .puf
# download on THIS machine, and the script pushes it to the rescue.
#   panel = the panel only. puf = the download only. none = no PSR file.
# A missing PSR file never stops the install. Without it, the Bluetooth
# proxy loads only its address. In modes auto and panel, the rescue first
# reads the government flag. A panel with government=1 (the TSW-760-NC) has
# no Bluetooth module: then there is no search, no .puf download, and SOURCE
# records "not-needed".
#
# Needs, from stock Android only (not for a reinstall): the Crestron admin
# user and password (--admin-user, --admin-password-file). The script stops
# before it logs in to the panel when one of them is missing.
# The prompts and the checks of panel.conf use the tsx-config of tsx-linux-common.
# --common DIR (or TSX_COMMON) is the top of a checkout. The default is the
# folder tsx-linux-common next to this repository.
# Host tools: sshpass ssh python3 curl sha256sum ip. unzip (or busybox with
# its unzip applet) is needed only for the .puf download, and debugfs
# (e2fsprogs) only for the PSR file from it.
# Without that download, a panel that has no DSP files gets no vendor speaker
# tuning.
# NETWORK (docs/install.md "Network requirements"): this host opens every
# connection (ssh to the Crestron sshd, the kiosk and the rescue), and every
# file goes over these connections. The panel never connects to this host, so
# a network that drops new connections from the panel (an IoT VLAN) still
# works. --ssh-ciphers LIST (or TSX_SSH_CIPHERS) sets the ssh cipher list for
# the rescue (default chacha20-poly1305 first). Rescue login: the root password
# or key of the panel, or a one-time password that the rescue shows on the
# panel screen (--rescue-password-file, or the prompt). The installed system
# has no fixed root password (docs/rootfs.md "Root login"), so the script logs
# in to a running mainline panel with your ssh key. If the panel has a root
# password, give it with --mainline-password-file.
# Test hook: TSX_PANEL_KIND=android|mainline|rescue|rescue-locked|unreachable skips the
# network probe that picks the path.
set -euo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
. "$HERE/lib/tsx-rescue.sh"
. "$HERE/lib/tsx-tfa.sh"   # tsx_tfa_plan (the rest of it runs in the rescue)
. "$HERE/lib/tsx-psr.sh"   # tsx_psr_plan (the rest of it runs in the rescue)
. "$HERE/lib/tsx-stage.sh" # stage on the panel first (host side)

usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d' >&2; echo >&2; tsx_creds_help >&2; }   # the whole header comment
. "$HERE/lib/tsx-creds.sh"   # --admin-user and the other logins: option, environment, prompt
PANEL= PAYLOAD=$HERE/out/payload KERNEL= UART_OPT=auto URL= SSHSHELL= CONFIG= YES=0 DRYRUN=0 RESULTS= WIPE_DATA=0 TFA_SOURCE=auto PSR_SOURCE=auto STAGE_OPT=auto FETCH=
while [ $# -gt 0 ]; do case "$1" in
	--payload) PAYLOAD=$2; shift 2;; --kernel) KERNEL=$2; shift 2;; --uart) UART_OPT=$2; shift 2;;
	--kiosk-url) URL=$2; shift 2;; --sshshell) SSHSHELL=$2; shift 2;; --results) RESULTS=$2; shift 2;;
	--config) CONFIG=$2; shift 2;; --wipe-data) WIPE_DATA=1; shift;; --tfa-source) TFA_SOURCE=$2; shift 2;;
	--psr-source) PSR_SOURCE=$2; shift 2;; --stage) STAGE_OPT=$2; shift 2;; --fetch) FETCH=$2; shift 2;;
	--release-url) export TSX_RELEASE_URL=$2; shift 2;; --stage-wait) export TSX_STAGE_WAIT_S=$2; shift 2;;
	--ssh-ciphers) export TSX_SSH_CIPHERS=$2; shift 2;; --common) export TSX_COMMON=$2; shift 2;;
	--yes) YES=1; shift;; --dry-run) DRYRUN=1; shift;; -h|--help) usage; exit 0;;
	--*) if tsx_creds_opt "$@"; then shift "$TSX_CREDS_SHIFT"; else echo "unknown option $1" >&2; usage; exit 2; fi;;
	*) [ -z "$PANEL" ] || { echo "extra argument $1" >&2; exit 2; }; PANEL=$1; shift;;
esac; done
[ -n "$PANEL" ] || { usage; exit 2; }
case "$KERNEL" in lts|stable) ;; *) echo "tsx-install-mainline: --kernel lts|stable is required" >&2; exit 2;; esac
case "$UART_OPT" in auto|yes|no) ;; *) echo "--uart must be auto, yes, or no" >&2; exit 2;; esac
case "$TFA_SOURCE" in auto|panel|puf|none) ;; *) echo "--tfa-source must be auto, panel, puf, or none" >&2; exit 2;; esac
case "$PSR_SOURCE" in auto|panel|puf|none) ;; *) echo "--psr-source must be auto, panel, puf, or none" >&2; exit 2;; esac
case "$STAGE_OPT" in auto|yes|no) ;; *) echo "--stage must be auto, yes, or no" >&2; exit 2;; esac
case "${TSX_STAGE_WAIT_S:-2400}" in ''|*[!0-9]*) echo "--stage-wait must be a number of seconds" >&2; exit 2;; esac
if [ -n "$FETCH" ]; then
	case "$FETCH" in *[!A-Za-z0-9._/:+-]*) echo "--fetch: a tag or a URL with plain characters only" >&2; exit 2;; esac
	[ "$STAGE_OPT" != no ] || { echo "--fetch needs the stage (not --stage no)" >&2; exit 2; }
	case "$FETCH" in *://*) FETCH_BASE=$FETCH;; *) FETCH_BASE=${TSX_RELEASE_URL:-https://github.com/tsx-mainline/tsx-xx60-linux/releases/download}/$FETCH;; esac
fi
[ -z "$CONFIG" ] || [ -f "$CONFIG" ] || { echo "tsx-install-mainline: --config file not found: $CONFIG" >&2; exit 2; }
. "$HERE/lib/tsx-config-prompt.sh"   # the prompts and the root login check
[ -n "$RESULTS" ] || RESULTS="$HERE/results/tsx-install-mainline-$(date +%Y%m%d-%H%M).txt"
mkdir -p "$(dirname "$RESULTS")"
log() { printf '[%s] %s\n' "$(date '+%F %T')" "$*" | tee -a "$RESULTS" >&2; }
logblock() { log "-- $1 --"; printf '%s\n' "$2" | while IFS= read -r l; do log "  $l"; done; log "-- end $1 --"; }
die() { log "ERROR: $*"; exit 1; }

RESCUE_IMG=$PAYLOAD/rescue.img
FLAVOR_DIR=$PAYLOAD/$KERNEL
if [ -z "$FETCH" ]; then
for f in "$RESCUE_IMG" "$FLAVOR_DIR/manifest" "$FLAVOR_DIR/root.img" "$FLAVOR_DIR/boot.img"; do
	[ -f "$f" ] || die "missing payload file: $f (see installer/emmc/mk-tsxroot-emmc.sh, mk-v2-bundle.sh, installer/rescue-v2/mkrescue-v2.sh)"
done
(cd "$FLAVOR_DIR" && sha256sum -c SHA256SUMS >/dev/null) || die "$FLAVOR_DIR/SHA256SUMS mismatch"
[ ! -f "$RESCUE_IMG.sha256" ] || { GOT=$(sha256sum < "$RESCUE_IMG" | cut -d' ' -f1); WANT=$(awk '{print $1}' "$RESCUE_IMG.sha256"); [ "$GOT" = "$WANT" ] || die "$RESCUE_IMG sha256 mismatch"; }
fi
# Root login (docs/rootfs.md "Root login"): the install stops unless it has a
# root password hash or an SSH public key. A test build with its own fixed
# password (TSX_DEV_ROOT_HASH) is the one exception: give its password in
# TSX_MAINLINE_PW (--mainline-password-file) and the check is skipped.
root_login_stop() { die "$(tsx_config_root_login_message | tr '\n' ' ')"; }
if [ -n "${TSX_MAINLINE_PW:-}" ]; then ROOT_LOGIN_CHECK=skip
elif [ -n "$CONFIG" ]; then
	tsx_config_has_root_login "$CONFIG" || root_login_stop
	ROOT_LOGIN_CHECK=done
else ROOT_LOGIN_CHECK=later
fi
log "== tsx-install-mainline v2: PANEL=$PANEL PAYLOAD=$([ -n "$FETCH" ] && echo "(none: --fetch $FETCH)" || echo "$PAYLOAD") KERNEL=$KERNEL uart=$UART_OPT tfa-source=$TFA_SOURCE psr-source=$PSR_SOURCE stage=$STAGE_OPT dry-run=$DRYRUN"

MPW=${TSX_MAINLINE_PW:-}
# The rescue has no fixed password (docs/recovery.md "Rescue login"). It takes the
# root password or key of the panel from /data. Our ssh key works for that. If you
# gave the panel's password (--mainline-password-file), the rescue takes it too.
# Else the rescue shows a one-time password on the panel screen: give it with
# --rescue-password-file (or type it when this script asks). A test rescue
# (TSX_DEV_RESCUE_HASH) uses that password as well. An empty $RPW means: use
# the ssh key.
RPW=${TSX_RESCUE_PW:-${TSX_MAINLINE_PW:-}}
# No fixed root password on the installed system: use the mainline password when
# it is set, else the ssh key (BatchMode: never ask for a password). sshpass -e
# reads the password from SSHPASS, so it is not on a command line.
MSSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=8"
# The cipher order for the streams into the rescue (lib/tsx-rescue.sh
# TSX_SSH_CIPHERS_DEFAULT, docs/install.md "Network requirements").
SSH_CIPHERS=${TSX_SSH_CIPHERS:-$TSX_SSH_CIPHERS_DEFAULT}
if [ -n "$MPW" ]; then export SSHPASS=$MPW; MSSH="sshpass -e ssh $MSSH_OPTS root@$PANEL"; else MSSH="ssh -o BatchMode=yes $MSSH_OPTS root@$PANEL"; fi
is_mainline_kiosk() { local out; is_crestron_sshd "$PANEL" && return 1; out=$($MSSH 'awk "\$2==\"/\"{print \$1}" /proc/mounts' 2>/dev/null) || return 1; [ "$out" = /dev/mmcblk1p8 ]; }
# After the install the panel may have no login that this host can use (a root
# password that only you know, no key). Then the OpenSSH banner on port 22
# tells the new system from the rescue (dropbear) and from Android.
ssh_banner() { timeout 5 bash -c 'exec 3<>/dev/tcp/$1/22 && head -n 1 <&3' _ "$1" 2>/dev/null | tr -d '\r'; }
kiosk_up() { is_mainline_kiosk && return 0; is_crestron_sshd "$PANEL" && return 1; case "$(ssh_banner "$PANEL")" in SSH-2.0-OpenSSH*) return 0;; *) return 1;; esac; }
run_stream_cmd() {  # CMD...: run CMD, stream its output to the terminal and the log, keep it in RS_OUT
	local tmp rc
	tmp=$(mktemp "$RESULTS.XXXXXX")
	if "$@" 2>&1 | tee "$tmp" | while IFS= read -r l; do log "  $l"; done; then rc=0; else rc=$?; fi
	RS_OUT=$(cat "$tmp"); rm -f "$tmp"
	return $rc
}
# SSHCMD REMOTECMD: like tsx-restore-factory's run_stream, parameterised on the ssh command (a word list)
run_stream_at() { local sshcmd=$1; shift; run_stream_cmd $sshcmd "$@"; }
WSIP_FOR() { ip route get "$1" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}'; }
STAGE1= STAGE2= STAGE3= RESCUE_WAIT_S=300
# The stage (--stage): STAGED=1 once it is complete on the panel. STAGE_REMOTE
# says where (kiosk or android). A stage that no arm step follows (an error,
# Ctrl-C) is removed again at exit, so a later rescue boot never runs it.
STAGED=0 STAGED_DONE=0 STAGE_REMOTE= STAGE_ARMED=0 STAGE_ANDROID_DIR= OLD_BOOT_ID= RIP= RSSH= MAC=
# temp files next to $RESULTS (panel.conf copies: may hold secrets, mode 600): removed on exit
TMPFILES=()
stage_remove() {
	case "$STAGE_REMOTE" in
	kiosk) $MSSH 'rm -rf /data/tsx-stage /data/tsx-stage.new' </dev/null >/dev/null 2>&1;;
	android) "$HERE/steps/rootsh" "$PANEL" "rm -rf $STAGE_ANDROID_DIR $STAGE_ANDROID_DIR.new" >/dev/null 2>&1;;
	esac
}
cleanup() {
	if [ -n "$STAGE_REMOTE" ] && [ "$STAGE_ARMED" = 0 ]; then
		log "  removing the stage from the panel (no rescue boot was armed)"; stage_remove || true
	fi
	rm -rf "$STAGE1" "$STAGE2" "$STAGE3" "${TSX_CONFIG_STAGE:-}"
	[ -z "$STAGE1" ] || rm -f "$STAGE1.tar"
	[ ${#TMPFILES[@]} = 0 ] || rm -f "${TMPFILES[@]}"
}
trap cleanup EXIT

# build_bundle: the install bundle for /tmp/b of the rescue (tsx-rescue-install).
# root.img (about 1 GiB, up to the 2.9 GiB of p8) does not fit in the RAM of
# the rescue, so the bundle does not include it. Step 4 streams it over ssh
# straight onto eMMC p8 (tsx-rescue-install run --root-from -), or the stage
# carries a gzip of it. The rescue verifies it by readback. The function makes
# the bundle once.
build_bundle() {
	[ -z "$STAGE2" ] || return 0
	STAGE2=$(mktemp -d "$RESULTS.bundle.XXXXXX")
	# --fetch: the panel adds manifest and boot.img of the release (steps/tsx-netinstall)
	tsx_bundle_make "$STAGE2" "$CONFIG" "$URL" "$([ -n "$FETCH" ] || echo "$FLAVOR_DIR")"
}
bundle_sums() { tsx_bundle_sums "$STAGE2"; }

# stage_skip REASON: a stage is not possible. --stage yes stops, auto goes on
# with the push path.
stage_skip() {
	[ "$STAGE_OPT" = yes ] && die "stage: $* (--stage yes)"
	log "  stage: $*. The images go over ssh during the rescue instead (--stage auto)"
}
# stage_puf_files: the .puf files for a stage (lib/tsx-stage.sh).
stage_puf_files() { tsx_stage_puf_files "$STAGE2" "$TFA_SOURCE" "$PSR_SOURCE"; }
# fetch_stage: --fetch. The kiosk downloads the signed release and makes the
# stage (steps/tsx-netinstall). Sets NET_RESCUE_SHA, BOOT_SHA_WANT and
# ROOT_SHA_WANT from the signed release.
fetch_stage() {
	local res
	log "== stage from the release (--fetch $FETCH): the panel downloads the signed release itself: $FETCH_BASE"
	build_bundle
	stage_puf_files
	STAGE3=$(mktemp -d "$RESULTS.stage.XXXXXX"); mkdir -p "$STAGE3/net"
	ln -s "$STAGE2" "$STAGE3/net/bundle"
	cp "$HERE/steps/tsx-netinstall" "$HERE/lib/tsx-verify-sig.py" "$STAGE3/net/"
	(cd "$STAGE3/net" && sha256sum tsx-netinstall tsx-verify-sig.py > SHA256SUMS)
	STAGE_REMOTE=kiosk
	# --keep dl: the partial downloads of an earlier try stay, and curl goes on there.
	TSX_PUSH_LABEL="the download scripts" run_stream_cmd tsx_push_dir "$STAGE3/net" /data/tsx-net --keep dl $MSSH </dev/null || die "copying the download scripts to /data/tsx-net of the panel failed (see above)"
	run_stream_cmd $MSSH "sh /data/tsx-net/tsx-netinstall --base '$FETCH_BASE' --flavor $KERNEL --keep $KEEP_DATA --golden 1 --tfa-source $TFA_SOURCE --psr-source $PSR_SOURCE" </dev/null \
		|| die "the panel could not download and stage the release (see above). The panel needs internet access to github.com. Nothing was armed"
	res=$(printf '%s\n' "$RS_OUT" | grep '^NETINSTALL-RESULT ok=1 ' | tail -n 1)
	[ -n "$res" ] || die "no NETINSTALL-RESULT line from the panel"
	NET_RESCUE_SHA=$(sed -n 's/.* rescue_sha256=\([0-9a-f]*\).*/\1/p' <<<"$res")
	BOOT_SHA_WANT=$(sed -n 's/.* boot_sha256=\([0-9a-f]*\).*/\1/p' <<<"$res")
	ROOT_SHA_WANT=$(sed -n 's/.* root_sha256=\([0-9a-f]*\).*/\1/p' <<<"$res")
	[ ${#NET_RESCUE_SHA} = 64 ] && [ ${#BOOT_SHA_WANT} = 64 ] && [ ${#ROOT_SHA_WANT} = 64 ] || die "bad NETINSTALL-RESULT line: $res"
	$MSSH 'rm -rf /data/tsx-net' </dev/null >/dev/null 2>&1 || true
	OLD_BOOT_ID=$($MSSH 'cat /proc/sys/kernel/random/boot_id' </dev/null 2>/dev/null) || OLD_BOOT_ID=
	STAGED=1
	log "  the stage of the release is complete on the panel (signature and sha256 checked there)"
}
# stage_panel: --stage. Copy the install (bundle and root.img.gz) onto the card
# of the panel before the arm step (lib/tsx-stage.sh).
stage_panel() {
	local golden=0
	[ "$STAGE_OPT" != no ] || { log "== stage: --stage no: the images go over ssh during the rescue"; return 0; }
	log "== stage (--stage $STAGE_OPT): copy the install onto the card of the panel before the rescue boot"
	tsx_stage_rescue_ok "$RESCUE_IMG" || { stage_skip "the rescue image of the payload cannot run a stage (an older payload)"; return 0; }
	build_bundle
	stage_puf_files
	tsx_stage_gzip "$FLAVOR_DIR/root.img" || { stage_skip "gzip of root.img failed"; return 0; }
	[ "$KIND" = mainline ] && golden=1
	STAGE3=$(mktemp -d "$RESULTS.stage.XXXXXX")
	tsx_stage_build "$STAGE3/s" "$STAGE2" "$STAGE_GZ" "$KERNEL" "$KEEP_DATA" "$golden" "$TFA_SOURCE" "$PSR_SOURCE"
	if [ "$KIND" = mainline ]; then
		STAGE_REMOTE=kiosk
		tsx_stage_push_kiosk "$STAGE3/s" $MSSH || { stage_remove; STAGE_REMOTE=; stage_skip "the copy to /data of the panel did not work"; return 0; }
		OLD_BOOT_ID=$($MSSH 'cat /proc/sys/kernel/random/boot_id' </dev/null 2>/dev/null) || OLD_BOOT_ID=
	else
		STAGE_REMOTE=android
		tsx_stage_push_android "$STAGE3/s" "$PANEL" || { stage_remove; STAGE_REMOTE=; stage_skip "the copy to card p5 of the panel did not work"; return 0; }
	fi
	STAGED=1
	log "  stage complete on the panel. After the rescue boot, the rescue installs it by itself and needs no network"
}

# Detect what PANEL_IP is now: android | mainline | rescue | unreachable | other.
# Do not log in where a failed login counts. is_crestron_sshd runs first.
panel_kind() {
	case "${TSX_PANEL_KIND:-}" in android|mainline|rescue|rescue-locked|unreachable|other) echo "$TSX_PANEL_KIND"; return 0;; esac
	case "$(ssh_server_id "$PANEL")" in
	"") echo unreachable;;
	*CrestronSSH*) echo android;;
	*)	if ssh_test_rescue "$PANEL" "$RPW"; then echo rescue
		elif is_mainline_kiosk; then echo mainline
		else case "$(ssh_server_id "$PANEL")" in *dropbear*) echo rescue-locked;; *) echo other;; esac; fi;;
	esac
}
KIND=$(panel_kind)
# The rescue answers, but it takes none of our logins: it shows a one-time
# password on the panel screen (docs/recovery.md "Rescue login"). Ask for it on
# a terminal, else stop: the other paths cannot reach this panel.
if [ "$KIND" = rescue-locked ]; then
	if [ "$YES" != 1 ] && [ "$DRYRUN" != 1 ] && [ -t 0 ]; then
		read -r -s -p "$PANEL runs the rescue. Type the one-time password from the panel screen: " RPW || RPW=
		echo >&2
		[ -n "$RPW" ] && ssh_test_rescue "$PANEL" "$RPW" && KIND=rescue
	fi
	[ "$KIND" = rescue ] || die "$PANEL runs the rescue, and it takes none of the logins of this host. Read the one-time password on the panel screen and run the same command again with --rescue-password-file FILE (the file holds that password), or power-cycle the panel once to go back to the system before the rescue boot"
fi
case "$KIND" in
android) log "== $PANEL: stock Android (Crestron sshd): Android -> mainline install";;
mainline) log "== $PANEL: already the mainline kiosk (root on eMMC p8): reinstall from the kiosk (no Android root needed)";;
rescue) log "== $PANEL: the mainline rescue answers: resume at step 3";;
*) log "== $PANEL: no recognized panel answers ssh right now ($KIND): assuming stock Android (step 1 checks it)";;
esac
# /data on a reinstall: the install keeps it unless --wipe-data is set. The
# rescue still formats it if the card is not folded yet or p4 is not a clean
# tsxdata. The Android path always formats it.
KEEP_DATA=0
case "$KIND" in mainline|rescue) [ "$WIPE_DATA" = 1 ] || KEEP_DATA=1;; esac
case "$FETCH:$KIND" in
:*|*:mainline|*:rescue) ;;
*) die "--fetch needs a panel that runs mainline (the kiosk downloads the release). For stock Android, use --payload DIR";;
esac
# The Android path logs in to the Crestron account: its user and password come
# from the options, the environment or a prompt, never from a default. Stop
# here, before any login, when one is missing.
case "$KIND" in
mainline|rescue) ;;
*)	if [ "$DRYRUN" = 1 ] || [ "$YES" = 1 ]; then tsx_creds_need_admin 0 || die "stock Android needs the Crestron admin login (see above). Nothing was changed"
	else tsx_creds_need_admin 1 || die "stock Android needs the Crestron admin login (see above). Nothing was changed"
	fi
	log "== Crestron admin login: user $TSX_ADMIN_USER, password given (from an option, the environment or the prompt)";;
esac
if [ "$KEEP_DATA" = 1 ]; then log "== /data (card p4 tsxdata): kept if it is a clean tsxdata file system (--wipe-data formats it)"
elif [ "$KIND" = mainline ] || [ "$KIND" = rescue ]; then log "== /data (card p4 tsxdata): --wipe-data: formatted again, only panel.conf is carried over"
fi

# --yes with no --config has no prompts. Only a reinstall of a mainline panel can
# still get a root login: from the panel.conf of that panel (checked below).
# A resume in the rescue counts too, if the rescue took the ssh key of this
# host with no password: the rescue reads the login from the panel's /data
# (docs/recovery.md "Rescue login"), and the install keeps /data. So the
# same command works again after a stop.
if [ "$ROOT_LOGIN_CHECK" = later ] && [ "$YES" = 1 ] && [ "$KIND" != mainline ]; then
	if [ "$KIND" = rescue ] && [ "$KEEP_DATA" = 1 ] && [ -z "$RPW" ]; then
		log "== root login: the rescue takes this host's ssh key from the panel's /data, and the install keeps /data: the panel keeps that login"
		ROOT_LOGIN_CHECK=done
	else root_login_stop
	fi
fi

if [ "$DRYRUN" = 1 ] && [ "$KIND" = mainline ]; then
	log "[dry-run] 1: skipped: the kiosk's own ssh (your key, or the mainline password) replaces Android root"
	log "[dry-run] 2: record eth0 MAC over ssh. Copy rescue.img to the kiosk's /tmp over ssh (sha256 checked). Run lib/tsx-arm-from-mainline.sh --rescue there (p1:tsxboot.img <- rescue, rm p1:tsxboot.off, tsx_once=1 verified). The panel reboots"
	log "[dry-run] 3: find the rescue (kiosk IP first, then a MAC sweep). Copy it into the golden slot p1:boot.img (verified). Push the $KERNEL bundle and get the TFA9890 files (as the Android path)"
fi
if [ "$DRYRUN" = 1 ]; then
	[ "$KIND" = mainline ] || log "[dry-run] 1: steps/tsx-ensure-root $PANEL --uart $UART_OPT (settle + root over steps/rootsh)"
	[ "$KIND" = mainline ] || log "[dry-run] 2: record eth0 MAC over rootsh. Copy one tar (steps/tsx-rescue-arm.sh + android/tsx-lib.sh + lib/tsx-rescue.sh + rescue.img) to /data/tsx-inst over the root shell (steps/rootsh --put: raw tty, sha256 checked), unpack it. Run 'preflight' then 'install --yes' over rootsh (reboots the panel)"
	[ "$KIND" = mainline ] || log "[dry-run] 3: wait_for_rescue (kiosk IP first, then a MAC sweep, installer/lib/tsx-rescue.sh). Push a bundle ($KERNEL manifest+boot.img, tsx-rescue.sh, tsx-tfa.sh, tsx-psr.sh, tsx-usb-recovery, tsx-rescue-install, kiosk-url.txt, panel.conf if --config or prompts were used) to /tmp/b as one tar stream over ssh (tsx_push_dir: sha256sum -c in the rescue)"
	log "[dry-run] network: push only. This host opens every connection (ssh), the panel opens none to this host. ssh ciphers for the image streams: $SSH_CIPHERS"
	[ -z "$FETCH" ] || log "[dry-run] stage from the release (--fetch $FETCH): copy steps/tsx-netinstall, lib/tsx-verify-sig.py and the bundle (no images) to /data/tsx-net of the kiosk. The kiosk downloads SHA256SUMS and SHA256SUMS.sig of $FETCH_BASE, checks the signature with /etc/apk/keys/tsx-mainline-*.rsa.pub, downloads tsx-xx60-rescue.img and tsx-xx60-$KERNEL-{manifest,boot.img,root.img.gz} (sha256 of the signed list), and makes /data/tsx-stage. The arm step uses the rescue.img of the release"
	case "$STAGE_OPT" in
	no) log "[dry-run] stage: --stage no: the bundle and root.img go over ssh during the rescue (below)";;
	*) log "[dry-run] stage (--stage $STAGE_OPT): before the arm, gzip root.img here and copy the bundle and root.img.gz to $([ "$KIND" = mainline ] && echo "/data/tsx-stage on the kiosk (tsx_push_dir)" || echo "card p5 (sdcard)/tsx-stage over the root shell (rootsh --put)"). Then the rescue runs steps/tsx-rescue-staged by itself (no network needed) and this host only watches. If the stage is not possible$([ "$STAGE_OPT" = yes ] && echo ": stop" || echo ", or the staged run fails while this host reaches the rescue: the push path below")";;
	esac
	case "$TFA_SOURCE" in
	auto) log "[dry-run] 3: TFA9890 DSP files (--tfa-source auto): tsx-rescue-install tfa /tmp/b (read-only: the current root on eMMC p8, then stock Android's boot image on eMMC p7. The files stay on the panel). Only if that finds no valid set: rootfs/vendor-fetch.sh here (the .puf download) and push its files over ssh. Never fatal";;
	panel) log "[dry-run] 3: TFA9890 DSP files (--tfa-source panel): tsx-rescue-install tfa /tmp/b only (current root, then stock Android's boot image). No .puf download";;
	puf) log "[dry-run] 3: TFA9890 DSP files (--tfa-source puf): rootfs/vendor-fetch.sh here (the .puf download), push its files to the rescue over ssh. The panel is not searched";;
	none) log "[dry-run] 3: TFA9890 DSP files (--tfa-source none): none. The speakers run without the vendor tuning";;
	esac
	case "$PSR_SOURCE" in
	auto) log "[dry-run] 3b: Bluetooth PSR file (--psr-source auto): tsx-rescue-install psr /tmp/b (government=1: no search, no download, SOURCE says not-needed. Else read-only: the current root on eMMC p8, or stock Android's system partition there. The file stays on the panel). Only if that finds no valid file: rootfs/vendor-fetch.sh --psr here (the .puf download) and push its file. Never fatal";;
	panel) log "[dry-run] 3b: Bluetooth PSR file (--psr-source panel): tsx-rescue-install psr /tmp/b only (government=1: not needed. Else the current root, or stock Android's system partition). No .puf download";;
	puf) log "[dry-run] 3b: Bluetooth PSR file (--psr-source puf): rootfs/vendor-fetch.sh --psr here (the .puf download), push its file to the rescue. The panel is not searched";;
	none) log "[dry-run] 3b: Bluetooth PSR file (--psr-source none): none. Bluetooth loads only its address";;
	esac
	log "[dry-run] 3c: stock LED bar firmware image: tsx-rescue-install ledstock /tmp/b (read-only: statussign_*.upg from stock Android's system partition on eMMC p8. The install copies it to /data/tsx/vendor/ on tsxdata. It stays on the panel. A reinstall that keeps /data keeps it. A missing file is not an error)"
	if [ -n "$CONFIG" ]; then log "[dry-run] panel configuration: --config $CONFIG (prompts would be skipped)"
	elif [ "$YES" = 1 ] && [ "$KIND" = mainline ] && [ "$KEEP_DATA" = 1 ]; then log "[dry-run] panel configuration: --yes with no --config on a reinstall: the panel's own /data/tsx/panel.conf would be kept in place on the kept tsxdata (only KERNEL_FLAVOR updated)"
	elif [ "$YES" = 1 ] && [ "$KIND" = mainline ]; then log "[dry-run] panel configuration: --yes with no --config on a reinstall: the panel's own /data/tsx/panel.conf would be kept (copied onto the new tsxdata, if it has one)"
	elif [ "$YES" = 1 ]; then log "[dry-run] panel configuration: --yes with no --config: prompts skipped, no panel.conf would be written"
	else log "[dry-run] panel configuration: would prompt interactively here (installer/panel.conf.example). Skipped under --dry-run"
	fi
	if [ "$KEEP_DATA" = 1 ]; then log "[dry-run] 4: tsx-rescue-install check /tmp/b --keep-data --root-from -. Then run /tmp/b --yes --keep-data --root-from - < $KERNEL/root.img over ssh (streamed output). It writes and verifies the eMMC boot and root (WRITE-RESULT lines, the host compares the sha256 with the manifest). It keeps card p4 tsxdata if that is a clean ext4 LABEL=tsxdata (e2fsck -fn), and formats it if not. It writes the final env and tsxboot.off, then reboots"
	else log "[dry-run] 4: tsx-rescue-install check /tmp/b --root-from -. Then run /tmp/b --yes --root-from - < $KERNEL/root.img over ssh (streamed: eMMC boot+root write/verify, the host compares the sha256 with the manifest, card fold + tsxdata mkfs, final env, tsxboot.off). The panel reboots"
	fi
	log "[dry-run] 5: wait for the rescue ssh to go away, then mainline ssh root@$PANEL. Verify root=/dev/mmcblk1p8 and the kiosk is running"
	log "== dry-run done"; exit 0
fi

# ------------------------------------------------ root password on a reinstall --
# A password set with passwd lives only in /etc/shadow of the old root image.
# The new image has a locked root. Before the install, the panel copies its
# current hash into its panel.conf (tsx-config sync-root). The hash is never
# printed or logged here.
if [ "$KIND" = mainline ] && [ "$DRYRUN" != 1 ] && $MSSH true >/dev/null 2>&1; then
	$MSSH 'tsx-config sync-root' >/dev/null 2>&1 || log "  note: the panel could not save its root password (old image?): the new image may have a locked root"
fi
# ---------------------------------------------------- panel configuration --
# docs/rootfs.md "Panel configuration". --config FILE is used as it is.
# --yes with no --config keeps the old behavior that uses only --kiosk-url
# (no panel.conf at all, for scripted and CI runs). Otherwise the script
# prompts. If the panel already answers as a mainline kiosk (a reinstall),
# the prompts offer its OWN panel.conf as the defaults.
if [ -n "$CONFIG" ]; then
	log "== panel configuration: using --config $CONFIG (prompts skipped)"
elif [ "$YES" != 1 ]; then
	REINSTALL_DEFAULTS=
	if $MSSH true >/dev/null 2>&1 && is_mainline_kiosk; then
		REINSTALL_DEFAULTS=$(mktemp "$RESULTS.reinstall-conf.XXXXXX"); TMPFILES+=("$REINSTALL_DEFAULTS")
		if $MSSH 'cat /data/tsx/panel.conf 2>/dev/null' > "$REINSTALL_DEFAULTS" 2>/dev/null && [ -s "$REINSTALL_DEFAULTS" ]; then
			log "== $PANEL already answers as the mainline kiosk: using its /data/tsx/panel.conf as prompt defaults (reinstall)"
		else
			rm -f "$REINSTALL_DEFAULTS"; REINSTALL_DEFAULTS=
		fi
	fi
	CONFIG=$(mktemp "$RESULTS.panel-conf.XXXXXX"); TMPFILES+=("$CONFIG")
	. "$HERE/lib/tsx-config-prompt.sh"
	tsx_config_prompt "$CONFIG" "$REINSTALL_DEFAULTS" || root_login_stop
	[ -z "$REINSTALL_DEFAULTS" ] || rm -f "$REINSTALL_DEFAULTS"
elif [ "$KIND" = mainline ] && [ "$KEEP_DATA" = 1 ]; then
	log "== panel configuration: --yes with no --config on a reinstall: the panel's own /data/tsx/panel.conf stays in place on the kept tsxdata"
	if [ "$ROOT_LOGIN_CHECK" = later ]; then
		# read it only to check the root login. The file stays on the panel.
		CHK=$(mktemp "$RESULTS.panel-conf.XXXXXX"); TMPFILES+=("$CHK")
		$MSSH 'cat /data/tsx/panel.conf 2>/dev/null' > "$CHK" 2>/dev/null || true
		tsx_config_has_root_login "$CHK" || root_login_stop
		rm -f "$CHK"
	fi
elif [ "$KIND" = mainline ]; then
	# --wipe-data formats tsxdata again: carry the panel's own panel.conf over
	CONFIG=$(mktemp "$RESULTS.panel-conf.XXXXXX"); TMPFILES+=("$CONFIG")
	if $MSSH 'cat /data/tsx/panel.conf 2>/dev/null' > "$CONFIG" 2>/dev/null && [ -s "$CONFIG" ]; then
		log "== panel configuration: --yes with no --config on a reinstall: keeping the panel's own /data/tsx/panel.conf"
	else
		rm -f "$CONFIG"; CONFIG=
		log "== panel configuration: --yes with no --config, and the panel has no /data/tsx/panel.conf: no panel.conf will be written"
	fi
	if [ "$ROOT_LOGIN_CHECK" = later ]; then tsx_config_has_root_login "$CONFIG" || root_login_stop; fi
else
	log "== panel configuration: --yes with no --config: skipping prompts, keeping only --kiosk-url (no panel.conf will be written)"
fi
# A reinstall with a --config file that has no root password keeps the password
# of the panel (the file may still give a new key).
if [ -n "$CONFIG" ] && [ "$KIND" = mainline ] && [ "$DRYRUN" != 1 ] \
	&& [ -z "$(TSX_CONF="$CONFIG" "$TSX_CONFIG_BIN" get ROOT_PASSWORD_HASH 2>/dev/null || true)" ]; then
	keep=$($MSSH 'tsx-config get ROOT_PASSWORD_HASH' 2>/dev/null || true)
	if [ -n "$keep" ] && TSX_CONF="$CONFIG" "$TSX_CONFIG_BIN" set ROOT_PASSWORD_HASH "$keep" >/dev/null 2>&1; then
		log "== the panel keeps its current root password (the config file has none)"
	fi
	keep=
fi
[ -n "$CONFIG" ] && { TSX_CONF="$CONFIG" "$TSX_CONFIG_BIN" set KERNEL_FLAVOR "$KERNEL" || die "could not record KERNEL_FLAVOR in $CONFIG"; }

# Resume: a panel that already answers as the rescue goes straight to step 3.
# An earlier run armed it and then failed in step 3 or 4. To retry, run the
# same command again (this is the documented way).
RESUME=0
if [ "$KIND" = rescue ] || { [ "$KIND" != mainline ] && [ "$KIND" != android ] && ssh_test_rescue "$PANEL" "$RPW"; }; then
	RESUME=1
	log "== $PANEL already answers as the mainline rescue: resuming at step 3 (steps 1-2 were done by an earlier run)"
	[ "$WIPE_DATA" = 1 ] || KEEP_DATA=1
fi
if [ "$RESUME" = 0 ] && [ "$KIND" = mainline ]; then
# ------------------------------------- steps 1-2 on a running mainline kiosk --
log "== step 1: $PANEL runs the mainline kiosk: no Android root needed (kiosk ssh)"
log "== step 2: arm the rescue boot from the kiosk"
MAC=$($MSSH 'cat /sys/class/net/eth0/address' 2>/dev/null) || die "could not read the panel's eth0 MAC before the reboot (needed for rescue discovery)"
log "  panel MAC (for rescue discovery): $MAC"
if [ -n "$FETCH" ]; then
	fetch_stage
	RSHA=$NET_RESCUE_SHA
	$MSSH 'cp /data/tsx-stage/rescue.img /tmp/tsx-rescue.img' </dev/null || die "copying the rescue.img of the release to /tmp failed"
else
	RSHA=$(sha256sum < "$RESCUE_IMG" | cut -d' ' -f1)
	log "  copying rescue.img ($(( $(stat -c %s "$RESCUE_IMG") / 1048576 )) MiB) to the kiosk's /tmp over ssh"
	$MSSH 'cat > /tmp/tsx-rescue.img' < "$RESCUE_IMG" || die "copying rescue.img to the kiosk failed"
fi
GOT=$($MSSH 'sha256sum < /tmp/tsx-rescue.img' 2>/dev/null | cut -d' ' -f1)
[ "$GOT" = "$RSHA" ] || die "rescue.img on the kiosk has sha256 ${GOT:-none}, want $RSHA"
log "  rescue.img on the kiosk verified (${RSHA:0:16}...)"
[ -n "$FETCH" ] || stage_panel
if [ "$YES" != 1 ]; then
	if [ "$KEEP_DATA" = 1 ]; then what="keeps the card's tsxdata (/data) if it is clean"; else what="formats the card's tsxdata (/data)"; fi
	[ "$STAGED" = 1 ] && what="$what. The rescue installs the stage by itself"
	read -r -p "Type INSTALL to arm the rescue boot on $PANEL (this reboots it; the install then $what): " ans </dev/tty
	[ "$ans" = INSTALL ] || die "aborted: operator did not type INSTALL"
fi
INSTOUT=$(timeout 120 $MSSH 'cat > /run/tsx-arm-from-mainline.sh && sh /run/tsx-arm-from-mainline.sh --rescue /tmp/tsx-rescue.img' < "$HERE/lib/tsx-arm-from-mainline.sh" 2>&1) || true
logblock "arm (lib/tsx-arm-from-mainline.sh)" "$INSTOUT"
grep -q "^REBOOTING" <<<"$INSTOUT" || die "arming the rescue from the kiosk failed (see above). Nothing was written unless the output says so"
STAGE_ARMED=1
log "  ok: rescue armed, panel is rebooting"
elif [ "$RESUME" = 0 ]; then
# ------------------------------------------------------------ step 1: root --
log "== step 1: get root over Crestron's sshd"
ENSURE_ARGS=("$PANEL" --uart "$UART_OPT" --results "$RESULTS")
[ -n "$SSHSHELL" ] && ENSURE_ARGS+=(--sshshell "$SSHSHELL")
"$HERE/steps/tsx-ensure-root" "${ENSURE_ARGS[@]}" || die "steps/tsx-ensure-root failed (see above)"

# ------------------------------------------------------------ step 2: arm ---
log "== step 2: arm the rescue boot"
MAC=$("$HERE/steps/rootsh" "$PANEL" 'cat /sys/class/net/eth0/address' 2>/dev/null) || die "could not read the panel's eth0 MAC before the reboot (needed for rescue discovery)"
log "  panel MAC (for rescue discovery): $MAC"
# The arm payload goes over the root shell that this host opened (steps/rootsh
# --put): the panel opens no connection to this host.
STAGE1=$(mktemp -d "$RESULTS.arm.XXXXXX")
mkdir -p "$STAGE1/steps" "$STAGE1/android" "$STAGE1/lib"
cp "$HERE/steps/tsx-rescue-arm.sh" "$STAGE1/steps/"; cp "$HERE/android/tsx-lib.sh" "$STAGE1/android/"; cp "$HERE/lib/tsx-rescue.sh" "$STAGE1/lib/"
cp "$RESCUE_IMG" "$STAGE1/rescue.img"
tsx_tar_c -C "$STAGE1" -cf "$STAGE1.tar" steps android lib rescue.img || die "could not pack the arm payload"
RSHA=$(sha256sum < "$RESCUE_IMG" | cut -d' ' -f1)
log "  copying the arm payload ($(( $(stat -c %s "$STAGE1.tar") / 1048576 )) MiB: tsx-rescue-arm.sh, tsx-lib.sh, tsx-rescue.sh, rescue.img) to /data/tsx-inst over the root shell"
run_stream_cmd "$HERE/steps/rootsh" --put "$PANEL" "$STAGE1.tar" /data/tsx-inst.tar \
	|| die "copying the arm payload to $PANEL failed (see above). Nothing was written to the boot slots or the env"
GOT=$("$HERE/steps/rootsh" "$PANEL" "mkdir -p /data/tsx-inst && busybox tar -xf /data/tsx-inst.tar -C /data/tsx-inst && rm -f /data/tsx-inst.tar && busybox sha256sum /data/tsx-inst/rescue.img" 2>>"$RESULTS" | grep -oE '^[0-9a-f]{64}' | tail -n 1) || GOT=
[ "$GOT" = "$RSHA" ] || die "rescue.img in /data/tsx-inst has sha256 ${GOT:-none}, want $RSHA. Nothing was written to the boot slots or the env"
log "  arm payload unpacked in /data/tsx-inst (rescue.img ${RSHA:0:16}...)"
stage_panel
# Without a stage, the images go over ssh into the rescue. From stock Android
# the rescue has no login of this host: it shows a one-time password on the
# panel screen (docs/recovery.md "Rescue login"), and step 3 asks for it on a
# terminal. With no terminal and no --rescue-password-file, stop before the arm
# step: the rescue would wait for a password that nobody can give.
if [ "$STAGED" != 1 ] && [ -z "$RPW" ] && ! [ -t 0 ]; then
	die "no stage on the panel, and this run has no terminal for the one-time password of the rescue. Run the installer on a terminal, or make the stage work (see above). Nothing was armed: the panel stays on stock Android"
fi
log "  running preflight"
PREOUT=$("$HERE/steps/rootsh" "$PANEL" 'bash /data/tsx-inst/steps/tsx-rescue-arm.sh preflight --rescue /data/tsx-inst/rescue.img 2>&1') || true
logblock "preflight" "$PREOUT"
grep -q "preflight OK" <<<"$PREOUT" || die "preflight did not report 'preflight OK'"
if [ "$YES" != 1 ]; then
	printf '%s\n' "$PREOUT"
	read -r -p "Type INSTALL to arm the rescue boot on $PANEL (this reboots it$([ "$STAGED" = 1 ] && echo ". The rescue installs the stage by itself")): " ans </dev/tty
	[ "$ans" = INSTALL ] || die "aborted: operator did not type INSTALL"
fi
INSTOUT=$(timeout 120 "$HERE/steps/rootsh" "$PANEL" 'bash /data/tsx-inst/steps/tsx-rescue-arm.sh install --rescue /data/tsx-inst/rescue.img --yes 2>&1') || true
logblock "install" "$INSTOUT"
grep -q "DONE\." <<<"$INSTOUT" || die "arm install did not report DONE."
STAGE_ARMED=1
log "  ok: rescue armed, panel is rebooting"
# Did it really go down? On 2026-09-29 one stock-Android unit printed
# "rebooting in 3 s" and stayed up. The arm step now leaves a trace on /data.
if android_went_down "$PANEL" 90; then log "  ok: stock Android went down"
else
	TRACEF=$(sed -n 's/.*reboot trace: //p' <<<"$INSTOUT" | tail -n 1)
	TR=$("$HERE/steps/rootsh" "$PANEL" "echo uptime \$(cut -d' ' -f1 /proc/uptime) s; cat ${TRACEF:-/dev/null}; ps 2>/dev/null | grep -e 'tsx-reboot' -e 'sleep' | grep -v grep" 2>&1) || true
	logblock "stock Android is still up 90 s after the arm step (reboot trace ${TRACEF:-unknown})" "$TR"
	log "  WARNING: the panel did not reboot by itself. It is armed for exactly one rescue boot: power-cycle it once now. This command keeps looking for the rescue for $((RESCUE_WAIT_S + 600)) s"
	RESCUE_WAIT_S=$((RESCUE_WAIT_S + 600))
fi
fi

# ------------------------------------------------------- step 3: discover --
log "== step 3: find the rescue on the network"
# A rescue that cannot read a login from /data shows a one-time password on the
# panel screen. Ask for it when a person is here.
if [ "$RESUME" != 1 ] && [ -z "$RPW" ] && [ "$KIND" != mainline ] && [ -t 0 ]; then
	read -r -s -p "The rescue shows a password on the panel screen when it starts. Type it here, or press Enter to use your SSH key: " RPW || RPW=
	echo >&2
fi
WSIP=$(WSIP_FOR "$PANEL"); [ -n "$WSIP" ] || die "no workstation IP towards $PANEL"
RESCUE_SSH_PW=$RPW
set_rip() { RIP=$1; RSSH="tsx_rescue_ssh_cur -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=8 -o ServerAliveInterval=10 -o ServerAliveCountMax=6 -o Ciphers=$SSH_CIPHERS root@$RIP"; }
if [ -z "$FETCH" ]; then
	ROOT_SHA_WANT=$(sed -n 's/^root_sha256=//p' "$FLAVOR_DIR/manifest" | tail -n 1)
	BOOT_SHA_WANT=$(sed -n 's/^boot_sha256=//p' "$FLAVOR_DIR/manifest" | tail -n 1)
fi

# ------------------------------------------- step 3: a staged install --------
# The rescue runs the stage by itself (steps/tsx-rescue-staged). This host only
# follows its log while it can reach the rescue, and it waits for the kiosk. A
# lost connection does not matter: the loop tries again until the kiosk comes
# up. A resume (the panel is the rescue now) asks the rescue too: an earlier
# run may have staged it.
# new_kiosk: the mainline kiosk answers, and it is not the kiosk from before
# the arm step (another boot_id).
new_kiosk() {
	local id
	kiosk_up || return 1
	[ -n "$OLD_BOOT_ID" ] || return 0
	id=$($MSSH 'cat /proc/sys/kernel/random/boot_id' </dev/null 2>/dev/null) || return 0
	[ "$id" != "$OLD_BOOT_ID" ]
}
staged_wait() {
	local t0 el hb=0 line=1 rc res cand limit=${TSX_STAGE_WAIT_S:-2400}
	STAGED_OUT=
	log "== step 3: the rescue installs the stage by itself (steps/tsx-rescue-staged). This host only watches: up to $limit s"
	t0=$(date +%s)
	while :; do
		el=$(( $(date +%s) - t0 ))
		[ $el -lt "$limit" ] || die "no result from the staged install within $limit s. Look at the panel screen. If the rescue is up, run this command again: it reads the log of the rescue and goes on"
		if [ "$STAGED_DONE" = 1 ] || [ $el -gt 60 ]; then
			if new_kiosk; then
				log "  the mainline kiosk answers at $PANEL"
				STAGED_DONE=1; return 0
			fi
		fi
		if [ "$STAGED_DONE" = 1 ]; then
			# Done in the rescue: only wait for the kiosk now.
			sleep 10
		else
			cand=
			if [ -n "$RIP" ] && ssh_test_rescue "$RIP" "$RPW"; then cand=$RIP
			elif [ -n "$MAC" ]; then cand=$(wait_for_rescue "$PANEL" "$MAC" "$WSIP" "$RPW" 1 2>/dev/null) || cand=
			elif ssh_test_rescue "$PANEL" "$RPW"; then cand=$PANEL
			fi
			if [ -n "$cand" ]; then
				[ "$cand" = "$RIP" ] || { set_rip "$cand"; log "  rescue reachable at $RIP: following the staged install (log line $line on)"; }
				rc=0; run_stream_cmd tsx_staged_follow "$line" $NOSTART $RSSH || rc=$?
				STAGED_OUT=$(printf '%s\n%s' "$STAGED_OUT" "$RS_OUT")
				res=$(printf '%s\n' "$RS_OUT" | grep '^STAGED-RESULT ' | tail -n 1)
				case "$res" in *" lines="[0-9]*) line=$(( $(printf '%s\n' "$res" | sed -n 's/.* lines=\([0-9]*\).*/\1/p') + 1 ));; esac
				case "$rc" in
				0)	[ "$STAGED_DONE" = 1 ] || log "  the staged install is done in the rescue. The panel reboots into the kiosk"
					STAGED_DONE=1;;
				1)	log "  the staged install FAILED in the rescue (see above). The rescue is up: this host pushes the images over ssh instead"
					STAGED=0; return 0;;
				3)	log "  the rescue has no stage to run (see above): this host pushes the images over ssh instead"
					STAGED=0; return 0;;
				2)	;;
				*)	log "  lost the connection to the rescue (ssh exit $rc). The install goes on in the panel by itself";;
				esac
			else
				sleep 10
			fi
		fi
		el=$(( $(date +%s) - t0 ))
		[ $el -ge $((hb + 30)) ] && { hb=$el; log "  waiting for the staged install (rescue or kiosk at $PANEL): ${el}/${limit} s"; }
	done
}
NOSTART=
if [ "$RESUME" = 1 ]; then
	set_rip "$PANEL"
	# Only a runner that this boot started already. A resume never starts one.
	case "$($RSSH 'cat /run/tsx-staged.state 2>/dev/null || echo none' </dev/null 2>/dev/null)" in
	searching|running|done*|failed*) log "  the rescue has a staged install from an earlier run: following it"; STAGED=1; NOSTART=--no-start;;
	esac
fi
[ "$STAGED" = 1 ] && staged_wait

if [ "$STAGED_DONE" != 1 ]; then
# ------------------------------------------------- the push path (option A) --
# The bundle and the images go over the ssh connections of this host.
[ -z "$FETCH" ] || die "the staged install of the release did not finish, and --fetch has no payload on this host to push. The rescue stays up: look at its log (ssh root@$PANEL cat /run/tsx-staged.log). Run the install again with --payload DIR, or power-cycle the panel"
if [ -z "$RIP" ]; then
	cand=$(wait_for_rescue "$PANEL" "$MAC" "$WSIP" "$RPW" "$RESCUE_WAIT_S") || die "could not find the rescue's IP within ${RESCUE_WAIT_S}s (MAC $MAC, ssh at $PANEL, sweep of ${PANEL%.*}.0/24 only when on-link). If the panel screen shows a one-time password, run this command again with --rescue-password-file FILE (the file holds that password)"
	set_rip "$cand"
fi
log "  rescue reachable at $RIP"
build_bundle
log "  pushing the install bundle to the rescue ($RIP) over ssh: $(cd "$STAGE2" && find . -type f ! -name SHA256SUMS | sed 's#^\./##' | sort | tr '\n' ' ')($(du -sm "$STAGE2" | cut -f1) MiB)"
run_stream_cmd tsx_push_dir "$STAGE2" /tmp/b --keep "tfa psr ledstock" $RSSH </dev/null || die "pushing the bundle failed (see above)"
if [ "$KIND" = mainline ]; then
	# Reinstall: the rescue that just booted (p1:tsxboot.img) also becomes the
	# rescue in the golden slot (lib/tsx-rescue.sh tsx_golden_update). Later
	# recovery (tsx-restore-factory, docs/recovery.md) then uses this version.
	# A failure is only a warning, because the install does not need the copy.
	log "  golden slot: p1:boot.img <- the rescue that just booted"
	run_stream_at "$RSSH" ". /usr/share/tsx/tsx-lib.sh; . /tmp/b/tsx-rescue.sh; tsx_golden_update" </dev/null \
		|| log "  WARNING: could not update the golden slot (p1:boot.img). The install continues (restore-factory would use the older rescue there)"
fi

# ------------------------------------------ step 3: TFA9890 DSP files -------
# --tfa-source (see the header): look on the panel first. The rescue reads the
# current root, then the stock Android boot image, and the files stay on the
# panel. The .puf download on this host is the fallback. A failure is never fatal.
tfa_puf() {  # rootfs/vendor-fetch.sh here, then push the files into /tmp/b/tfa
	local files
	tfa_puf_fetch "$STAGE2/tfa" || return 1
	files=$(cd "$STAGE2/tfa" && find . -type f ! -name SHA256SUMS | sed 's#^\./##' | sort | tr '\n' ' ')
	log "  pushing the .puf's DSP files to the rescue over ssh: $files"
	TSX_PUSH_LABEL="the speaker DSP files" run_stream_cmd tsx_push_dir "$STAGE2/tfa" /tmp/b/tfa $RSSH </dev/null \
		|| { log "  WARNING: pushing the .puf's DSP files to the rescue failed"; return 1; }
	TFA_USED="puf (rootfs/vendor-fetch.sh), $TFA_PUF_N of 3 variants"
}
TFA_USED=none PANEL_N=- PANEL_SRC=
if [ "$TFA_SOURCE" = auto ] || [ "$TFA_SOURCE" = panel ]; then
	log "== step 3: TFA9890 DSP files (--tfa-source $TFA_SOURCE): looking on the panel first (read-only, the files stay on the panel)"
	if run_stream_at "$RSSH" "sh /tmp/b/tsx-rescue-install tfa /tmp/b 2>&1"; then
		PANEL_RES=$(printf '%s\n' "$RS_OUT" | sed -n 's/^TFA-RESULT //p' | tail -n 1)
		PANEL_N=$(printf '%s\n' "$PANEL_RES" | sed -n 's/.*count=\([0-9]*\).*/\1/p')
		PANEL_SRC=$(printf '%s\n' "$PANEL_RES" | sed -n 's/.*source=\([^ ]*\).*/\1/p')
		[ -n "$PANEL_N" ] || PANEL_N=-
	else
		log "  WARNING: tsx-rescue-install tfa failed (see above)"
	fi
else
	log "== step 3: TFA9890 DSP files (--tfa-source $TFA_SOURCE): the panel is not searched"
fi
TFA_ACTION=$(tsx_tfa_plan "$TFA_SOURCE" "$PANEL_N") || true
use_panel_set() {
	run_stream_at "$RSSH" "rm -rf /tmp/b/tfa && mv /tmp/b/tfa-panel /tmp/b/tfa && echo 'tfa: the panel set is in /tmp/b/tfa'" \
		&& TFA_USED="panel: $PANEL_SRC ($PANEL_N of 3 variants; no .puf download)" \
		|| log "  WARNING: could not move the panel's DSP files into place"
}
case "$TFA_ACTION" in
use-panel) use_panel_set;;
puf) tfa_puf || true;;
puf-or-panel)
	log "  the panel has only $PANEL_N of 3 variants: trying the .puf download for a full set"
	tfa_puf || { log "  using the panel's partial set instead"; use_panel_set; };;
none) run_stream_at "$RSSH" "rm -rf /tmp/b/tfa /tmp/b/tfa-panel" || true;;
esac
# ------------------------------------------ step 3b: Bluetooth PSR file -----
# --psr-source (see the header): read-only on the panel first, like the DSP
# files. That file stays on the panel. The .puf download on this host is the
# fallback. A failure is never fatal: without the file, the Bluetooth proxy
# loads only its address (docs/hardware.md "Bluetooth (CSR8811)").
psr_puf() {  # rootfs/vendor-fetch.sh --psr here, then push the file into /tmp/b/psr
	psr_puf_fetch "$STAGE2/psr" || return 1
	log "  pushing the .puf's PSR file to the rescue over ssh"
	TSX_PUSH_LABEL="the Bluetooth PSR file" run_stream_cmd tsx_push_dir "$STAGE2/psr" /tmp/b/psr $RSSH </dev/null \
		|| { log "  WARNING: pushing the .puf's PSR file to the rescue failed"; return 1; }
	PSR_USED="puf (rootfs/vendor-fetch.sh --psr), sha256 $PSR_PUF_SHA"
}
PSR_USED=none PSR_OK=- PSR_SRC= PSR_GOV=
if [ "$PSR_SOURCE" = auto ] || [ "$PSR_SOURCE" = panel ]; then
	log "== step 3b: Bluetooth PSR file (--psr-source $PSR_SOURCE): looking on the panel first (read-only, the file stays on the panel)"
	if run_stream_at "$RSSH" "sh /tmp/b/tsx-rescue-install psr /tmp/b 2>&1"; then
		PSR_RES=$(printf '%s\n' "$RS_OUT" | sed -n 's/^PSR-RESULT //p' | tail -n 1)
		PSR_OK=$(printf '%s\n' "$PSR_RES" | sed -n 's/.*ok=\([01]\).*/\1/p')
		PSR_SRC=$(printf '%s\n' "$PSR_RES" | sed -n 's/.*source=\([^ ]*\).*/\1/p')
		PSR_GOV=$(printf '%s\n' "$PSR_RES" | sed -n 's/.*government=\([01]\).*/\1/p')
		[ -n "$PSR_OK" ] || PSR_OK=-
		log "  Bluetooth PSR on the panel: ${PSR_RES:-no result line}"
	else
		log "  WARNING: tsx-rescue-install psr failed (see above)"
	fi
else
	log "== step 3b: Bluetooth PSR file (--psr-source $PSR_SOURCE): the panel is not searched"
fi
PSR_ACTION=$(tsx_psr_plan "$PSR_SOURCE" "$PSR_OK" "$PSR_GOV") || true
case "$PSR_ACTION" in
not-needed) PSR_USED="not needed: government=1, the panel has no Bluetooth module (no .puf download)";;
use-panel) PSR_USED="panel: $PSR_SRC (no .puf download)";;
puf) psr_puf || true;;
none) run_stream_at "$RSSH" "rm -rf /tmp/b/psr" || true;;
esac
if [ "$PSR_USED" = none ]; then
	log "  Bluetooth PSR: no file will be installed: Bluetooth loads only its address (docs/install.md \"Bluetooth PSR file\")"
else
	log "  Bluetooth PSR source used: $PSR_USED"
fi
if [ "$TFA_USED" = none ]; then
	log "  TFA9890: no DSP files will be installed: the speakers work, without the vendor EQ/volume presets (later: installer/steps/tsx-deploy-tfa.sh $PANEL)"
else
	log "  TFA9890 source used: $TFA_USED"
fi

# ------------------------------------ step 3c: stock LED bar firmware -------
# The rescue copies statussign_*.upg from stock Android's system partition
# (read-only, installer/lib/tsx-ledstock.sh). The install then puts it in
# /data/tsx/vendor/ on the panel. The file never reaches this host. A missing
# file never stops the install.
log "== step 3c: stock LED bar firmware image: looking in the stock system of the panel (read-only, the file stays on the panel)"
if run_stream_at "$RSSH" "sh /tmp/b/tsx-rescue-install ledstock /tmp/b 2>&1"; then
	LED_RES=$(printf '%s\n' "$RS_OUT" | sed -n 's/^LEDSTOCK-RESULT //p' | tail -n 1)
	case "$LED_RES" in
	*ok=1*) log "  stock LED bar image: found ($LED_RES). The install copies it to /data/tsx/vendor/ on the panel";;
	*) log "  stock LED bar image: not found. The install keeps a copy that /data already has";;
	esac
else
	log "  WARNING: tsx-rescue-install ledstock failed (see above). The install continues without the stock LED bar image"
fi

# --------------------------------------------------------- step 4: install --
log "== step 4: install (rescue: eMMC boot+root, card fold, final env)"
KEEP_ARG=; [ "$KEEP_DATA" = 1 ] && KEEP_ARG=--keep-data
run_stream_at "$RSSH" "sh /tmp/b/tsx-rescue-install check /tmp/b $KEEP_ARG --root-from - 2>&1" </dev/null || die "tsx-rescue-install check failed (see above)"
if [ "$YES" != 1 ]; then
	read -r -p "Write the eMMC (boot+root, $KERNEL) and fold the card of $PANEL (rescue at $RIP)? Type INSTALL: " ans </dev/tty
	[ "$ans" = INSTALL ] || die "aborted: operator did not type INSTALL"
fi
t0=$(date +%s)
log "  streaming root.img ($(( $(stat -c %s "$FLAVOR_DIR/root.img") / 1048576 )) MiB) into the rescue over ssh. The eMMC write sets the speed. The rescue prints its progress about every 15 s"
run_stream_at "$RSSH" "sh /tmp/b/tsx-rescue-install run /tmp/b --yes $KEEP_ARG --root-from - 2>&1" < "$FLAVOR_DIR/root.img" || die "tsx-rescue-install run FAILED. The rescue is still reachable at $RIP. Read the output above and fix the cause. Then run this same command again. It resumes at step 3 while the rescue is up and writes the images again. The installer never changes U-Boot, so two power cycles always return the unit to stock Android"
# The rescue compared its readback with the manifest. Compare it here too,
# with the values of this host.
tsx_write_result_check "$RS_OUT" boot "$BOOT_SHA_WANT" || die "the rescue did not report the eMMC boot sha256 $BOOT_SHA_WANT (see above)"
tsx_write_result_check "$RS_OUT" root "$ROOT_SHA_WANT" || die "the rescue did not report the eMMC root sha256 $ROOT_SHA_WANT (see above)"
log "  ok: eMMC boot ${BOOT_SHA_WANT:0:16}... and root ${ROOT_SHA_WANT:0:16}... read back by the rescue, sha256 equal to the payload"
log "  install finished in $(( $(date +%s) - t0 )) s"
fi   # the push path (option A)

# --------------------------------------------------------- step 5: verify ---
log "== step 5: wait for the mainline kiosk"
w=0; while [ -n "$RSSH" ] && [ "$STAGED_DONE" != 1 ] && $RSSH true >/dev/null 2>&1 && [ $w -lt 60 ]; do sleep 5; w=$((w + 5)); done
# Count wall-clock seconds (the ssh timeout of each probe counts too).
# Print a heartbeat about every 30 s.
t0=$(date +%s); hb=0
until kiosk_up; do
	sleep 10; w=$(( $(date +%s) - t0 ))
	[ $w -ge $((hb + 30)) ] && { hb=$w; log "  still waiting for mainline ssh (root=/dev/mmcblk1p8) on $PANEL: ${w}/420 s"; }
	[ $w -lt 420 ] || die "the kiosk did not come up on $PANEL within 420 s after the install (OpenSSH on port 22 of the new system). The installer verified the eMMC writes before the reboot. The panel most likely booted with another DHCP address, because some images used a random eth0 MAC on the first boot. Power-cycle the panel once, or find it in the leases of your DHCP server. Then check it with ssh root@<its-ip>"
done
if [ "$STAGED_DONE" = 1 ]; then
	# The rescue compared the readback with the manifest (tsx-rescue-staged
	# stops on a mismatch). Compare it here too: the log of the rescue is in
	# /data/tsx/install-staged.log of the new system, and in the lines that this
	# host followed.
	SLOG=$($MSSH 'cat /data/tsx/install-staged.log' </dev/null 2>/dev/null) || SLOG=
	SLOG="$SLOG
$STAGED_OUT"
	if tsx_write_result_check "$SLOG" boot "$BOOT_SHA_WANT" && tsx_write_result_check "$SLOG" root "$ROOT_SHA_WANT"; then
		log "  ok: eMMC boot ${BOOT_SHA_WANT:0:16}... and root ${ROOT_SHA_WANT:0:16}... read back by the rescue, sha256 equal to the payload (staged install)"
	elif grep -q 'WRITE-RESULT' <<<"$SLOG"; then
		die "the staged install log has no WRITE-RESULT with the sha256 of this payload (boot $BOOT_SHA_WANT, root $ROOT_SHA_WANT)"
	else
		log "  WARNING: this host cannot read the log of the staged install (no login to the new system). The rescue compared the sha256 of boot and root itself"
	fi
fi
KIOSK_UP=$($MSSH 'if [ -e /etc/init.d/kiosk ]; then pgrep -f "[c]hromium" >/dev/null && echo yes || echo no; else echo "not in this image profile"; fi' 2>/dev/null) || KIOSK_UP=unknown
log "  ok: root=/dev/mmcblk1p8, kiosk running=$KIOSK_UP"
# the profile of the installed image: /etc/tsx/profile (a missing file means ha)
PROFILE=$($MSSH 'cat /etc/tsx/profile 2>/dev/null || echo ha' 2>/dev/null | head -n 1 | tr -cd 'a-z0-9') || PROFILE=
[ -n "$PROFILE" ] || PROFILE=unknown
log "== DONE. $PANEL now runs mainline, profile $PROFILE, on the eMMC ($KERNEL kernel). ssh root@$PANEL (the root password that you gave, or your SSH key)."
# a newly generated ESPHome API key (installer/lib/tsx-config-prompt.sh), once
if [ "$(type -t tsx_config_print_api_key)" = function ]; then tsx_config_print_api_key "$PANEL"; fi
if [ "$(type -t tsx_config_print_root_login)" = function ]; then tsx_config_print_root_login "$CONFIG"; fi
