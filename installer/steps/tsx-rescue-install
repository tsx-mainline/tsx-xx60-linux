#!/bin/sh
# xx60 mainline installer v2, step 2. It runs INSIDE the mainline rescue
# system (RAM root, busybox ash). installer/tsx-install-mainline pushes it
# there in a bundle at /tmp/b (same delivery as installer/tsx-restore-factory).
# The script writes the eMMC boot and root regions from pre-built images. It
# deploys the TFA9890 DSP files and (optionally) KIOSK_URL into the new root.
# It folds p5..p8 of the SD card into p4 (tsxdata). It writes the FINAL env (see
# docs/boot.md "The v2 env state machine"). It never touches U-Boot itself. It
# writes only the env at 1 MiB.
#
#   tsx-rescue-install check BUNDLE_DIR [--keep-data]
#   tsx-rescue-install tfa   BUNDLE_DIR
#   tsx-rescue-install psr   BUNDLE_DIR
#   tsx-rescue-install run   BUNDLE_DIR [--yes] [--keep-data]
#
# tfa (read-only, before run): look for the TFA9890 DSP files on the panel
# itself. First the current mainline root on eMMC p8 (a reinstall), then the
# stock Android boot image on eMMC p7. Validate the files and put the result
# in BUNDLE_DIR/tfa-panel/ (installer/lib/tsx-tfa.sh, docs/install.md "TFA9890
# speaker DSP tuning"). If the host takes the files, it moves them to
# BUNDLE_DIR/tfa/. The files stay on the panel.
#
# psr (read-only, before run): look for the CSR8811 Bluetooth PSR file on the
# panel itself: the current mainline root on eMMC p8, else the stock Android
# system partition in the same region (installer/lib/tsx-psr.sh). A valid
# file goes to BUNDLE_DIR/psr/, and "run" deploys it. It stays on the panel.
# If the panel has no valid file, the host can put the file of the .puf
# download there instead (rootfs/vendor-fetch.sh --psr). On a panel with
# government=1 (no Bluetooth module, docs/hardware.md "Panel variants"), it
# looks for no file and puts only psr/SOURCE (source=not-needed) there.
#
# --keep-data (a mainline -> mainline reinstall, docs/install.md "Reinstalling
# or updating a mainline panel"): if the card is already folded and p4 is a
# clean tsxdata ext4 (tsx_tsxdata_keepable), keep p4 as it is, with no mkfs.
# The browser profile and login, logs, panel.conf and sendspin state survive.
# Without --keep-data (the Android -> mainline path, or --wipe-data on the
# host), the script always formats p4.
#
# BUNDLE_DIR layout (the host builds it, see installer/emmc/mk-tsxroot-emmc.sh
# and installer/tsx-install-mainline):
#   manifest              key=value: root_bytes, root_sha256, boot_sha256, kernel
#                          flavor, root_partition_min_bytes (if the build set it)
#   root.img              ext4 (LABEL=tsxroot-emmc), built COMPACT (content plus a
#                          margin, well under the ~2.9 GiB of p8, see the eMMC region
#                          table in docs/boot.md). After the write, resize2fs grows
#                          it to fill p8. The bundle has root.img OR root-url.txt.
#   root-url.txt          one line: an http URL that serves that root.img. The
#                          rescue does not need to store the image on its own
#                          disk first. The script streams it onto p8 (wget -O -
#                          | dd) either way. The readback sha256 against the
#                          manifest verifies it.
#   boot.img              the eMMC boot image (kernel+DTB+initramfs), <= 32 MiB
#   tsx-rescue.sh          installer/lib/tsx-rescue.sh (pr_dd, tsx_env_apply, tsx_mbr_fold, tsx_mkfs_tsxdata)
#   tsx-usb-recovery       installer/emmc/tsx-usb-recovery (copied verbatim, runs standalone)
#   tsx-tfa.sh             installer/lib/tsx-tfa.sh (the tfa command)
#   tsx-psr.sh             (optional) installer/lib/tsx-psr.sh (the psr command)
#   tfa/<variant>/stereo.cnt   (optional) TFA9890 DSP tuning files. The host
#                          puts them there, from the panel (tfa-panel/, above)
#                          or pushed from rootfs/vendor-fetch.sh. tfa/SOURCE
#                          says where they came from. It is deployed with them.
#   psr/PSR-CSR8811.psr    (optional) the Bluetooth PSR file, from the panel
#                          (the psr command, above) or pushed from
#                          rootfs/vendor-fetch.sh --psr. psr/SOURCE says where
#                          it came from. It is deployed with it.
#   kiosk-url.txt          (optional) one line: the KIOSK_URL to set
#   panel.conf             (optional) installer/panel.conf.example, built by
#                          the prompts of tsx-install-mainline or by
#                          --config FILE. The script writes it straight onto
#                          the new tsxdata as /data/tsx/panel.conf
#                          (docs/rootfs.md "Panel configuration"). If
#                          kiosk-url.txt is ALSO present, KIOSK_URL in
#                          panel.conf wins once tsx-config apply runs. The
#                          direct kiosk.conf edit below runs first, at first
#                          boot. After that, an override in panel.conf always
#                          takes precedence.
# Test hooks: TSX_EMMC/TSX_BOOT0 (as tsx-emmc-restore), TSX_RUN, TSX_SYSBLOCK
# (card disk), TSX_CMDLINE (the kernel command line for the psr command), TSX_STATUS (status-screen state file, default /run/tsx-install-state).
set -eu
RUN=${TSX_RUN:-/run}; mkdir -p "$RUN"
say() { echo "tsx-rescue-install: $(date +%T 2>/dev/null) $*" >&2; }
die() { say "ERROR: $*"; set_state "failed: $*"; exit 1; }
CMD=${1:-}; B=${2:-}; [ $# -ge 2 ] && shift 2 || { sed -n '2,/^set -eu$/p' "$0" | sed '$d'; exit 2; }
YES=0 KEEP_DATA=0
while [ $# -gt 0 ]; do case "$1" in --yes) YES=1;; --keep-data) KEEP_DATA=1;; *) die "unknown option $1";; esac; shift; done
case "$CMD" in check|run|tfa|psr) ;; *) sed -n '2,/^set -eu$/p' "$0" | sed '$d'; exit 2;; esac
[ -f "$B/manifest" ] && grep -q '^format=tsx-rescue-install-1$' "$B/manifest" || die "$B is not a v2 install bundle (no manifest)"
. "$B/tsx-rescue.sh"
. /usr/share/tsx/tsx-lib.sh   # tsx_find_disk, TSX_MBR_P4_TYPE_OFFSET, TSX_ENV_OFFSET/SIZE (already on the rescue image)

STATUS=${TSX_STATUS:-/run/tsx-install-state}
set_state() { printf '%s\n' "$1" > "$STATUS" 2>/dev/null || true; }
# The rescue screen (tsx-rescue-status) shows the state and the pr_dd progress
# of the tool named here, while its pid lives. A "check" writes nothing to disks.
echo "$$ install" > "$RUN/tsx-op" 2>/dev/null || true
set_state "starting ($CMD)"

conf() { sed -n "s/^$1=//p" "$B/manifest" | tail -n 1; }
ROOT_BYTES=$(conf root_bytes); ROOT_SHA=$(conf root_sha256); BOOT_SHA=$(conf boot_sha256); FLAVOR=$(conf kernel_flavor)
ROOT_MINPART=$(conf root_partition_min_bytes)
[ -n "$ROOT_BYTES" ] && [ -n "$ROOT_SHA" ] && [ -n "$BOOT_SHA" ] || die "manifest missing root_bytes/root_sha256/boot_sha256"
# pr_dd and the readback below both work in whole-MiB dd blocks (bs=1M
# count=N MiB). mk-tsxroot-emmc.sh rounds the compact image up to a MiB
# multiple for exactly this reason. A bundle that did not round would
# silently leave a fractional trailing MiB unwritten. The readback sha256
# still covers the whole file, so the readback check would always fail.
[ "$((ROOT_BYTES % 1048576))" = 0 ] || die "manifest root_bytes=$ROOT_BYTES is not a whole MiB (bad bundle?)"
[ -f "$B/boot.img" ] || die "$B missing boot.img"
ROOT_URL=
if [ ! -f "$B/root.img" ]; then
	[ -f "$B/root-url.txt" ] || die "$B has neither root.img nor root-url.txt"
	ROOT_URL=$(head -n 1 "$B/root-url.txt")
	[ -n "$ROOT_URL" ] || die "$B/root-url.txt is empty"
fi

# ---- the eMMC: the mmcblk with a boot0 sibling (as tsx-emmc-restore) -------
if [ -n "${TSX_EMMC:-}" ]; then EDEV=$TSX_EMMC; EBOOT0=${TSX_BOOT0:?TSX_BOOT0}
else
	EDEV=; for d in /sys/block/mmcblk[0-9]; do n=${d##*/}; [ -e "/sys/block/${n}boot0" ] && { EDEV=/dev/$n; EBOOT0=/dev/${n}boot0; break; }; done
	[ -n "$EDEV" ] || die "no mmcblk with a boot0 area (the eMMC) found"
fi
EBOOT=${EDEV}p7 EROOT=${EDEV}p8
[ -b "$EBOOT" ] && [ -b "$EROOT" ] || die "$EBOOT / $EROOT not found (blkdevparts not on the kernel cmdline?)"
GOT_ROOT_SECT=$(cat "/sys/class/block/${EROOT#/dev/}/size" 2>/dev/null || echo 0)
GOT_ROOT_BYTES=$((GOT_ROOT_SECT * 512))
# The build makes root.img COMPACT (content plus a margin, not p8-sized, see
# installer/emmc/mk-tsxroot-emmc.sh). So p8 must be AT LEAST as big as the
# image, not an exact match. The script grows the image to fill p8 after the
# write (below). root_partition_min_bytes (if the manifest has it) is a
# second, independent floor. It is the partition size that the build used for
# the image. So the script still refuses a wrong or undersized device, even if
# that device is bigger than this particular (small) image.
[ "$GOT_ROOT_BYTES" -ge "$ROOT_BYTES" ] || die "$EROOT is $GOT_ROOT_BYTES bytes, smaller than the root image (manifest root_bytes=$ROOT_BYTES)"
if [ -n "$ROOT_MINPART" ]; then
	[ "$GOT_ROOT_BYTES" -ge "$ROOT_MINPART" ] || die "$EROOT is $GOT_ROOT_BYTES bytes, smaller than the expected partition minimum (manifest root_partition_min_bytes=$ROOT_MINPART): wrong device?"
fi
grep -q "^$EBOOT \| $EBOOT \|^$EROOT \| $EROOT " /proc/mounts && die "$EBOOT or $EROOT is mounted: refusing to write the eMMC"

# ---- tfa: the DSP files from the panel itself (read-only, before any write) --
if [ "$CMD" = tfa ]; then
	[ -f "$B/tsx-tfa.sh" ] || die "$B/tsx-tfa.sh missing (bundle too old for the tfa command)"
	. "$B/tsx-tfa.sh"
	set_state "looking for the speaker DSP files"
	say "looking for the TFA9890 DSP files on this panel (read-only: $EROOT, then $EBOOT)"
	tsx_tfa_collect "$B/tfa-panel" "$EBOOT" "$EROOT" "$B/tfa"
	set_state "checked OK"
	exit 0
fi

# ---- psr: the Bluetooth PSR file from the panel itself (read-only) ----------
if [ "$CMD" = psr ]; then
	[ -f "$B/tsx-psr.sh" ] || die "$B/tsx-psr.sh missing (bundle too old for the psr command)"
	. "$B/tsx-psr.sh"
	set_state "looking for the Bluetooth PSR file"
	# The flag: the kernel command line, else the U-Boot env (read-only)
	if tsx_find_disk 2>/dev/null; then
		printf '%s 0x%x 0x%x\n' "$WHOLE" "${TSX_ENV_OFFSET:-1048576}" "${TSX_ENV_SIZE:-65536}" > "$RUN/tsx-psr-env.cfg"
		FWCFG=$RUN/tsx-psr-env.cfg; tsx_pick_fwenv 2>/dev/null || FWP=
	fi
	gov=$(tsx_psr_government "${TSX_CMDLINE:-/proc/cmdline}")
	say "government=${gov:-unknown} on this panel"
	if [ "$gov" = 1 ]; then
		tsx_psr_not_needed "$B/psr"
	else
		say "looking for the Bluetooth PSR file on this panel (read-only: $EROOT)"
		tsx_psr_collect "$B/psr" "$EROOT" "$B/psr"
	fi
	set_state "checked OK"
	exit 0
fi

# ---- the card (SD): tsx_find_disk from tsx-lib.sh --------------------------
tsx_find_disk || die "no card with the Crestron/card-stage partition layout found"
CWHOLE=$WHOLE CP1=$P1 CP4=$P4

say "eMMC $EDEV: boot $EBOOT ($ROOT_BYTES bytes wanted on root), card $CWHOLE ($TSX_DISK_LAYOUT layout)"
if [ -z "$ROOT_URL" ]; then
	say "checking the bundle (sha256 of root.img and boot.img). This can take a minute"
	[ "$(sha256sum < "$B/root.img" | cut -d' ' -f1)" = "$ROOT_SHA" ] || die "root.img sha256 mismatch (corrupt transfer?)"
else
	say "checking the bundle (boot.img sha256). root.img streams from $ROOT_URL and the readback verifies it after the write"
	GOTN=$(wget -q -O - "$ROOT_URL" 2>/dev/null | head -c 4096 | wc -c)
	[ "$GOTN" = 4096 ] || die "cannot read the root image from $ROOT_URL (got $GOTN bytes)"
fi
[ "$(sha256sum < "$B/boot.img" | cut -d' ' -f1)" = "$BOOT_SHA" ] || die "boot.img sha256 mismatch (corrupt transfer?)"
say "bundle OK (flavor: ${FLAVOR:-unknown})"

if [ "$CMD" = check ]; then
	if [ "$KEEP_DATA" = 1 ] && [ "$TSX_DISK_LAYOUT" = card ]; then
		rc=0; WHY=$(tsx_tsxdata_keepable "$CP4") || rc=$?
		case $rc in 0) say "tsxdata $CP4: $WHY: it will be kept";; 2) say "tsxdata $CP4: $WHY: run will try e2fsck -fp, and format it if that does not help";; *) say "tsxdata $CP4: $WHY: run will format it";; esac
	else
		say "tsxdata: run will fold/format the card's p4"
	fi
	say "check OK (nothing written)"; set_state "checked OK"; exit 0
fi
if [ $YES != 1 ]; then
	printf 'Type INSTALL to write the eMMC (boot+root) and fold the card of this unit: ' >&2
	read -r ans; [ "$ans" = INSTALL ] || die "not confirmed"
fi

# ---- 1. eMMC boot (p7), pr_dd + readback ------------------------------------
set_state "writing eMMC boot (p7)"
BOOT_MIB=$(( ($(stat -c %s "$B/boot.img") + 1048575) / 1048576 ))
say "writing boot.img -> $EBOOT ($BOOT_MIB MiB)"
pr_dd "$EBOOT" 0 "$BOOT_MIB" "eMMC boot" -- if="$B/boot.img" bs=1M conv=fsync || die "write to $EBOOT failed"
sync; echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
GOT=$(dd if="$EBOOT" bs=1M count="$BOOT_MIB" 2>/dev/null | head -c "$(stat -c %s "$B/boot.img")" | sha256sum | cut -d' ' -f1)
[ "$GOT" = "$BOOT_SHA" ] || die "eMMC boot readback mismatch ($GOT != $BOOT_SHA)"
say "eMMC boot verified ($GOT)"

# ---- 2. eMMC root (p8): write only the (compact) image, then grow it ------
set_state "writing eMMC root (p8)"
ROOT_MIB=$((ROOT_BYTES / 1048576))
say "discarding $EROOT, then writing root.img ($ROOT_MIB MiB). p8 itself is $((GOT_ROOT_BYTES / 1048576)) MiB, and the script grows the file system into it below"
# -f: the blkdiscard of util-linux refuses a device that still carries a file
# system signature. That is always the case on a reinstall (the previous
# tsxroot-emmc). It only prints "contains existing file system". Plain
# blkdiscard is the fallback for a build whose blkdiscard has no -f.
blkdiscard -f "$EROOT" 2>/dev/null || blkdiscard "$EROOT" 2>&1 || say "blkdiscard $EROOT failed (continuing)"
if [ -z "$ROOT_URL" ]; then
	pr_dd "$EROOT" 0 "$ROOT_MIB" "eMMC root" -- if="$B/root.img" bs=1M conv=fsync || die "write to $EROOT failed"
else
	# The writes are sequential and take whatever the pipe delivers. This is
	# correct without iflag=fullblock. The readback catches a short or failed
	# download.
	wget -q -O - "$ROOT_URL" | pr_dd "$EROOT" 0 "$ROOT_MIB" "eMMC root" -- bs=1M conv=fsync || die "write to $EROOT failed"
fi
sync; echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
set_state "verifying eMMC root"
GOT=$(dd if="$EROOT" bs=1M count="$ROOT_MIB" 2>/dev/null | sha256sum | cut -d' ' -f1)
[ "$GOT" = "$ROOT_SHA" ] || die "eMMC root readback mismatch ($GOT != $ROOT_SHA)"
say "eMMC root verified ($GOT)"

# ---- 2b. grow the (compact) root to fill the rest of p8 --------------------
# The build made root.img with content plus a margin, not with the real size of
# p8 (see installer/emmc/mk-tsxroot-emmc.sh). So p8 now has unused space past
# the image. Run e2fsck before the resize, because resize2fs requires a clean
# file system. Grow with resize2fs (no size argument = grow to fill the block
# device). Then run e2fsck again.
set_state "growing eMMC root (p8)"
say "e2fsck -fy $EROOT (pre-resize)"
e2fsck -fy "$EROOT" >/dev/null 2>&1; rc=$?
[ $rc -lt 4 ] || die "e2fsck -fy $EROOT failed before resize (exit $rc): the just-written image is not clean"
say "resize2fs $EROOT (grow to fill $((GOT_ROOT_BYTES / 1048576)) MiB)"
resize2fs "$EROOT" >/dev/null 2>&1 || die "resize2fs $EROOT failed"
say "e2fsck -fy $EROOT (post-resize)"
e2fsck -fy "$EROOT" >/dev/null 2>&1; rc=$?
[ $rc -lt 4 ] || die "e2fsck -fy $EROOT failed after resize (exit $rc)"
say "eMMC root grown to fill p8"

# ---- 3. deploy TFA9890 DSP files + KIOSK_URL into the new root -------------
set_state "configuring the new root"
MNT=$RUN/newroot; mkdir -p "$MNT"
mount -t ext4 -o rw "$EROOT" "$MNT" || die "cannot mount $EROOT"
# Always stamp kernel_flavor again onto the root that this script just wrote
# (fresh install and reinstall alike). Use the FLAVOR in the manifest of THIS
# bundle. That is the flavor now on the boot partition. Do not trust what
# mk-tsxroot-emmc.sh put into the root image at payload-build time. See
# tsx_rootinfo_set_flavor in tsx-rescue.sh for the reason. A mismatch there
# (a root image built with one --flavor and bundled under a different one) left
# a fresh --kernel stable install with kernel_flavor=lts on disk. That
# silently steered the next kernel package upgrade onto the wrong flavor.
tsx_rootinfo_set_flavor "$MNT/etc/tsx/emmc-root.info" "$FLAVOR"
say "  emmc-root.info: kernel_flavor=${FLAVOR:-unchanged}"
# A failure here is never fatal, because the speakers work without the DSP files.
TFADIR=$MNT/usr/local/share/tsx/tfa9890
if [ -d "$B/tfa" ]; then
	for v in "$B"/tfa/*/; do
		[ -f "$v/stereo.cnt" ] || continue
		variant=$(basename "$v")
		want=$(sha256sum < "$v/stereo.cnt" | cut -d' ' -f1)
		mkdir -p "$TFADIR/$variant"
		if cp "$v/stereo.cnt" "$TFADIR/$variant/stereo.cnt" 2>/dev/null \
			&& [ "$(sha256sum < "$TFADIR/$variant/stereo.cnt" | cut -d' ' -f1)" = "$want" ]; then
			say "  tfa: $variant/stereo.cnt deployed ($want)"
		else
			say "  WARNING: tfa: $variant/stereo.cnt copy failed (non-fatal, see docs/install.md)"
		fi
	done
	[ -f "$B/tfa/SOURCE" ] && cp "$B/tfa/SOURCE" "$TFADIR/SOURCE" 2>/dev/null \
		&& say "  tfa: source: $(sed -n 's/^source=//p' "$B/tfa/SOURCE"), firmware: $(sed -n 's/^firmware=//p' "$B/tfa/SOURCE")"
else
	say "  tfa: no TFA9890 DSP files in the bundle: the speakers run without the vendor tuning"
fi
# The Bluetooth PSR file (the psr command above). Never fatal: without it,
# tsx-bt loads only the Bluetooth address.
PSRDIR=$MNT/usr/local/share/tsx/csr8811
if [ -f "$B/psr/PSR-CSR8811.psr" ]; then
	mkdir -p "$PSRDIR"
	want=$(sha256sum < "$B/psr/PSR-CSR8811.psr" | cut -d' ' -f1)
	if cp "$B/psr/PSR-CSR8811.psr" "$PSRDIR/PSR-CSR8811.psr" 2>/dev/null \
		&& [ "$(sha256sum < "$PSRDIR/PSR-CSR8811.psr" | cut -d' ' -f1)" = "$want" ]; then
		cp "$B/psr/SOURCE" "$PSRDIR/SOURCE" 2>/dev/null || true
		say "  psr: PSR-CSR8811.psr deployed ($want, source $(sed -n 's/^source=//p' "$B/psr/SOURCE" 2>/dev/null))"
	else
		say "  WARNING: psr: PSR-CSR8811.psr copy failed (non-fatal: Bluetooth loads only its address)"
	fi
elif grep -q '^source=not-needed' "$B/psr/SOURCE" 2>/dev/null; then
	mkdir -p "$PSRDIR" && cp "$B/psr/SOURCE" "$PSRDIR/SOURCE" \
		&& say "  psr: not needed (government=1: no Bluetooth module). SOURCE recorded"
else
	say "  psr: no Bluetooth PSR file in the bundle (non-fatal: Bluetooth loads only its address)"
fi
if [ -f "$B/kiosk-url.txt" ] && [ -f "$MNT/etc/kiosk.conf" ]; then
	URL=$(head -n 1 "$B/kiosk-url.txt")
	sed -i "s|^KIOSK_URL=.*|KIOSK_URL=\"$URL\"|" "$MNT/etc/kiosk.conf" && say "  KIOSK_URL set: $URL"
fi
sync; umount "$MNT"

# ---- 4. card fold: p5..p8 -> p4 tsxdata (tsx-rescue.sh, TSX_MBR_P4_TYPE_OFFSET from tsx-lib.sh) --
# The script always folds and formats a stock card. An already folded card
# keeps its tsxdata with --keep-data if tsx_tsxdata_keepable says so (after one
# e2fsck -fp repair try). The script formats anything else.
set_state "folding the card (p5..p8 -> p4 tsxdata)"
KEEP=0
if [ "$TSX_DISK_LAYOUT" = stock ]; then
	[ "$KEEP_DATA" = 0 ] || say "card not folded yet (stock layout): --keep-data does not apply, p4 is formatted"
	tsx_mbr_fold "$CWHOLE" "$TSX_MBR_P4_TYPE_OFFSET" || die "MBR fold failed"
	# The kernel keeps the old table (p4 = the 1 KiB extended stub, p5..p8)
	# until it reads the table again. Without this, p4 would still be the stub
	# below.
	blockdev --rereadpt "$CWHOLE" 2>/dev/null || partx -u "$CWHOLE" 2>/dev/null || true
	sleep 1
	tsx_find_disk || true   # detect again: the layout changed from stock to card, and P4 now names the new primary partition
	[ "$TSX_DISK_LAYOUT" = card ] || die "the kernel did not pick up the folded card table (blockdev --rereadpt failed?). The MBR itself is folded: re-run this step once the table is re-read"
	CP4=$P4
else
	say "card already folded (layout=card): p4 is $CP4"
	if [ "$KEEP_DATA" = 1 ]; then
		grep -q "^$CP4 " /proc/mounts && die "$CP4 (tsxdata) is mounted in the rescue: refusing to check or format it"
		rc=0; WHY=$(tsx_tsxdata_keepable "$CP4") || rc=$?
		if [ "$rc" = 2 ]; then
			say "$CP4: $WHY: repairing with e2fsck -fp"
			e2fsck -fp "$CP4" >/dev/null 2>&1 || true
			rc=0; WHY=$(tsx_tsxdata_keepable "$CP4") || rc=$?
		fi
		if [ "$rc" = 0 ]; then KEEP=1; say "keeping tsxdata on $CP4 ($WHY): no mkfs, /data survives the reinstall"
		else say "WARNING: $CP4 cannot be kept ($WHY): formatting it (tsxdata starts empty)"; fi
	fi
fi
P4SECT=$(cat "/sys/class/block/${CP4##*/}/size" 2>/dev/null || echo 0)
[ "$P4SECT" -gt 131072 ] || die "$CP4 is only $P4SECT sectors: refusing to mkfs it as tsxdata"
say "card p4 (tsxdata): $CP4, $((P4SECT / 2048)) MiB"
if [ "$KEEP" = 0 ]; then
	MKUUID=$(cat /proc/sys/kernel/random/uuid 2>/dev/null) || die "cannot generate a UUID for tsxdata"
	say "mkfs.ext4 -L tsxdata -U $MKUUID $CP4"
	tsx_mkfs_tsxdata "$CP4" "$MKUUID" || die "mkfs of $CP4 (tsxdata) failed"
fi
if [ -f "$B/panel.conf" ] || [ "$KEEP" = 1 ]; then
	DMNT=$RUN/newdata; mkdir -p "$DMNT"
	mount -t ext4 "$CP4" "$DMNT" || die "cannot mount $CP4 (tsxdata) to write panel.conf"
	mkdir -p "$DMNT/tsx"
	if [ -f "$B/panel.conf" ]; then
		say "writing panel.conf onto tsxdata (installer/panel.conf.example, docs/rootfs.md)"
		install -m 600 "$B/panel.conf" "$DMNT/tsx/panel.conf"
	elif [ -f "$DMNT/tsx/panel.conf" ]; then
		tsx_conf_set_flavor "$DMNT/tsx/panel.conf" "$FLAVOR"
		say "kept the panel's own /data/tsx/panel.conf (KERNEL_FLAVOR=${FLAVOR:-unchanged})"
	else
		say "the kept tsxdata has no tsx/panel.conf: the panel runs with the rootfs defaults"
	fi
	sync; umount "$DMNT"
fi

# ---- 5. final env: one verified write (docs/boot.md "The v2 env state machine") --
set_state "finalizing (env + tsx-usb-recovery)"
# fw_env.config needs a hex offset and size (see installer/steps/tsx-rescue-arm.sh for the reason).
printf '%s 0x%x 0x%x\n' "$CWHOLE" "$TSX_ENV_OFFSET" "$TSX_ENV_SIZE" > "$RUN/tsx-final-env.cfg"
WANT="boot_retry 0
golden_boot_retry 0
DataRecoveryDone 1"
OUT=$(tsx_env_apply "$RUN/tsx-final-env.cfg" "$WANT" 2>&1) || die "$OUT"
say "$OUT"
if [ -x "$B/tsx-usb-recovery" ]; then
	sh "$B/tsx-usb-recovery" enable 2>&1 | while IFS= read -r l; do say "  usb-recovery: $l"; done   # it finds the card disk itself (p1 and p2 offsets), as tsx_find_disk does
else
	say "WARNING: $B/tsx-usb-recovery missing. USB recovery not (re-)armed. Run it by hand later."
fi
mount -t vfat "$CP1" "$RUN/p1" 2>/dev/null || { mkdir -p "$RUN/p1"; mount -t vfat "$CP1" "$RUN/p1"; }
touch "$RUN/p1/tsxboot.off"; sync; umount "$RUN/p1"
say "p1:tsxboot.off written: the hook is disabled, stock bootcmd now boots eMMC boot (p7) directly"

set_state "done, rebooting"
say "DONE. Rebooting into the kiosk from the eMMC (boot p7, root p8)."
sync
# Reboot in the background. Then the ssh session of the host ends cleanly and
# does not hang on a connection that the reboot never closes. tsx-restore-factory
# uses the same pattern.
(sleep 3; reboot -f) >/dev/null 2>&1 </dev/null &
exit 0
