#!/usr/bin/env bash
# Host: make sure a stock-Android xx60 has a Crestron admin account. This is
# what the first-run page of the web UI does. A factory-fresh /data has no
# account: GET /Device/Authentication then says AuthenticationState.IsEnabled=false
# and lists no LocalUsers. On a unit with forced authentication (env
# forced_auth_mode=true, e.g. the TSS-10 tested), every page of https://PANEL/
# also redirects to /createUser.html. A unit without it (e.g. a TSW-760 as
# shipped) serves its pages with authentication off and no redirect. In both
# cases the script creates the account with the call that the first-run form
# makes:
#   POST /Device/Authentication
#   {"Device":{"Authentication":{"AuthenticationState":{"AdminUsername":U,"AdminPassword":P,"IsEnabled":true}}}}
# The answer is StatusId 0, "Authentication enabled successfully" (done on unit
# B 2026-09-27 07:55). If an account already exists, the script changes
# nothing. Afterwards the Crestron SSH console must answer `ver` with that
# login.
#
#   steps/crestron-admin [--admin-user USER] [--admin-password-file FILE] PANEL
#        The user and the password have no default. An option wins over the
#        environment variable (TSX_ADMIN_USER, TSX_ADMIN_PW). A missing value
#        stops the script before it contacts the panel (lib/tsx-creds.sh).
#   steps/crestron-admin --autoupdate-off [LOGIN] PANEL
#        as above, and after the console login works, turn the Crestron auto
#        update off (console AUENABLE OFF). A Crestron panel with internet
#        checks for a firmware update every day at its AUTIME, and a restored
#        panel reports "PUF: Unknown", so it installs the same firmware again.
#        That update writes the card and the eMMC and reboots the panel: it
#        must not run during an install.
#   steps/crestron-admin --update-busy [LOGIN] PANEL
#        print "yes" when the Crestron auto update reports "Update in
#        Progress: Yes" (a download or an install), else "no".
#   steps/crestron-admin --status PANEL
#                                  print "none" (no account yet) or "exists".
#                                  It does not log in, change anything or need
#                                  a password.
# The script checks the console with one login. After it creates the
# account, it tries the console up to 6 times in 60 s, because the panel can
# restart its services after the change. It never tries again after a
# refused password: the Crestron sshd blocks a host for 24 hours after 3
# failed logins.
# Exit status:
#   0  the console answers `ver` with that login (--status: it printed the state)
#   1  no answer: the web UI or the console does not answer (yet)
#      (--status: the web UI does not answer)
#   2  usage, or a missing user or password
#   3  the Crestron sshd refused the login (a wrong user or password), or it
#      blocks this host
#   4  the panel refused to create the account (its answer is in the output)
# Test hook: TSX_ADMIN_POLL_S replaces the waits of 5 s and 10 s.
set -uo pipefail
. "$(cd "$(dirname "$0")/.." && pwd)/lib/tsx-creds.sh"
STATUS=0 H= AUOFF=0 BUSY=0
while [ $# -gt 0 ]; do case "$1" in
	--status) STATUS=1; shift;; --autoupdate-off) AUOFF=1; shift;; --update-busy) BUSY=1; shift;;
	-h|--help) sed -n '2,/^set -uo/p' "$0" | sed '$d'; exit 0;;
	--*) tsx_creds_opt "$@" && shift "$TSX_CREDS_SHIFT" || { echo "crestron-admin: unknown option $1" >&2; exit 2; };;
	*) [ -z "$H" ] || { echo "crestron-admin: extra argument $1" >&2; exit 2; }; H=$1; shift;;
esac; done
[ -n "$H" ] || { echo "usage: crestron-admin [--status] [--admin-user USER --admin-password-file FILE] PANEL" >&2; exit 2; }
if [ "$STATUS" = 0 ]; then
	tsx_creds_need_admin 0 || exit 2
	U=$TSX_ADMIN_USER PW=$TSX_ADMIN_PW
fi
say() { echo "crestron-admin: $*" >&2; }
JAR=$(mktemp); trap 'rm -f "$JAR"' EXIT
# account_state: "none" | "exists" | "" (web UI does not answer)
account_state() {
	local js loc
	js=$(curl -sk -m 15 -c "$JAR" -b "$JAR" -H 'X-Requested-With: XMLHttpRequest' "https://$H/Device/Authentication" 2>/dev/null)
	case "$(printf '%s' "$js" | python3 -c '
import json, sys
try:
    a = json.load(sys.stdin)["Device"]["Authentication"]
except Exception:
    sys.exit(0)
print("none" if not a.get("AuthenticationState", {}).get("IsEnabled") and not a.get("LocalUsers") else "exists")' 2>/dev/null)" in
	none) echo none; return;; exists) echo exists; return;; esac
	# fallback: the first-run redirect of a unit with forced authentication
	loc=$(curl -sk -m 15 -c "$JAR" -b "$JAR" -o /dev/null -w '%{redirect_url}' "https://$H/index_device.html") || return 0
	case "$loc" in *createUser.html) echo none;; *) echo exists;; esac
}
if [ "$BUSY" = 1 ]; then
	# console_cmd is defined below: a short copy here keeps the order simple.
	f=$(mktemp)
	printf 'AUSTATUS\r\nbye\r\n' | SSHPASS=$PW timeout 30 sshpass -e ssh -tt -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=10 "$U@$H" > "$f" 2>&1; rc=$?
	o=$(tr -d '\r' < "$f"); rm -f "$f"
	[ "$rc" = 5 ] && { say "the Crestron sshd refused the password of $U"; exit 3; }
	grep -q 'Update in Progress:' <<<"$o" || { say "no AUSTATUS answer from the console"; exit 1; }
	if grep -q 'Update in Progress: Yes' <<<"$o"; then echo yes; else echo no; fi
	exit 0
fi
st=$(account_state)
if [ "$STATUS" = 1 ]; then [ -n "$st" ] || { say "web UI https://$H/ does not answer"; exit 1; }; echo "$st"; exit 0; fi
case "$st" in
none)
	say "no Crestron account yet (authentication off, no users): creating '$U'"
	# python3 makes the JSON, so a quote or a backslash in the user or the
	# password cannot break it. curl reads the body on stdin: the password is
	# not on a command line.
	body=$(U=$U PW=$PW python3 -c 'import json, os
print(json.dumps({"Device": {"Authentication": {"AuthenticationState": {"AdminUsername": os.environ["U"], "AdminPassword": os.environ["PW"], "IsEnabled": True}}}}, separators=(",", ":")))') \
		|| { say "python3 could not make the request"; exit 1; }
	ans=$(printf '%s' "$body" | curl -sk -m 30 -c "$JAR" -b "$JAR" -H 'Content-Type: application/json' -H 'X-Requested-With: XMLHttpRequest' \
		-H "Origin: https://$H" -H "Referer: https://$H/createUser.html" --data-binary @- "https://$H/Device/Authentication")
	body=
	say "answer: ${ans:-(empty)}"
	if ! grep -q '"StatusId":0' <<<"$ans"; then
		# a unit without forced authentication (TSW-760 tested) enables it and
		# restarts its web service before it answers: ask again
		for i in 1 2 3 4 5 6; do sleep "${TSX_ADMIN_POLL_S:-5}"; st=$(account_state); [ "$st" = exists ] && break; done
		if [ "$st" != exists ]; then
			case "$ans" in
			*'"StatusId"'*) say "the panel refused the account (answer above). The password may not meet the password rules of the panel"; exit 4;;
			*) say "no account after 30 s, and no answer from the web UI"; exit 1;;
			esac
		fi
		say "no answer to the request, but the account now exists (web UI restarted)"
	fi
	TRIES=6;;
exists) say "the web UI already has an account (or authentication on): not changing it"; TRIES=1;;
*) say "web UI https://$H/ does not answer"; exit 1;;
esac
# console_cmd CMD: one login to the Crestron SSH console with the command CMD.
# Returns the status of sshpass (5: the password was refused) or timeout. OUT
# holds the output of the session.
console_cmd() {
	local f rc
	f=$(mktemp)
	printf '%s\r\nbye\r\n' "$1" | SSHPASS=$PW timeout 30 sshpass -e ssh -tt -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=10 "$U@$H" > "$f" 2>&1; rc=$?
	OUT=$(tr -d '\r' < "$f"); rm -f "$f"
	return "$rc"
}
# console_ver: the console answers `ver`. Returns 0, 5 (password refused) or
# another status.
console_ver() {
	local rc=0
	console_cmd ver || rc=$?
	printf '%s\n' "$OUT" | grep -qE '\[v[0-9]' && return 0
	[ "$rc" = 0 ] && rc=1
	return "$rc"
}
# autoupdate_off: AUENABLE OFF, then the state from AUSTATUS.
autoupdate_off() {
	console_cmd "AUENABLE OFF" || true
	if grep -q 'Auto Updates State: OFF' <<<"$OUT"; then say "Crestron auto update is OFF now (AUENABLE OFF): no firmware update starts during the install"
	else say "WARNING: AUENABLE OFF gave no confirmation: $(grep -v -e '^$' -e '^bye' <<<"$OUT" | tail -n 2 | tr '\n' ' ')"; fi
	console_cmd AUSTATUS || true
	grep -q 'Update in Progress: Yes' <<<"$OUT" && say "Crestron reports an update in progress: the installer waits until it ends"
	return 0
}
for i in $(seq 1 "$TRIES"); do
	rc=0; console_ver || rc=$?
	if [ "$rc" = 0 ]; then
		say "ok: console login $U works: $(printf '%s\n' "$OUT" | grep -E '\[v[0-9]' | head -n 1)"
		[ "$AUOFF" = 0 ] || autoupdate_off
		exit 0
	fi
	if grep -qi 'blocked' <<<"$OUT"; then
		say "the Crestron sshd blocks this host: $(grep -i -m 1 'blocked' <<<"$OUT"). Run REMBLOCKEDIP <this-host-ip> on the Crestron console from another machine"; exit 3
	fi
	if [ "$rc" = 5 ]; then
		say "the Crestron sshd refused the password of $U. This script does not try again: after 3 failed logins the sshd blocks this host for 24 hours"; exit 3
	fi
	say "no answer from the Crestron SSH console yet (try $i of $TRIES, ssh status $rc)${OUT:+: $(printf '%s' "$OUT" | tail -n 1)}"
	[ "$i" -lt "$TRIES" ] && sleep "${TSX_ADMIN_POLL_S:-10}"
done
say "the Crestron SSH console did not answer"; exit 1
