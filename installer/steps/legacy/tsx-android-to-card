#!/usr/bin/env bash
# Host: drive the whole conversion of a stock-Android TSW-1060/TSS-10 to the
# mainline kiosk, hands off. This is the card stage. tsx-card-to-emmc migrates
# the unit onto the eMMC afterwards. This is an internal step of
# tsx-install-mainline. Calling it directly is an expert and debug path. It
# uses no adb, and it never touches adbd. Root comes from the patched Crestron
# sshd (steps/rootsh), and the payload travels over HTTP.
#
#   steps/tsx-android-to-card --payload DIR --rootfs FILE PANEL_IP [options]
#
#   DIR                a payload directory built by mkpayload --rootfs-p2 (e.g.
#                       out/payload). It MUST be a subdirectory of the parent
#                       of FILE. The script serves that parent over HTTP.
#   FILE                the raw, uncompressed p2 rootfs image
#                       (out/rootfs-p2.ext4). The script uses a FILE.sha256
#                       sidecar if there is one. The parent directory of FILE
#                       must also hold sshShell.sh (out/sshShell.sh, see
#                       docs/install.md "TSX Android root over SSH").
#   PANEL_IP            the LAN IP of the panel (any current state: mainline,
#                       half-booted Android, or fresh stock Android)
#
# Options:
#   --port N            HTTP server port on the workstation (default 8080)
#   --ws-ip IP          workstation IP to hand to the panel (default:
#                       auto-detected from `ip route get PANEL_IP`)
#   --dest DIR          panel-side staging directory (default /logs/tsx-payload)
#   --results FILE      log file (default results/tsx-android-to-card-<date>.txt,
#                       appended, timestamped)
#   --from-step N       skip the steps before N (1..7, see the numbered comments
#                       below). Step 1 (setup + HTTP server) always runs.
#   --uart auto|yes|no  control channel for steps 3, 4 and 7 (default auto).
#                       auto uses the UART only if serlog.py looks like it
#                       runs (pgrep) AND ../../tools/bench/uc.sh exists.
#                       Otherwise, and with --uart no, those steps use only
#                       the network (steps/rootsh + ssh polling, no serial
#                       console). --uart yes forces the UART and dies if
#                       uc.sh is missing. See docs/install.md "Network-only
#                       mode (no UART)" for the prerequisites.
#   --yes               do not ask before the install (step 6 still prints
#                       the preflight output first)
#   --dry-run           print what each step would do, without hardware or an
#                       HTTP server
#
# Needs on the host: bash, sshpass, ssh, python3, split, sha256sum, ip, awk.
# It reuses steps/rootsh (root over the patched Crestron sshd),
# steps/mkpanelfetch.sh (generates the panel-side fetch script) and
# steps/crestron-admin (creates the Crestron admin account on a factory-fresh
# unit, so rootsh has a login). Unless --uart no forces network-only, it also
# uses ../../tools/bench/uc.sh (UART). serlog.py must already run and log to
# ../../tools/bench/boot-2200.log.
# UART commands stay at 80 characters or fewer, because the console mangles
# longer lines. The script writes a longer command to a small script, serves it
# over HTTP, and runs it with a short wget/sh pair. This includes the one-line
# sshShell.sh install recipe (docs/install.md).
set -euo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
INSTALLER=$(cd "$HERE/../.." && pwd)   # installer/steps/legacy/ -> installer/
SERIALDIR=$(cd "$INSTALLER/../tools/bench" && pwd)
UC="$SERIALDIR/uc.sh"
ROOTSH="$INSTALLER/steps/rootsh"
MKPANELFETCH="$INSTALLER/steps/mkpanelfetch.sh"
CRESTRONADMIN="$INSTALLER/steps/crestron-admin"
INSTALLER_REL=tsx-install/android/tsx-android-install.sh
MAINLINE_PW=${TSX_MAINLINE_PW:-tsx}

usage() { sed -n '2,54p' "$0" >&2; }
log() { local ts; ts=$(date '+%Y-%m-%d %H:%M:%S'); printf '[%s] %s\n' "$ts" "$*" | tee -a "$RESULTS" >&2; }
die() { log "ERROR: $*"; exit 1; }
log_multiline() {  # label text
	log "-- $1 --"
	printf '%s\n' "$2" | while IFS= read -r l; do log "  $l"; done
	log "-- end $1 --"
}
need_cmd() { command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"; }
run_with_heartbeat() {  # LABEL CMD...: runs CMD in the background (its stdout+stderr going
	# to a temp file, because the output of $ROOTSH cannot be streamed. It prints only when
	# the whole ssh session ends). Print an elapsed-time heartbeat every ~30s while it
	# runs. Leave the full output in $HB_OUT and the exit status in $HB_RC. The function only
	# polls with kill -0 and reaps its own direct child with wait. It never signals the child.
	local label=$1; shift
	local tmp; tmp=$(mktemp)
	"$@" >"$tmp" 2>&1 &
	local cpid=$! w=0
	log "  $label: started (pid $cpid), this can take a while..."
	while kill -0 "$cpid" 2>/dev/null; do
		sleep 5; w=$((w + 5))
		[ $((w % 30)) -eq 0 ] && log "  $label: still running, ${w}s elapsed"
	done
	# set -e is on. A failing CMD (for example rc=255 when the install reboots the
	# panel under the ssh session) must not end the script here. The caller checks $HB_RC.
	if wait "$cpid"; then HB_RC=0; else HB_RC=$?; fi
	HB_OUT=$(cat "$tmp"); rm -f "$tmp"
	log "  $label: finished after ${w}s (rc=$HB_RC)"
}

PAYLOAD= ROOTFS= PANEL= PORT=8080 WSIP= DEST=/logs/tsx-payload
RESULTS= FROM_STEP=1 YES=0 DRYRUN=0 UART_OPT=auto
while [ $# -gt 0 ]; do
	case "$1" in
	--payload) PAYLOAD=$2; shift 2;;
	--rootfs) ROOTFS=$2; shift 2;;
	--port) PORT=$2; shift 2;;
	--ws-ip) WSIP=$2; shift 2;;
	--dest) DEST=$2; shift 2;;
	--results) RESULTS=$2; shift 2;;
	--from-step) FROM_STEP=$2; shift 2;;
	--uart) UART_OPT=$2; shift 2;;
	--yes) YES=1; shift;;
	--dry-run) DRYRUN=1; shift;;
	-h|--help) usage; exit 0;;
	--*) echo "tsx-android-to-card: unknown option $1" >&2; usage; exit 2;;
	*) [ -z "$PANEL" ] || die "unexpected extra argument: $1"; PANEL=$1; shift;;
	esac
done
[ -n "$PAYLOAD" ] && [ -n "$ROOTFS" ] && [ -n "$PANEL" ] || { usage; exit 2; }
case "$UART_OPT" in auto|yes|no) ;; *) echo "tsx-android-to-card: --uart must be auto, yes, or no (got: $UART_OPT)" >&2; usage; exit 2;; esac
[ -n "$RESULTS" ] || RESULTS="results/tsx-android-to-card-$(date +%Y%m%d).txt"
mkdir -p "$(dirname "$RESULTS")"
log "== tsx-android-to-card: PANEL=$PANEL PAYLOAD=$PAYLOAD ROOTFS=$ROOTFS from-step=$FROM_STEP dry-run=$DRYRUN uart=$UART_OPT"

# Choose the control channel. auto uses the UART only if serlog.py looks like
# it runs AND uc.sh exists. --uart yes and --uart no force it on and off. The
# script resolves this early (no network, no hardware touched), so the "needs"
# checks of step 1 below know whether uc.sh is required.
case "$UART_OPT" in
yes) UART_MODE=yes;;
no) UART_MODE=no;;
auto)
	if command -v pgrep >/dev/null 2>&1 && pgrep -f 'serlog\.py' >/dev/null 2>&1 && [ -x "$UC" ]; then
		UART_MODE=yes
	else
		UART_MODE=no
	fi
	;;
esac
if [ "$UART_MODE" = yes ]; then
	log "control channel: --uart=$UART_OPT -> UART_MODE=yes (serial console via uc.sh + wait_serial)"
else
	log "control channel: --uart=$UART_OPT -> UART_MODE=no (network-only: steps/rootsh + ssh polling, no serial console)"
fi

# ---------------------------------------------------------------- step 1 --
# Inputs, sanity checks, workstation IP, HTTP server. This step always runs.
# Later steps depend on its output, even when --from-step skips the earlier
# steps.
for c in sshpass ssh python3 split sha256sum ip awk; do need_cmd "$c"; done
[ -d "$PAYLOAD" ] || die "$PAYLOAD is not a directory"
[ -f "$ROOTFS" ] || die "$ROOTFS not found"
CONF="$PAYLOAD/tsx-install/tsx-install.conf"
[ -f "$CONF" ] || die "$CONF not found (not a payload directory?)"
conf_get() { sed -n "s/^$1=//p" "$2" | tail -n 1; }
P2BYTES=$(conf_get ROOTFS_P2_BYTES "$CONF")
P2SHA=$(conf_get ROOTFS_P2_SHA256 "$CONF")
[ -n "$P2BYTES" ] && [ -n "$P2SHA" ] || die "$CONF has no ROOTFS_P2_BYTES/ROOTFS_P2_SHA256"
SZ=$(stat -c %s "$ROOTFS")
[ "$SZ" = "$P2BYTES" ] || die "$ROOTFS is $SZ bytes, tsx-install.conf says $P2BYTES"
GOT=
[ -f "$ROOTFS.sha256" ] && GOT=$(awk '{print $1}' "$ROOTFS.sha256")
[ "$GOT" = "$P2SHA" ] || { log "hashing $ROOTFS locally ($((P2BYTES / 1048576)) MiB)..."; GOT=$(sha256sum "$ROOTFS" | awk '{print $1}'); }
[ "$GOT" = "$P2SHA" ] || die "$ROOTFS sha256 $GOT != tsx-install.conf ROOTFS_P2_SHA256 $P2SHA"
log "step 1: $ROOTFS matches tsx-install.conf ($P2SHA, $((P2BYTES / 1048576)) MiB)"

OUTDIR=$(cd "$(dirname "$ROOTFS")" && pwd)
PAYLOADABS=$(cd "$PAYLOAD" && pwd)
case "$PAYLOADABS" in "$OUTDIR"/*) PAYLOADBASE=$(basename "$PAYLOADABS");; *) die "$PAYLOAD must be a subdirectory of $OUTDIR (the HTTP server serves $OUTDIR)";; esac
# The patched sshShell.sh is needed only when rootsh is not root yet AND the
# UART installs it (step 4). A unit whose sshd already gives a root shell
# needs nothing here.
SSHSHELL="$OUTDIR/sshShell.sh"
[ -x "$ROOTSH" ] || die "$ROOTSH not found/executable"
[ -x "$MKPANELFETCH" ] || die "$MKPANELFETCH not found/executable"
[ -x "$CRESTRONADMIN" ] || die "$CRESTRONADMIN not found/executable"
if [ "$UART_MODE" = yes ]; then
	[ -x "$UC" ] || die "$UC not found/executable"
else
	log "step 1: network-only mode (--uart=$UART_OPT), not requiring $UC"
fi

if [ -z "$WSIP" ]; then
	WSIP=$(ip route get "$PANEL" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')
	[ -n "$WSIP" ] || die "could not auto-detect the workstation IP that routes to $PANEL (use --ws-ip)"
	log "step 1: workstation IP for $PANEL is $WSIP (ip route get)"
else
	log "step 1: workstation IP $WSIP (given)"
fi
BASEURL="http://$WSIP:$PORT"

HTTP_PIDFILE="$OUTDIR/.tsx-android-to-card-http-$PORT.pid"
HTTP_LOGFILE="$OUTDIR/.tsx-android-to-card-http-$PORT.log"
stop_http_server() {
	[ -f "$HTTP_PIDFILE" ] || return 0
	local pid; pid=$(cat "$HTTP_PIDFILE" 2>/dev/null || true)
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then kill "$pid" 2>/dev/null || true; log "stopped HTTP server (pid $pid)"; fi
	rm -f "$HTTP_PIDFILE"
}
trap stop_http_server EXIT

if [ "$DRYRUN" = 1 ]; then
	log "[dry-run] step 1: would serve $OUTDIR at $BASEURL/ (python3 -m http.server $PORT --bind 0.0.0.0), pidfile $HTTP_PIDFILE"
else
	( cd "$OUTDIR" || exit 1; nohup python3 -m http.server "$PORT" --bind 0.0.0.0 >"$HTTP_LOGFILE" 2>&1 & echo $! >"$HTTP_PIDFILE" )   # not "cd && python &": $! would be the subshell
	sleep 1
	pid=$(cat "$HTTP_PIDFILE")
	kill -0 "$pid" 2>/dev/null || die "python3 -m http.server failed to start (see $HTTP_LOGFILE)"
	log "step 1: HTTP server pid $pid serving $OUTDIR at $BASEURL/"
fi

# --- small helpers used by steps 2-7 --------------------------------------
MSSH="sshpass -p $MAINLINE_PW ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=8 root@$PANEL"
is_mainline() {
	local out; out=$($MSSH uname -r 2>/dev/null) || return 1
	case "$out" in [6-9].*|[1-9][0-9].*) return 0;; *) return 1;; esac   # 6.x LTS, 7.x stable, ...
}
rootsh_ok() {
	# A stock sshShell.sh drops "rootsh" into the Crestron console, which never exits. So use a short timeout.
	local out; out=$(TSX_SSH_TIMEOUT=30 "$ROOTSH" "$PANEL" id 2>/dev/null) || true
	grep -q '^uid=0(' <<<"$out"   # the tty echo ("bash-3.2# id; ...") can come first
}
uart() {  # [-w N] cmd   -- one UART command, <=80 chars, through uc.sh
	local w=5
	if [ "$1" = -w ]; then w=$2; shift 2; fi
	local c=$1
	[ ${#c} -le 80 ] || die "UART command >80 chars (would be mangled): $c"
	"$UC" -w "$w" "$c"
}
wait_serial() {  # pattern timeout_s [abort_pattern ...]
	local pat=$1 timeout=$2; shift 2
	local waited=0 poll=15 out a
	log "  waiting on the serial log for: $pat (timeout ${timeout}s)"
	while [ "$waited" -lt "$timeout" ]; do
		out=$("$UC" -w "$poll" 2>/dev/null || true)
		if [ -n "$out" ]; then
			for a in "$@"; do grep -qF -- "$a" <<<"$out" && die "serial log: abort pattern seen: $a"; done
			grep -qF -- "$pat" <<<"$out" && { log "  ok: seen '$pat'"; return 0; }
		fi
		waited=$((waited + poll))
		[ $((waited % 30)) -eq 0 ] && log "  still waiting for '$pat': ${waited}/${timeout}s"
	done
	die "timeout (${timeout}s) waiting on the serial log for: $pat"
}
wait_serial_from() {  # MARK pattern timeout_s [abort_pattern ...] -- like wait_serial, but searches
	# the serial log from line MARK on. The reboot can end before the ssh session
	# that started it returns. On 2026-09-27 the kiosk was up 72 s before install returned.
	local mark=$1 pat=$2 timeout=$3; shift 3
	local waited=0 out a
	log "  waiting on the serial log (from line $mark) for: $pat (timeout ${timeout}s)"
	while :; do
		out=$(tail -n +"$mark" "$SERIALDIR/boot-2200.log" | tr -d '\0')
		# Use here-strings, not "printf | grep -q". With pipefail, the early exit of grep -q sends SIGPIPE to printf on a big log.
		for a in "$@"; do grep -qF -- "$a" <<<"$out" && die "serial log: abort pattern seen: $a"; done
		grep -qF -- "$pat" <<<"$out" && { log "  ok: seen '$pat'"; return 0; }
		[ "$waited" -lt "$timeout" ] || die "timeout (${timeout}s) waiting on the serial log for: $pat"
		sleep 5; waited=$((waited + 5))
		[ $((waited % 30)) -eq 0 ] && log "  still waiting for '$pat': ${waited}/${timeout}s"
	done
}
wait_mainline_ssh() {  # timeout_s
	local timeout=$1 waited=0
	log "  waiting for ssh root@$PANEL (mainline)"
	while [ "$waited" -lt "$timeout" ]; do
		is_mainline && { log "  ok: mainline ssh answers"; return 0; }
		sleep 10; waited=$((waited + 10))
		[ $((waited % 30)) -eq 0 ] && log "  still waiting for mainline ssh on $PANEL: ${waited}/${timeout}s"
	done
	die "timeout (${timeout}s) waiting for mainline ssh on $PANEL"
}
wait_android_stable() {  # timeout_s -- fwUpgrade=0, no pending upgrade image,
	# boot_completed=1 and the root prompt, all through the UART. A stock unit
	# can run the one-time golden re-install of Crestron on first boot (~5 min,
	# then it reboots itself), even when nobody reformatted p5. So this function
	# is unconditional. It keeps polling, and so it tolerates that reboot, until
	# everything answers or the timeout is reached.
	local timeout=$1 waited=0 poll=20 fw ls raw bc
	log "  waiting for stock Android to settle (fwUpgrade=0, no pending upgrade image, boot_completed=1, root prompt). Tolerates one self-reboot (timeout ${timeout}s)"
	while :; do
		fw=$(uart -w 5 'fw_printenv fwUpgrade' 2>/dev/null || true)
		ls=$(uart -w 5 'ls /mnt/sdcard/ROMDISK/romdisk/user/system/image' 2>/dev/null || true)
		raw=$(uart -w 5 'getprop sys.boot_completed' 2>/dev/null || true)
		bc=$(printf '%s\n' "$raw" | grep -oE '^[01]$' | tail -n 1)
		if grep -q 'fwUpgrade=0' <<<"$fw" \
			&& grep -qi 'no such file' <<<"$ls" \
			&& [ "${bc:-}" = 1 ] \
			&& grep -qF "root@Crestron Touchpanel:/ #" <<<"$raw"; then
			log "  ok: Android settled (fwUpgrade=0, boot_completed=1, root prompt present)"
			return 0
		fi
		waited=$((waited + poll)); [ "$waited" -lt "$timeout" ] || die "timeout (${timeout}s) waiting for stock Android to settle"
		sleep "$poll"
	done
}
wait_android_stable_net() {  # timeout_s -- network-only equivalent of wait_android_stable:
	# same four conditions (fwUpgrade=0, no pending upgrade image, boot_completed=1,
	# p5 mounted), but through steps/rootsh instead of the UART. rootsh needs
	# root, so each round starts with rootsh_ok. If it fails (e.g. during the
	# reboot of the golden re-install), that round does not count as settled
	# yet. This is how the function tolerates the one self-reboot, as the UART
	# version does.
	local timeout=$1 waited=0 poll=20 fw ls bc mounted
	log "  waiting for stock Android to settle over the network (root via rootsh, fwUpgrade=0, no pending upgrade image, boot_completed=1, p5 mounted). Tolerates one self-reboot (timeout ${timeout}s)"
	while :; do
		if rootsh_ok; then
			fw=$("$ROOTSH" "$PANEL" 'fw_printenv fwUpgrade' 2>/dev/null) || fw=
			# ls is EXPECTED to fail here ("No such file"). rootsh returns the
			# exit status of the remote command, so keep the output and do not
			# blank it when rc != 0.
			ls=$("$ROOTSH" "$PANEL" 'ls /mnt/sdcard/ROMDISK/romdisk/user/system/image' 2>/dev/null) || true
			bc=$("$ROOTSH" "$PANEL" 'getprop sys.boot_completed' 2>/dev/null) || bc=
			mounted=$("$ROOTSH" "$PANEL" 'grep -c mmcblk0p5 /proc/mounts' 2>/dev/null) || mounted=
			if grep -q 'fwUpgrade=0' <<<"$fw" \
				&& grep -qi 'no such file' <<<"$ls" \
				&& grep -q '^1$' <<<"$bc" \
				&& grep -qE '^[1-9][0-9]*$' <<<"$mounted"; then
				log "  ok: Android settled over the network (fwUpgrade=0, boot_completed=1, p5 mounted)"
				return 0
			fi
		fi
		waited=$((waited + poll)); [ "$waited" -lt "$timeout" ] || die "timeout (${timeout}s) waiting for stock Android to settle (network-only)"
		log "  still waiting for Android to settle (network-only): ${waited}/${timeout}s (root: $([ -n "${fw:-}" ] && echo ok || echo no))"
		sleep "$poll"
	done
}

# ---------------------------------------------------------------- step 2 --
# If the panel runs mainline now, force the next boot into stock Android
# (p1:tsxboot.off) and wait for the UART root prompt.
if [ "$FROM_STEP" -le 2 ]; then
	log "== step 2: make sure the next boot is stock Android"
	if [ "$DRYRUN" = 1 ]; then
		log "[dry-run] would check 'ssh root@$PANEL uname -r'. If it answers Linux 6.x: mount p1, touch tsxboot.off, sync, umount, reboot. Then wait_serial 'root@Crestron Touchpanel:/ #' 180"
	elif is_mainline && [ "$UART_MODE" != yes ]; then
		# Going back to Android needs the UART prompt below. Without the UART,
		# the usual cause is a finished card stage (a re-run after a later step
		# failed).
		die "panel $PANEL already runs mainline ($($MSSH 'uname -r' 2>/dev/null)). Network-only mode cannot take it back to stock Android. If the card stage is done (root /dev/mmcblk0p2), continue with: steps/tsx-card-to-emmc $PANEL, steps/tsx-deploy-tfa.sh $PANEL, then emmc/tsx-usb-recovery enable on the panel (see tsx-install-mainline)"
	elif is_mainline; then
		log "  panel is on mainline. Creating p1:tsxboot.off and rebooting"
		$MSSH 'mkdir -p /mnt/p1 && mount -t vfat /dev/mmcblk0p1 /mnt/p1 && touch /mnt/p1/tsxboot.off && sync && umount /mnt/p1 && reboot' >>"$RESULTS" 2>&1 || true
		wait_serial "root@Crestron Touchpanel:/ #" 180
	else
		log "  panel does not answer mainline ssh. Assuming it is already stock Android"
	fi
else
	log "== step 2: skipped (--from-step $FROM_STEP)"
fi

# ---------------------------------------------------------------- step 3 --
# Stock Android must boot FULLY, or it resets itself ~8.5 min in. If p5 is not
# a stock file system (fs_mgr_mount_all error or e2fsck unsupported feature),
# reformat it from the UART. Then let the firmware re-install of Crestron run
# once (~5 min) before the script touches p2.
if [ "$FROM_STEP" -le 3 ]; then
	log "== step 3: make sure stock Android boots fully (p5 stock fs) and has settled"
	if [ "$DRYRUN" = 1 ]; then
		if [ "$UART_MODE" = yes ]; then
			log "[dry-run] (uart) would scan the recent serial log for 'fs_mgr_mount_all returned unexpected error 255' / e2fsck 'unsupported feature'. If seen: uart 'grep -c mmcblk0p5 /proc/mounts' (expect 0), uart 'busybox mke2fs -F -L sdcard -b 4096 -I 256 -N 95616 /dev/block/mmcblk0p5', uart 'busybox reboot -f', wait_serial for the second prompt"
			log "[dry-run] (uart) would then ALWAYS poll the UART for up to 12 min, whether or not it reformatted p5. A stock unit can run the one-time golden re-install of Crestron on first boot and reboot itself, even without a p5 reformat. The poll waits for 'fw_printenv fwUpgrade' = fwUpgrade=0, 'ls /mnt/sdcard/ROMDISK/romdisk/user/system/image' absent, 'getprop sys.boot_completed' = 1 and the root prompt. It tolerates one self-reboot"
		else
			log "[dry-run] (network) would require rootsh_ok. Root over ssh must already work, because network-only mode cannot bootstrap it here. Check 'grep -c mmcblk0p5 /proc/mounts' via rootsh and die if p5 is not mounted (the mke2fs repair is UART-only, rerun with --uart yes). Then poll rootsh for up to 12 min for 'fw_printenv fwUpgrade' = fwUpgrade=0, the upgrade image dir absent, 'getprop sys.boot_completed' = 1 and p5 still mounted. It tolerates one self-reboot, and it retries ssh drops until the timeout"
		fi
	elif [ "$UART_MODE" = yes ]; then
		WINDOW=$(tail -n 4000 "$SERIALDIR/boot-2200.log" 2>/dev/null || true)
		if grep -qE 'fs_mgr_mount_all returned unexpected error 255|unsupported feature' <<<"$WINDOW"; then
			log "  p5 is not a stock filesystem (fs_mgr/e2fsck error seen). Reformatting from the UART"
			MOUNTED=$(uart -w 3 'grep -c mmcblk0p5 /proc/mounts' | grep -oE '^[0-9]+$' | tail -n 1)
			[ "${MOUNTED:-1}" = 0 ] || die "p5 (mmcblk0p5) appears mounted (${MOUNTED:-unknown}). Refusing to mke2fs it"
			uart -w 5 'busybox mke2fs -F -L sdcard -b 4096 -I 256 -N 95616 /dev/block/mmcblk0p5' >>"$RESULTS" 2>&1
			uart -w 3 'busybox reboot -f' >>"$RESULTS" 2>&1 || true
			wait_serial "root@Crestron Touchpanel:/ #" 180
		else
			log "  no fs_mgr/e2fsck error in the recent serial log. p5 looks stock already"
		fi
		log "  waiting for stock Android to settle before touching it. The golden firmware re-install can run on first boot even without a p5 reformat. It takes about 5 min and then reboots the unit once"
		wait_android_stable 720
	else
		log "  network-only mode: checking root over ssh (rootsh.sh) and that p5 is mounted (the mke2fs repair is UART-only)"
		rootsh_ok || die "network-only mode needs root over ssh already (steps/rootsh). See docs/install.md 'Network-only mode (no UART)', or rerun with --uart yes"
		MOUNTED=$("$ROOTSH" "$PANEL" 'grep -c mmcblk0p5 /proc/mounts' 2>/dev/null) || MOUNTED=
		grep -qE '^[1-9][0-9]*$' <<<"$MOUNTED" || die "p5 (mmcblk0p5) is not mounted. The mke2fs repair is UART-only, rerun with --uart yes"
		log "  p5 (mmcblk0p5) is mounted. Looks stock already"
		log "  waiting for stock Android to settle before touching it (network-only). The golden firmware re-install can run on first boot and reboot the unit once. This drops ssh, which is expected"
		wait_android_stable_net 720
	fi
else
	log "== step 3: skipped (--from-step $FROM_STEP)"
fi

# ---------------------------------------------------------------- step 4 --
# Root over the Crestron sshd: install the patched sshShell.sh from the UART
# if steps/rootsh does not answer uid=0 yet. The remount, cp and chmod chain is
# too long for one UART line. So the script writes it to a small script and
# fetches and runs that script (the same trick as panel-fetch.sh).
if [ "$FROM_STEP" -le 4 ]; then
	log "== step 4: root over Crestron's sshd (steps/rootsh)"
	if [ "$DRYRUN" = 1 ]; then
		if [ "$UART_MODE" = yes ]; then
			log "[dry-run] (uart) would check '$ROOTSH $PANEL id'. If not uid=0: run $CRESTRONADMIN $PANEL (factory-fresh unit may have no account yet), retry. If still not root: uart wget sshShell.sh, sha256 check, then fetch+run a small install-sshshell.sh (remount rw, backup, install, chmod, sync, remount ro) and re-check"
		else
			log "[dry-run] (network) would check '$ROOTSH $PANEL id'. If not uid=0: run $CRESTRONADMIN $PANEL (factory-fresh unit may have no account yet), retry. If still not root: die (network-only mode cannot install the sshShell.sh patch itself. Needs it done already via UART, adb, or --uart yes)"
		fi
	elif rootsh_ok; then
		log "  rootsh already answers uid=0, nothing to install"
	elif [ "$UART_MODE" = yes ]; then
		log "  rootsh is not root yet. Trying $CRESTRONADMIN first (a factory-fresh unit has no account yet, so rootsh cannot work even after the sshShell.sh patch)"
		"$CRESTRONADMIN" "$PANEL" >>"$RESULTS" 2>&1 || log "  crestron-admin.sh did not confirm console login (continuing. An account may already exist)"
		if rootsh_ok; then
			log "  ok: rootsh now answers uid=0 (the account was the only thing missing)"
		else
			[ -f "$SSHSHELL" ] || die "rootsh is not root and $SSHSHELL is missing: put your patched sshShell.sh there (see docs/install.md) or enable the root shell first"
			log "  rootsh is still not root. Installing $SSHSHELL from the UART"
			uart -w 5 "busybox wget -q -O /logs/sshShell.sh $BASEURL/sshShell.sh"
			REMOTESHA=$(uart -w 5 'busybox sha256sum /logs/sshShell.sh' | grep -oE '^[0-9a-f]{64}' | tail -n 1)
			LOCALSHA=$(sha256sum "$SSHSHELL" | awk '{print $1}')
			[ "$REMOTESHA" = "$LOCALSHA" ] || die "sshShell.sh sha256 mismatch after wget: $REMOTESHA != $LOCALSHA"
			INSTSCRIPT="$OUTDIR/ish.sh"   # short name: the UART wget line must stay <= 80 chars
			cat >"$INSTSCRIPT" <<-'EOF'
				#!/system/bin/sh
				set -e
				mount -o remount,rw /system
				cp /system/bin/sshShell.sh /logs/sshShell.sh.stock
				cp /logs/sshShell.sh /system/bin/sshShell.sh
				chmod 755 /system/bin/sshShell.sh
				sync
				mount -o remount,ro /system
				echo INSTALL_SSHSHELL_DONE
			EOF
			uart -w 5 "busybox wget -q -O /logs/ish.sh $BASEURL/ish.sh"
			OUT=$(uart -w 8 'busybox sh /logs/ish.sh')
			grep -q INSTALL_SSHSHELL_DONE <<<"$OUT" || die "ish.sh (sshShell.sh install) did not report done: $OUT"
			rootsh_ok || die "$ROOTSH $PANEL id still does not print uid=0 after installing sshShell.sh"
			log "  ok: rootsh now answers uid=0"
		fi
	else
		log "  rootsh is not root yet. Trying $CRESTRONADMIN (a factory-fresh unit may have no account yet). The sshShell.sh patch needs a root shell, and network-only mode has none"
		"$CRESTRONADMIN" "$PANEL" >>"$RESULTS" 2>&1 || log "  crestron-admin.sh did not confirm console login (continuing. An account may already exist)"
		if rootsh_ok; then
			log "  ok: rootsh now answers uid=0 (the account was the only thing missing)"
		else
			die "root over ssh needs the patched /system/bin/sshShell.sh (out/sshShell.sh, recipe in README). Install it once from any root shell (UART or adb), or run with --uart yes."
		fi
	fi
else
	log "== step 4: skipped (--from-step $FROM_STEP)"
fi

# ---------------------------------------------------------------- step 5 --
# Payload over HTTP, no adb. Split the raw p2 image into chunks. Generate the
# panel-side fetch script (mkpanelfetch.sh). Push it with rootsh + wget. Run it
# in the background. Poll the log for ALL DONE.
if [ "$FROM_STEP" -le 5 ]; then
	log "== step 5: payload over HTTP (p2 chunks + payload files)"
	CHUNKDIR="$OUTDIR/p2-chunks"
	PANELFETCH="$OUTDIR/panel-fetch.sh"
	if [ "$DRYRUN" = 1 ]; then
		log "[dry-run] would: split -b 64M -d -a 2 $ROOTFS $CHUNKDIR/rootfs-p2.part"
		log "[dry-run] would: $MKPANELFETCH $ROOTFS $CHUNKDIR $PAYLOAD $BASEURL/p2-chunks $BASEURL/$PAYLOADBASE $DEST > $PANELFETCH"
		log "[dry-run] would: rootsh wget $PANELFETCH -> /logs/panel-fetch.sh, verify sha256, nohup bash it, poll tail -n 1 /logs/panel-fetch.log every 20s for ALL DONE"
	else
		if [ -d "$CHUNKDIR" ] && [ -n "$(ls -A "$CHUNKDIR" 2>/dev/null)" ]; then
			log "  $CHUNKDIR already has chunks, not re-splitting"
		else
			mkdir -p "$CHUNKDIR"
			log "  splitting $ROOTFS into 64 MiB chunks under $CHUNKDIR"
			split -b 64M -d -a 2 "$ROOTFS" "$CHUNKDIR/rootfs-p2.part"
		fi
		"$MKPANELFETCH" "$ROOTFS" "$CHUNKDIR" "$PAYLOAD" "$BASEURL/p2-chunks" "$BASEURL/$PAYLOADBASE" "$DEST" >"$PANELFETCH"
		log "  generated $PANELFETCH"
		"$ROOTSH" "$PANEL" "busybox wget -q -O /logs/panel-fetch.sh $BASEURL/panel-fetch.sh" >>"$RESULTS" 2>&1
		REMOTESHA=$("$ROOTSH" "$PANEL" "busybox sha256sum /logs/panel-fetch.sh" | awk '{print $1}')
		LOCALSHA=$(sha256sum "$PANELFETCH" | awk '{print $1}')
		[ "$REMOTESHA" = "$LOCALSHA" ] || die "panel-fetch.sh sha256 mismatch after wget: $REMOTESHA != $LOCALSHA"
		# Use an own session (setsid) and a short wait before the "exit" of rootsh.
		# A plain "nohup ... &" died at the pty hangup before it had opened its
		# log (2026-09-27).
		"$ROOTSH" "$PANEL" 'busybox setsid /system/bin/bash /logs/panel-fetch.sh > /logs/panel-fetch.log 2>&1 < /dev/null & sleep 3; ls -l /logs/panel-fetch.log' >>"$RESULTS" 2>&1 || true
		log "  panel-fetch.sh started. Polling /logs/panel-fetch.log every 20s"
		elapsed=0
		while :; do
			sleep 20; elapsed=$((elapsed + 20))
			OUT=$("$ROOTSH" "$PANEL" 'tail -n 1 /logs/panel-fetch.log' 2>&1) || true
			log "  panel-fetch: $OUT"
			case "$OUT" in
			*"ALL DONE"*) log "  ok: panel-fetch ALL DONE"; break;;
			*FAILED*|*MISMATCH*) die "panel-fetch reported failure: $OUT";;
			esac
			[ $elapsed -lt 2400 ] || die "timeout (2400s) waiting for panel-fetch ALL DONE"
		done
	fi
else
	log "== step 5: skipped (--from-step $FROM_STEP)"
fi

# ---------------------------------------------------------------- step 6 --
# Run preflight. Then run install --p2-written, after an explicit gate unless
# --yes is set.
if [ "$FROM_STEP" -le 6 ]; then
	log "== step 6: preflight + install"
	PREFLIGHT_CMD="/system/bin/bash $DEST/$INSTALLER_REL preflight --stick $DEST --p2-written 2>&1"
	INSTALL_CMD="/system/bin/bash $DEST/$INSTALLER_REL install --stick $DEST --p2-written --yes 2>&1"
	if [ "$DRYRUN" = 1 ]; then
		log "[dry-run] would run: $ROOTSH $PANEL '$PREFLIGHT_CMD'"
		log "[dry-run] would require 'preflight OK' in the output, then (unless --yes) ask to type INSTALL"
		log "[dry-run] would run: $ROOTSH $PANEL '$INSTALL_CMD'  (rc=255 expected: the panel reboots)"
		log "[dry-run] would require 'DONE.' in the output"
	else
		run_with_heartbeat "preflight" "$ROOTSH" "$PANEL" "$PREFLIGHT_CMD"
		PREOUT=$HB_OUT; PRC=$HB_RC
		log_multiline "preflight output (rc=$PRC)" "$PREOUT"
		grep -q "preflight OK" <<<"$PREOUT" || die "preflight did not report 'preflight OK'"
		if [ "$YES" != 1 ]; then
			printf '%s\n' "$PREOUT"
			read -r -p "Type INSTALL to proceed (this writes p1/p2 and reboots the panel): " ans </dev/tty
			[ "$ans" = INSTALL ] || die "aborted: operator did not type INSTALL"
		fi
		# The serial log exists only with the UART. Network-only mode has none.
		if [ "$UART_MODE" = yes ]; then SERIAL_MARK=$(wc -l < "$SERIALDIR/boot-2200.log"); fi
		run_with_heartbeat "install" "$ROOTSH" "$PANEL" "$INSTALL_CMD"
		INSTOUT=$HB_OUT; IRC=$HB_RC
		log_multiline "install output (rc=$IRC, 255 expected: reboot kills the ssh session)" "$INSTOUT"
		grep -q "DONE\." <<<"$INSTOUT" || die "install output did not contain DONE."
		log "  ok: install DONE., panel is rebooting into the mainline kiosk"
	fi
else
	log "== step 6: skipped (--from-step $FROM_STEP)"
fi

# ---------------------------------------------------------------- step 7 --
# Wait for the kiosk to come up.
if [ "$FROM_STEP" -le 7 ]; then
	log "== step 7: wait for the mainline kiosk boot"
	if [ "$DRYRUN" = 1 ]; then
		if [ "$UART_MODE" = yes ]; then
			log "[dry-run] (uart) would wait_serial 'tsx: booting tsxboot.img' 90, then 'switch_root to /dev/mmcblk0p2' 240, then 'tsx: starting kiosk' 90 (abort on 'Kernel panic' / 'tsx: mainline disabled')"
			log "[dry-run] (uart) would then wait_mainline_ssh 120"
		else
			log "[dry-run] (network) would poll 'ssh root@$PANEL uname -r' (is_mainline) up to 400s, tolerating the install reboot dropping ssh. Then log 'cat /proc/cmdline', the root device from /proc/mounts (expect /dev/mmcblk0p2) and 'pgrep -f chromium' (kiosk)"
		fi
	else
		if [ "$UART_MODE" = yes ]; then
			# For --from-step 7, look back the serial lines of ~2 boots.
			[ -n "${SERIAL_MARK:-}" ] || SERIAL_MARK=$(( $(wc -l < "$SERIALDIR/boot-2200.log") - 1500 )); [ "$SERIAL_MARK" -gt 0 ] || SERIAL_MARK=1
			wait_serial_from "$SERIAL_MARK" "tsx: booting tsxboot.img" 300 "Kernel panic" "tsx: mainline disabled"
			wait_serial_from "$SERIAL_MARK" "switch_root to /dev/mmcblk0p2" 240 "Kernel panic" "tsx: mainline disabled"
			wait_serial_from "$SERIAL_MARK" "tsx: starting kiosk" 120 "Kernel panic" "tsx: mainline disabled"
			wait_mainline_ssh 120
		else
			log "  network-only mode: waiting for mainline ssh (tolerates the install reboot dropping the connection)"
			wait_mainline_ssh 400
			CMDLINE=$($MSSH 'cat /proc/cmdline' 2>&1) || CMDLINE="(ssh failed)"
			log "  /proc/cmdline: $CMDLINE"
			# busybox has no findmnt
			ROOTSRC=$($MSSH "awk '\$2==\"/\"{print \$1}' /proc/mounts" 2>&1) || ROOTSRC="(ssh failed)"
			log "  root filesystem source: $ROOTSRC"
			grep -q '/dev/mmcblk0p2' <<<"$ROOTSRC" || log "  WARNING: root filesystem source is not /dev/mmcblk0p2: $ROOTSRC"
			if $MSSH 'pgrep -f chromium' >/dev/null 2>&1; then
				log "  ok: chromium (kiosk) is running"
			else
				log "  WARNING: chromium (kiosk) does not appear to be running yet"
			fi
		fi
	fi
else
	log "== step 7: skipped (--from-step $FROM_STEP)"
fi

log "== done"
