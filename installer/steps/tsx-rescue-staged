#!/bin/sh
# Run a staged install in the mainline rescue (docs/install.md "Stage on the
# panel first"). It runs INSIDE the rescue system (RAM root, busybox ash).
#
#   tsx-rescue-staged auto            find a stage on the card and run it
#   tsx-rescue-staged start           the same, in the background (for the host)
#   tsx-rescue-staged status          print the state: none | searching | nostage |
#                                     running | done | failed: REASON
#   tsx-rescue-staged follow [LINE]   print the log from LINE (default 1) and
#                                     follow it until the run ends
#
# Before the rescue boot, installer/tsx-install-mainline copies a stage to the
# card of the panel: tsx-stage/ on card p5 (stock Android, the "sdcard" ext2)
# or on card p4 (tsxdata, a mainline panel). installer/tsx-make-stick puts a
# stage on a USB stick (docs/install.md "Install from a USB stick"). The stage
# has:
#   STAGE         key=value: format=tsx-stage-1, kernel, keep_data, golden,
#                 tfa_source, psr_source, root_gz_bytes, root_gz_sha256
#   bundle/       the install bundle of tsx-rescue-install, with SHA256SUMS.
#                 Optional bundle/tfa-puf/ and bundle/psr-puf/: files of the
#                 .puf download that the host already had, used only if the
#                 panel has none
#   root.img.gz   the root image, gzip
# The rescue image starts "tsx-rescue-staged auto" once at boot (inittab,
# installer/rescue/mkrescue.sh). If an older rescue has no such line, the host
# copies this script to /run and runs "start". After that the install needs no
# network: a lost link or a network move does not stop it.
#
# What "auto" does:
#   1. Find the card (tsx-lib.sh). Mount p5 (stock layout) or p4 (folded card)
#      and look for tsx-stage/STAGE. If the card has none, look for a USB
#      stick with tsx-stage/STAGE (up to 20 s for the stick to show up). No
#      stage: exit 0, nothing changes.
#      A stick stays read-only: the runner never changes it, so one stick
#      installs many panels. p1:tsxstick.done holds the sha256 of the STAGE
#      that this panel installed. The same stick does not install it twice.
#      One exception: a panel that boots again from the stick that installed
#      it (the stick stayed in through a reboot) renames jabil.txt on the
#      stick to jabil.txt.done and reboots, so U-Boot boots the kiosk. Rename
#      the file back for the next panel.
#   2. Check that the RAM can hold the bundle and root.img.gz (plus 64 MiB).
#      If not, rename STAGE to STAGE.failed and stop: the host then pushes
#      the images over ssh.
#   3. Rename STAGE to STAGE.taken (a stage runs once). Copy the bundle to
#      /tmp/b and root.img.gz to /tmp. Check SHA256SUMS and the sha256 of
#      root.img.gz. Remove tsx-stage/ from the card and unmount it.
#   4. golden=1 (a reinstall): copy p1:tsxboot.img to the golden slot
#      p1:boot.img (tsx_golden_update).
#   5. The DSP files, the PSR file and the stock LED bar image from the panel
#      (tsx-rescue-install tfa, psr, ledstock). The .puf files of the stage are
#      the fallback.
#   6. tsx-rescue-install check, then run --no-reboot with root.img.gz through
#      gunzip on stdin. The readback checks the sha256 of boot and root.
#   7. Copy the log to /data/tsx/install-staged.log on the new tsxdata, so the
#      host can compare the WRITE-RESULT lines after the boot. Reboot.
#      From a stick: write p1:tsxstick.done, put the rescue image of the
#      stick in the golden slot and p1:tsxboot.img (golden=stick), keep the
#      old p1:boot.img in /data/tsx/backup, and ask on the screen to remove
#      the stick. Reboot when the stick is gone.
# A failure stops the run and keeps the rescue up with the files in RAM. The
# log is /run/tsx-staged.log.
# Test hooks: TSX_RUN, TSX_TMP (default /tmp), TSX_STAGE_DIR (a stage folder:
# no card, no mount), TSX_STICK_DIR (the root of a stick: no card, no mount,
# no p1), TSX_STAGED_INSTALL (the tsx-rescue-install to run),
# TSX_MEMAVAIL_KIB, TSX_NO_REBOOT=1, TSX_STAGED_FOLLOW_S (the follow limit),
# TSX_STICK_WAIT (seconds to wait for a stick, default 20).
RUN=${TSX_RUN:-/run}; TMP=${TSX_TMP:-/tmp}
LOG=$RUN/tsx-staged.log STATE=$RUN/tsx-staged.state PIDF=$RUN/tsx-staged.pid
# One runner per boot: the first one makes this folder (mkdir is atomic). It
# stays after a run, so a stage never runs twice in one boot.
LOCK=$RUN/tsx-staged.lock
MNT=$RUN/tsx-stage-mnt
B=$TMP/b
CMD=${1:-}

state() { cat "$STATE" 2>/dev/null || echo none; }
running() { p=$(cat "$PIDF" 2>/dev/null) && [ -n "$p" ] && kill -0 "$p" 2>/dev/null; }

case "$CMD" in
status)
	s=$(state); case "$s" in searching|running) running || s="failed: the runner stopped";; esac
	echo "$s"; exit 0;;
follow)
	# Print the log from line N and follow it. End when the run ends. The last
	# line is STAGED-RESULT state=... with the line count, so a host that lost
	# the connection can go on from there.
	n=${2:-1}; t0=$(date +%s)
	while :; do
		if [ -f "$LOG" ]; then
			tail -n +"$n" "$LOG" > "$RUN/tsx-staged.follow" 2>/dev/null
			c=$(wc -l < "$RUN/tsx-staged.follow")
			[ "$c" -gt 0 ] && { cat "$RUN/tsx-staged.follow"; n=$((n + c)); }
		fi
		s=$(state)
		case "$s" in
		searching|running) running || { echo "STAGED-RESULT state=failed lines=$((n - 1)) the runner stopped"; exit 1; };;
		done*) echo "STAGED-RESULT state=done lines=$((n - 1))"; exit 0;;
		none|nostage) echo "STAGED-RESULT state=$s lines=$((n - 1))"; exit 3;;
		*) echo "STAGED-RESULT state=failed lines=$((n - 1)) $s"; exit 1;;
		esac
		[ $(( $(date +%s) - t0 )) -lt "${TSX_STAGED_FOLLOW_S:-3600}" ] || { echo "STAGED-RESULT state=running lines=$((n - 1))"; exit 2; }
		sleep 1
	done;;
start)
	[ -d "$LOCK" ] && { echo "tsx-rescue-staged: state $(state): a runner started in this boot already"; exit 0; }
	nohup sh "$0" auto </dev/null >/dev/null 2>&1 &
	# Wait until the runner holds the lock, so a "follow" right after this
	# sees "searching" and not "none".
	n=0; while [ ! -d "$LOCK" ] && [ $n -lt 50 ]; do sleep 0.1; n=$((n + 1)); done
	echo "tsx-rescue-staged: started (pid $!)"; exit 0;;
auto) ;;
*) sed -n '2,/^RUN=/p' "$0" | sed '$d'; exit 2;;
esac

mkdir "$LOCK" 2>/dev/null || exit 0
echo $$ > "$PIDF"
echo searching > "$STATE"
: > "$LOG"
nostage() { rm -f "$PIDF" "$LOG"; echo nostage > "$STATE"; exit 0; }
say() { echo "tsx-rescue-staged: $(date +%T 2>/dev/null) $*" >> "$LOG"; }
STATUS=${TSX_STATUS:-$RUN/tsx-install-state}
fail() { say "ERROR: $*"; echo "failed: $*" > "$STATE"; printf '%s\n' "failed: $*" > "$STATUS" 2>/dev/null; exit 1; }
FROM=card STICKDEV= STM=$RUN/tsx-stick-mnt
unmount() { [ -n "${TSX_STAGE_DIR:-}${TSX_STICK_DIR:-}" ] || { sync; umount "$MNT" 2>/dev/null; umount "$STM" 2>/dev/null; }; }
# A stage on the card runs once: it is marked or removed. A stick stays as it is.
mark() { [ "$FROM" = stick ] || mv "$S/$1" "$S/$2"; }

# ---- 1. find the stage --------------------------------------------------------
# find_stick: mount the first USB stick (vfat) that has tsx-stage/STAGE on $STM,
# read-only. Sets STICKDEV. Waits up to TSX_STICK_WAIT s for the stick.
find_stick() {
	local end b n dev
	end=$(( $(cut -d. -f1 /proc/uptime) + ${TSX_STICK_WAIT:-20} ))
	mkdir -p "$STM"
	while [ "$(cut -d. -f1 /proc/uptime)" -lt "$end" ]; do
		for b in /sys/block/sd*; do
			[ -e "$b" ] || continue
			n=${b##*/}
			for dev in /dev/${n}1 /dev/$n; do
				[ -b "$dev" ] || continue
				mount -t vfat -o ro "$dev" "$STM" 2>/dev/null || continue
				[ -f "$STM/tsx-stage/STAGE" ] && { STICKDEV=$n; return 0; }
				umount "$STM"
			done
		done
		sleep 1
	done
	return 1
}
if [ -n "${TSX_STAGE_DIR:-}" ]; then S=$TSX_STAGE_DIR
elif [ -n "${TSX_STICK_DIR:-}" ]; then S=$TSX_STICK_DIR/tsx-stage; FROM=stick
else
	[ -f /usr/share/tsx/tsx-lib.sh ] || nostage
	# Never next to a run of the push path: it can format p4 at any moment.
	p=$(cat "$RUN/tsx-install-run.pid" 2>/dev/null) && [ -n "$p" ] && kill -0 "$p" 2>/dev/null && nostage
	. /usr/share/tsx/tsx-lib.sh
	# The card can probe a few seconds after init starts.
	n=0; until tsx_find_disk 2>/dev/null; do n=$((n + 1)); [ $n -lt 20 ] || nostage; sleep 1; done
	if [ "$TSX_DISK_LAYOUT" = stock ]; then DEV=$P5; else DEV=$P4; fi
	mkdir -p "$MNT"
	S=$MNT/tsx-stage
	mount -t ext4 -o rw,noatime "$DEV" "$MNT" 2>/dev/null || mount -t ext2 -o rw,noatime "$DEV" "$MNT" 2>/dev/null || S=
	if [ -z "$S" ] || [ ! -f "$S/STAGE" ]; then
		umount "$MNT" 2>/dev/null
		find_stick || nostage
		S=$STM/tsx-stage FROM=stick DEV="USB stick /dev/$STICKDEV"
	fi
fi
if [ ! -f "$S/STAGE" ]; then unmount; nostage; fi
echo running > "$STATE"
echo "$$ staged install" > "$RUN/tsx-op" 2>/dev/null
printf '%s\n' "staged install: starting" > "$STATUS" 2>/dev/null
say "stage found: ${DEV:-$S}"
conf() { sed -n "s/^$1=//p" "$S/STAGE" | tail -n 1; }
grep -q '^format=tsx-stage-1$' "$S/STAGE" || { mark STAGE STAGE.failed; unmount; fail "$S/STAGE is not a tsx-stage-1 file"; }
STAGE_ID=$(sha256sum < "$S/STAGE" | cut -d' ' -f1)
# p1:tsxstick.done names the stick stage that this panel installed already.
# p1_dir: mount p1 (vfat) on $RUN/tsx-p1s and print the folder (test hook TSX_P1_DIR).
p1_dir() { if [ -n "${TSX_P1_DIR:-}" ]; then echo "$TSX_P1_DIR"; else mkdir -p "$RUN/tsx-p1s"; mount -t vfat "$P1" "$RUN/tsx-p1s" && echo "$RUN/tsx-p1s"; fi; }
p1_done() { [ -n "${TSX_P1_DIR:-}" ] || { sync; umount "$RUN/tsx-p1s" 2>/dev/null; }; }
# wait_stick_out MESSAGE: show MESSAGE on the screen until the stick is gone, then reboot.
wait_stick_out() {
	printf '%s\n' "done: $1" > "$STATUS" 2>/dev/null
	say "$1"
	[ "${TSX_NO_REBOOT:-0}" = 1 ] && exit 0
	while [ -n "$STICKDEV" ] && [ -e "/sys/block/$STICKDEV" ]; do sleep 2; done
	say "the USB stick is out: rebooting"
	sync; reboot -f; exit 0
}
if [ "$FROM" = stick ]; then
	P1D=$(p1_dir) && OLDID=$(cat "$P1D/tsxstick.done" 2>/dev/null); p1_done
	if [ "${OLDID:-}" = "$STAGE_ID" ]; then
		# The stick stayed in through a reboot after its install. U-Boot boots
		# it again at every boot while jabil.txt is there. Rename it, so the
		# next boot reaches the kiosk, and reboot.
		echo "done" > "$STATE"
		say "this panel is installed from this USB stick already (p1:tsxstick.done)"
		STD=${TSX_STICK_DIR:-$STM}
		if [ -f "$STD/jabil.txt" ] && { [ -n "${TSX_STICK_DIR:-}" ] || mount -o remount,rw "$STM"; } \
			&& mv "$STD/jabil.txt" "$STD/jabil.txt.done" && sync; then
			unmount
			printf '%s\n' "done: installed from this USB stick already. jabil.txt on the stick is now jabil.txt.done: the panel restarts into the kiosk" > "$STATUS" 2>/dev/null
			say "jabil.txt on the stick renamed to jabil.txt.done (rename it back for the next panel). Rebooting into the kiosk"
			rm -f "$PIDF"
			[ "${TSX_NO_REBOOT:-0}" = 1 ] && exit 0
			sleep "${TSX_STAGED_REBOOT_S:-10}"; sync; reboot -f; exit 0
		fi
		unmount
		wait_stick_out "this panel is installed from this USB stick already. Remove the USB stick: the panel then restarts"
	fi
fi
# A stick without panel.conf (tsx-make-stick --no-config) gives no root login
# to a stock Android panel: refuse it there, before any write.
if [ "$(conf needs_mainline)" = 1 ] && [ "${TSX_DISK_LAYOUT:-}" = stock ]; then
	unmount; fail "this stick has no panel.conf and is for panels that run mainline only. This panel has the stock card layout (stock Android). Nothing was written"
fi
GZB=$(conf root_gz_bytes); GZS=$(conf root_gz_sha256); KEEP=$(conf keep_data); GOLDEN=$(conf golden)
TFA_SOURCE=$(conf tfa_source); PSR_SOURCE=$(conf psr_source)
say "kernel $(conf kernel), keep_data=$KEEP, golden=$GOLDEN, tfa_source=$TFA_SOURCE, psr_source=$PSR_SOURCE, root.img.gz $GZB bytes"

# ---- 2. room in RAM -------------------------------------------------------------
BK=$(du -sk "$S/bundle" | cut -f1)
NEEDK=$(( GZB / 1024 + BK + 65536 ))
AVK=${TSX_MEMAVAIL_KIB:-$(awk '/^MemAvailable:/{print $2}' /proc/meminfo)}
if [ "${AVK:-0}" -lt "$NEEDK" ]; then
	mark STAGE STAGE.failed; unmount
	fail "the RAM has ${AVK:-?} KiB available, the stage needs $NEEDK KiB. The host can push the images over ssh instead"
fi

# ---- 3. take the stage, copy it to RAM, check it, remove it from the card --------
mark STAGE STAGE.taken && sync || { unmount; fail "cannot mark the stage as taken"; }
say "copying the stage to RAM ($((NEEDK / 1024 - 64)) MiB, ${AVK} KiB available)"
printf '%s\n' "staged install: copying the stage to RAM" > "$STATUS" 2>/dev/null
rm -rf "$B" "$TMP/tsx-root.img.gz"
cp -a "$S/bundle" "$B" || { unmount; fail "copying the stage to RAM failed"; }
# pr_dd (tsx-rescue.sh of the bundle) shows the copy of root.img.gz on the
# rescue screen and in the log.
. "$B/tsx-rescue.sh"
pr_dd "$TMP/tsx-root.img.gz" 0 $(( (GZB + 1048575) / 1048576 )) "stage copy to RAM" -- if="$S/root.img.gz" bs=1M 2>> "$LOG" \
	|| { unmount; fail "copying root.img.gz to RAM failed"; }
( cd "$B" && sha256sum -c SHA256SUMS > "$RUN/tsx-staged.sums" 2>&1 ) || { grep -v ': OK$' "$RUN/tsx-staged.sums" >> "$LOG"; [ "$FROM" = stick ] || mv "$S" "$S.failed" 2>/dev/null; unmount; fail "the bundle of the stage does not match its SHA256SUMS (on the card it stays as tsx-stage.failed)"; }
[ "$(stat -c %s "$TMP/tsx-root.img.gz")" = "$GZB" ] && [ "$(sha256sum < "$TMP/tsx-root.img.gz" | cut -d' ' -f1)" = "$GZS" ] \
	|| { [ "$FROM" = stick ] || mv "$S" "$S.failed" 2>/dev/null; unmount; fail "root.img.gz of the stage has a wrong size or sha256 (on the card it stays as tsx-stage.failed)"; }
say "stage checked: bundle SHA256SUMS ok, root.img.gz sha256 $GZS"
if [ "$GOLDEN" = stick ]; then
	# The rescue image of the stick (STAGE rescue_sha256) for the p1 slots.
	cp "$S/../tsx-rescue.img" "$TMP/tsx-stick-rescue.img" 2>/dev/null \
		&& [ "$(sha256sum < "$TMP/tsx-stick-rescue.img" | cut -d' ' -f1)" = "$(conf rescue_sha256)" ] \
		|| { unmount; fail "tsx-rescue.img of the stick is missing or has a wrong sha256"; }
fi
if [ "$FROM" = stick ]; then unmount; say "the stage is in RAM. The stick is not changed. From here the install needs no network"
else
	rm -rf "$S" && sync || say "WARNING: could not remove $S from the card"
	unmount
	say "the stage is in RAM and gone from the card. From here the install needs no network"
fi

# ---- 4. the golden slot (a reinstall) -------------------------------------------
if [ "$GOLDEN" = 1 ] && [ -z "${TSX_STAGE_DIR:-}${TSX_STICK_DIR:-}" ]; then
	say "golden slot: p1:boot.img <- the rescue that just booted"
	tsx_golden_update >> "$LOG" 2>&1 || say "WARNING: could not update the golden slot (p1:boot.img). The install goes on"
elif [ "$GOLDEN" = stick ]; then
	# The rescue of the stick goes to the golden slot and to p1:tsxboot.img, as
	# the arm step does. The old p1:boot.img (the Crestron golden image on a
	# stock card) goes to /data/tsx/backup after the install.
	say "p1: boot.img and tsxboot.img <- the rescue of the stick"
	P1D=$(p1_dir) || fail "cannot mount p1"
	[ -f "$P1D/boot.img" ] && ! cmp -s "$P1D/boot.img" "$TMP/tsx-stick-rescue.img" && cp "$P1D/boot.img" "$TMP/tsx-p1-boot.old"
	tsx_p1_rescue "$P1D" "$TMP/tsx-stick-rescue.img" >> "$LOG" 2>&1 || { p1_done; fail "writing the rescue to p1 failed (see the log)"; }
	p1_done
fi

# ---- 5. DSP, PSR and LED bar files from the panel --------------------------------
INST=${TSX_STAGED_INSTALL:-$B/tsx-rescue-install}
step() { sh "$INST" "$@" >> "$LOG" 2>&1; }
printf '%s\n' "staged install: looking for the vendor files" > "$STATUS" 2>/dev/null
case "$TFA_SOURCE" in
auto|panel)
	step tfa "$B" || say "WARNING: tsx-rescue-install tfa failed"
	N=$(sed -n 's/^TFA-RESULT .*count=\([0-9]*\).*/\1/p' "$LOG" | tail -n 1)
	if [ "${N:-0}" = 3 ] || { [ "${N:-0}" -gt 0 ] && { [ "$TFA_SOURCE" = panel ] || [ ! -d "$B/tfa-puf" ]; }; }; then
		rm -rf "$B/tfa"; mv "$B/tfa-panel" "$B/tfa" && say "tfa: the panel set ($N of 3 variants)"
	elif [ "$TFA_SOURCE" = auto ] && [ -d "$B/tfa-puf" ]; then
		rm -rf "$B/tfa"; mv "$B/tfa-puf" "$B/tfa" && say "tfa: the .puf files of the stage (the panel has ${N:-0} of 3 variants)"
	else
		rm -rf "$B/tfa" "$B/tfa-panel"; say "tfa: no DSP files: the speakers run without the vendor tuning (later: installer/steps/tsx-deploy-tfa.sh)"
	fi;;
puf) say "tfa: the .puf files that the host put in the stage";;
*) rm -rf "$B/tfa" "$B/tfa-panel"; say "tfa: none (--tfa-source none)";;
esac
rm -rf "$B/tfa-puf"
case "$PSR_SOURCE" in
auto|panel)
	step psr "$B" || say "WARNING: tsx-rescue-install psr failed"
	if [ ! -f "$B/psr/PSR-CSR8811.psr" ] && ! grep -q '^source=not-needed' "$B/psr/SOURCE" 2>/dev/null; then
		if [ "$PSR_SOURCE" = auto ] && [ -d "$B/psr-puf" ]; then rm -rf "$B/psr"; mv "$B/psr-puf" "$B/psr" && say "psr: the .puf file of the stage"
		else say "psr: no PSR file: Bluetooth loads only its address"; fi
	fi;;
puf) say "psr: the .puf file that the host put in the stage";;
*) rm -rf "$B/psr"; say "psr: none (--psr-source none)";;
esac
rm -rf "$B/psr-puf"
step ledstock "$B" || say "WARNING: tsx-rescue-install ledstock failed (the install goes on)"

# ---- 6. check and run ----------------------------------------------------------------
KEEP_ARG=; [ "$KEEP" = 1 ] && KEEP_ARG=--keep-data
step check "$B" $KEEP_ARG --root-from - || fail "tsx-rescue-install check failed (see the log)"
say "writing the eMMC from root.img.gz in RAM (gunzip on the panel)"
gunzip -c "$TMP/tsx-root.img.gz" | sh "$INST" run "$B" --yes --no-reboot $KEEP_ARG --root-from - >> "$LOG" 2>&1 \
	|| fail "tsx-rescue-install run failed (see the log). The rescue stays up. Run the install command on the host again: it pushes the images over ssh"
grep -q '^WRITE-RESULT name=root .* ok=1$' "$LOG" || fail "no good WRITE-RESULT line for root"
rm -f "$TMP/tsx-root.img.gz"

# ---- 7. the log onto the new tsxdata, then reboot --------------------------------
echo "done" > "$STATE"
if [ "$FROM" = stick ]; then
	if P1D=$(p1_dir); then echo "$STAGE_ID" > "$P1D/tsxstick.done"; p1_done; fi
fi
[ "$FROM" = stick ] || printf '%s\n' "done: the install is complete, the panel reboots into the kiosk" > "$STATUS" 2>/dev/null
say "DONE. The log goes to /data/tsx/install-staged.log"
if [ -z "${TSX_STAGE_DIR:-}${TSX_STICK_DIR:-}" ] && tsx_find_disk 2>/dev/null; then
	D=$RUN/tsx-staged-data; mkdir -p "$D"
	if mount -t ext4 "$P4" "$D" 2>/dev/null; then
		mkdir -p "$D/tsx"
		# The name has the sha256 of the image: the rescue has no clock, and the
		# same image is kept only once.
		if [ -f "$TMP/tsx-p1-boot.old" ]; then
			n=$(sha256sum < "$TMP/tsx-p1-boot.old" | cut -c1-16)
			mkdir -p "$D/tsx/backup" && [ -f "$D/tsx/backup/p1-boot-$n.img" ] || cp "$TMP/tsx-p1-boot.old" "$D/tsx/backup/p1-boot-$n.img"
		fi
		cp "$LOG" "$D/tsx/install-staged.log"; sync; umount "$D"
	fi
fi
rm -f "$PIDF"
[ "$FROM" = stick ] && wait_stick_out "the install is complete. Remove the USB stick: the panel then restarts into the kiosk"
[ "${TSX_NO_REBOOT:-0}" = 1 ] || { sleep "${TSX_STAGED_REBOOT_S:-10}"; sync; reboot -f; }
exit 0
