#!/usr/bin/env bash
# Host: make sure PANEL_IP is stock Android, settled, and answers root over
# the patched Crestron sshd (steps/rootsh). Every install flow needs this
# bootstrap over the network or the UART. It is extracted from
# steps/legacy/tsx-android-to-card (its old steps 2-4), so tsx-install-mainline v2
# (the rescue-first flow) can reuse it. steps/legacy/tsx-android-to-card keeps its
# own copy (see installer/steps/legacy/). Behavior did not change. This is
# a straight extraction.
#
#   steps/tsx-ensure-root PANEL_IP [--uart auto|yes|no] [--sshshell FILE]
#                         [--port N] [--ws-ip IP] [--results FILE] [--dry-run]
#                         [--admin-user USER] [--admin-password PW]
#                         [--mainline-password PW]
#
# On success, `steps/rootsh PANEL_IP id` answers uid=0. Needs the Crestron
# admin user and password (the console and web UI login): --admin-user and
# --admin-password, or TSX_ADMIN_USER and TSX_ADMIN_PW (the drivers give them
# in the environment). An option wins
# over the environment variable. There is no default. A missing value stops
# the script before it contacts the panel.
# --uart auto (the default) uses the UART only if serlog.py runs and
# ../../tools/bench/uc.sh exists. --uart no is network-only. It needs the
# rootsh command in /system/bin/sshShell.sh of the panel, which a panel as
# Crestron ships it does not have. The script cannot add the command without
# the UART. Network-only mode runs steps/crestron-admin at each poll until
# root works (it creates the account, or it checks the console login, and its
# lines show on the screen). It stops at once on a refused login or a refused
# account, and after two polls where the console login works but rootsh gives
# no root shell (the command is missing).
# Test hooks: TSX_ROOT_POLL_S (default 20) is the time between two polls,
# TSX_SETTLE_S (default 720) the time limit of the network-only wait.
set -euo pipefail
HERE=$(cd "$(dirname "$0")" && pwd); INSTALLER=$(cd "$HERE/.." && pwd)
SERIALDIR=$(cd "$INSTALLER/../tools/bench" && pwd 2>/dev/null || echo "$INSTALLER/../tools/bench")
UC="$SERIALDIR/uc.sh"
ROOTSH="$INSTALLER/steps/rootsh"
. "$INSTALLER/lib/tsx-rescue.sh"   # is_crestron_sshd: never try a root/password login on the Crestron sshd
CRESTRONADMIN="$INSTALLER/steps/crestron-admin"
usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d' >&2; }
. "$INSTALLER/lib/tsx-creds.sh"
PANEL= UART_OPT=auto SSHSHELL= PORT=8079 WSIP= RESULTS= DRYRUN=0
while [ $# -gt 0 ]; do case "$1" in
	--uart) UART_OPT=$2; shift 2;; --sshshell) SSHSHELL=$2; shift 2;; --port) PORT=$2; shift 2;;
	--ws-ip) WSIP=$2; shift 2;; --results) RESULTS=$2; shift 2;; --dry-run) DRYRUN=1; shift;;
	-h|--help) usage; exit 0;;
	--*) if tsx_creds_opt "$@"; then shift "$TSX_CREDS_SHIFT"; else echo "unknown option $1" >&2; usage; exit 2; fi;;
	*) [ -z "$PANEL" ] || { echo "extra argument $1" >&2; exit 2; }; PANEL=$1; shift;;
esac; done
[ -n "$PANEL" ] || { usage; exit 2; }
case "$UART_OPT" in auto|yes|no) ;; *) echo "--uart must be auto, yes, or no" >&2; exit 2;; esac
[ "$DRYRUN" = 1 ] || tsx_creds_need_admin 0 || exit 2
[ -n "$RESULTS" ] || RESULTS="results/tsx-ensure-root-$(date +%Y%m%d-%H%M).txt"
mkdir -p "$(dirname "$RESULTS")"
log() { printf '[%s] %s\n' "$(date '+%F %T')" "$*" | tee -a "$RESULTS" >&2; }
die() { log "ERROR: $*"; exit 1; }

case "$UART_OPT" in
yes) UART_MODE=yes;;
no) UART_MODE=no;;
auto) if command -v pgrep >/dev/null 2>&1 && pgrep -f 'serlog\.py' >/dev/null 2>&1 && [ -x "$UC" ]; then UART_MODE=yes; else UART_MODE=no; fi;;
esac
log "== tsx-ensure-root: PANEL=$PANEL uart=$UART_OPT ($UART_MODE)"

# No fixed root password on the installed system: the mainline password if set
# (sshpass -e reads SSHPASS), else the ssh key.
MSSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=8"
if [ -n "${TSX_MAINLINE_PW:-}" ]; then export SSHPASS=$TSX_MAINLINE_PW; MSSH="sshpass -e ssh $MSSH_OPTS root@$PANEL"; else MSSH="ssh -o BatchMode=yes $MSSH_OPTS root@$PANEL"; fi
is_mainline() { local out; is_crestron_sshd "$PANEL" && return 1; out=$($MSSH uname -r 2>/dev/null) || return 1; case "$out" in [6-9].*|[1-9][0-9].*) return 0;; *) return 1;; esac; }
rootsh_ok() { local out; out=$(TSX_SSH_TIMEOUT=30 "$ROOTSH" "$PANEL" id 2>/dev/null) || true; grep -q '^uid=0(' <<<"$out"; }
uart() { local w=5; if [ "$1" = -w ]; then w=$2; shift 2; fi; [ ${#1} -le 80 ] || die "UART command >80 chars: $1"; "$UC" -w "$w" "$1"; }
wait_serial() { local pat=$1 timeout=$2; shift 2; local waited=0 poll=15 out a
	log "  waiting on the serial log for: $pat (timeout ${timeout}s)"
	while [ "$waited" -lt "$timeout" ]; do
		out=$("$UC" -w "$poll" 2>/dev/null || true)
		if [ -n "$out" ]; then for a in "$@"; do grep -qF -- "$a" <<<"$out" && die "serial log abort pattern: $a"; done
			grep -qF -- "$pat" <<<"$out" && { log "  ok: seen '$pat'"; return 0; }; fi
		waited=$((waited + poll)); [ $((waited % 30)) -eq 0 ] && log "  still waiting for '$pat': ${waited}/${timeout}s"
	done
	die "timeout (${timeout}s) waiting for: $pat"
}
wait_android_stable() { local timeout=$1 waited=0 poll=20 fw ls raw bc
	log "  waiting for stock Android to settle (UART, tolerates one self-reboot, timeout ${timeout}s)"
	while :; do
		fw=$(uart -w 5 'fw_printenv fwUpgrade' 2>/dev/null || true)
		ls=$(uart -w 5 'ls /mnt/sdcard/ROMDISK/romdisk/user/system/image' 2>/dev/null || true)
		raw=$(uart -w 5 'getprop sys.boot_completed' 2>/dev/null || true)
		bc=$(printf '%s\n' "$raw" | grep -oE '^[01]$' | tail -n 1)
		if grep -q 'fwUpgrade=0' <<<"$fw" && grep -qi 'no such file' <<<"$ls" && [ "${bc:-}" = 1 ] && grep -qF "root@Crestron Touchpanel:/ #" <<<"$raw"; then
			log "  ok: Android settled"; return 0; fi
		waited=$((waited + poll)); [ "$waited" -lt "$timeout" ] || die "timeout (${timeout}s) waiting for Android to settle"
		sleep "$poll"
	done
}
# admin_console: steps/crestron-admin PANEL. It creates the Crestron account on a
# factory-fresh /data, else it checks the console login once. Its lines go to
# the screen and to the results file. ADMIN_RC gets its exit status (0 login
# works, 1 no answer yet, 3 login refused or host blocked, 4 account refused).
admin_console() {
	local rcf; rcf=$(mktemp)
	{ "$CRESTRONADMIN" --autoupdate-off "$PANEL" 2>&1 && echo 0 > "$rcf" || echo $? > "$rcf"; } | while IFS= read -r l; do log "    $l"; done
	ADMIN_RC=$(cat "$rcf"); rm -f "$rcf"
}
# admin_stop: stop for the exit status of crestron-admin that no later poll can
# change. The sshd counts each failed login, so the script never tries again.
admin_stop() {
	case "$ADMIN_RC" in
	2) die "steps/crestron-admin: a missing login (see above)";;
	3) die "the Crestron sshd refused the login of $TSX_ADMIN_USER, or it blocks this host (see above). Check ADMIN_USER and ADMIN_PASSWORD (or --admin-user and --admin-password). After 3 failed logins the sshd blocks the host for 24 hours, so the installer does not try again";;
	4) die "the panel refused to create the Crestron account (see the answer above). Use another password, for example a longer one";;
	126|127) die "this host cannot start steps/crestron-admin (see above): it needs bash in PATH and python3";;
	esac
}
noroot_msg() { echo "the Crestron console accepts the login of $TSX_ADMIN_USER, but 'ssh -tt $TSX_ADMIN_USER@$PANEL rootsh' gives no root shell: the panel does not have the rootsh method in /system/bin/sshShell.sh (a panel as Crestron ships it does not). A network-only install REQUIRES this method, and the installer does not set it up over the network. Read docs/install.md \"Root over the Crestron sshd\": add the method once over the UART (--uart yes --sshshell FILE). Nothing was changed on the panel except the Crestron account"; }
# crestron_update_msg: what the screen says while Crestron installs its own
# firmware update.
crestron_update_msg() { echo "Crestron is installing a firmware update (its auto update; a restored panel reports \"PUF: Unknown\" and installs the same firmware again). It writes the card and the eMMC and ends with a reboot, about 15 min in total. The installer waits and does not interrupt it. Do not power off the panel"; }
wait_android_stable_net() { local timeout=$1 limit=$1 t0 el poll=${TSX_ROOT_POLL_S:-20} fw ls bc mounted proc zip busy rooted=0 noroot=0 now why= ROMD=/mnt/sdcard/ROMDISK/romdisk/user/system
	log "  waiting for stock Android to settle (network-only, tolerates one self-reboot, timeout ${timeout}s)"
	t0=$(date +%s)
	while :; do
		# In network-only mode every check below needs rootsh, and rootsh needs a
		# Crestron account. A factory-fresh unit has none. Until root works once,
		# each poll first runs crestron-admin: it creates the account, or it
		# checks the console login, and it turns the Crestron auto update off.
		# Only a working console login leads to a rootsh try, so a wrong
		# password costs one failed login, not one per poll.
		now=0 why=
		if [ "$rooted" = 0 ]; then
			log "  Crestron account and console login (steps/crestron-admin)"
			admin_console; admin_stop
			if [ "$ADMIN_RC" = 0 ]; then
				if rootsh_ok; then rooted=1 now=1
				else
					noroot=$((noroot + 1))
					# The same sshd and the same login give the console, but no root
					# shell: the rootsh command is missing. Two tries, a poll apart,
					# rule out a restart of the sshd.
					[ "$noroot" -lt 2 ] || die "$(noroot_msg)"
					log "  the console login works, but rootsh gives no root shell (try $noroot of 2)"
				fi
			else
				noroot=0
				log "  no console login yet (see above). Android may still start: trying again on the next poll"
			fi
		fi
		if [ "$rooted" = 1 ] && { [ "$now" = 1 ] || rootsh_ok; }; then
			fw=$("$ROOTSH" "$PANEL" 'fw_printenv fwUpgrade' 2>/dev/null) || fw=
			ls=$("$ROOTSH" "$PANEL" "ls $ROMD/image" 2>/dev/null) || true
			zip=$("$ROOTSH" "$PANEL" "ls $ROMD | grep -c '^image_.*\\.zip\$'; true" 2>/dev/null | tail -n 1) || zip=
			proc=$("$ROOTSH" "$PANEL" "busybox ps | grep -v grep | grep -c -e crestronLocalUpgrade -e crestronUpgrade; true" 2>/dev/null | tail -n 1) || proc=
			bc=$("$ROOTSH" "$PANEL" 'getprop sys.boot_completed' 2>/dev/null) || bc=
			mounted=$("$ROOTSH" "$PANEL" 'grep -c mmcblk0p5 /proc/mounts' 2>/dev/null) || mounted=
			if grep -q 'fwUpgrade=0' <<<"$fw" && grep -qi 'no such file' <<<"$ls" && [ "${zip:-x}" = 0 ] && [ "${proc:-x}" = 0 ] \
				&& grep -q '^1$' <<<"$bc" && grep -qE '^[1-9][0-9]*$' <<<"$mounted"; then
				log "  ok: Android settled (network-only), no Crestron update staged or running"; return 0; fi
			if ! grep -q 'fwUpgrade=0' <<<"$fw" || [ "${proc:-0}" != 0 ]; then
				# Crestron applies an update now. Never interrupt it: wait longer.
				why="$(crestron_update_msg) (fwUpgrade=${fw#*=}, update script running: ${proc:-?})"
				[ "$limit" -ge "${TSX_CRESTRON_UPDATE_S:-2400}" ] || limit=${TSX_CRESTRON_UPDATE_S:-2400}
			elif ! grep -qi 'no such file' <<<"$ls" || [ "${zip:-0}" != 0 ]; then
				# A downloaded or unpacked update with fwUpgrade=0 and no update
				# script: either a download is still running, or an update that a
				# reboot cut off. Crestron's own update script removes the folder
				# in that case too. Ask the auto update first.
				busy=$("$CRESTRONADMIN" --update-busy "$PANEL" 2>/dev/null) || busy=
				if [ "$busy" = no ]; then
					if "$ROOTSH" "$PANEL" "fw_printenv fwUpgrade | grep -qx fwUpgrade=0 && ! busybox ps | grep -v grep | grep -q -e crestronLocalUpgrade -e crestronUpgrade && busybox rm -rf $ROMD/image $ROMD/image_*.zip && sync && echo CLEARED" 2>/dev/null | grep -q CLEARED; then
						log "  removed a staged Crestron update that no process applies (fwUpgrade=0, auto update idle): $ROMD/image and image_*.zip. The install replaces Android anyway"
						continue
					fi
					why="a staged Crestron update could not be removed"
				else
					why="$(crestron_update_msg) (the auto update reports an update in progress: ${busy:-no answer})"
					[ "$limit" -ge "${TSX_CRESTRON_UPDATE_S:-2400}" ] || limit=${TSX_CRESTRON_UPDATE_S:-2400}
				fi
			else
				grep -q '^1$' <<<"$bc" || why="$why, Android has not finished its boot (sys.boot_completed=${bc:-?})"
				grep -qE '^[1-9][0-9]*$' <<<"$mounted" || why="$why, the sdcard partition p5 is not mounted"
				why=${why#, }
			fi
			[ -z "$why" ] || log "  not settled yet: $why"
		elif [ "$rooted" = 1 ]; then
			why="the panel does not answer root over ssh (a reboot?)"
			log "  not settled yet: $why"
		fi
		el=$(( $(date +%s) - t0 ))
		[ "$el" -lt "$limit" ] || die "timeout (${limit}s) waiting for Android to settle (network-only)${why:+: $why}"
		log "  still waiting (network-only): ${el}/${limit}s"
		sleep "$poll"
	done
}

if [ -z "$WSIP" ]; then WSIP=$(ip route get "$PANEL" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')
	[ -n "$WSIP" ] || die "could not auto-detect the workstation IP towards $PANEL (--ws-ip)"; fi
BASEURL="http://$WSIP:$PORT"

if [ "$DRYRUN" = 1 ]; then
	log "[dry-run] would check is_mainline. If mainline and UART: p1:tsxboot.off + reboot + wait_serial prompt"
	log "[dry-run] would then wait_android_stable(_net) up to 720s, then rootsh_ok. If not root: crestron-admin, then (UART only) install \$SSHSHELL via wget+ish.sh"
	exit 0
fi

if is_mainline && [ "$UART_MODE" = yes ]; then
	log "  panel is on mainline. Forcing p1:tsxboot.off and rebooting to stock Android"
	$MSSH 'mkdir -p /mnt/p1 && mount -t vfat /dev/mmcblk0p1 /mnt/p1 && touch /mnt/p1/tsxboot.off && sync && umount /mnt/p1 && reboot' >>"$RESULTS" 2>&1 || true
	wait_serial "root@Crestron Touchpanel:/ #" 180
elif is_mainline; then
	die "panel $PANEL runs mainline and --uart is not yes: network-only mode cannot force it back to stock Android (needs the UART once)"
fi

if [ "$UART_MODE" = yes ]; then wait_android_stable 720; else wait_android_stable_net "${TSX_SETTLE_S:-720}"; fi

if rootsh_ok; then
	log "== done: rootsh already answers uid=0 on $PANEL"
	exit 0
fi
log "  rootsh is not root yet. Trying crestron-admin (factory-fresh unit may have no account)"
admin_console; admin_stop
[ "$ADMIN_RC" = 0 ] || log "  crestron-admin did not confirm the console login (see above). Continuing"
if rootsh_ok; then log "== done: rootsh now answers uid=0 (account was the only thing missing)"; exit 0; fi

[ "$UART_MODE" = yes ] || die "root over ssh needs the patched sshShell.sh installed already (see docs/install.md). network-only mode cannot install it. Re-run with --uart yes, or install it by hand once."
[ -n "$SSHSHELL" ] && [ -f "$SSHSHELL" ] || die "rootsh is not root and --sshshell FILE was not given: supply your patched sshShell.sh (docs/install.md 'TSX Android root over SSH')"
log "  installing $SSHSHELL from the UART"
OUTDIR=$(cd "$(dirname "$SSHSHELL")" && pwd)
( cd "$OUTDIR" && nohup python3 -m http.server "$PORT" --bind 0.0.0.0 >/dev/null 2>&1 & echo $! > "$OUTDIR/.tsx-ensure-root-http.pid" )
trap '[ -f "$OUTDIR/.tsx-ensure-root-http.pid" ] && kill "$(cat "$OUTDIR/.tsx-ensure-root-http.pid")" 2>/dev/null; rm -f "$OUTDIR/.tsx-ensure-root-http.pid"' EXIT
sleep 1
uart -w 5 "busybox wget -q -O /logs/sshShell.sh $BASEURL/$(basename "$SSHSHELL")"
REMOTESHA=$(uart -w 5 'busybox sha256sum /logs/sshShell.sh' | grep -oE '^[0-9a-f]{64}' | tail -n 1)
LOCALSHA=$(sha256sum "$SSHSHELL" | awk '{print $1}')
[ "$REMOTESHA" = "$LOCALSHA" ] || die "sshShell.sh sha256 mismatch after wget: $REMOTESHA != $LOCALSHA"
INSTSCRIPT="$OUTDIR/ish.sh"
cat >"$INSTSCRIPT" <<-'EOF'
	#!/system/bin/sh
	set -e
	mount -o remount,rw /system
	cp /system/bin/sshShell.sh /logs/sshShell.sh.stock
	cp /logs/sshShell.sh /system/bin/sshShell.sh
	chmod 755 /system/bin/sshShell.sh
	sync
	mount -o remount,ro /system
	echo INSTALL_SSHSHELL_DONE
EOF
uart -w 5 "busybox wget -q -O /logs/ish.sh $BASEURL/ish.sh"
OUT=$(uart -w 8 'busybox sh /logs/ish.sh')
grep -q INSTALL_SSHSHELL_DONE <<<"$OUT" || die "ish.sh (sshShell.sh install) did not report done: $OUT"
rootsh_ok || die "rootsh still does not answer uid=0 after installing sshShell.sh"
log "== done: rootsh now answers uid=0 on $PANEL"
