#!/bin/bash
# Host: run a command as root on a stock-Android xx60 through the Crestron
# sshd. This needs the patched /system/bin/sshShell.sh (out/sshShell.sh: a
# "rootsh" command drops into /system/bin/bash -l). The sshd wants a tty, so it
# echoes the input. The script strips the echo line and the CRs. It prints the
# exit status of the remote command on the last line as "rc=N" and returns it.
# The script sends two "exit" lines. Some patched sshShell.sh variants (e.g. the
# one that the no-UART enabler writes) start /system/bin/sh after the root bash
# returns. The second exit ends that shell. If the session already closed, the
# session never reads it.
#   steps/rootsh HOST 'command ...'   (user $TSX_ADMIN_USER, default admin.
#                                       Password: required, $TSX_ADMIN_PW)
set -uo pipefail
H=${1:?HOST}; C=${2:?command}
U=${TSX_ADMIN_USER:-admin}
PW=${TSX_ADMIN_PW:?set TSX_ADMIN_PW to the Crestron console admin password}
# The command output sits between markers that printf %s builds. So the script
# drops the tty echo of the input (it shows the format strings, not the markers)
# and the bash prompts.
C=${C%"${C##*[![:space:];]}"}; case "$C" in *'&') SEP=' ';; *) SEP='; ';; esac   # "cmd &; x" is a syntax error
out=$(printf '%s\n' "printf '\\n__RS_%s__\\n' BEGIN; $C${SEP}printf '\\n__RS_END=%d__\\n' \$?" exit exit | timeout "${TSX_SSH_TIMEOUT:-900}" sshpass -p "$PW" ssh -tt -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=10 -o LogLevel=ERROR "$U@$H" rootsh 2>/dev/null | tr -d '\r')
printf '%s\n' "$out" | awk '/^__RS_BEGIN__$/ {on=1; n=0; next} on && /^__RS_END=[0-9]+__$/ {exit} on {buf[++n]=$0} END {if (n && buf[n] == "") n--; for (i = 1; i <= n; i++) print buf[i]}'
rc=$(printf '%s\n' "$out" | /bin/grep -a -o '^__RS_END=[0-9]*__$' | tail -n 1 | tr -dc 0-9); exit "${rc:-255}"
