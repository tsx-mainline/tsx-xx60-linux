#!/bin/sh
# Network: use a static address if the kernel cmdline has
# tsx.ip=A.B.C.D/NN[,GW]. Otherwise use DHCP.
# This script runs for every rescue: the initramfs own rescue (/init fallback,
# force-rescue, tsx.rescue) and the standalone rescue image (installer/rescue,
# same BASE).
# It also sets a stable eth0 MAC, as rootfs/overlay/etc/init.d/tsx-setup does.
# Mainline has no MAC source on this board. Without this step, stmmac picks a
# random MAC on each boot and DHCP hands out a new address every time.
# The rescue runs from RAM only, so it does not keep /etc/tsx/eth0.mac.
# If U-Boot has no valid ethaddr, the rescue keeps the random kernel MAC.
hostname tsx-rescue
ip link set lo up
for c in $(cat /proc/cmdline); do case $c in tsx.ip=*) STATIC=${c#tsx.ip=};; esac; done
( n=0; while [ ! -e /sys/class/net/eth0 ] && [ $n -lt 30 ]; do sleep 1; n=$((n+1)); done
  macsrc=random; mac=
  . /usr/local/lib/tsx/board.sh
  n=0; while [ ! -b "$TSX_MAC_DEV" ] && [ $n -lt 10 ]; do sleep 1; n=$((n+1)); done   # the card can probe after eth0
  mac=$(tsx_board_mac_early)
  if [ -n "$mac" ]; then
    ip link set eth0 down 2>/dev/null
    if ip link set dev eth0 address "$mac" 2>/dev/null; then macsrc=$(tsx_board_mac_source); else mac=; fi
  fi
  [ -z "$mac" ] && mac=$(cat /sys/class/net/eth0/address 2>/dev/null)
  echo "$macsrc" > /run/tsx-eth0-mac-src 2>/dev/null
  case $macsrc in
    uboot) echo "tsx-rescue: eth0 MAC $mac (from U-Boot env)" > /dev/kmsg 2>/dev/null;;
    *) echo "tsx-rescue: eth0 MAC $mac (random, no U-Boot env)" > /dev/kmsg 2>/dev/null;;
  esac
  ip link set eth0 up
  if [ -n "${STATIC:-}" ]; then
    ip addr add ${STATIC%%,*} dev eth0
    case $STATIC in *,*) ip route add default via ${STATIC#*,};; esac
  else
    udhcpc -b -i eth0 -s /usr/share/udhcpc/default.script -q -t 20 >/dev/null 2>&1 || udhcpc -b -i eth0 >/dev/null 2>&1
  fi
  echo "eth0: $(ip -4 -o addr show eth0 | awk '{print $4}')" > /dev/kmsg
) &
dropbear -R -E 2>/dev/null
echo "rcS: dropbear started, root password 'tsx'" > /dev/kmsg
