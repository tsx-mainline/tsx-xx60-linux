#!/bin/sh
# tsx-confont: load the console font that suits the LCD. Run it after the text
# console has the screen (`tsx-splash console` bound fbcon to fb0).
#
# The kernel built-in font is the 8x16 VGA font. On the 1280x800 LCD it gives
# 160x50 cells, which are small and hard to read. Its / \ _ glyphs do not
# join, so the figlet banner of the rescue screen falls apart. This script
# picks the largest Terminus bold font that still gives at least 80x25 cells
# on fb0:
#   1280x800 (TSW-1060 / TSS-10)  ter-132b 16x32 -> 80x25
#   1024x600 (TSW-760)            ter-124b 12x24 -> 85x25
#   portrait (the console turned a quarter, fbcon rotate 1/3): 800x1280
#   ter-120b 10x20 -> 80x64. 600x1024 has no font with 80 columns, so the
#   kernel font stays (75x64).
# The fonts are PSF files from the Alpine package font-terminus. The build
# copies them into the initramfs (rootfs/initramfs/mkinitramfs-switchroot.sh).
# The script loads a font with busybox setfont (KDFONTOP) on TTY. The default
# TTY is /dev/tty0, the visible console. The font then stays for the rest of
# the boot, also after switch_root. The script never fails. If it has no
# framebuffer size, no font that fits, or no working setfont, the kernel
# default font stays and the exit code is 0.
#
#   tsx-confont [-n] [TTY]    -n: only print "FONT COLSxROWS" (or "default")
# Env (tests): TSX_SYSFS (default /sys), TSX_CONFONT_DIR (default
# /usr/share/tsx/consolefonts), TSX_SETFONT (default setfont, else busybox setfont).
set -u
SYS=${TSX_SYSFS:-/sys}
DIR=${TSX_CONFONT_DIR:-/usr/share/tsx/consolefonts}
dry=
[ "${1:-}" = -n ] && { dry=1; shift; }
TTY=${1:-/dev/tty0}
say() { [ -n "$dry" ] || echo "tsx-confont: $*" 2>/dev/null > /dev/kmsg; }

# The visible size of fb0 comes from the current mode ("U:1280x800p-0"). If
# there is none, it comes from virtual_size ("1280,800"). Here the fbdev
# emulation virtual size is the visible size.
fb=$SYS/class/graphics/fb0
wh=$(head -n 1 "$fb/modes" 2>/dev/null | sed -n 's/^[^:]*:\([0-9]*\)x\([0-9]*\).*/\1 \2/p')
[ -n "$wh" ] || wh=$(sed -n 's/^\([0-9]*\),\([0-9]*\)$/\1 \2/p' "$fb/virtual_size" 2>/dev/null)
set -- $wh
if [ $# -ne 2 ] || [ "$1" -lt 1 ] || [ "$2" -lt 1 ]; then
	say "no framebuffer size, keeping the default font"
	[ -z "$dry" ] || echo default
	exit 0
fi
W=$1 H=$2
# A console turned a quarter (fbcon rotate 1 or 3: ORIENTATION portrait or
# portrait-flipped, set by /init) swaps width and height. On the 1280x800 LCD
# it is 800x1280 and gets ter-120b 10x20 -> 80x64.
case $(cat "$SYS/class/graphics/fbcon/rotate" 2>/dev/null) in 1|3) W=$2 H=$1;; esac

# List the largest font first: NAME:CELL_WIDTHxCELL_HEIGHT (Terminus bold)
pick=
for f in ter-132b:16x32 ter-128b:14x28 ter-124b:12x24 ter-122b:11x22 ter-120b:10x20 ter-118b:10x18 ter-116b:8x16; do
	name=${f%%:*} cell=${f#*:}
	fw=${cell%x*} fh=${cell#*x}
	cols=$((W / fw)) rows=$((H / fh))
	[ "$cols" -ge 80 ] && [ "$rows" -ge 25 ] || continue
	[ -s "$DIR/$name.psf" ] || continue
	pick=$name; break
done
if [ -z "$pick" ]; then
	say "no font in $DIR gives 80x25 on ${W}x${H}, keeping the default font"
	[ -z "$dry" ] || echo default
	exit 0
fi
if [ -n "$dry" ]; then echo "$pick ${cols}x${rows}"; exit 0; fi

if [ -n "${TSX_SETFONT:-}" ]; then set -- "$TSX_SETFONT"
elif command -v setfont >/dev/null 2>&1; then set -- setfont
else set -- busybox setfont; fi
if "$@" -C "$TTY" "$DIR/$pick.psf" 2>/dev/null; then
	say "$pick on ${W}x${H}: ${cols}x${rows} cells"
else
	say "setfont $pick failed, keeping the default font"
fi
exit 0
