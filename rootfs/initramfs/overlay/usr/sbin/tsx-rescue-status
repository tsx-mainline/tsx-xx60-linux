#!/bin/sh
# tsx-rescue-status: the rescue screen. It shows the Tux and "TSX - LINUX"
# banner, the unit and network facts, and "Press Enter for a rescue shell".
# While an install or restore runs, it also shows what that operation does.
# Both rescues use this screen: the standalone rescue image and the initramfs
# own rescue (force-rescue, tsx.rescue, no usable root). The script draws on
# /dev/tty0 (the panel LCD, through fbcon: docs/recovery.md "The rescue
# screen"). It also mirrors the screen as one line to /dev/kmsg (with a
# kernel timestamp, so it reaches ttyAML0). busybox ash only.
#
#   tsx-rescue-status loop    The inittab entry "tty1::respawn:" runs this mode
#                             and gives it tty1 as stdin and controlling tty.
#                             It redraws when something changed. Each round it
#                             waits at most 2 s for Enter on tty1 (a USB
#                             keyboard). Enter runs a root shell there with no
#                             password, because a person at the panel has
#                             physical access. ssh and the serial console are
#                             unchanged. `exit` returns to the screen.
#   tsx-rescue-status once    prints one frame and exits (scripts/tests)
#
# Reads (never writes, except its own scratch file under $RUN):
#   /run/tsx-install-state    free text: the current step of an install/restore
#                             (installer/steps/tsx-rescue-install, the factory
#                             restore tools). "idle*" and "checked OK*" mean none.
#   /run/tsx-op               "PID NAME" of the running tool (NAME is "install" if absent)
#   /run/tsx-progress         "POS_BYTES OFF_BYTES LEN_BYTES NAME...", written by pr_dd
#                             (installer/lib/tsx-rescue.sh) every ~15 s.
#                             The script ignores it when it is older than 2 min.
#   /run/rescue-reason        why the rescue started. The screen does not show it.
#                             The shell prints it when it opens, and so does
#                             `tsx-rescue status`.
#   /run/tsx-eth0-mac-src     uboot|random (rootfs/initramfs/overlay/etc/init.d/rcS).
#                             Absent: rcS has not set the MAC yet ("starting").
#   /etc/tsx/rescue-version   the version line of the rescue image (absent in the initramfs rescue)
#   the U-Boot env (product_name, ethaddr) through tsx-lib.sh
# Test hooks: TSX_RUN TSX_STATUS_TTY (output) TSX_STATUS_IN (keyboard tty)
# TSX_STATUS_SHELL TSX_STATUS_COLS (default 80) TSX_STATUS_LOOPS (rounds, default endless) TSX_STATUS_WAIT (default 2 s)
set -u
RUN=${TSX_RUN:-/run}
TTY=${TSX_STATUS_TTY:-/dev/tty0}
IN=${TSX_STATUS_IN:-/dev/tty1}
SHELLCMD=${TSX_STATUS_SHELL:-/bin/sh -l}
COLS=${TSX_STATUS_COLS:-80}
WAIT=${TSX_STATUS_WAIT:-2}
VERFILE=${TSX_VERFILE:-/etc/tsx/rescue-version}
. ${TSX_LIB:-/usr/share/tsx/tsx-lib.sh} 2>/dev/null || true

# ---- banner: small enough for an 80x25 console (63 columns). On the LCD the
# console font is Terminus bold sized for the screen (tsx-confont: 16x32 on
# 1280x800 = 80x25, 12x24 on 1024x600 = 85x25). The kernel 8x16 VGA font
# would break the slanted figlet letters. Tux is the classic public-domain
# ASCII penguin. The name is `figlet -f smslant "TSX - LINUX"` (spaces around
# the dash).
splash() {
	cat <<'BANNER'
    .--.
   |o_o |      ___________  __        __   _____  ____  ___  __
   |:_/ |     /_  __/ __/ |/_/ ____  / /  /  _/ |/ / / / / |/_/
  //   \ \     / / _\ \_>  <  /___/ / /___/ //    / /_/ />  <
 (|     | )   /_/ /___/_/|_|       /____/___/_/|_/\____/_/|_|
/'\_   _/`\
\___)=(___/   rescue
BANNER
}

kmsg_line() { echo "tsx-rescue-status: $1" > /dev/kmsg 2>/dev/null || true; }

# Kernel messages go to the serial console and dmesg only, not to this screen.
# The kernel redirects its VT output to VT 12 (busybox setlogcons, which uses
# TIOCL_SETKMSGREDIRECT), and nobody shows VT 12. One open of /dev/tty12
# allocates it. Without this step, every kernel line would scribble over the
# frame.
kmsg_off_lcd() {
	[ "$TTY" = /dev/tty0 ] || return 0
	[ -c /dev/tty12 ] && : < /dev/tty12 2>/dev/null
	setlogcons 12 >/dev/null 2>&1 || true
}

# Load the Terminus console font for the LCD size (see tsx-confont). /init
# already loaded it. This loads it again in case something reset the console.
# It does nothing without the tool.
lcd_font() {
	[ "$TTY" = /dev/tty0 ] || return 0
	[ -x /usr/sbin/tsx-confont ] && /usr/sbin/tsx-confont "$TTY" 2>/dev/null
	return 0
}

# ---- the operation section -------------------------------------------------
# This function sets OP_KIND (none|running|done|failed|stopped), OP_NAME,
# OP_STATE and OP_BAR (the progress line, or empty).
read_op() {
	OP_KIND=none OP_NAME=install OP_STATE= OP_BAR=
	local pid f now mt
	[ -f "$RUN/tsx-install-state" ] || return 0
	OP_STATE=$(head -n 1 "$RUN/tsx-install-state" 2>/dev/null)
	case $OP_STATE in ''|idle*|"checked OK"*) OP_STATE=; return 0;; esac
	pid=
	if [ -f "$RUN/tsx-op" ]; then
		read -r pid OP_NAME < "$RUN/tsx-op" 2>/dev/null || true
		[ -n "$OP_NAME" ] || OP_NAME=install
	fi
	case $OP_STATE in
	failed*|FAILED*|ERROR*) OP_KIND=failed; return 0;;
	done*|DONE*) OP_KIND=done; return 0;;
	esac
	OP_KIND=running
	# If the tool died without a message (killed, ssh session lost), it is not "running".
	if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then OP_KIND=stopped; return 0; fi
	f=$RUN/tsx-progress
	[ -f "$f" ] || return 0
	now=$(date +%s); mt=$(stat -c %Y "$f" 2>/dev/null || echo 0)
	[ $((now - mt)) -le 120 ] || return 0
	# The format is "POS OFF LEN NAME...". The numbers come first because the
	# name can contain spaces.
	OP_BAR=$(awk '$1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ {
		d = ($1 - $2) / 1048576; if (d < 0) d = 0; len = $3 / 1048576
		if (len > 0) {
			if (d > len) d = len
			pct = d * 100 / len; n = int(pct * 40 / 100 + 0.5); bar = ""
			for (i = 0; i < 40; i++) bar = bar (i < n ? "#" : "-")
			printf "[%s] %3.0f%%  %.0f of %.0f MiB", bar, pct, d, len
		} else printf "%.0f MiB written", d
	}' "$f" 2>/dev/null)
}

# ---- one frame (text on stdout) -------------------------------------------
frame_text() {
	local ip method mac macsrc envmac noaddr rver kver pname punit fw model hint
	ip=$(ip -4 -o addr show eth0 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
	case " $(cat /proc/cmdline 2>/dev/null) " in *" tsx.ip="*) method=static;; *) method=dhcp;; esac
	mac=$(cat /sys/class/net/eth0/address 2>/dev/null)
	macsrc=$(cat "$RUN/tsx-eth0-mac-src" 2>/dev/null) || macsrc=
	envmac=
	rver="initramfs rescue (no rescue image)"; [ -f "$VERFILE" ] && rver=$(head -n 1 "$VERFILE")
	kver=$(uname -r 2>/dev/null || echo unknown)

	pname=; punit=
	if type tsx_find_disk >/dev/null 2>&1; then
		if tsx_find_disk 2>/dev/null; then
			# fw_env.config needs a hex offset and size (installer/steps/tsx-rescue-arm.sh says why)
			printf '%s 0x%x 0x%x\n' "$WHOLE" "${TSX_ENV_OFFSET:-1048576}" "${TSX_ENV_SIZE:-65536}" > "$RUN/tsx-status-env.cfg" 2>/dev/null
			FWCFG=$RUN/tsx-status-env.cfg
			tsx_pick_fwenv 2>/dev/null
			pname=$(tsx_env product_name 2>/dev/null || true)
			punit=$(tsx_unit_id 2>/dev/null || true)
			[ -n "$macsrc" ] || envmac=$(tsx_env ethaddr 2>/dev/null || true)
		fi
	fi
	# rcS writes tsx-eth0-mac-src when it has set the MAC. Before that, eth0
	# still has the random MAC of the kernel and has no address yet. The
	# screen then shows the MAC from the U-Boot env (or no MAC) and "starting".
	noaddr="(no address yet)"
	if [ -z "$macsrc" ]; then
		noaddr="(starting)"
		if echo "$envmac" | grep -qiE '^[0-9a-f]{2}(:[0-9a-f]{2}){5}$'; then mac=$envmac macsrc=uboot; else mac=; fi
	fi
	# product_name looks like "TSS-10_[v3.002.1061,_#0A1B2C3D]". It has the
	# model, then the stock firmware version and the tsid. The tsid stays off
	# the screen.
	model=${pname%%_\[*}
	fw=$(echo "$pname" | sed -n 's/^[^[]*\[\(v[0-9][0-9.]*\).*/\1/p')

	splash
	echo "----------------------------------------------------------------"
	echo "model        : ${model:-unknown}${fw:+   stock fw $fw}${punit:+   unit $punit}"
	echo "rescue       : $rver"
	echo "kernel       : $kver"
	echo "network      : eth0 ${ip:-$noaddr} ($method${mac:+, MAC $mac}${macsrc:+, $macsrc})"
	if [ -n "$ip" ]; then echo "repair shell : ssh root@$ip   (password: tsx)"
	else echo "repair shell : ssh root@<ip once DHCP/static assigns one>  (password: tsx)"; fi
	echo "----------------------------------------------------------------"
	case $OP_KIND in
	running)
		echo "$OP_NAME: $OP_STATE"
		[ -n "$OP_BAR" ] && echo "  $OP_BAR"
		echo "DO NOT power off the system."
		echo "----------------------------------------------------------------";;
	stopped)
		echo "$OP_NAME stopped (the tool is no longer running): $OP_STATE"
		echo "----------------------------------------------------------------";;
	failed) echo "$OP_NAME FAILED: $OP_STATE"
		echo "----------------------------------------------------------------";;
	done) echo "$OP_NAME: $OP_STATE"
		echo "----------------------------------------------------------------";;
	esac
	# No power-cycle advice. The result of a power cycle depends on the U-Boot
	# env (one-shot armed or not, eMMC layout or not), and the screen cannot
	# promise it.
	echo "Press Enter for a rescue shell"
}

# Build the frame first. Redraw only when it changed, and without `clear`
# (cursor home, overwrite, clear to end of line), so the LCD never blanks.
# Cut every line to the console width. A line must never wrap.
frame() {
	read_op
	txt=$(frame_text | cut -c1-"$COLS")
	if [ "$txt" != "${LAST_TXT:-}" ]; then
		LAST_TXT=$txt
		{
		printf '\033[?25l\033[H'
		printf '%s\n' "$txt" | awk '{ printf "%s\033[K\n", $0 }'
		printf '\033[J'
		} > "$TTY" 2>/dev/null || true
	fi
	kline="eth0 $(ip -4 -o addr show eth0 2>/dev/null | awk '{print $4}' | cut -d/ -f1) | ${OP_KIND}${OP_STATE:+: $OP_STATE}${OP_BAR:+ -- $OP_BAR}"
	if [ "$kline" != "${LAST_KLINE:-}" ]; then LAST_KLINE=$kline; kmsg_line "$kline"; fi
}

# Enter opens a root shell on the local console. It needs no password, because
# a person at the panel has physical access, and the serial console works the
# same way. `exit` returns to the status screen.
open_shell() {
	local reason
	reason=$(cat "$RUN/rescue-reason" 2>/dev/null || echo "(unknown)")
	{
	printf '\033[2J\033[H\033[?25h'
	echo "Rescue shell on this console (no password). Type 'exit' to return to the screen."
	[ "$OP_KIND" = running ] && echo "WARNING: $OP_NAME is running ($OP_STATE). DO NOT power off the system."
	echo "Why this rescue: $reason"
	echo
	} > "$TTY" 2>/dev/null
	$SHELLCMD
	# A shell can leave the terminal in any state.
	stty -F "$IN" sane -echo 2>/dev/null
	printf '\033[2J' > "$TTY" 2>/dev/null
	LAST_TXT=
}

# Wait up to 2 s for Enter on the keyboard tty. The screen does not echo typed
# text. Any text followed by Enter counts. Return 0 when the user pressed Enter.
wait_key() {
	local rc junk
	read -r -t "$WAIT" junk < "$IN" 2>/dev/null; rc=$?
	[ $rc -eq 0 ] && return 0
	# A code of 129 or more is the timeout. Any other code (no such tty, end
	# of input) returned at once. Still wait, so the loop does not spin.
	[ $rc -gt 128 ] || sleep "$WAIT"
	return 1
}

case "${1:-loop}" in
once) printf '\033[2J' > "$TTY" 2>/dev/null; frame;;
loop)
	kmsg_off_lcd; lcd_font
	stty -F "$IN" -echo 2>/dev/null
	printf '\033[2J' > "$TTY" 2>/dev/null
	n=0
	while :; do
		frame
		n=$((n + 1)); [ "$n" -ge "${TSX_STATUS_LOOPS:-0}" ] && [ "${TSX_STATUS_LOOPS:-0}" -gt 0 ] && break
		wait_key && open_shell
	done;;
*) echo "usage: tsx-rescue-status once|loop" >&2; exit 2;;
esac
