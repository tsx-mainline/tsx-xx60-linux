#!/bin/sh
# tsx-autoinstall: stage 2 of the UART-free install. Runs in the mainline
# switch_root initramfs (busybox ash), called by /init BEFORE the root search:
#
#   /usr/sbin/tsx-autoinstall || rescue "tsx-autoinstall failed"
#
# Exit 0 = nothing to do (normal boot goes on). On a successful install it
# reboots and does not return. Exit 1 = an install was requested but failed
# (or waits for deploy.sh): /init drops to the rescue system (DHCP, dropbear
# root/tsx), the reason is on the screen and in /run/tsx-autoinstall.log.
#
# Triggers (anything else, e.g. a random USB stick, is ignored):
#   p1:tsxinst.cfg          written by tsx-android-install.sh (stage 1 on stock Android)
#   stick tsx-install/GO    hands-off (re)install on a unit that already boots mainline:
#                           plug the stick, power-cycle (GO is renamed after the install)
#   U-Boot jabil boot       the image was booted from the stick by the stock jabil_factory
#                           hook (cmdline has androidboot.selinux=permissive); only if
#                           U-Boot USB works on the unit (REPORT.md section 1)
#
# Uses /usr/share/tsx/{install.sh,tsx-disk.sh} (unchanged) and tsx-lib.sh.
# Test hooks: TSX_SYSBLOCK TSX_DEVDIR TSX_STICK (stick root, skips USB detection)
#             TSX_USB_SYSFS (fake /sys/bus/usb/devices) TSX_USB_WAIT TSX_STICK_WAIT
#             TSX_SHARE TSX_NO_REBOOT=1 TSX_CMDLINE TSX_DT_MODEL TSX_RUN
SHARE=${TSX_SHARE:-/usr/share/tsx}
. "$SHARE/tsx-lib.sh"
RUN=${TSX_RUN:-/run}; mkdir -p "$RUN"
LOG=$RUN/tsx-autoinstall.log
P1M=$RUN/tsx-p1 STM=$RUN/tsx-stick
CMDLINE=$(cat "${TSX_CMDLINE:-/proc/cmdline}" 2>/dev/null)
msg() {
	echo "tsx-autoinstall: $*" >> "$LOG"
	if [ -n "${TSX_NO_REBOOT:-}" ]; then echo "tsx-autoinstall: $*" >&2; return 0; fi
	echo "tsx-autoinstall: $*" > /dev/kmsg 2>/dev/null
	echo "tsx-autoinstall: $*" > /dev/tty0 2>/dev/null
	return 0
}
up() { cut -d. -f1 /proc/uptime; }

# the SD card normally shows up ~1.3 s before /init runs (mmcblk0 at 1.56 s,
# /init at 2.84 s on the TSW-1060); wait up to TSX_DISK_WAIT s in case the
# MMC probe is late, so a pending p1:tsxinst.cfg is never skipped silently
end=$(( $(up) + ${TSX_DISK_WAIT:-5} ))
until tsx_find_disk; do
	[ "$(up)" -ge "$end" ] && exit 0         # not a xx60 disk layout: nothing to do
	sleep 0.25
done
FWP=$(command -v fw_printenv); FWS=$(command -v fw_setenv)
FWCFG=$RUN/tsx-fw_env.config
echo "$WHOLE 0x100000 0x10000" > "$FWCFG"

mkdir -p "$P1M" "$STM"
mount -t vfat -o ro "$P1" "$P1M" 2>/dev/null || exit 0

# ---------------------------------------------------------------- card stage: /data setup (p4 = tsxdata)
# p2 = kiosk rootfs, p4 = one primary partition over the old extended area. The
# Android installer leaves p1:tsxlayout.cfg (MKDATA=p4): format p4 as tsxdata
# ONCE, then rename the order. No order = never format. Nothing else runs here.
if [ "$TSX_DISK_LAYOUT" = card ]; then
	if [ -f "$P1M/tsxlayout.cfg" ] && [ "$(tsx_conf MKDATA "$P1M/tsxlayout.cfg")" = p4 ]; then
		WANT_UUID=$(tsx_conf MKDATA_UUID "$P1M/tsxlayout.cfg")
		umount "$P1M"
		# The label alone is not proof p4 already holds THIS order's tsxdata: a
		# previous conversion's ext4 superblock can survive a factory restore
		# at the start of what is now p4 (the restore only rewrites the EBR
		# sector and p5..p8 inside the old extended area, not the sector before
		# it), so blkid still finds LABEL=tsxdata there while the filesystem is
		# actually stale/corrupt for THIS card. MKDATA_UUID (written fresh by
		# the installer for every conversion) tells the two apart; mkfs writes
		# it with -U so the check is exact next time. Older orders with no
		# MKDATA_UUID fall back to label + e2fsck -fn (both present in this
		# initramfs: package list in mkinitramfs-switchroot.sh).
		FORMAT=1
		if [ -n "$WANT_UUID" ]; then
			GOT_UUID=$(blkid -s UUID -o value "$P4" 2>/dev/null)
			if [ "$GOT_UUID" = "$WANT_UUID" ]; then
				FORMAT=0
				msg "card stage: p4 UUID ($GOT_UUID) matches the MKDATA_UUID in this order, not formatted again"
			else
				msg "card stage: p4 UUID ($GOT_UUID) does not match the MKDATA_UUID in this order ($WANT_UUID): formatting"
			fi
		else
			LBL=$(blkid -s LABEL -o value "$P4" 2>/dev/null)
			# Accept the pre-rename label (tswdata) too: a card converted by an older
			# build of this installer (before the tsw->tsx rename) still carries it
			# on disk, and treating it as valid here avoids wiping real /data just
			# because the label string changed.
			if { [ "$LBL" = tsxdata ] || [ "$LBL" = tswdata ]; } && e2fsck -fn "$P4" >> "$LOG" 2>&1; then
				FORMAT=0
				msg "card stage: no MKDATA_UUID in this order (older installer); p4 label=$LBL and e2fsck -fn clean, not formatted again"
			else
				msg "card stage: no MKDATA_UUID in this order (older installer); p4 label=$LBL or e2fsck -fn failed: formatting"
			fi
		fi
		if [ $FORMAT = 1 ]; then
			msg "card stage: formatting p4 ($P4) as ext4 tsxdata (ordered by p1:tsxlayout.cfg)"
			if [ -n "$WANT_UUID" ]; then
				mkfs.ext4 -F -q -O ^metadata_csum_seed,^orphan_file -L tsxdata -m 1 -U "$WANT_UUID" "$P4" >> "$LOG" 2>&1 || { msg "mkfs of p4 failed (see $LOG); the kiosk boots without /data"; exit 0; }
			else
				mkfs.ext4 -F -q -O ^metadata_csum_seed,^orphan_file -L tsxdata -m 1 "$P4" >> "$LOG" 2>&1 || { msg "mkfs of p4 failed (see $LOG); the kiosk boots without /data"; exit 0; }
			fi
		fi
		mount -t vfat -o rw "$P1" "$P1M" && { mv -f "$P1M/tsxlayout.cfg" "$P1M/tsxlayout.done"; sync; umount "$P1M"; }
		exit 0
	fi
	umount "$P1M"; exit 0
fi
TRIG=; CFG=
[ -f "$P1M/tsxinst.cfg" ] && { TRIG=p1cfg; cp "$P1M/tsxinst.cfg" "$RUN/tsxinst.cfg"; CFG=$RUN/tsxinst.cfg; }
case " $CMDLINE " in *" androidboot.selinux=permissive "*) TRIG=${TRIG:-jabil};; esac
umount "$P1M"

SOURCE=usb
[ -n "$CFG" ] && SOURCE=$(tsx_conf SOURCE "$CFG")

p5_label() { blkid "$P5" 2>/dev/null | sed -n 's/.* LABEL="\([^"]*\)".*/\1/p'; }
p1_rename() {   # p1_rename FROM TO (mount p1 rw for a moment)
	mount -t vfat -o rw "$P1" "$P1M" && { mv -f "$P1M/$1" "$P1M/$2" 2>/dev/null; sync; umount "$P1M"; }
}

if [ "$SOURCE" = net ]; then
	if [ "$(p5_label)" = tsxroot ]; then
		msg "p1:tsxinst.cfg SOURCE=net and p5 holds tsxroot: install finished by deploy.sh"
		p1_rename tsxinst.cfg tsxinst.done; exit 0
	fi
	msg "SOURCE=net: staying in the rescue system; run work/rootfs/deploy.sh <ip> from the host"
	exit 1
fi

# ---------------------------------------------------------------- find the stick
USB=${TSX_USB_SYSFS:-/sys/bus/usb/devices}
has_msc() { grep -qx 08 "$USB"/*/bInterfaceClass 2>/dev/null; }
# The panel has ONE external USB-A socket (usb 1-1). If the Crestron LED bar
# (14be:001b) is what enumerated there and no hub is in between, no stick can be
# plugged in: stop waiting at once. Otherwise (nothing yet, or something else)
# wait for a mass-storage interface, at most TSX_USB_WAIT s (default 3; USB
# devices enumerate ~1.2 s after /init on the TSW-1060).
ledbar_only() {
	local d bar=0
	for d in "$USB"/[0-9]*-*; do
		case "${d##*/}" in *:*) continue;; esac
		[ -e "$d/idVendor" ] || continue
		[ "$(cat "$d/bDeviceClass" 2>/dev/null)" = 09 ] && return 1
		[ "$(cat "$d/idVendor"):$(cat "$d/idProduct" 2>/dev/null)" = 14be:001b ] && bar=1
	done
	[ $bar = 1 ]
}
STICK=
if [ -n "${TSX_STICK:-}" ]; then STICK=$TSX_STICK
else
	if [ -z "$TRIG" ]; then
		# no pending order: look for a stick only if a USB mass-storage
		# interface shows up (the LED bar is vendor class 0xff and is ignored)
		t0=$(cut -d' ' -f1 /proc/uptime)
		end=$(( $(up) + ${TSX_USB_WAIT:-3} ))
		while ! has_msc && [ "$(up)" -lt "$end" ]; do
			ledbar_only && { echo "usb wait: LED bar in the socket, no stick possible (from ${t0} s to $(cut -d' ' -f1 /proc/uptime) s)" >> "$LOG"; exit 0; }
			sleep 0.25
		done
		has_msc || { echo "usb wait: no mass storage (from ${t0} s to $(cut -d' ' -f1 /proc/uptime) s)" >> "$LOG"; exit 0; }
		echo "usb wait: mass storage seen at $(cut -d' ' -f1 /proc/uptime) s, looking for tsx-install/GO" >> "$LOG"
	fi
	end=$(( $(up) + ${TSX_STICK_WAIT:-20} ))
	while [ -z "$STICK" ] && [ "$(up)" -lt "$end" ]; do
		for b in /sys/block/sd*; do
			[ -e "$b" ] || continue
			n=${b##*/}
			for dev in /dev/${n}1 /dev/$n; do
				[ -b "$dev" ] || continue
				mount -t vfat -o ro "$dev" "$STM" 2>/dev/null || continue
				if [ -f "$STM/tsx-install/tsx-install.conf" ]; then STICK=$STM; STICKDEV=$dev; break 2; fi
				umount "$STM"
			done
		done
		[ -n "$STICK" ] || sleep 1
	done
fi
if [ -z "$STICK" ]; then
	[ -z "$TRIG" ] && exit 0
	msg "install requested ($TRIG) but no USB stick with tsx-install/tsx-install.conf found (is the LED bar in the socket instead of the stick?)"
	exit 1
fi
if [ -z "$TRIG" ]; then
	if [ -f "$STICK/tsx-install/GO" ]; then TRIG=stick-go
	else [ -z "${TSX_STICK:-}" ] && umount "$STM"; exit 0; fi
fi
if [ -z "${TSX_STICK:-}" ]; then mount -o remount,rw "$STICK" || { msg "cannot remount the stick rw"; exit 1; }; fi

CONF=$STICK/tsx-install/tsx-install.conf
fail() {
	msg "FAILED: $*"
	[ "$TRIG" = p1cfg ] && p1_rename tsxinst.cfg tsxinst.failed
	mkdir -p "$STICK/tsx-install/log" && cp "$LOG" "$STICK/tsx-install/log/${UNIT:-unit}-$(date +%Y%m%d-%H%M%S)-autoinstall-FAILED.log" 2>/dev/null
	sync
	msg "the panel stays in the rescue system (ssh root@<ip>, password tsx). After 5 boots without success U-Boot boots stock Android."
	exit 1
}

msg "install requested ($TRIG), stick $STICK ($(tsx_conf VERSION "$CONF"))"

# ---------------------------------------------------------------- checks
ENVOK=0; tsx_env_sane >/dev/null 2>&1 && ENVOK=1
MODEL=$(tsx_model 2>/dev/null) || MODEL=
DTM=${TSX_DT_MODEL:-$(tr -d '\000' < /proc/device-tree/model 2>/dev/null)}
case "$DTM" in *TSW-1060*) DTMODEL=tsw1060;; *TSW-760*) DTMODEL=tsw760;; *) DTMODEL=;; esac
[ -n "$MODEL" ] || MODEL=$DTMODEL
[ -n "$MODEL" ] || fail "unknown panel model (env lcdsize/aml_dt/product_name, DT model '$DTM')"
[ -z "$DTMODEL" ] || [ "$DTMODEL" = "$MODEL" ] || fail "env says $MODEL but the running kernel's DT is '$DTM'"
UNIT=$(tsx_unit_id 2>/dev/null); [ -n "$UNIT" ] || UNIT=unknown
BOOTIMG=$(tsx_conf "BOOTIMG_$MODEL" "$CONF"); [ -n "$BOOTIMG" ] || fail "tsx-install.conf has no BOOTIMG_$MODEL"
ROOTFS=$(tsx_conf ROOTFS "$CONF"); RSHA=$(tsx_conf ROOTFS_SHA256 "$CONF")
[ -f "$STICK/$ROOTFS" ] && [ -n "$RSHA" ] || fail "no ROOTFS / ROOTFS_SHA256 in tsx-install.conf"
[ -f "$STICK/$BOOTIMG" ] || fail "no $BOOTIMG on the stick"
msg "model $MODEL, unit $UNIT, env $( [ $ENVOK = 1 ] && echo ok || echo 'NOT sane (hook not touched)')"

msg "checking the stick payload (sha256, about a minute)"
(cd "$STICK" && sha256sum -c tsx-install/SHA256SUMS > "$RUN/sums.txt" 2>&1) || fail "stick payload corrupt: $(grep -v ': OK$' "$RUN/sums.txt" | head -n 3 | tr '\n' ' ')"
BSHA=$(sha256sum < "$STICK/$BOOTIMG" | cut -d' ' -f1)

# ---------------------------------------------------------------- backups (read only so far)
TS=$(date +%Y%m%d-%H%M%S)
BK=$STICK/tsx-install/backup/$UNIT-$TS-mainline
mkdir -p "$BK" || fail "cannot write to the stick"
dd if="$WHOLE" bs=65536 skip=16 count=1 of="$BK/env-0x100000.bin" 2>/dev/null
dd if="$WHOLE" bs=1048576 count=2 of="$BK/disk-head-2M.bin" 2>/dev/null
dd if="$P5" bs=1048576 count=1 of="$BK/p5-head-1M.bin" 2>/dev/null
[ $ENVOK = 1 ] && "$FWP" -c "$FWCFG" > "$BK/fw_printenv.txt" 2>&1
blkid "$P5" > "$BK/p5-blkid.txt" 2>&1
(cd "$BK" && sha256sum * > SHA256SUMS) && sync
P5SHA=$(sha256sum < "$BK/p5-head-1M.bin" | cut -d' ' -f1)
msg "backups: $BK"

# ---------------------------------------------------------------- install (install.sh)
set -- --rootfs "$STICK/$ROOTFS" --sha256 "$RSHA" --p5-backup-sha256 "$P5SHA" --bootimg "$STICK/$BOOTIMG" --bootimg-sha256 "$BSHA"
U=$(tsx_conf KIOSK_URL "$CONF"); [ -n "$U" ] && set -- "$@" --url "$U"
T=$(tsx_conf TOKEN_FILE "$CONF"); [ -n "$T" ] && [ -f "$STICK/tsx-install/$T" ] && set -- "$@" --token-file "$STICK/tsx-install/$T"
[ "$(tsx_conf FORCE_FS "$CONF")" = 1 ] && set -- "$@" --force-fs
msg "writing p5 (mkfs.ext4 + rootfs, ~3 min) and p1:tsxboot.img"
TSX_DISK_GLOB=${TSX_SYSBLOCK:-/sys/block/$DISK} sh "$SHARE/install.sh" install "$@" >> "$LOG" 2>&1 || fail "install.sh failed (see log)"
msg "rootfs installed"

# ---------------------------------------------------------------- U-Boot env hook (idempotent)
if [ $ENVOK = 1 ]; then
	GUARD=$(tsx_conf GUARD "$CONF"); [ -n "$GUARD" ] || GUARD=fallback
	case "$GUARD" in nogolden) WANT=$TSX_SWITCH_NOGOLDEN;; *) WANT=$TSX_SWITCH_FALLBACK;; esac
	st=$(tsx_hook_state)
	case "$st" in
	stock|fallback|nogolden|plain)
		[ "$(tsx_env tsx_boot 2>/dev/null)" = "$TSX_BOOT_CMD" ] || "$FWS" -c "$FWCFG" tsx_boot "$TSX_BOOT_CMD"
		[ "$st" = "$GUARD" ] || "$FWS" -c "$FWCFG" switch_bootmode "$WANT"
		"$FWS" -c "$FWCFG" boot_retry 0
		# on by default (keeps DataRecoveryDone=1 so the golden image does not format
		# p5 / wipe /data); only DEFUSE_GOLDEN=0 in the stick's tsx-install.conf turns it off
		[ "$(tsx_conf DEFUSE_GOLDEN "$CONF")" != 0 ] && [ "$(tsx_env DataRecoveryDone 2>/dev/null)" != 1 ] && "$FWS" -c "$FWCFG" DataRecoveryDone 1
		tsx_env_sane >/dev/null 2>&1 && [ "$(tsx_env switch_bootmode)" = "$WANT" ] || fail "env hook readback failed; env backup: $BK/env-0x100000.bin"
		msg "U-Boot hook: $GUARD";;
	*) msg "WARNING: switch_bootmode has foreign content, hook not installed";;
	esac
else
	msg "WARNING: env not sane, U-Boot hook not installed (booted via jabil only?)"
fi

# ---------------------------------------------------------------- consume the triggers
[ "$TRIG" = p1cfg ] && p1_rename tsxinst.cfg tsxinst.done
[ -f "$STICK/tsx-install/GO" ] && mv "$STICK/tsx-install/GO" "$STICK/tsx-install/GO.done-$UNIT-$TS"
[ "$TRIG" = jabil ] && [ -f "$STICK/jabil.txt" ] && mv "$STICK/jabil.txt" "$STICK/jabil.txt.done"
mkdir -p "$STICK/tsx-install/log"; cp "$LOG" "$STICK/tsx-install/log/$UNIT-$TS-autoinstall.log"
sync
msg "DONE ($UNIT). Rebooting into the kiosk. The stick can stay or go."
[ -z "${TSX_STICK:-}" ] && umount "$STM"
[ -n "${TSX_NO_REBOOT:-}" ] && exit 0
sleep 3; reboot -f
