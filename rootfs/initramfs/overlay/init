#!/bin/sh
# PID 1 of the xx60 switch_root initramfs.
# It mounts the kiosk rootfs (default LABEL=tsxroot) and switch_roots into it.
# It falls back to the rescue system (busybox init, DHCP, dropbear, root/tsx)
# when the rootfs is missing or broken, or when the user asks for rescue.
#
# Kernel cmdline:  tsx.root=LABEL=x|UUID=x|PARTUUID=x|/dev/x
#                  Default: try LABEL=tsxroot-emmc first, then LABEL=tsxroot.
#                  A candidate must mount and have an init. A stale label left
#                  on the eMMC by an earlier install then falls through to the
#                  card and does not drop to rescue.
#                  tsx.rootwait=SECONDS (default 10)   tsx.rescue   tsx.init=/sbin/init
#                  tsx.verbose (boot text on the LCD instead of the splash)
# Rootfs files:    /etc/tsx/force-rescue on the rootfs boots the rescue system
#                  once. The init removes the file, so the next boot is normal.
#                  /etc/tsx/boot-verbose (panel.conf BOOT_VERBOSE=1, tsx-config
#                  apply) acts like tsx.verbose from the root mount on.
#                  /etc/tsx/orientation (panel.conf ORIENTATION) turns the splash
#                  and the text console from the root mount on. Before that
#                  they are landscape. The rescue is always landscape.
# Screen: the kernel keeps the text console off the LCD (fbcon=map:1 on the
# command line). tsx-splash draws the boot splash on /dev/fb0. Every way into
# the rescue system, and BOOT_VERBOSE, first gives the screen back to the text
# console. tsx-splash console does this, then tsx-confont loads a console font
# that suits the LCD size. A failure never hides behind the splash.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null
mkdir -p /dev/pts /run /tmp /newroot; mount -t devpts devpts /dev/pts

msg() { echo "tsx-initramfs: $*" > /dev/kmsg 2>/dev/null; echo "tsx-initramfs: $*" > /dev/tty0 2>/dev/null; }
verbose=
# Screen orientation. It stays landscape until the root file system is
# mounted, because the orientation file lives there. tsx-orientation holds the table.
orient=landscape fbrot=0
# The splash needs the real display driver. Until the meson DRM driver
# probes, fb0 is simpledrm on the U-Boot framebuffer. The probe can happen
# a moment after /init starts. When it does, the driver switches the U-Boot
# plane off, and the console bound to the simpledrm fb0 does not follow.
# Wait for the driver for 2 s at most. The U-Boot logo stays up meanwhile.
wait_drm_fb() {
	i=0
	while [ $i -lt 40 ]; do
		case $(cat /sys/class/graphics/fb0/name 2>/dev/null) in ''|*simple*) usleep 50000; i=$((i + 1));; *) return 0;; esac
	done
}
# The text console also binds to fb0. It binds to the DRM driver fb0, not the
# simpledrm one. This function turns the console to the orientation (fbcon
# rotate_all needs a bound console). Then tsx-confont sets a Terminus font
# sized for the LCD (80x25 or more).
text_console() {
	verbose=1; wait_drm_fb; /usr/sbin/tsx-splash console 2>/dev/null
	echo "$fbrot" > /sys/class/graphics/fbcon/rotate_all 2>/dev/null
	/usr/sbin/tsx-confont 2>/dev/null
}
# splash TEXT PERCENT [show]: draw a status line and a progress bar. It does
# nothing in verbose mode.
splash() { [ -n "$verbose" ] || /usr/sbin/tsx-splash -o "$orient" -s "$1" -p "$2" "${3:-status}" 2>/dev/null; }
# The rescue system is busybox init (etc/inittab). rcS starts the network and
# dropbear. The LCD shows the rescue screen /usr/sbin/tsx-rescue-status, with
# "Press Enter for a rescue shell" for a USB keyboard. Every way into the
# rescue shows the same screen, also the standalone rescue image.
rescue() {
	fbrot=0   # the rescue screen is always landscape
	text_console
	msg "RESCUE: $*"
	echo "$*" > /run/rescue-reason
	mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
	exec /sbin/init
}

root=; wait=10; init=/sbin/init; want_rescue=
for c in $(cat /proc/cmdline); do
	case $c in
	tsx.root=*) root=${c#tsx.root=};;
	tsx.rootwait=*) wait=${c#tsx.rootwait=};;
	tsx.init=*) init=${c#tsx.init=};;
	tsx.rescue|tsx.rescue=1) want_rescue=1;;
	tsx.verbose|tsx.verbose=1) verbose=1;;
	esac
done
[ -n "$want_rescue" ] && rescue "requested on the kernel command line"
# The rescue image itself carries this flag (installer/rescue/overlay). Both
# p1:boot.img and p1:tsxboot.img therefore have it. p1:boot.img is the
# golden/factory-recovery slot, which U-Boot boots after boot_retry
# overflows. p1:tsxboot.img is the one-shot installer hook target, which
# U-Boot boots on a normal, expected installer boot. From here, nothing on
# this side of U-Boot can tell which of the two happened. The reason stays
# generic and does not claim "golden-slot". That claim was wrong on a plain
# installer-armed boot (see the 2026-09-27 hardware run notes). This path
# never switch_roots, never runs tsx-autoinstall and never formats anything.
# See /usr/sbin/tsx-rescue.
# TODO: installer/steps/tsx-rescue-arm.sh will get a one-shot tsx_once env
# flag (separate change, in flight). When it exists, read and clear it here
# (or in the rescue rcS). Then the message can say "installer arm", "golden
# fallback" or "manual" instead of this generic text.
[ -e /etc/tsx/rescue-image ] && rescue "$(head -n 1 /etc/tsx/rescue-image)"
if [ -n "$verbose" ]; then text_console; else wait_drm_fb; splash "starting" 5 show; fi

# Installer: an install without a UART. The trigger is p1:tsxinst.cfg from
# stock Android, a stick with tsx-install/GO, or a U-Boot jabil boot from a
# stick. Exit code 0 means there is nothing to do.
if [ -x /usr/sbin/tsx-autoinstall ]; then
	/usr/sbin/tsx-autoinstall || {
		# The rescue screen shows this as the operation that went wrong.
		echo "- autoinstall" > /run/tsx-op; echo "failed, see /run/tsx-autoinstall.log" > /run/tsx-install-state
		rescue "tsx-autoinstall: install failed or waits for deploy.sh, see /run/tsx-autoinstall.log"
	}
fi

up() { cut -d. -f1 /proc/uptime; }

# find_dev SPEC TIMEOUT: print the backing device for SPEC (LABEL=x, UUID=x,
# PARTUUID=x or /dev/x) when it appears. Wait up to TIMEOUT seconds.
# Return 1 if the device never appears.
find_dev() {
	spec=$1; to=$2
	end=$(( $(up) + to ))
	while :; do
		case $spec in
		/dev/*) [ -b "$spec" ] && { echo "$spec"; return 0; };;
		*) d=$(findfs "$spec" 2>/dev/null); [ -n "$d" ] && { echo "$d"; return 0; };;
		esac
		[ "$(up)" -ge "$end" ] && return 1
		sleep 0.25
	done
}

# eMMC-root fallback (2026-09-26): without tsx.root=, try the eMMC root
# (LABEL=tsxroot-emmc) first, then the card (LABEL=tsxroot).
# Root-selection fix (2026-09-27): the init tries each candidate in turn and
# uses it only if it mounts and has an init. An earlier install can leave a
# stale tsxroot-emmc superblock behind (the file system is since overwritten).
# That case must fall through to the card and must not drop to rescue.
# A tsx.root= on the cmdline is a single explicit candidate with no fallback.
if [ -n "$root" ]; then candidates=$root; else candidates="LABEL=tsxroot-emmc LABEL=tsxroot"; fi

set -- $candidates; nleft=$#
dev=; used=
for cand in $candidates; do
	nleft=$((nleft - 1))
	# Every candidate but the last gets the old 3 s grace wait. That is enough
	# to tell a slow label from an absent one. The last candidate gets the
	# full tsx.rootwait= timeout, as before this fix.
	if [ "$nleft" -gt 0 ]; then t=3; else t=$wait; fi
	d=$(find_dev "$cand" "$t") || { msg "$cand unusable (not found within ${t}s), trying next"; continue; }

	msg "root $cand is $d, checking"
	splash "checking the root file system" 10
	e2fsck -p "$d" > /run/fsck.log 2>&1; rc=$?
	if [ $rc -ge 4 ]; then
		e2fsck -y "$d" >> /run/fsck.log 2>&1; rc=$?
		if [ $rc -ge 4 ]; then
			msg "$cand on $d unusable (fsck failed, code $rc), trying next"
			continue
		fi
	fi
	[ $((rc & 2)) -ne 0 ] && { msg "fsck changed $d, rebooting"; sync; reboot -f; }

	if ! mount -t ext4 -o rw,noatime "$d" /newroot; then
		msg "$cand on $d unusable (mount failed), trying next"
		continue
	fi
	# ORIENTATION: from here on, the splash turns (its next status redraws the
	# whole frame turned). The text console turns now if it has the screen.
	if [ -x /usr/sbin/tsx-orientation ]; then
		eval "$(/usr/sbin/tsx-orientation -f /newroot/etc/tsx/orientation info 2>/dev/null)"
		if [ "${ORIENTATION:-landscape}" != "$orient" ]; then
			orient=$ORIENTATION fbrot=$FBCON_ROTATE
			msg "orientation $orient"
			[ -n "$verbose" ] && text_console
		fi
	fi
	[ -e /newroot/etc/tsx/boot-verbose ] && [ -z "$verbose" ] && text_console
	if [ -e /newroot/etc/tsx/force-rescue ]; then
		rm -f /newroot/etc/tsx/force-rescue; umount /newroot
		rescue "/etc/tsx/force-rescue was set on the rootfs ($cand on $d)"
	fi
	if [ ! -x "/newroot$init" ] && [ ! -L "/newroot$init" ]; then
		umount /newroot
		msg "$cand on $d unusable (no $init), trying next"
		continue
	fi
	dev=$d; used=$cand
	break
done
[ -n "$dev" ] || rescue "no usable root found among: $candidates"
cp /run/fsck.log /newroot/var/log/initramfs-fsck.log 2>/dev/null

msg "switch_root ($used) to $dev"
splash "starting the system" 15
umount /dev/pts 2>/dev/null
for m in /dev /proc /sys; do mkdir -p /newroot$m; mount --move $m /newroot$m; done
exec switch_root /newroot "$init"
