#!/bin/sh
# PID 1 of the xx60 switch_root initramfs .
# Mounts the kiosk rootfs (default LABEL=tsxroot) and switch_roots into it.
# Falls back to the rescue system (busybox init, DHCP, dropbear, root/tsx)
# when the rootfs is missing, broken, or rescue is requested.
#
# Kernel cmdline:  tsx.root=LABEL=x|UUID=x|PARTUUID=x|/dev/x  (default: try
#                  LABEL=tsxroot-emmc first, then LABEL=tsxroot; a candidate is
#                  used only if it mounts AND has an init, so a stale label left
#                  behind on the eMMC by an earlier install falls through to the
#                  card instead of dropping to rescue)
#                  tsx.rootwait=SECONDS (default 10)   tsx.rescue   tsx.init=/sbin/init
#                  tsx.verbose (boot text on the LCD instead of the splash)
# Rootfs file:     /etc/tsx/force-rescue on the rootfs -> boot the rescue system once
#                  (the file is removed so the next boot is normal again).
#                  /etc/tsx/boot-verbose (panel.conf BOOT_VERBOSE=1, tsx-config
#                  apply) -> like tsx.verbose, from the root mount on.
#                  /etc/tsx/orientation (panel.conf ORIENTATION) -> the splash
#                  and the text console turn with it from the root mount on
#                  (before it: landscape; the rescue: always landscape).
# Screen: the kernel keeps the text console off the LCD (fbcon=map:1 on the
# command line) and tsx-splash draws the boot splash on /dev/fb0. Every way
# into the rescue system, and BOOT_VERBOSE, first gives the screen back to the
# text console (tsx-splash console, then tsx-confont loads a console font that
# suits the LCD size): a failure never hides behind the splash.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null
mkdir -p /dev/pts /run /tmp /newroot; mount -t devpts devpts /dev/pts

msg() { echo "tsx-initramfs: $*" > /dev/kmsg 2>/dev/null; echo "tsx-initramfs: $*" > /dev/tty0 2>/dev/null; }
verbose=
# screen orientation: unknown (landscape) until the root file system is
# mounted (the file lives there; tsx-orientation holds the table)
orient=landscape fbrot=0
# The splash needs the real display driver: fb0 is simpledrm on U-Boot's
# framebuffer until the meson DRM driver has probed, which can be a moment
# after /init starts, and that driver switches U-Boot's plane off when it
# takes over (and the console bound to simpledrm's fb0 does not follow). Wait
# for it, at most 2 s (the U-Boot logo stays up meanwhile).
wait_drm_fb() {
	i=0
	while [ $i -lt 40 ]; do
		case $(cat /sys/class/graphics/fb0/name 2>/dev/null) in ''|*simple*) usleep 50000; i=$((i + 1));; *) return 0;; esac
	done
}
# the text console binds to fb0 too: to the DRM driver's, not simpledrm's;
# turned to the orientation (fbcon rotate_all; needs the console bound), then
# a Terminus font sized for the LCD (80x25 or more; tsx-confont)
text_console() {
	verbose=1; wait_drm_fb; /usr/sbin/tsx-splash console 2>/dev/null
	echo "$fbrot" > /sys/class/graphics/fbcon/rotate_all 2>/dev/null
	/usr/sbin/tsx-confont 2>/dev/null
}
# splash TEXT PERCENT [show]: status line + progress bar (no-op when verbose)
splash() { [ -n "$verbose" ] || /usr/sbin/tsx-splash -o "$orient" -s "$1" -p "$2" "${3:-status}" 2>/dev/null; }
# The rescue system is busybox init (etc/inittab): rcS (network, dropbear) and the
# rescue screen /usr/sbin/tsx-rescue-status on the LCD, with "Press Enter for a
# rescue shell" for a USB keyboard. The same screen for every way in, the
# standalone rescue image included.
rescue() {
	fbrot=0   # the rescue screen is always landscape
	text_console
	msg "RESCUE: $*"
	echo "$*" > /run/rescue-reason
	mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
	exec /sbin/init
}

root=; wait=10; init=/sbin/init; want_rescue=
for c in $(cat /proc/cmdline); do
	case $c in
	tsx.root=*) root=${c#tsx.root=};;
	tsx.rootwait=*) wait=${c#tsx.rootwait=};;
	tsx.init=*) init=${c#tsx.init=};;
	tsx.rescue|tsx.rescue=1) want_rescue=1;;
	tsx.verbose|tsx.verbose=1) verbose=1;;
	esac
done
[ -n "$want_rescue" ] && rescue "requested on the kernel command line"
# This flag is baked into the rescue image itself (installer/rescue/overlay),
# so it is carried by BOTH p1:boot.img (the golden/factory-recovery slot,
# reached after boot_retry overflows) and p1:tsxboot.img (the one-shot
# installer hook target, reached on a normal, expected installer boot) --
# from here, nothing on this side of U-Boot can tell which of the two
# actually happened, so the reason stays generic rather than presuming
# "golden-slot" (which was wrong on a plain installer-armed boot; see the
# 2026-09-27 hardware run notes). It never switch_roots, never runs
# tsx-autoinstall and never formats anything; see /usr/sbin/tsx-rescue.
# TODO: installer/steps/tsx-rescue-arm.sh is gaining a one-shot tsx_once env
# flag (separate change, in flight); once it exists, read/clear it here (or
# in the rescue's own rcS) to report "installer arm" vs "golden fallback" vs
# "manual" precisely instead of this generic message.
[ -e /etc/tsx/rescue-image ] && rescue "$(head -n 1 /etc/tsx/rescue-image)"
if [ -n "$verbose" ]; then text_console; else wait_drm_fb; splash "starting" 5 show; fi

# installer: UART-free install (p1:tsxinst.cfg from stock Android, a stick with
# tsx-install/GO, or a U-Boot jabil boot from a stick). Exit 0 = nothing to do.
if [ -x /usr/sbin/tsx-autoinstall ]; then
	/usr/sbin/tsx-autoinstall || {
		# the rescue screen shows this as the operation that went wrong
		echo "- autoinstall" > /run/tsx-op; echo "failed, see /run/tsx-autoinstall.log" > /run/tsx-install-state
		rescue "tsx-autoinstall: install failed or waits for deploy.sh, see /run/tsx-autoinstall.log"
	}
fi

up() { cut -d. -f1 /proc/uptime; }

# find_dev SPEC TIMEOUT: print the backing device for SPEC (LABEL=x, UUID=x,
# PARTUUID=x or /dev/x) once it appears, waiting up to TIMEOUT seconds;
# return 1 if it never shows up.
find_dev() {
	spec=$1; to=$2
	end=$(( $(up) + to ))
	while :; do
		case $spec in
		/dev/*) [ -b "$spec" ] && { echo "$spec"; return 0; };;
		*) d=$(findfs "$spec" 2>/dev/null); [ -n "$d" ] && { echo "$d"; return 0; };;
		esac
		[ "$(up)" -ge "$end" ] && return 1
		sleep 0.25
	done
}

# eMMC-root fallback (2026-09-26): without tsx.root= try the eMMC root (LABEL=tsxroot-emmc)
# first, then the card (LABEL=tsxroot). Root-selection fix (2026-09-27): each candidate
# is tried in turn and is used only if it mounts AND has an init; a stale
# tsxroot-emmc superblock left behind by an earlier install (fs since
# overwritten) must fall through to the card instead of dropping to rescue.
# tsx.root= on the cmdline is a single explicit candidate, no fallback.
if [ -n "$root" ]; then candidates=$root; else candidates="LABEL=tsxroot-emmc LABEL=tsxroot"; fi

set -- $candidates; nleft=$#
dev=; used=
for cand in $candidates; do
	nleft=$((nleft - 1))
	# Every candidate but the last gets the old 3 s grace wait (enough to tell
	# a present-but-slow label from an absent one); the last candidate gets
	# the full tsx.rootwait= timeout, same as before this fix.
	if [ "$nleft" -gt 0 ]; then t=3; else t=$wait; fi
	d=$(find_dev "$cand" "$t") || { msg "$cand unusable (not found within ${t}s), trying next"; continue; }

	msg "root $cand is $d, checking"
	splash "checking the root file system" 10
	e2fsck -p "$d" > /run/fsck.log 2>&1; rc=$?
	if [ $rc -ge 4 ]; then
		e2fsck -y "$d" >> /run/fsck.log 2>&1; rc=$?
		if [ $rc -ge 4 ]; then
			msg "$cand on $d unusable (fsck failed, code $rc), trying next"
			continue
		fi
	fi
	[ $((rc & 2)) -ne 0 ] && { msg "fsck changed $d, rebooting"; sync; reboot -f; }

	if ! mount -t ext4 -o rw,noatime "$d" /newroot; then
		msg "$cand on $d unusable (mount failed), trying next"
		continue
	fi
	# ORIENTATION: from here on the splash (its next status redraws the whole
	# frame turned) and the text console (turned now if it has the screen)
	if [ -x /usr/sbin/tsx-orientation ]; then
		eval "$(/usr/sbin/tsx-orientation -f /newroot/etc/tsx/orientation info 2>/dev/null)"
		if [ "${ORIENTATION:-landscape}" != "$orient" ]; then
			orient=$ORIENTATION fbrot=$FBCON_ROTATE
			msg "orientation $orient"
			[ -n "$verbose" ] && text_console
		fi
	fi
	[ -e /newroot/etc/tsx/boot-verbose ] && [ -z "$verbose" ] && text_console
	if [ -e /newroot/etc/tsx/force-rescue ]; then
		rm -f /newroot/etc/tsx/force-rescue; umount /newroot
		rescue "/etc/tsx/force-rescue was set on the rootfs ($cand on $d)"
	fi
	if [ ! -x "/newroot$init" ] && [ ! -L "/newroot$init" ]; then
		umount /newroot
		msg "$cand on $d unusable (no $init), trying next"
		continue
	fi
	dev=$d; used=$cand
	break
done
[ -n "$dev" ] || rescue "no usable root found among: $candidates"
cp /run/fsck.log /newroot/var/log/initramfs-fsck.log 2>/dev/null

msg "switch_root ($used) to $dev"
splash "starting the system" 15
umount /dev/pts 2>/dev/null
for m in /dev /proc /sys; do mkdir -p /newroot$m; mount --move $m /newroot$m; done
exec switch_root /newroot "$init"
