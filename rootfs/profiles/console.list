# --- files that the build installs
built /usr/local/sbin/tsx-idled
built /usr/local/sbin/tsx-buttons
built /usr/local/bin/tsx-ledbar
built /usr/local/bin/tsx-peak
built /usr/local/bin/tsx-splash
tree /usr/share/tsx/splash
tree /usr/local/share/tsx/tfa9890
step compile-base
step splash
step tfa-containers
step ssh-policy
step root-password

# --- Alpine packages
