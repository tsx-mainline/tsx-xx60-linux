overlay etc/udev/rules.d/60-tsx-backlight.rules
overlay etc/udhcpc/post-bound/tsx-ntp
overlay etc/udhcpc/post-renew/tsx-ntp
overlay usr/local/bin/tsx-audio
overlay usr/local/bin/tsx-blank
overlay usr/local/bin/tsx-board
overlay usr/local/bin/tsx-display-power
overlay usr/local/bin/tsx-keypad
