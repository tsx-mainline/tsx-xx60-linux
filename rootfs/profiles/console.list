# Base of every image profile (profile "console"): a plain Linux system with
# a text login on the panel screen and SSH. Every other profile adds to it.
# Format: KIND NAME. See ../profile.sh. The packages own the files of the
# panel software. A profile can also have files that no other profile has, in
# profiles/NAME/overlay. image.list names the files that the image keeps (the
# build copies them from there or from rootfs/overlay).
#   step     build step of mkrootfs.sh (the profile has the step, or it has not)
#   pkg      Alpine or tsx-aports package, from packages.txt or packages-tsx.txt
#   svc      OpenRC service: svc RUNLEVEL NAME (boot or default)
#   user     system user that mkrootfs.sh adds

step tfa-containers
step ssh-policy
step root-password

# --- Alpine packages
pkg alpine-baselayout
pkg alpine-release
pkg apk-tools
pkg busybox
pkg busybox-openrc
pkg busybox-suid
pkg openrc
pkg musl-utils
pkg eudev
pkg eudev-openrc
pkg e2fsprogs
pkg dosfstools
pkg util-linux-misc
pkg kmod
pkg tzdata
pkg ca-certificates
pkg logrotate
pkg ifupdown-ng
pkg chrony
pkg openssh-server
pkg openssh-sftp-server
pkg openssh-client-default
pkg dbus
pkg curl
pkg libusb
pkg alsa-lib
pkg alsa-utils
pkg avahi
pkg python3
pkg bluez-deprecated
pkg brightnessctl
pkg evtest
pkg u-boot-tools
pkg i2c-tools
pkg htop
pkg procps-ng
pkg tsx-keys
pkg tsx-xx60-kernel-lts
pkg tsx-xx60-kernel-stable

# --- services
svc boot tsx-setup
svc boot tsx-hostname
svc boot tsx-data
svc boot tsx-config
svc default tsx-idled
svc default tsx-cpufreq
svc default tsx-buttons
svc default tsx-als
svc default tsx-ledbar
svc default tsx-audio
svc default tsx-tfa-dsp
svc default tsx-panelctl
svc default tsx-autoupdate
svc default tsx-boot-ok
svc default networking
svc default chronyd
svc default sshd
svc default crond
svc default watchdog
svc default dbus
svc default avahi-daemon
svc default local

