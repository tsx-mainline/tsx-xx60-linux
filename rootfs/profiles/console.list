overlay usr/local/lib/tsx/csr_psload.py
overlay usr/local/lib/tsx/tfa_dsp.py
overlay usr/local/sbin/tsx-als
overlay usr/local/sbin/tsx-autoupdate
overlay usr/local/sbin/tsx-boot-ok
overlay usr/local/sbin/tsx-bt
