# Base of every image profile (profile "console"): a plain Linux system with
# a text login on the panel screen and SSH. Every other profile adds to it.
# Format: KIND NAME. See ../profile.sh. A profile can also have files that no
# other profile has, in profiles/NAME/overlay. The build copies them over the
# image last (console: the login on tty1 and the banner. kiosk: the marker file
# /etc/tsx/profile. ha: none, and a missing marker means ha).
#   overlay  file below rootfs/overlay, path relative to it
#   built    file that mkrootfs.sh compiles or installs, absolute path on the panel
#   tree     directory that a build step installs, absolute path on the panel
#   step     build step of mkrootfs.sh
#   pkg      Alpine or tsx-aports package, from packages.txt or packages-tsx.txt
#   svc      OpenRC service: svc RUNLEVEL NAME (boot or default)
#   user     system user that mkrootfs.sh adds

# --- files of the overlay
overlay etc/apk/keys/tsx-mainline-6ab9ca44.rsa.pub
overlay etc/asound.conf
overlay etc/chrony/chrony.conf
overlay etc/conf.d/chronyd
overlay etc/conf.d/syslog
overlay etc/conf.d/watchdog
overlay etc/fstab
overlay etc/init.d/tsx-als
overlay etc/init.d/tsx-audio
overlay etc/init.d/tsx-autoupdate
overlay etc/init.d/tsx-boot-ok
overlay etc/init.d/tsx-buttons
overlay etc/init.d/tsx-config
overlay etc/init.d/tsx-cpufreq
overlay etc/init.d/tsx-data
overlay etc/init.d/tsx-hostname
overlay etc/init.d/tsx-idled
overlay etc/init.d/tsx-ledbar
overlay etc/init.d/tsx-panelctl
