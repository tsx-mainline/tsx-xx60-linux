#!/bin/sh
# tsx-banner: write the login banner of the console profile: /etc/issue (shown
# above the login prompt on the panel screen and on the serial console) and
# /etc/motd (shown after a login). Both have the Tux and "TSX - LINUX" art of
# /etc/tsx/banner.art, then the model, the IP address and "SSH is on".
#
#   tsx-banner        write both files. When /etc/issue changed, end the idle
#                     getty processes. init starts them again, so the login
#                     prompt shows the new address.
#
#   tsx-banner watch  run "check" every few seconds, without end
#   tsx-banner check  write both files only when the root password or the
#                     authorized keys changed since the last run. This is how
#                     the banner follows a passwd or a new key at once.
#
# /etc/local.d/tsx-banner.start runs it at boot, starts "watch", and runs it
# again when the DHCP lease gives an address. /etc/udhcpc/post-bound/tsx-banner
# runs it at each new lease.
# The model comes from /run/tsx/model, which /etc/init.d/tsx-hostname writes.
# Test hooks: TSX_BANNER_ART TSX_ISSUE_FILE TSX_MOTD_FILE TSX_RUN TSX_IP
# (an empty value means: no address) TSX_ROOTPW_BIN TSX_PKILL TSX_NO_RESPAWN=1
# TSX_SHADOW_FILE TSX_AUTH_KEYS_FILE TSX_WATCH_SEC.
set -u
SHADOW=${TSX_SHADOW_FILE:-/etc/shadow}
KEYS=${TSX_AUTH_KEYS_FILE:-/root/.ssh/authorized_keys}
ART=${TSX_BANNER_ART:-/etc/tsx/banner.art}
ISSUE=${TSX_ISSUE_FILE:-/etc/issue}
MOTD=${TSX_MOTD_FILE:-/etc/motd}
RUN=${TSX_RUN:-/run/tsx}

# the files that decide which root password case the banner shows
stamp() { stat -c '%Y:%s' "$SHADOW" "$KEYS" 2>/dev/null | tr '\n' ' '; }

case "${1:-}" in
watch)
	while :; do sleep "${TSX_WATCH_SEC:-3}"; "$0" check; done;;
check)
	[ "$(stamp)" != "$(cat "$RUN/banner.stamp" 2>/dev/null)" ] || exit 0;;
esac
mkdir -p "$RUN" 2>/dev/null; stamp > "$RUN/banner.stamp" 2>/dev/null

model=$(head -n 1 "$RUN/model" 2>/dev/null) || model=
[ -n "$model" ] || model="TSX panel"
if [ -n "${TSX_IP+x}" ]; then ip=$TSX_IP
else ip=$(ip -4 -o addr show dev eth0 2>/dev/null | awk '{ print $4; exit }' | cut -d/ -f1); fi

facts() {
	echo "   model:    $model"
	if [ -n "$ip" ]; then
		echo "   address:  $ip"
		echo "   SSH is on: ssh root@$ip"
	else
		echo "   address:  none yet (waiting for DHCP)"
		echo "   SSH is on (port 22)"
	fi
	# which root password case applies (tsx-rootpw note)
	"${TSX_ROOTPW_BIN:-/usr/local/bin/tsx-rootpw}" note 2>/dev/null
}

tmp=$ISSUE.tmp.$$
{
	echo
	# getty reads a backslash and a percent sign in /etc/issue as an escape.
	# Double them, so the art prints as it is.
	sed 's/\\/\\\\/g; s/%/%%/g' "$ART" 2>/dev/null
	echo
	facts | sed 's/\\/\\\\/g; s/%/%%/g'
	echo
} > "$tmp" && chmod 644 "$tmp" || { rm -f "$tmp"; exit 1; }
changed=1; cmp -s "$tmp" "$ISSUE" 2>/dev/null && changed=0
mv "$tmp" "$ISSUE"

tmp=$MOTD.tmp.$$
{
	echo
	cat "$ART" 2>/dev/null
	echo
	facts
	echo
	echo "   config:      tsx-config show        logs: /var/log/messages"
	echo "   screen:      tsx-blank on|off       update: tsx-autoupdate status"
	echo "   env/boot:    /usr/local/sbin/tsx-boot-ok --status"
} > "$tmp" && chmod 644 "$tmp" && mv "$tmp" "$MOTD" || rm -f "$tmp"

# A getty that waits at the prompt shows the old /etc/issue. Ending it makes
# init start a fresh one. A getty that has turned into a login is not touched.
if [ "$changed" = 1 ] && [ "${TSX_NO_RESPAWN:-}" != 1 ]; then "${TSX_PKILL:-pkill}" -x getty 2>/dev/null; fi
exit 0
