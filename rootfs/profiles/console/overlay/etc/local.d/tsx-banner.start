#!/bin/sh
# Write the login banner (tsx-banner) now, and again when eth0 has an address.
/usr/local/sbin/tsx-banner
# follow passwd and key changes while the panel runs
/usr/local/sbin/tsx-banner watch >/dev/null 2>&1 &
(
for i in $(seq 1 60); do
	ip -4 -o addr show dev eth0 2>/dev/null | grep -q inet && { /usr/local/sbin/tsx-banner; exit 0; }
	sleep 1
done
) >/dev/null 2>&1 &
