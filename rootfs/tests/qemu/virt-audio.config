# Audio-loopback host test kernel (qemu -M virt, NOT for the panel): the
# base virt config (rootfs/config/qemu-virt.config) is merged first, then this.
# Sound: only the ALSA loopback card, created with id TSW1060 (kernel command
# line snd_aloop.id=TSW1060): playback on hw:TSW1060,0 comes back as capture
# on hw:TSW1060,1, which is exactly the device layout of the panel's card.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_DRIVERS=y
CONFIG_SND_ALOOP=y
CONFIG_SND_PCM_TIMER=y
CONFIG_SND_HRTIMER=y
# no other sound cards
CONFIG_SND_SOC=n
CONFIG_SND_DUMMY=n
CONFIG_SND_VIRTIO=n
CONFIG_SND_HDA_INTEL=n
CONFIG_SND_USB_AUDIO=n
