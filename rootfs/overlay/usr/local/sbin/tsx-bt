#!/bin/sh
# tsx-bt: start and stop the Bluetooth controller of the panel
# (docs/hardware.md "Bluetooth (CSR8811)"). /etc/init.d/tsx-bt runs it when
# BT_PROXY=on in panel.conf. You can also run it by hand as root.
#
#   tsx-bt up       bring the controller up: hciN exists, HCIDEVUP is done
#   tsx-bt down     detach the chip and hold it in reset
#   tsx-bt status   print the state file and the hciconfig output
#   tsx-bt mac      print the Bluetooth address that "up" loads
#
# This script holds the steps that every board needs. The steps of one chip
# are in a chip file (default /usr/local/lib/tsx/bt-chip-csr8811.sh, see its
# header for the functions): the rfkill pulse, the PSR upload, hciattach and
# the government check. A board with another chip sets TSX_BT_CHIP to its
# own file. A board whose kernel driver registers hciN by itself sets
# TSX_BT_CHIP=none.
#
# "up" does these steps:
#   1. Stop when the board has no Bluetooth module (hw.conf BT=no) or the
#      kernel has no Bluetooth. State absent, exit 0.
#   2. Find the Bluetooth address (see below), then run chip_up.
#   3. Wait for hciN, at most TSX_BT_WAIT seconds (default 20). A kernel
#      driver may register it late. TSX_BT_HCI names the device (default
#      hci0) when no chip file says it.
#   4. HCIDEVUP on hciN (btscan.py --up).
#
# The Bluetooth address: BT_MAC of panel.conf if set, else the eth0 MAC. The
# vendor firmware uses the same value (ro.boot.mac_bt = the U-Boot ethaddr).
# It is unique for each panel and does not change on a reinstall. A passive
# scan never sends it over the air. A board with no address source (no chip
# file, or no network MAC and no BT_MAC) keeps the address of the controller.
# tsx-btscan then reads it with Read BD_ADDR and writes it to bt.mac.
#
# Every step logs why it failed. "up" writes $TSX_RUN_DIR/bt.state
# (state=up|failed|down|absent, reason=, hci=, mac=, psr=) and exits 1 on a
# failure. The init script never fails the boot on that exit status.
#
# A panel without a Bluetooth module (BT=no in /run/tsx/hw.conf, from
# tsx-hw: government=1, the TSW-760-NC) never touches the chip: no rfkill
# pulse, no UART. "up", "down" and "status" then report state=absent with
# the reason, and exit 0.
#
# Files: /run/tsx/hw.conf (BT=, GOVERNMENT=, REASON=, written by tsx-hw at
# boot), /run/tsx/bt.conf (PROXY=, ACTIVE=, MAC=, written by tsx-config
# apply), /usr/local/share/tsx/csr8811/PSR-CSR8811.psr (+ SOURCE, from the
# installer). Test hooks: TSX_RUN_DIR, TSX_SYSFS, TSX_PROC, TSX_BT_CHIP,
# TSX_BT_LIB, TSX_BT_WAIT, TSX_BT_HCI, TSX_BT_MODDIR, and the hooks of the
# chip file.
set -u
RUN=${TSX_RUN_DIR:-/run/tsx}
SYS=${TSX_SYSFS:-/sys}
PROC=${TSX_PROC:-/proc}
LIB=${TSX_BT_LIB:-/usr/local/lib/tsx}
CHIP=${TSX_BT_CHIP:-$LIB/bt-chip-csr8811.sh}
WAIT=${TSX_BT_WAIT:-20}
DEFAULT_HCI=${TSX_BT_HCI:-hci0}
MODDIR=${TSX_BT_MODDIR:-/lib/modules/$(uname -r 2>/dev/null)}
HCI= MAC= PSRKIND=

log() { echo "tsx-bt: $*"; logger -t tsx-bt "$*" 2>/dev/null || true; }

# conf_get KEY: a value from $RUN/bt.conf (KEY="value" lines). The file is
# never sourced.
conf_get() {
	sed -n "s/^$1=\"\{0,1\}\([^\"]*\)\"\{0,1\}\$/\1/p" "$RUN/bt.conf" 2>/dev/null | tail -n 1
}

# hw_get KEY: a value from $RUN/hw.conf (tsx-hw). Empty if it is not there.
hw_get() { sed -n "s/^$1=//p" "$RUN/hw.conf" 2>/dev/null | tail -n 1; }

# The chip file: chip_absent_reason, chip_up and chip_down. With
# TSX_BT_CHIP=none (or no file) the board has no chip steps.
HAVE_CHIP=no
if [ "$CHIP" != none ] && [ -r "$CHIP" ]; then
	. "$CHIP"
	HAVE_CHIP=yes
fi

absent_reason() {
	if [ "$HAVE_CHIP" = yes ]; then chip_absent_reason
	else echo "no Bluetooth module on this board ($(hw_get REASON))"
	fi
}

state() {  # state STATE REASON
	mkdir -p "$RUN"
	{
		echo "state=$1"
		echo "reason=$2"
		echo "hci=${HCI:-}"
		echo "mac=${MAC:-}"
		echo "psr=${PSRKIND:-}"
		echo "time=$(date '+%F %T')"
	} > "$RUN/bt.state.tmp" && mv "$RUN/bt.state.tmp" "$RUN/bt.state"
}

# absent: on a board without a Bluetooth module or without Bluetooth in the
# kernel, record that and succeed. Return 1 on any other board.
absent() {
	HCI= MAC= PSRKIND=
	if [ "$(hw_get BT)" = no ]; then
		state absent "$(absent_reason)"
		log "absent: $(absent_reason). The chip is not touched"
		return 0
	fi
	[ "$1" = up ] || return 1
	if ! kernel_has_bt; then
		state absent "the kernel has no Bluetooth"
		log "absent: the kernel has no Bluetooth. Bluetooth stays off"
		return 0
	fi
	return 1
}

# kernel_has_bt: the Bluetooth core is built in or loaded, or a module of it
# is on the disk (hciattach and the kernel load it).
kernel_has_bt() {
	[ -d "$SYS/class/bluetooth" ] || [ -d "$SYS/module/bluetooth" ] && return 0
	for f in "$MODDIR"/kernel/net/bluetooth/bluetooth.ko*; do
		[ -e "$f" ] && return 0
	done
	return 1
}

valid_mac() { printf '%s' "$1" | grep -Eq '^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$'; }

# bt_mac: print the Bluetooth address in upper case. Return 1 if BT_MAC is
# not an address. Return 2 if there is no address source (the controller
# keeps its own address then).
bt_mac() {
	m=$(conf_get MAC)
	if [ -n "$m" ]; then
		valid_mac "$m" || { log "BT_MAC '$m' is not a MAC address"; return 1; }
		printf '%s\n' "$m" | tr 'a-f' 'A-F'
		return 0
	fi
	eth=
	for f in "$SYS/class/net/eth0/address" "$SYS"/class/net/*/address; do
		[ -r "$f" ] || continue
		case "$f" in */lo/address) continue;; esac
		a=$(cat "$f" 2>/dev/null)
		valid_mac "$a" || continue
		[ "$a" = 00:00:00:00:00:00 ] && continue
		eth=$a; break
	done
	[ -n "$eth" ] || return 2
	printf '%s\n' "$eth" | tr 'a-f' 'A-F'
}

fail() { log "FAILED: $*"; state failed "$*"; exit 1; }

hci_list() { ls -d "$SYS"/class/bluetooth/hci* 2>/dev/null | sed 's#.*/##' | grep -E '^hci[0-9]+$'; }

# wait_hci: wait for the hci device, at most $WAIT seconds
wait_hci() {
	[ -n "$HCI" ] || HCI=$DEFAULT_HCI
	i=0
	while [ ! -e "$SYS/class/bluetooth/$HCI" ] && [ "$i" -lt $((WAIT * 10)) ]; do
		sleep 0.1; i=$((i + 1))
	done
	[ -e "$SYS/class/bluetooth/$HCI" ] || fail "$HCI did not show up in $WAIT s (does the kernel driver find the controller?)"
}

do_up() {
	state starting ""
	rm -f "$RUN/bt.mac"
	if [ "$HAVE_CHIP" = yes ]; then
		MAC=$(bt_mac); rc=$?
		case $rc in
		0) ;;
		2) MAC=; log "no BT_MAC and no network MAC: the controller keeps its own address";;
		*) fail "BT_MAC is not a valid address";;
		esac
		chip_up
	else
		if [ -n "$(conf_get MAC)" ]; then
			log "WARNING: BT_MAC does not apply on this board (no chip file, the controller keeps its address)"
		fi
	fi
	wait_hci
	# HCIDEVUP. "Already up" is not an error. The kernel may power a new
	# controller on by itself.
	out=$(python3 "$LIB/btscan.py" --hci "$HCI" --up 2>&1) || {
		echo "$out" | sed 's/^/  /'
		fail "$HCI does not come up: $(echo "$out" | tail -n 1)"
	}
	[ -z "$MAC" ] || printf '%s\n' "$MAC" > "$RUN/bt.mac"
	state up ""
	log "$HCI up${MAC:+, Bluetooth address $MAC}"
	return 0
}

do_down() {
	HCI=$(sed -n 's/^hci=//p' "$RUN/bt.state" 2>/dev/null)
	MAC= PSRKIND=
	[ "$HAVE_CHIP" = yes ] && chip_down
	state down ""
	log "Bluetooth down"
}

case "${1:-}" in
up) absent up || do_up;;
down) absent down || do_down;;
status)
	if [ "$(hw_get BT)" = no ]; then
		# Say "absent" also when nothing has run yet (no state file).
		if grep -q '^state=absent' "$RUN/bt.state" 2>/dev/null; then cat "$RUN/bt.state"
		else echo "state=absent"; echo "reason=$(absent_reason)"
		fi
		exit 0
	fi
	cat "$RUN/bt.state" 2>/dev/null || echo "state=unknown (tsx-bt has not run)"
	h=$(sed -n 's/^hci=//p' "$RUN/bt.state" 2>/dev/null)
	[ -n "$h" ] && hciconfig "$h" 2>/dev/null
	exit 0;;
mac)
	bt_mac; rc=$?
	[ $rc = 2 ] && { echo "none: the controller keeps its own address"; exit 0; }
	exit $rc;;
*) sed -n '2,10p' "$0" >&2; exit 2;;
esac
