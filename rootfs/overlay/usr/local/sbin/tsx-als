#!/bin/sh
# tsx-als: ambient light sensor -> backlight level for the xx60 kiosk.
#
#   tsx-als                 daemon (OpenRC service tsx-als)
#   tsx-als status          current lux, level, auto state
#   tsx-als auto on|off     on = back to automatic (drops the manual level
#                           and offset). Off = keep the level on the glass as
#                           a fixed level (/run/tsx/brightness). It also
#                           changes AUTO_BRIGHTNESS in panel.conf and applies
#                           it, so the setting stays after a reboot. The Home
#                           Assistant "Auto brightness" switch calls it.
#   tsx-als lux             one reading in lux (no smoothing)
#
# It reads the MAX44009 through IIO (in_illuminance_input, lux), multiplies
# it by ALS_SCALE and holds the value (see "Response" below). The front window passes only part of
# the light, and ALS_SCALE corrects that (lux = sensor lux x ALS_SCALE). An
# empty ALS_SCALE means 1.0. It maps the value to a backlight step with ALS_CURVE
# (/etc/tsx/als.conf). The step goes to
# /run/tsx/als-level. tsx-idled uses that file in place of the day/night
# level while the file is fresh (< 30 s). An absolute manual level still wins
# (/run/tsx/brightness: "brightness N" key action, HA Backlight). The script
# adds the local manual setting to the step (/run/tsx/brightness-offset:
# key-strip slide, quick-settings overlay, "brightness +N/-N").
# While the screen is lit, tsx-als also ramps the backlight itself one step at
# a time (ALS_RAMP_MS), so the change is smooth and immediate. While the
# screen is blank, it never touches the backlight.
#
# Response: the same model as tsx-sensord (LightResponse in tsx_brightness.py,
# the idea of the brightening and darkening debounce of the Android automatic
# brightness controller). The held light moves up only when every reading of
# the last AUTO_BRIGHTEN_S seconds is more than AUTO_BRIGHTEN_BAND above it
# (then it takes the lowest of them). It moves down only when every reading of
# the last AUTO_DARKEN_S seconds is more than AUTO_DARKEN_BAND below it (then
# it takes the highest). The bands are in log10(1 + lux). A short flash or
# shadow changes nothing. A change of one step in the opposite direction of
# the last change needs a double band. The values are in als.conf, and
# kiosk.conf and panel-board.conf win over it. The MAX44009 makes a new value
# every 0.8 s, so ALS_PERIOD_S is never below ALS_MIN_PERIOD_S (0.8).
#
# panel.conf: AUTO_BRIGHTNESS and ALS_SCALE reach this script through
# /run/tsx/als.panel (written by "tsx-config apply", the lines ALS_AUTO and
# ALS_SCALE). They win over the same names in als.conf. The script reads the
# file again every 5 readings. A change of AUTO_BRIGHTNESS there (the setup
# page) acts like "tsx-als auto on|off".
#
# Learning: tsx_brightness.py (als-daemon) runs beside the loop. A manual
# change that the user holds for a few seconds becomes a point of the curve.
# The daemon writes the whole curve to /run/tsx/als-curve. The loop uses that
# file in place of ALS_CURVE while it exists and moves to the new level at
# once when the file changes (docs/adaptive-brightness.md). No level goes
# below BACKLIGHT_MIN (default 1).
#
# State for tsx-mqtt: /run/tsx/als.state ("lux N", "raw N", "report N",
# "level N", "auto on|off"). Lux values are integers.
#
# Process starts: the loop starts no process while the light is steady. It
# reads the sensor, the backlight and the state files with the shell command
# read, and waits with read -t on a FIFO that it holds open. It writes
# als-level and als.state only when the content changes. It also writes
# als-level every 15 s, because tsx-idled uses the file only while it is less
# than 30 s old, and als.state every 60 s. It reads the settings files again
# only when one of them changed.
#
# Env overrides for tests: TSX_ALS_CONF, TSX_ALS_PANEL, TSX_CONFIG_BIN, TSX_KIOSK_CONF, TSX_RUN_DIR,
# TSX_IIO_DIR, TSX_BACKLIGHT_DIR, TSX_LEARN_MOD (the path of tsx_brightness.py), TSX_IDLED_STATE, TSX_ALS_LOOPS (stop after N
# readings), TSX_ALS_NOW (fixed epoch seconds per reading: start value), TSX_ALS_NAP
# (a command that runs with the wait in microseconds, in place of the wait).
set -u
CONF=${TSX_ALS_CONF:-/etc/tsx/als.conf}
KCONF=${TSX_KIOSK_CONF:-/etc/kiosk.conf}
R=${TSX_RUN_DIR:-/run/tsx}
IIO=${TSX_IIO_DIR:-/sys/bus/iio/devices}
BLBASE=${TSX_BACKLIGHT_DIR:-/sys/class/backlight}
IDLED=${TSX_IDLED_STATE:-/run/tsx-idled.state}
PANEL=${TSX_ALS_PANEL:-$R/als.panel}
CONFIG=${TSX_CONFIG_BIN:-tsx-config}

ALS_AUTO=1 ALS_CURVE="0:3 5:5 20:8 80:12 300:17 1000:21 3000:23"
AUTO_BRIGHTEN_S=1.5 AUTO_DARKEN_S=5 AUTO_BRIGHTEN_BAND=0.06 AUTO_DARKEN_BAND=0.10
ALS_PERIOD_S=0.8 ALS_MIN_PERIOD_S=0.8 ALS_REVERSE_S=30 ALS_RAMP_MS=60
ALS_NIGHT_CAP=0 ALS_BL_COMP=0 ALS_REPORT_PCT=10 ALS_REPORT_MAX=300 ALS_DEVICE=auto
ALS_START_WAIT=15 ALS_SCALE=
[ -r "$CONF" ] && . "$CONF"
BACKLIGHT_MAX=23 BACKLIGHT_MIN=1 NIGHT_START=22 NIGHT_END=7
[ -r "$KCONF" ] && eval "$(grep -E '^(BACKLIGHT_MAX|BACKLIGHT_MIN|NIGHT_START|NIGHT_END)=[0-9]+$' "$KCONF")"
BOARD=${TSX_PANEL_BOARD_CONF:-/etc/tsx/panel-board.conf}
[ -r "$BOARD" ] && eval "$(grep -E '^(BACKLIGHT_MAX|BACKLIGHT_MIN)=[0-9]+$' "$BOARD")"
# Response values: als.conf, then kiosk.conf, then the board file
TIMING_RE='^(AUTO_BRIGHTEN_S|AUTO_DARKEN_S|AUTO_BRIGHTEN_BAND|AUTO_DARKEN_BAND|ALS_PERIOD_S)=[0-9]+(\.[0-9]+)?$'
LEARN_MOD=${TSX_LEARN_MOD:-/usr/local/lib/tsx/tsx_brightness.py}

log() { echo "$(date '+%F %T') tsx-als: $*"; }

# The values of /run/tsx/als.panel (panel.conf). Empty = not set there.
PANEL_AUTO= PANEL_SCALE=
SCALE_MILLI=1000 scale_bad=
load_panel() {
	PANEL_AUTO= PANEL_SCALE=
	[ -r "$PANEL" ] || return 0
	PANEL_AUTO=$(sed -n 's/^ALS_AUTO="\([01]\)"$/\1/p' "$PANEL" | tail -n 1)
	PANEL_SCALE=$(sed -n 's/^ALS_SCALE="\([0-9.]*\)"$/\1/p' "$PANEL" | tail -n 1)
}

# Work out SCALE_MILLI (ALS_SCALE x 1000, an integer): the panel.conf value,
# else ALS_SCALE of als.conf, else 1.0.
load_scale() {
	s=${PANEL_SCALE:-$ALS_SCALE}; src=ALS_SCALE
	if [ -n "$s" ]; then
		if printf '%s' "$s" | grep -Eq '^[0-9]{1,4}(\.[0-9]{1,3})?$' \
			&& awk -v x="$s" 'BEGIN{exit !(x >= 0.01 && x <= 1000)}'; then
			SCALE_MILLI=$(awk -v x="$s" 'BEGIN{printf "%d", x * 1000 + 0.5}')
			scale_bad=
			return 0
		fi
		[ "$scale_bad" = "$src:$s" ] || log "bad value '$s' in $src (need 0.01 to 1000). Using 1.0"
		scale_bad="$src:$s"
	fi
	SCALE_MILLI=1000
}

# The response values as integers: BR_CS and DK_CS (centiseconds), UP_PCT and
# DN_PCT (the bands as a percent of 1 + lux), PER_MS (milliseconds between
# readings, never below ALS_MIN_PERIOD_S). A bad value gives the default.
BR_CS=150 DK_CS=500 UP_PCT=15 DN_PCT=26 PER_MS=800
load_timing() {
	for f in "$KCONF" "$BOARD"; do
		[ -r "$f" ] && eval "$(grep -E "$TIMING_RE" "$f")"
	done
	num='^[0-9]+(\.[0-9]+)?$'
	for v in AUTO_BRIGHTEN_S AUTO_DARKEN_S AUTO_BRIGHTEN_BAND AUTO_DARKEN_BAND ALS_PERIOD_S ALS_MIN_PERIOD_S; do
		eval "x=\$$v"
		printf '%s' "$x" | grep -Eq "$num" || { log "bad value '$x' in $v. Using the default"; case $v in
			AUTO_BRIGHTEN_S) AUTO_BRIGHTEN_S=1.5;; AUTO_DARKEN_S) AUTO_DARKEN_S=5;; AUTO_BRIGHTEN_BAND) AUTO_BRIGHTEN_BAND=0.06;;
			AUTO_DARKEN_BAND) AUTO_DARKEN_BAND=0.10;; ALS_PERIOD_S) ALS_PERIOD_S=0.8;; ALS_MIN_PERIOD_S) ALS_MIN_PERIOD_S=0.8;; esac; }
	done
	eval "$(awk -v bs="$AUTO_BRIGHTEN_S" -v ds="$AUTO_DARKEN_S" -v bb="$AUTO_BRIGHTEN_BAND" -v db="$AUTO_DARKEN_BAND" -v p="$ALS_PERIOD_S" -v m="$ALS_MIN_PERIOD_S" \
		'BEGIN{ if (p < m) p = m; printf "BR_CS=%d DK_CS=%d UP_PCT=%d DN_PCT=%d PER_MS=%d", bs*100+0.5, ds*100+0.5, (10^bb-1)*100+0.5, (10^db-1)*100+0.5, p*1000+0.5 }')"
}

timing_key=
timing_log() {
	k="$BR_CS $DK_CS $UP_PCT $DN_PCT $PER_MS"
	[ "$k" != "$timing_key" ] || return 0
	timing_key=$k
	log "response: brighter after $(( BR_CS / 100 )).$(( BR_CS % 100 / 10 )) s (band $UP_PCT %), darker after $(( DK_CS / 100 )).$(( DK_CS % 100 / 10 )) s (band $DN_PCT %), reading every $PER_MS ms"
}

# Apply a deci-lux value of the sensor: lux x scale
scale_dlux() { echo $(( ($1 * SCALE_MILLI + 500) / 1000 )); }

find_dev() {
	if [ "$ALS_DEVICE" != auto ]; then echo "$ALS_DEVICE"; return; fi
	for d in "$IIO"/iio:device*; do
		fd_n=
		[ -r "$d/name" ] && { read -r fd_n < "$d/name"; } 2>/dev/null
		[ "$fd_n" = max44009 ] && { echo "$d"; return; }
	done
}

# read_dlux DEV: "12.345000" -> DLUX=123 (deci-lux, integer). It starts no
# process. It fails when the sensor gives no number.
DLUX=
read_dlux() {
	rd_v=
	{ read -r rd_v < "$1/in_illuminance_input"; } 2>/dev/null
	case $rd_v in ''|*[!0-9.]*) return 1;; esac
	rd_i=${rd_v%%.*}; rd_f=0
	case $rd_v in *.*) rd_f=${rd_v#*.}; rd_f=${rd_f%"${rd_f#?}"}; [ -n "$rd_f" ] || rd_f=0;; esac
	DLUX=$(( ${rd_i:-0} * 10 + rd_f ))
}

# nap MS: wait MS milliseconds without a process. The daemon holds a FIFO open
# for reading and writing (file descriptor 9), and read -t on it times out.
# Without the FIFO, usleep waits. TSX_ALS_NAP replaces the wait in tests.
NAP_OK= napped=0
nap_init() {
	[ -z "${TSX_ALS_NAP:-}" ] || return 0
	ni_f=$R/.als-nap.$$
	if mkfifo "$ni_f" 2>/dev/null && exec 9<>"$ni_f"; then NAP_OK=1; fi
	rm -f "$ni_f"
}
nap() {
	napped=$(( napped + $1 ))
	if [ -n "${TSX_ALS_NAP:-}" ]; then "$TSX_ALS_NAP" $(( $1 * 1000 )); return; fi
	if [ -n "$NAP_OK" ]; then
		nap_f=$(( $1 % 1000 + 1000 ))
		read -r -t "$(( $1 / 1000 )).${nap_f#1}" nap_x <&9
		return 0
	fi
	usleep $(( $1 * 1000 ))
}

# The learned curve (als-curve of the learning daemon), or empty
# The check with grep runs only when the file has new content.
USE_CURVE= curve_changed= curve_raw=
load_curve() {
	c=
	[ -r "$R/als-curve" ] && read -r c < "$R/als-curve"
	[ "$c" != "$curve_raw" ] || return 0
	curve_raw=$c
	if [ -n "$c" ] && ! printf '%s' "$c" | grep -Eq '^[0-9]+:[0-9]+( [0-9]+:[0-9]+)*$'; then c=; fi
	if [ "$c" != "$USE_CURVE" ]; then USE_CURVE=$c; curve_changed=1; fi
}

# deci-lux -> step (piecewise linear on the learned curve, else ALS_CURVE).
# The step is in CURVE_OUT.
CURVE_OUT=
curve_level() {
	x=$1; pl=; ps=; out=
	for p in ${USE_CURVE:-$ALS_CURVE}; do
		l=$(( ${p%%:*} * 10 )); s=${p#*:}
		if [ "$x" -le "$l" ]; then
			if [ -z "$pl" ] || [ "$l" -le "$pl" ]; then out=$s
			else out=$(( ps + ((s - ps) * (x - pl) * 2 + (l - pl)) / (2 * (l - pl)) )); fi
			break
		fi
		pl=$l; ps=$s
	done
	[ -n "$out" ] || out=${ps:-1}
	CURVE_OUT=$out
}

auto_on() {
	a=${PANEL_AUTO:-$ALS_AUTO}
	if [ -r "$R/als-auto" ]; then a=; read -r a < "$R/als-auto"; fi
	case $a in 1|on|ON|yes) return 0;; esac
	return 1
}

bl_dir() { for d in "$BLBASE"/*; do [ -w "$d/brightness" ] && { echo "$d"; return; }; done; }

is_night() {
	[ "$NIGHT_START" = "$NIGHT_END" ] && return 1
	h=$(date +%H); h=${h#0}
	if [ "$NIGHT_START" -lt "$NIGHT_END" ]; then [ "$h" -ge "$NIGHT_START" ] && [ "$h" -lt "$NIGHT_END" ]
	else [ "$h" -ge "$NIGHT_START" ] || [ "$h" -lt "$NIGHT_END" ]; fi
}

# The run-time part of "auto on|off"
do_auto() {
	case $1 in
	on)  echo on > "$R/als-auto"; rm -f "$R/brightness" "$R/brightness-offset";;
	off) echo off > "$R/als-auto"
	     # Freeze what is on the glass. Otherwise the offset would suddenly
	     # apply to the day/night level instead. Use the level of tsx-idled
	     # while lit.
	     if [ ! -e "$R/brightness" ]; then
	         l=$(sed -n 's/^level //p' "$R/brightness.state" 2>/dev/null | head -n 1)
	         st=; [ -r "$IDLED" ] && read -r st _ < "$IDLED"
	         case $l in [1-9]|[1-9][0-9]) [ "$st" = on ] && echo "$l" > "$R/brightness";; esac
	     fi
	     rm -f "$R/brightness-offset" "$R/als-level";;
	esac
}

# The "auto" line of als.state follows a change at once. The daemon writes the
# file once per loop, and a ramp of the backlight can take a few seconds.
state_auto() {
	[ -r "$R/als.state" ] || return 0
	sed "s/^auto .*/auto $1/" "$R/als.state" > "$R/als.state.tmp.$$" && mv -f "$R/als.state.tmp.$$" "$R/als.state"
}

state_field() { [ -r "$R/als.state" ] && sed -n "s/^$1 //p" "$R/als.state" | head -1; }

case ${1:-} in
status)
	if [ -r "$R/als.state" ]; then cat "$R/als.state"; else echo "tsx-als not running"; fi
	[ -r "$R/brightness" ] && echo "manual override $(cat "$R/brightness")"
	[ -r "$R/brightness-offset" ] && echo "manual offset $(cat "$R/brightness-offset")"
	exit 0;;
auto)
	mkdir -p "$R"
	case ${2:-} in
	on|off) do_auto "$2"; state_auto "$2"
	     # Keep the setting in panel.conf. If that fails, the run-time change stays.
	     "$CONFIG" set AUTO_BRIGHTNESS "$2" && "$CONFIG" apply \
	         || echo "tsx-als: could not save AUTO_BRIGHTNESS in panel.conf" >&2;;
	*)   echo "usage: tsx-als auto on|off"; exit 2;;
	esac
	echo "auto ${2}"; exit 0;;
lux)
	d=$(find_dev); [ -n "$d" ] || { echo "no max44009 in $IIO" >&2; exit 1; }
	read_dlux "$d" || exit 1
	load_panel; load_scale; v=$(scale_dlux "$DLUX")
	echo "$((v / 10)).$((v % 10))"; exit 0;;
'') ;;
*)  echo "usage: tsx-als [status | auto on|off | lux]"; exit 2;;
esac

# conf_changed: true when the panel file, kiosk.conf or the board file is new
# or gone since the last call, or has a modification time that is not older
# than the stamp file (a change in the same second as the stamp counts). It
# makes the stamp again. The shell tests the files, so a check starts no
# process. (A read of kiosk.conf with the shell command read costs two system
# calls for each byte.) If the stamp cannot be made, every call says yes.
conf_stamp=$R/.als-conf-stamp conf_ex=
conf_changed() {
	cc_n= cc_e=
	for cc_f in "$PANEL" "$KCONF" "$BOARD"; do
		if [ -e "$cc_f" ]; then
			cc_e="${cc_e}1"
			[ "$conf_stamp" -nt "$cc_f" ] || cc_n=1
		else
			cc_e="${cc_e}0"
		fi
	done
	[ "$cc_e" = "$conf_ex" ] || cc_n=1
	[ -n "$cc_n" ] || return 1
	conf_ex=$cc_e
	echo 1 > "$conf_stamp" 2>/dev/null || conf_ex=
	return 0
}

# ---- daemon ------------------------------------------------------------------
mkdir -p "$R"
conf_changed || :
load_panel; load_scale; load_timing; timing_log
seen_auto=$PANEL_AUTO
dev= dl= hist= cur=0 last_dl=-1 last_change=0 last_dir=0 rep=-1 rep_t=0 n=0 warned=
bd= lvl_w= lvl_t=0 st_w= st_t=0
nl='
'
now_cs=0
[ -z "${TSX_ALS_NOW:-}" ] || now_cs=$(( TSX_ALS_NOW * 100 ))
LEARN_PID=
if [ -z "${TSX_ALS_LOOPS:-}" ] && command -v python3 >/dev/null 2>&1 && [ -r "$LEARN_MOD" ]; then
	python3 "$LEARN_MOD" als-daemon &
	LEARN_PID=$!
fi
nap_init
trap 'rm -f "$R/als-level" "$conf_stamp"; [ -n "$LEARN_PID" ] && kill "$LEARN_PID" 2>/dev/null; exit 0' INT TERM

while :; do
	if [ -n "${TSX_ALS_LOOPS:-}" ] && [ "$n" -ge "$TSX_ALS_LOOPS" ]; then break; fi
	n=$((n + 1))
	# The clock: the shell command read takes two system calls for each byte,
	# and /proc/uptime costs 7 ms (about as much as the rest of the loop). So
	# the loop adds its waits to the clock and reads /proc/uptime every 15th loop.
	if [ -n "${TSX_ALS_NOW:-}" ]; then now_cs=$(( now_cs + PER_MS / 10 ))
	elif [ $(( n % 15 )) -ne 1 ]; then now_cs=$(( now_cs + napped / 10 + 1 )); napped=0
	else read -r up _ < /proc/uptime; f=${up#*.}; now_cs=$(( ${up%.*} * 100 + ${f#0} )); napped=0; fi
	now=$(( now_cs / 100 ))
	[ -n "$dev" ] && [ -r "$dev/in_illuminance_input" ] || dev=$(find_dev)
	if [ -z "$dev" ]; then
		[ -n "$warned" ] || { log "no max44009 IIO device yet (CONFIG_MAX44009, DT node light-sensor@4a). Waiting"; warned=1; }
		[ ! -e "$R/als-level" ] || rm -f "$R/als-level"
		lvl_w=; nap 10000; continue
	fi
	if [ $(( n % 5 )) -eq 1 ] && [ "$n" -gt 1 ] && conf_changed; then
		load_panel; load_scale; load_timing; timing_log
		# AUTO_BRIGHTNESS changed in panel.conf (the setup page): act as "auto on|off"
		if [ "$PANEL_AUTO" != "$seen_auto" ]; then
			seen_auto=$PANEL_AUTO
			case $PANEL_AUTO in 1) w=on;; 0) w=off;; *) w=;; esac
			cur_a=; [ -r "$R/als-auto" ] && read -r cur_a < "$R/als-auto"
			if [ -n "$w" ] && [ "$cur_a" != "$w" ]; then log "panel.conf: AUTO_BRIGHTNESS $w"; do_auto "$w"; fi
		fi
	fi
	read_dlux "$dev" || { nap "$PER_MS"; continue; }
	raw=$DLUX
	# Right after a cold boot, the MAX44009 can read 0 lx for several seconds
	# before its first conversion. If the script took that value at face
	# value, it dimmed the boot splash to the darkest step and back up 10-20 s
	# later. Until the first level, a 0 reading waits (at most ALS_START_WAIT
	# readings). There is no als-level yet, so tsx-idled keeps the level on
	# the glass (boot hold).
	if [ "$raw" -le 0 ] && [ "$cur" -eq 0 ] && [ "$n" -le "$ALS_START_WAIT" ]; then
		nap "$PER_MS"
		continue
	fi
	[ -n "$warned" ] && { log "sensor $dev: $((raw / 10)) lx"; warned=; }

	# Compensate for the own backlight
	if [ -z "$bd" ] || [ ! -w "$bd/brightness" ]; then bd=$(bl_dir); fi
	bl=0
	[ -z "$bd" ] || { read -r bl < "$bd/brightness"; } 2>/dev/null
	case $bl in ''|*[!0-9]*) bl=0;; esac
	amb=$(( raw - ALS_BL_COMP * bl )); [ "$amb" -ge 0 ] || amb=0
	amb=$(( (amb * SCALE_MILLI + 500) / 1000 ))

	# Hold the value: keep the readings of the longer time, and look at the
	# lowest of the brighten time and the highest of the darken time
	hist="$hist $now_cs:$amb"
	bcut=$(( now_cs - BR_CS - 1 )); dcut=$(( now_cs - DK_CS - 1 ))
	pcut=$bcut; [ "$dcut" -ge "$pcut" ] || pcut=$dcut
	keep= bmin= dmax=
	for e in $hist; do
		t=${e%%:*}; v=${e#*:}
		[ "$t" -gt "$pcut" ] || continue
		keep="$keep $e"
		if [ "$t" -gt "$bcut" ] && { [ -z "$bmin" ] || [ "$v" -lt "$bmin" ]; }; then bmin=$v; fi
		if [ "$t" -gt "$dcut" ] && { [ -z "$dmax" ] || [ "$v" -gt "$dmax" ]; }; then dmax=$v; fi
	done
	hist=$keep
	if [ -z "$dl" ]; then dl=$amb
	elif [ -n "$bmin" ] && [ "$bmin" -gt $(( dl + (dl + 10) * UP_PCT / 100 )) ]; then dl=$bmin
	elif [ -n "$dmax" ] && [ "$dmax" -lt $(( dl - (dl + 10) * DN_PCT / 100 )) ]; then dl=$dmax
	fi

	# Pick the level. A new learned curve or the first level: no checks
	load_curve
	curve_level "$dl"; want=$CURVE_OUT
	if [ "$ALS_NIGHT_CAP" -gt 0 ] && is_night && [ "$want" -gt "$ALS_NIGHT_CAP" ]; then want=$ALS_NIGHT_CAP; fi
	[ "$want" -le "$BACKLIGHT_MAX" ] || want=$BACKLIGHT_MAX
	[ "$want" -ge "$BACKLIGHT_MIN" ] || want=$BACKLIGHT_MIN
	if [ "$cur" -eq 0 ] || [ -n "$curve_changed" ]; then
		curve_changed=
		cur=$want; last_dl=$dl; last_change=$now_cs; last_dir=0
	elif [ "$want" -ne "$cur" ]; then
		go=1
		if [ "$want" -eq $(( cur + 1 )) ] || [ "$want" -eq $(( cur - 1 )) ]; then
			# One step on a 24 step scale: the light must have moved a band from
			# the light of the last change, two bands to go back within ALS_REVERSE_S
			if [ "$want" -gt "$cur" ]; then dir=1; pct=$UP_PCT; else dir=-1; pct=$DN_PCT; fi
			thr=$(( (last_dl + 10) * pct / 100 ))
			if [ "$dir" -ne "$last_dir" ] && [ "$last_dir" -ne 0 ] && [ $(( now_cs - last_change )) -lt $(( ALS_REVERSE_S * 100 )) ]; then thr=$(( thr * 2 )); fi
			d=$(( dl - last_dl )); [ "$d" -ge 0 ] || d=$(( -d ))
			[ "$d" -gt "$thr" ] || go=
		fi
		if [ -n "$go" ]; then
			log "$((dl / 10)) lx: step $cur -> $want"
			if [ "$want" -gt "$cur" ]; then last_dir=1; else last_dir=-1; fi
			cur=$want; last_dl=$dl; last_change=$now_cs
		fi
	fi

	# Hand over to tsx-idled. Ramp the backlight while it is lit and not overridden.
	if auto_on; then
		# only a new level, or the refresh, or no file: tsx-idled needs the file
		# to be less than 30 s old
		if [ "$cur" != "$lvl_w" ] || [ $(( now - lvl_t )) -ge 15 ] || [ ! -e "$R/als-level" ]; then
			echo "$cur" > "$R/als-level.tmp" && mv -f "$R/als-level.tmp" "$R/als-level"
			lvl_w=$cur lvl_t=$now
		fi
		st=; [ -r "$IDLED" ] && read -r st _ < "$IDLED"
		# The local manual offset, as tsx-idled adds it (clamped 1..BACKLIGHT_MAX)
		off=0; [ -r "$R/brightness-offset" ] && read -r off _ < "$R/brightness-offset"
		case $off in [0-9]|[0-9][0-9]|-[0-9]|-[0-9][0-9]) ;; *) off=0;; esac
		tgt=$((cur + off)); [ "$tgt" -ge "$BACKLIGHT_MIN" ] || tgt=$BACKLIGHT_MIN; [ "$tgt" -le "$BACKLIGHT_MAX" ] || tgt=$BACKLIGHT_MAX
		if [ "$st" = on ] && [ ! -e "$R/brightness" ] && [ -n "$bd" ] && [ "$bl" -gt 0 ] && [ "$bl" -ne "$tgt" ]; then
			if [ "$ALS_RAMP_MS" -gt 0 ]; then
				b=$bl
				while [ "$b" -ne "$tgt" ]; do
					if [ "$b" -lt "$tgt" ]; then b=$((b + 1)); else b=$((b - 1)); fi
					echo "$b" > "$bd/brightness" 2>/dev/null || break
					auto_on || break   # "auto off" came in: stop the ramp
					[ "$b" -ne "$tgt" ] && nap "$ALS_RAMP_MS"
				done
			else
				echo "$tgt" > "$bd/brightness" 2>/dev/null
			fi
		fi
		a=on
	else
		[ ! -e "$R/als-level" ] || rm -f "$R/als-level"
		lvl_w=; a=off
	fi

	# Report a value for MQTT, with a deadband
	lx=$(( (dl + 5) / 10 ))
	if [ "$rep" -lt 0 ]; then rep=$lx; rep_t=$now
	else
		d=$(( lx - rep )); [ "$d" -ge 0 ] || d=$(( -d ))
		thr=$(( rep * ALS_REPORT_PCT / 100 )); [ "$thr" -ge 1 ] || thr=1
		if [ "$d" -gt "$thr" ] || [ $(( now - rep_t )) -ge "$ALS_REPORT_MAX" ]; then rep=$lx; rep_t=$now; fi
	fi
	# "auto on|off" may have come in during the ramp: report the state now
	if auto_on; then a=on; else a=off; fi
	# the state file: only new content, or every 30 s, or no file
	st_n="lux $lx${nl}raw $(( (raw + 5) / 10 ))${nl}report $rep${nl}level $cur${nl}auto $a"
	if [ "$st_n" != "$st_w" ] || [ $(( now - st_t )) -ge 60 ] || [ ! -e "$R/als.state" ]; then
		printf '%s\n' "$st_n" > "$R/als.state.tmp" && mv -f "$R/als.state.tmp" "$R/als.state"
		st_w=$st_n st_t=$now
	fi

	nap "$PER_MS"
done
