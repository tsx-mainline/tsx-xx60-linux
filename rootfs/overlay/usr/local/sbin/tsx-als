#!/bin/sh
# tsx-als: ambient light sensor -> backlight level for the xx60 kiosk.
#
#   tsx-als                 daemon (OpenRC service tsx-als)
#   tsx-als status          current lux, level, auto state
#   tsx-als auto on|off     on = back to automatic (drops the manual level
#                           and offset). Off = keep the level on the glass as
#                           a fixed level (/run/tsx/brightness). It also
#                           changes AUTO_BRIGHTNESS in panel.conf and applies
#                           it, so the setting stays after a reboot. The Home
#                           Assistant "Auto brightness" switch calls it.
#   tsx-als lux             one reading in lux (no smoothing)
#
# It reads the MAX44009 through IIO (in_illuminance_input, lux), multiplies
# it by ALS_SCALE and smooths the value. The front window passes only part of
# the light, and ALS_SCALE corrects that (lux = sensor lux x ALS_SCALE). An
# empty ALS_SCALE means 1.0. It maps the value to a backlight step with ALS_CURVE
# (/etc/tsx/als.conf) and applies hysteresis. The step goes to
# /run/tsx/als-level. tsx-idled uses that file in place of the day/night
# level while the file is fresh (< 30 s). An absolute manual level still wins
# (/run/tsx/brightness: "brightness N" key action, HA Backlight). The script
# adds the local manual setting to the step (/run/tsx/brightness-offset:
# key-strip slide, quick-settings overlay, "brightness +N/-N").
# While the screen is lit, tsx-als also ramps the backlight itself one step at
# a time, so the change is smooth and immediate. While the screen is blank,
# it never touches the backlight.
#
# panel.conf: AUTO_BRIGHTNESS and ALS_SCALE reach this script through
# /run/tsx/als.panel (written by "tsx-config apply", the lines ALS_AUTO and
# ALS_SCALE). They win over the same names in als.conf. The script reads the
# file again every 5 readings. A change of AUTO_BRIGHTNESS there (the setup
# page) acts like "tsx-als auto on|off".
#
# Learning: tsx_brightness.py (als-daemon) runs beside the loop. A manual
# change that the user holds for a few seconds becomes a point of the curve.
# The daemon writes the whole curve to /run/tsx/als-curve. The loop uses that
# file in place of ALS_CURVE while it exists and moves to the new level at
# once when the file changes (docs/adaptive-brightness.md). No level goes
# below BACKLIGHT_MIN (default 1).
#
# State for tsx-mqtt: /run/tsx/als.state ("lux N", "raw N", "report N",
# "level N", "auto on|off"). Lux values are integers.
#
# Env overrides for tests: TSX_ALS_CONF, TSX_ALS_PANEL, TSX_CONFIG_BIN, TSX_KIOSK_CONF, TSX_RUN_DIR,
# TSX_IIO_DIR, TSX_BACKLIGHT_DIR, TSX_LEARN_MOD (the path of tsx_brightness.py), TSX_IDLED_STATE, TSX_ALS_LOOPS (stop after N
# readings), TSX_ALS_NOW (fixed epoch seconds per reading: start value).
set -u
CONF=${TSX_ALS_CONF:-/etc/tsx/als.conf}
KCONF=${TSX_KIOSK_CONF:-/etc/kiosk.conf}
R=${TSX_RUN_DIR:-/run/tsx}
IIO=${TSX_IIO_DIR:-/sys/bus/iio/devices}
BLBASE=${TSX_BACKLIGHT_DIR:-/sys/class/backlight}
IDLED=${TSX_IDLED_STATE:-/run/tsx-idled.state}
PANEL=${TSX_ALS_PANEL:-$R/als.panel}
CONFIG=${TSX_CONFIG_BIN:-tsx-config}

ALS_AUTO=1 ALS_CURVE="0:3 5:5 20:8 80:12 300:17 1000:21 3000:23" ALS_INTERVAL=1
ALS_SMOOTH=5 ALS_HYST_PCT=25 ALS_HYST_ABS=2 ALS_HOLD=10 ALS_RAMP_MS=150
ALS_NIGHT_CAP=0 ALS_BL_COMP=0 ALS_REPORT_PCT=10 ALS_REPORT_MAX=300 ALS_DEVICE=auto
ALS_START_WAIT=12 ALS_SCALE=
[ -r "$CONF" ] && . "$CONF"
BACKLIGHT_MAX=23 BACKLIGHT_MIN=1 NIGHT_START=22 NIGHT_END=7
[ -r "$KCONF" ] && eval "$(grep -E '^(BACKLIGHT_MAX|BACKLIGHT_MIN|NIGHT_START|NIGHT_END)=[0-9]+$' "$KCONF")"
BOARD=${TSX_PANEL_BOARD_CONF:-/etc/tsx/panel-board.conf}
[ -r "$BOARD" ] && eval "$(grep -E '^(BACKLIGHT_MAX|BACKLIGHT_MIN)=[0-9]+$' "$BOARD")"
LEARN_MOD=${TSX_LEARN_MOD:-/usr/local/lib/tsx/tsx_brightness.py}

log() { echo "$(date '+%F %T') tsx-als: $*"; }

# The values of /run/tsx/als.panel (panel.conf). Empty = not set there.
PANEL_AUTO= PANEL_SCALE=
SCALE_MILLI=1000 scale_bad=
load_panel() {
	PANEL_AUTO= PANEL_SCALE=
	[ -r "$PANEL" ] || return 0
	PANEL_AUTO=$(sed -n 's/^ALS_AUTO="\([01]\)"$/\1/p' "$PANEL" | tail -n 1)
	PANEL_SCALE=$(sed -n 's/^ALS_SCALE="\([0-9.]*\)"$/\1/p' "$PANEL" | tail -n 1)
}

# Work out SCALE_MILLI (ALS_SCALE x 1000, an integer): the panel.conf value,
# else ALS_SCALE of als.conf, else 1.0.
load_scale() {
	s=${PANEL_SCALE:-$ALS_SCALE}; src=ALS_SCALE
	if [ -n "$s" ]; then
		if printf '%s' "$s" | grep -Eq '^[0-9]{1,4}(\.[0-9]{1,3})?$' \
			&& awk -v x="$s" 'BEGIN{exit !(x >= 0.01 && x <= 1000)}'; then
			SCALE_MILLI=$(awk -v x="$s" 'BEGIN{printf "%d", x * 1000 + 0.5}')
			scale_bad=
			return 0
		fi
		[ "$scale_bad" = "$src:$s" ] || log "bad value '$s' in $src (need 0.01 to 1000). Using 1.0"
		scale_bad="$src:$s"
	fi
	SCALE_MILLI=1000
}

# Apply a deci-lux value of the sensor: lux x scale
scale_dlux() { echo $(( ($1 * SCALE_MILLI + 500) / 1000 )); }

find_dev() {
	if [ "$ALS_DEVICE" != auto ]; then echo "$ALS_DEVICE"; return; fi
	for d in "$IIO"/iio:device*; do
		[ -r "$d/name" ] && [ "$(cat "$d/name")" = max44009 ] && { echo "$d"; return; }
	done
}

# "12.345000" -> 123 (deci-lux, integer)
read_dlux() {
	v=$(cat "$1/in_illuminance_input" 2>/dev/null) || return 1
	case $v in ''|*[!0-9.]*) return 1;; esac
	i=${v%%.*}; f=0
	case $v in *.*) f=${v#*.}; f=${f%"${f#?}"}; [ -n "$f" ] || f=0;; esac
	echo $(( ${i:-0} * 10 + f ))
}

# The learned curve (als-curve of the learning daemon), or empty
USE_CURVE= curve_changed=
load_curve() {
	c=
	[ -r "$R/als-curve" ] && read -r c < "$R/als-curve"
	if [ -n "$c" ] && ! printf '%s' "$c" | grep -Eq '^[0-9]+:[0-9]+( [0-9]+:[0-9]+)*$'; then c=; fi
	if [ "$c" != "$USE_CURVE" ]; then USE_CURVE=$c; curve_changed=1; fi
}

# deci-lux -> step (piecewise linear on the learned curve, else ALS_CURVE)
curve_level() {
	x=$1; pl=; ps=; out=
	for p in ${USE_CURVE:-$ALS_CURVE}; do
		l=$(( ${p%%:*} * 10 )); s=${p#*:}
		if [ "$x" -le "$l" ]; then
			if [ -z "$pl" ] || [ "$l" -le "$pl" ]; then out=$s
			else out=$(( ps + ((s - ps) * (x - pl) * 2 + (l - pl)) / (2 * (l - pl)) )); fi
			break
		fi
		pl=$l; ps=$s
	done
	[ -n "$out" ] || out=${ps:-1}
	echo "$out"
}

auto_on() {
	a=${PANEL_AUTO:-$ALS_AUTO}
	[ -r "$R/als-auto" ] && a=$(cat "$R/als-auto")
	case $a in 1|on|ON|yes) return 0;; esac
	return 1
}

bl_dir() { for d in "$BLBASE"/*; do [ -w "$d/brightness" ] && { echo "$d"; return; }; done; }

is_night() {
	[ "$NIGHT_START" = "$NIGHT_END" ] && return 1
	h=$(date +%H); h=${h#0}
	if [ "$NIGHT_START" -lt "$NIGHT_END" ]; then [ "$h" -ge "$NIGHT_START" ] && [ "$h" -lt "$NIGHT_END" ]
	else [ "$h" -ge "$NIGHT_START" ] || [ "$h" -lt "$NIGHT_END" ]; fi
}

# The run-time part of "auto on|off"
do_auto() {
	case $1 in
	on)  echo on > "$R/als-auto"; rm -f "$R/brightness" "$R/brightness-offset";;
	off) echo off > "$R/als-auto"
	     # Freeze what is on the glass. Otherwise the offset would suddenly
	     # apply to the day/night level instead. Use the level of tsx-idled
	     # while lit.
	     if [ ! -e "$R/brightness" ]; then
	         l=$(sed -n 's/^level //p' "$R/brightness.state" 2>/dev/null | head -n 1)
	         st=; [ -r "$IDLED" ] && read -r st _ < "$IDLED"
	         case $l in [1-9]|[1-9][0-9]) [ "$st" = on ] && echo "$l" > "$R/brightness";; esac
	     fi
	     rm -f "$R/brightness-offset" "$R/als-level";;
	esac
}

# The "auto" line of als.state follows a change at once. The daemon writes the
# file once per loop, and a ramp of the backlight can take a few seconds.
state_auto() {
	[ -r "$R/als.state" ] || return 0
	sed "s/^auto .*/auto $1/" "$R/als.state" > "$R/als.state.tmp.$$" && mv -f "$R/als.state.tmp.$$" "$R/als.state"
}

state_field() { [ -r "$R/als.state" ] && sed -n "s/^$1 //p" "$R/als.state" | head -1; }

case ${1:-} in
status)
	if [ -r "$R/als.state" ]; then cat "$R/als.state"; else echo "tsx-als not running"; fi
	[ -r "$R/brightness" ] && echo "manual override $(cat "$R/brightness")"
	[ -r "$R/brightness-offset" ] && echo "manual offset $(cat "$R/brightness-offset")"
	exit 0;;
auto)
	mkdir -p "$R"
	case ${2:-} in
	on|off) do_auto "$2"; state_auto "$2"
	     # Keep the setting in panel.conf. If that fails, the run-time change stays.
	     "$CONFIG" set AUTO_BRIGHTNESS "$2" && "$CONFIG" apply \
	         || echo "tsx-als: could not save AUTO_BRIGHTNESS in panel.conf" >&2;;
	*)   echo "usage: tsx-als auto on|off"; exit 2;;
	esac
	echo "auto ${2}"; exit 0;;
lux)
	d=$(find_dev); [ -n "$d" ] || { echo "no max44009 in $IIO" >&2; exit 1; }
	v=$(read_dlux "$d") || exit 1
	load_panel; load_scale; v=$(scale_dlux "$v")
	echo "$((v / 10)).$((v % 10))"; exit 0;;
'') ;;
*)  echo "usage: tsx-als [status | auto on|off | lux]"; exit 2;;
esac

# ---- daemon ------------------------------------------------------------------
mkdir -p "$R"
[ "$ALS_SMOOTH" -ge 1 ] 2>/dev/null || ALS_SMOOTH=1
load_panel; load_scale
seen_auto=$PANEL_AUTO
dev= acc= cur=0 last_dl=-1 last_change=0 rep=-1 rep_t=0 n=0 warned=
now=${TSX_ALS_NOW:-}
LEARN_PID=
if [ -z "${TSX_ALS_LOOPS:-}" ] && command -v python3 >/dev/null 2>&1 && [ -r "$LEARN_MOD" ]; then
	python3 "$LEARN_MOD" als-daemon &
	LEARN_PID=$!
fi
trap 'rm -f "$R/als-level"; [ -n "$LEARN_PID" ] && kill "$LEARN_PID" 2>/dev/null; exit 0' INT TERM

while :; do
	if [ -n "${TSX_ALS_LOOPS:-}" ] && [ "$n" -ge "$TSX_ALS_LOOPS" ]; then break; fi
	n=$((n + 1))
	if [ -n "${TSX_ALS_NOW:-}" ]; then now=$((now + ALS_INTERVAL)); else now=$(date +%s); fi
	[ -n "$dev" ] && [ -r "$dev/in_illuminance_input" ] || dev=$(find_dev)
	if [ -z "$dev" ]; then
		[ -n "$warned" ] || { log "no max44009 IIO device yet (CONFIG_MAX44009, DT node light-sensor@4a). Waiting"; warned=1; }
		rm -f "$R/als-level"; sleep 10; continue
	fi
	if [ $(( n % 5 )) -eq 1 ] && [ "$n" -gt 1 ]; then
		load_panel; load_scale
		# AUTO_BRIGHTNESS changed in panel.conf (the setup page): act as "auto on|off"
		if [ "$PANEL_AUTO" != "$seen_auto" ]; then
			seen_auto=$PANEL_AUTO
			case $PANEL_AUTO in 1) w=on;; 0) w=off;; *) w=;; esac
			cur_a=; [ -r "$R/als-auto" ] && cur_a=$(cat "$R/als-auto")
			if [ -n "$w" ] && [ "$cur_a" != "$w" ]; then log "panel.conf: AUTO_BRIGHTNESS $w"; do_auto "$w"; fi
		fi
	fi
	raw=$(read_dlux "$dev") || { sleep "$ALS_INTERVAL"; continue; }
	# Right after a cold boot, the MAX44009 can read 0 lx for several seconds
	# before its first conversion. If the script took that value at face
	# value, it dimmed the boot splash to the darkest step and back up 10-20 s
	# later. Until the first level, a 0 reading waits (at most ALS_START_WAIT
	# readings). There is no als-level yet, so tsx-idled keeps the level on
	# the glass (boot hold).
	if [ "$raw" -le 0 ] && [ "$cur" -eq 0 ] && [ "$n" -le "$ALS_START_WAIT" ]; then
		[ -n "${TSX_ALS_LOOPS:-}" ] || sleep "$ALS_INTERVAL"
		continue
	fi
	[ -n "$warned" ] && { log "sensor $dev: $((raw / 10)) lx"; warned=; }

	# Compensate for the own backlight
	bd=$(bl_dir); bl=0
	[ -n "$bd" ] && bl=$(cat "$bd/brightness" 2>/dev/null || echo 0)
	amb=$(( raw - ALS_BL_COMP * bl )); [ "$amb" -ge 0 ] || amb=0
	amb=$(scale_dlux "$amb")

	# Smooth the value
	if [ -z "$acc" ]; then acc=$(( amb * ALS_SMOOTH )); else acc=$(( acc - acc / ALS_SMOOTH + amb )); fi
	dl=$(( acc / ALS_SMOOTH ))

	# Pick the level with hysteresis
	load_curve
	want=$(curve_level "$dl")
	if [ "$ALS_NIGHT_CAP" -gt 0 ] && is_night && [ "$want" -gt "$ALS_NIGHT_CAP" ]; then want=$ALS_NIGHT_CAP; fi
	[ "$want" -le "$BACKLIGHT_MAX" ] || want=$BACKLIGHT_MAX
	[ "$want" -ge "$BACKLIGHT_MIN" ] || want=$BACKLIGHT_MIN
	if [ "$cur" -eq 0 ] || [ -n "$curve_changed" ]; then
		# the first level, or a new learned curve: no hysteresis
		curve_changed=
		cur=$want; last_dl=$dl; last_change=$now
	elif [ "$want" -ne "$cur" ]; then
		d=$(( dl - last_dl )); [ "$d" -ge 0 ] || d=$(( -d ))
		thr=$(( last_dl * ALS_HYST_PCT / 100 )); [ "$thr" -ge $(( ALS_HYST_ABS * 10 )) ] || thr=$(( ALS_HYST_ABS * 10 ))
		if [ "$d" -gt "$thr" ] && [ $(( now - last_change )) -ge "$ALS_HOLD" ]; then
			log "$((dl / 10)) lx: step $cur -> $want"
			cur=$want; last_dl=$dl; last_change=$now
		fi
	fi

	# Hand over to tsx-idled. Ramp the backlight while it is lit and not overridden.
	if auto_on; then
		echo "$cur" > "$R/als-level.tmp" && mv -f "$R/als-level.tmp" "$R/als-level"
		st=; [ -r "$IDLED" ] && read -r st _ < "$IDLED"
		# The local manual offset, as tsx-idled adds it (clamped 1..BACKLIGHT_MAX)
		off=0; [ -r "$R/brightness-offset" ] && read -r off _ < "$R/brightness-offset"
		case $off in [0-9]|[0-9][0-9]|-[0-9]|-[0-9][0-9]) ;; *) off=0;; esac
		tgt=$((cur + off)); [ "$tgt" -ge "$BACKLIGHT_MIN" ] || tgt=$BACKLIGHT_MIN; [ "$tgt" -le "$BACKLIGHT_MAX" ] || tgt=$BACKLIGHT_MAX
		if [ "$st" = on ] && [ ! -e "$R/brightness" ] && [ -n "$bd" ] && [ "$bl" -gt 0 ] && [ "$bl" -ne "$tgt" ]; then
			if [ "$ALS_RAMP_MS" -gt 0 ]; then
				b=$bl
				while [ "$b" -ne "$tgt" ]; do
					if [ "$b" -lt "$tgt" ]; then b=$((b + 1)); else b=$((b - 1)); fi
					echo "$b" > "$bd/brightness" 2>/dev/null || break
					auto_on || break   # "auto off" came in: stop the ramp
					[ "$b" -ne "$tgt" ] && usleep $(( ALS_RAMP_MS * 1000 ))
				done
			else
				echo "$tgt" > "$bd/brightness" 2>/dev/null
			fi
		fi
		a=on
	else
		rm -f "$R/als-level"; a=off
	fi

	# Report a value for MQTT, with a deadband
	lx=$(( (dl + 5) / 10 ))
	if [ "$rep" -lt 0 ]; then rep=$lx; rep_t=$now
	else
		d=$(( lx - rep )); [ "$d" -ge 0 ] || d=$(( -d ))
		thr=$(( rep * ALS_REPORT_PCT / 100 )); [ "$thr" -ge 1 ] || thr=1
		if [ "$d" -gt "$thr" ] || [ $(( now - rep_t )) -ge "$ALS_REPORT_MAX" ]; then rep=$lx; rep_t=$now; fi
	fi
	# "auto on|off" may have come in during the ramp: report the state now
	if auto_on; then a=on; else a=off; fi
	printf 'lux %s\nraw %s\nreport %s\nlevel %s\nauto %s\n' "$lx" "$(( (raw + 5) / 10 ))" "$rep" "$cur" "$a" > "$R/als.state.tmp" \
		&& mv -f "$R/als.state.tmp" "$R/als.state"

	[ -n "${TSX_ALS_LOOPS:-}" ] || sleep "$ALS_INTERVAL"
done
