#!/bin/sh
# tsx-mqtt: MQTT bridge between the panel kiosk and Home Assistant.
#
# It publishes HA MQTT discovery (retained) for one device with:
#   light  "LED bar"      RGB (tsx-ledbar. HA 0..255 <-> bar 0..100 per channel.
#                         Only where tsx-ledbar is installed)
#   light  "Key LEDs"     brightness 0..255 (tsx-keypad led N|off. Only with
#                         /etc/tsx/buttons.conf)
#   switch "Screen"       ON = lit, OFF = blanked (tsx-blank)
#   number "Backlight"    1..BACKLIGHT_MAX of /etc/kiosk.conf (tsx-idled override)
#   number "Blank timeout"  seconds without input before the screen goes dark,
#                         0 = never (panel.conf BLANK_TIMEOUT via tsx-config)
#   binary_sensor "Touched recently"  last real input < 30 s ago (tsx-idled's
#                         /run/tsx/last-input)
#   event  "Key NAME"     per front-panel key: short / long / hold
#   device triggers       per key: button_short_press / button_long_press
#   sensor "Illuminance"  lux of the MAX44009 (tsx-als. Only with /etc/tsx/als.conf
#                         or /run/tsx/als.state)
#   switch "Auto brightness"  tsx-als auto on|off
#   sensor "eMMC life used A/B", "eMMC end of life"  (diagnostic. Only with
#                         /run/tsx/emmc.state, which tsx-emmc-state writes)
#   number "Volume"       0..100 % of the ALSA "Master" softvol (only when the
#                         sound card exists. /etc/asound.conf)
#   update "Update"       status of tsx-autoupdate (installed and pending
#                         Alpine packages, reboot pending, Chromium hold
#                         state). Install runs "tsx-autoupdate now" in the
#                         background
# State and commands are under $BASE (default tsx/<hostname>). Availability
# uses LWT.
#
# Config /etc/tsx/mqtt.conf (empty BROKER = exit quietly). It needs
# mosquitto-clients.
# Key presses come from the "last" line of /run/tsx/buttons.state
# (tsx-buttons). Two identical presses within the same second are one event.
#
# This program is part of the Home Assistant layer (tsx-ha). It does not touch
# the hardware. Every command goes to the base system through tsx-panelctl
# (`tsx-panelctl send ...`), and so do the volume and the LED bar check
# (`tsx-panelctl get volume`, `tsx-panelctl has ledbar`). It reads the state
# files under /run/tsx, which are the event interface of the base system.
#
# Env overrides for tests: TSX_MQTT_CONF, TSX_RUN_DIR, TSX_IDLED_STATE,
# TSX_BUTTONS_CONF, TSX_KIOSK_CONF, TSX_PANELCTL_BIN, TSX_MQTT_DRY=1 (print
# instead of publish, read commands from stdin, one pass).
# TSX_MQTT_PUB_TIMEOUT=seconds limits each mosquitto_pub connect+publish
# (default 5), so an unreachable broker cannot hang the script. See pub()
# and the stop trap below.
set -u
CONF=${TSX_MQTT_CONF:-/etc/tsx/mqtt.conf}
R=${TSX_RUN_DIR:-/run/tsx}
IDLED=${TSX_IDLED_STATE:-/run/tsx-idled.state}
BCONF=${TSX_BUTTONS_CONF:-/etc/tsx/buttons.conf}
KCONF=${TSX_KIOSK_CONF:-/etc/kiosk.conf}
ACONF=${TSX_ALS_CONF:-/etc/tsx/als.conf}
. "${TSX_BOARD_CONF:-/usr/local/lib/tsx/board.sh}"
PCTL=${TSX_PANELCTL_BIN:-tsx-panelctl}   # the hardware interface of the base system
DRY=${TSX_MQTT_DRY:-0}
PUBTO=${TSX_MQTT_PUB_TIMEOUT:-5}
LASTPUBOK=1   # 0 after a publish fails or times out. The stop trap then skips the LWT offline publish

BROKER= PORT=1883 USER= PASSWORD= CAFILE= DISCOVERY_PREFIX=homeassistant NODE_ID= BASE_TOPIC= DEVICE_NAME=
[ -r "$CONF" ] && . "$CONF"
# panel.conf overrides (MQTT_HOST/PORT/USER/PASSWORD through `tsx-config apply`).
# They have the same precedence as /etc/kiosk.conf + /run/tsx/kiosk.conf in
# kiosk-session -- docs/rootfs.md "Panel configuration"
[ -r "$R/mqtt.conf" ] && . "$R/mqtt.conf"
if [ -z "$BROKER" ] && [ "$DRY" != 1 ]; then
	echo "tsx-mqtt: BROKER not set in $CONF, nothing to do"; exit 0
fi
command -v mosquitto_pub >/dev/null || [ "$DRY" = 1 ] || { echo "tsx-mqtt: mosquitto_pub missing (apk add mosquitto-clients)"; exit 1; }

HOST=$(hostname)
NODE=$(printf '%s' "${NODE_ID:-$HOST}" | tr -c 'A-Za-z0-9_-' '_')
BASE=${BASE_TOPIC:-tsx/$NODE}
DP=$DISCOVERY_PREFIX
DNAME=${DEVICE_NAME:-TSX $HOST}
M=$R/mqtt
mkdir -p "$M" && chmod 700 "$M"
log() { echo "$(date '+%F %T') tsx-mqtt: $*"; }

# Put the mosquitto client options in files (XDG_CONFIG_HOME), not on the command line.
export XDG_CONFIG_HOME=$M
{
	echo "-h $BROKER"; echo "-p $PORT"
	[ -n "$USER" ] && echo "-u $USER"
	[ -n "$PASSWORD" ] && echo "-P $PASSWORD"
	[ -n "$CAFILE" ] && echo "--cafile $CAFILE"
} > "$M/mosquitto_pub"
cp "$M/mosquitto_pub" "$M/mosquitto_sub"
chmod 600 "$M/mosquitto_pub" "$M/mosquitto_sub"

pub() {  # pub [-r] TOPIC PAYLOAD
	r=; [ "$1" = -r ] && { r=-r; shift; }
	if [ "$DRY" = 1 ]; then echo "PUB${r:+ (retained)} $1 $2"; return 0; fi
	# setsid + timeout limit connect+publish to $PUBTO seconds, even with an
	# unreachable broker. setsid puts mosquitto_pub in its own process group
	# (pgid = pid of timeout). The stop trap can then kill both with one
	# signal, and mosquitto_pub does not stay orphaned in mid-connect.
	setsid timeout "$PUBTO" mosquitto_pub -i "$NODE-pub-$$" -q 1 $r -t "$1" -m "$2" &
	pp=$!
	echo "$pp" >> "$M/pub.pids"
	wait "$pp"; rc=$?
	sed -i "/^${pp}\$/d" "$M/pub.pids" 2>/dev/null
	if [ $rc -eq 0 ]; then LASTPUBOK=1; else LASTPUBOK=0; log "publish $1 failed"; fi
	return $rc
}

# ---- helpers ---------------------------------------------------------------
BL_MAX=23
[ -r "$KCONF" ] && BL_MAX=$(sed -n 's/^BACKLIGHT_MAX=\([0-9][0-9]*\).*/\1/p' "$KCONF" | tail -1)
[ -n "$BL_MAX" ] || BL_MAX=23
# hardware only some panels have: an entity is announced only when it is
# there, and its discovery topic is cleared otherwise (so Home Assistant
# drops an entity an older build announced)
has_ledbar() { "$PCTL" has ledbar >/dev/null 2>&1; }
has_sound() { "$PCTL" has sound >/dev/null 2>&1; }
has_keypad() { [ -r "$BCONF" ]; }
has_als() { [ -r "$ACONF" ] || [ -r "$R/als.state" ]; }
has_emmc() { [ -r "$R/emmc.state" ]; }

keys() {  # names of the "button NAME KEY" lines of buttons.conf
	[ -r "$BCONF" ] && sed -n 's/^[[:space:]]*button[[:space:]]\{1,\}\([A-Za-z0-9_-]\{1,\}\)[[:space:]].*/\1/p' "$BCONF"
}

field() {  # field FILE KEY -> rest of the first line "KEY ..."
	[ -r "$1" ] && sed -n "s/^$2 //p" "$1" | head -1
}

# ---- discovery ---------------------------------------------------------------
DEV="\"dev\":{\"ids\":[\"tsx_$NODE\"],\"name\":\"$DNAME\",\"mf\":\"Crestron\",\"mdl\":\"$TSX_HA_MODEL (mainline Linux)\"}"
AV="\"avty_t\":\"$BASE/availability\""

discovery() {
	if has_ledbar; then pub -r "$DP/light/$NODE/ledbar/config" "{\"name\":\"LED bar\",\"uniq_id\":\"${NODE}_ledbar\",\"cmd_t\":\"$BASE/ledbar/set\",\"stat_t\":\"$BASE/ledbar/state\",\"bri_cmd_t\":\"$BASE/ledbar/brightness/set\",\"bri_stat_t\":\"$BASE/ledbar/brightness\",\"bri_scl\":255,\"rgb_cmd_t\":\"$BASE/ledbar/rgb/set\",\"rgb_stat_t\":\"$BASE/ledbar/rgb\",\"on_cmd_type\":\"last\",\"icon\":\"mdi:led-strip-variant\",$AV,$DEV}"
	else pub -r "$DP/light/$NODE/ledbar/config" ""; fi
	if has_keypad; then pub -r "$DP/light/$NODE/keypad/config" "{\"name\":\"Key LEDs\",\"uniq_id\":\"${NODE}_keypad\",\"cmd_t\":\"$BASE/keypad/set\",\"stat_t\":\"$BASE/keypad/state\",\"bri_cmd_t\":\"$BASE/keypad/brightness/set\",\"bri_stat_t\":\"$BASE/keypad/brightness\",\"bri_scl\":255,\"on_cmd_type\":\"brightness\",\"icon\":\"mdi:gesture-tap-button\",$AV,$DEV}"
	else pub -r "$DP/light/$NODE/keypad/config" ""; fi
	pub -r "$DP/switch/$NODE/screen/config" "{\"name\":\"Screen\",\"uniq_id\":\"${NODE}_screen\",\"cmd_t\":\"$BASE/screen/set\",\"stat_t\":\"$BASE/screen/state\",\"icon\":\"mdi:monitor\",$AV,$DEV}"
	pub -r "$DP/number/$NODE/backlight/config" "{\"name\":\"Backlight\",\"uniq_id\":\"${NODE}_backlight\",\"cmd_t\":\"$BASE/backlight/set\",\"stat_t\":\"$BASE/backlight/state\",\"min\":1,\"max\":$BL_MAX,\"step\":1,\"mode\":\"slider\",\"icon\":\"mdi:brightness-6\",$AV,$DEV}"
	pub -r "$DP/number/$NODE/blank_timeout/config" "{\"name\":\"Blank timeout\",\"uniq_id\":\"${NODE}_blank_timeout\",\"cmd_t\":\"$BASE/blank_timeout/set\",\"stat_t\":\"$BASE/blank_timeout/state\",\"min\":0,\"max\":86400,\"step\":10,\"unit_of_meas\":\"s\",\"mode\":\"box\",\"icon\":\"mdi:timer-outline\",$AV,$DEV}"
	pub -r "$DP/binary_sensor/$NODE/touched_recently/config" "{\"name\":\"Touched recently\",\"uniq_id\":\"${NODE}_touched_recently\",\"stat_t\":\"$BASE/touched_recently/state\",\"dev_cla\":\"motion\",\"icon\":\"mdi:gesture-tap\",$AV,$DEV}"
	if has_als; then
		pub -r "$DP/sensor/$NODE/illuminance/config" "{\"name\":\"Illuminance\",\"uniq_id\":\"${NODE}_illuminance\",\"stat_t\":\"$BASE/als/lux\",\"dev_cla\":\"illuminance\",\"unit_of_meas\":\"lx\",\"stat_cla\":\"measurement\",$AV,$DEV}"
		pub -r "$DP/switch/$NODE/als_auto/config" "{\"name\":\"Auto brightness\",\"uniq_id\":\"${NODE}_als_auto\",\"cmd_t\":\"$BASE/als_auto/set\",\"stat_t\":\"$BASE/als_auto/state\",\"icon\":\"mdi:brightness-auto\",$AV,$DEV}"
	fi
	if has_emmc; then
		for w in a b; do
			W=$(printf '%s' $w | tr a-z A-Z)
			pub -r "$DP/sensor/$NODE/emmc_life_$w/config" "{\"name\":\"eMMC life used $W\",\"uniq_id\":\"${NODE}_emmc_life_$w\",\"stat_t\":\"$BASE/emmc/life_$w\",\"val_tpl\":\"{{ none if value == 'none' else value | int }}\",\"unit_of_meas\":\"%\",\"stat_cla\":\"measurement\",\"ent_cat\":\"diagnostic\",\"icon\":\"mdi:harddisk\",$AV,$DEV}"
		done
		pub -r "$DP/sensor/$NODE/emmc_eol/config" "{\"name\":\"eMMC end of life\",\"uniq_id\":\"${NODE}_emmc_eol\",\"stat_t\":\"$BASE/emmc/eol\",\"ent_cat\":\"diagnostic\",\"icon\":\"mdi:harddisk-remove\",$AV,$DEV}"
	fi
	if has_sound; then
		pub -r "$DP/number/$NODE/volume/config" "{\"name\":\"Volume\",\"uniq_id\":\"${NODE}_volume\",\"cmd_t\":\"$BASE/volume/set\",\"stat_t\":\"$BASE/volume/state\",\"min\":0,\"max\":100,\"step\":1,\"unit_of_meas\":\"%\",\"mode\":\"slider\",\"icon\":\"mdi:volume-high\",$AV,$DEV}"
	fi
	pub -r "$DP/update/$NODE/update/config" "{\"name\":\"Update\",\"uniq_id\":\"${NODE}_update\",\"cmd_t\":\"$BASE/update/set\",\"stat_t\":\"$BASE/update/state\",\"icon\":\"mdi:package-up\",$AV,$DEV}"
	for k in $(keys); do
		pub -r "$DP/event/$NODE/key_$k/config" "{\"name\":\"Key $k\",\"uniq_id\":\"${NODE}_key_$k\",\"stat_t\":\"$BASE/key/$k\",\"evt_typ\":[\"short\",\"long\",\"hold\"],\"dev_cla\":\"button\",$AV,$DEV}"
		pub -r "$DP/device_automation/$NODE/key_${k}_short/config" "{\"atype\":\"trigger\",\"t\":\"$BASE/trigger/$k/short\",\"type\":\"button_short_press\",\"stype\":\"$k\",\"pl\":\"short\",$DEV}"
		pub -r "$DP/device_automation/$NODE/key_${k}_long/config" "{\"atype\":\"trigger\",\"t\":\"$BASE/trigger/$k/long\",\"type\":\"button_long_press\",\"stype\":\"$k\",\"pl\":\"long\",$DEV}"
	done
}

# ---- state -----------------------------------------------------------------
# LED bar: panel keeps "want R G B" (0..100). HA sees rgb (max channel 255) + brightness
ledbar_state() {
	w=$(field "$R/ledbar.state" want); [ -n "$w" ] || w="0 0 0"
	set -- $w
	mx=$1; [ "$2" -gt "$mx" ] && mx=$2; [ "$3" -gt "$mx" ] && mx=$3
	if [ "$mx" -gt 0 ]; then
		echo "ON $(( (mx * 255 + 50) / 100 )) $(( ($1 * 255 + mx / 2) / mx )),$(( ($2 * 255 + mx / 2) / mx )),$(( ($3 * 255 + mx / 2) / mx ))"
	else
		echo "OFF 0 0,0,0"
	fi
}
keypad_state() {
	l=$(field "$R/buttons.state" led); set -- ${l:-0 unknown}
	[ "${1:-0}" -gt 0 ] 2>/dev/null && echo "ON $1" || echo "OFF 0"
}
screen_state() {
	s=; [ -r "$IDLED" ] && read -r s lvl < "$IDLED"
	if [ "$s" = blank ]; then echo "OFF"; else echo "ON ${lvl:-}"; fi
}

blank_timeout_state() {  # seconds: tsx-config's runtime file, else kiosk.conf
	v=; [ -r "$R/blank-timeout" ] && read -r v _ < "$R/blank-timeout"
	case $v in ''|*[!0-9]*) v=$([ -r "$KCONF" ] && sed -n 's/^BLANK_TIMEOUT=\([0-9][0-9]*\).*/\1/p' "$KCONF" | tail -1);; esac
	echo "${v:-300}"
}

touched_state() {  # ON while tsx-idled saw real input in the last 30 s
	l=; [ -r "$R/last-input" ] && read -r l _ < "$R/last-input"
	case $l in ''|*[!0-9]*) echo OFF; return;; esac
	[ $(( $(date +%s) - l )) -lt 30 ] && echo ON || echo OFF
}

als_state() {  # "LUX ON|OFF" from tsx-als (lux with a reporting deadband)
	l=$(field "$R/als.state" report); a=$(field "$R/als.state" auto)
	[ -n "$l" ] && echo "$l $( [ "$a" = on ] && echo ON || echo OFF)"
}

volume_state() {  # "NN" percent of the Master softvol
	"$PCTL" get volume 2>/dev/null || true
}

emmc_life() {  # emmc_life a|b -> percent (upper bound of the JEDEC band), or none
	c=$(field "$R/emmc.state" "life_$1")
	case $c in 0x0[1-9]) echo $(( ${c#0x0} * 10 ));; 0x0[aA]) echo 100;; 0x0[bB]) echo 110;; *) echo none;; esac
}
emmc_state() {  # "LIFE_A LIFE_B EOL"
	e=$(field "$R/emmc.state" eol)
	case $e in 0x01) e=normal;; 0x02) e=warning;; 0x03) e=urgent;; *) e=unknown;; esac
	echo "$(emmc_life a) $(emmc_life b) $e"
}
update_state() {  # raw HA-ready JSON from tsx-autoupdate (same $R), or a safe default
	if [ -r "$R/update-ha-state.json" ]; then cat "$R/update-ha-state.json"
	else echo '{"installed_version":"unknown","latest_version":"unknown","title":"TSX packages","release_summary":"tsx-autoupdate has not run yet","in_progress":false}'
	fi
}

P_LED= P_KP= P_SCR= P_BL= P_ALS= P_VOL= P_UPD= P_BT= P_TR= P_EMMC=
publish_states() {  # $1 = force
	f=${1:-}
	v=$(ledbar_state); if [ "$v" != "$P_LED" ] || [ -n "${1:-}" ]; then
		set -- $v; pub -r "$BASE/ledbar/state" "$1"; pub -r "$BASE/ledbar/brightness" "$2"; pub -r "$BASE/ledbar/rgb" "$3"; P_LED=$v; fi
	v=$(keypad_state); if [ "$v" != "$P_KP" ] || [ -n "${1:-}" ]; then
		set -- $v; pub -r "$BASE/keypad/state" "$1"; pub -r "$BASE/keypad/brightness" "$2"; P_KP=$v; fi
	v=$(screen_state); if [ "$v" != "$P_SCR" ] || [ -n "${1:-}" ]; then
		set -- $v; pub -r "$BASE/screen/state" "$1"; P_SCR=$v
		if [ -n "${2:-}" ] && [ "$2" != none ] && [ "$2" != "$P_BL" ]; then pub -r "$BASE/backlight/state" "$2"; P_BL=$2; fi
	fi
	v=$(blank_timeout_state); if [ "$v" != "$P_BT" ] || [ -n "${1:-}" ]; then
		pub -r "$BASE/blank_timeout/state" "$v"; P_BT=$v; fi
	v=$(touched_state); if [ "$v" != "$P_TR" ] || [ -n "${1:-}" ]; then
		pub -r "$BASE/touched_recently/state" "$v"; P_TR=$v; fi
	v=$(als_state); if [ -n "$v" ] && { [ "$v" != "$P_ALS" ] || [ -n "${1:-}" ]; }; then
		set -- $v; pub -r "$BASE/als/lux" "$1"; pub -r "$BASE/als_auto/state" "$2"; P_ALS=$v; fi
	v=$(volume_state); if [ -n "$v" ] && { [ "$v" != "$P_VOL" ] || [ -n "${1:-}" ]; }; then
		pub -r "$BASE/volume/state" "$v"; P_VOL=$v; fi
	v=$(update_state); if [ "$v" != "$P_UPD" ] || [ -n "${1:-}" ]; then
		pub -r "$BASE/update/state" "$v"; P_UPD=$v; fi
	if has_emmc; then
		v=$(emmc_state); if [ "$v" != "$P_EMMC" ] || [ -n "$f" ]; then
			set -- $v; pub -r "$BASE/emmc/life_a" "$1"; pub -r "$BASE/emmc/life_b" "$2"; pub -r "$BASE/emmc/eol" "$3"; P_EMMC=$v; fi
	fi
}

# ---- commands --------------------------------------------------------------
# HA rgb "r,g,b" 0..255 + brightness 0..255 -> bar 0..100 per channel
ledbar_set() {  # r g b bri
	"$PCTL" send ledbar set $(( ($1 * $4 * 100 + 32512) / 65025 )) $(( ($2 * $4 * 100 + 32512) / 65025 )) $(( ($3 * $4 * 100 + 32512) / 65025 ))
}
led_rgb() { c=$(cat "$M/rgb" 2>/dev/null); echo "${c:-255,255,255}"; }
split_rgb() { c=$1; r=${c%%,*}; c=${c#*,}; g=${c%%,*}; b=${c#*,}; }
led_bri() { b=$(cat "$M/bri" 2>/dev/null); echo "${b:-255}"; }

handle() {  # topic payload
	t=${1#"$BASE"/}; p=$2
	case $t in
	ledbar/set)
		case $p in
		OFF) "$PCTL" send ledbar off;;
		ON)  if [ -e "$M/pending" ]; then rm -f "$M/pending"
		     else
			cur=$(ledbar_state); [ "${cur%% *}" = ON ] || "$PCTL" send ledbar on
		     fi;;
		esac;;
	ledbar/brightness/set)
		case $p in *[!0-9]*|'') return;; esac
		echo "$p" > "$M/bri"; split_rgb "$(led_rgb)"
		ledbar_set "$r" "$g" "$b" "$p"; : > "$M/pending";;
	ledbar/rgb/set)
		split_rgb "$p"
		case "$r$g$b" in *[!0-9]*|'') return;; esac
		echo "$r,$g,$b" > "$M/rgb"
		cur=$(ledbar_state); set -- $cur
		bri=$(led_bri); [ "$1" = ON ] && bri=$2; [ "$bri" -gt 0 ] || bri=255
		ledbar_set "$r" "$g" "$b" "$bri"; : > "$M/pending";;
	keypad/set)
		case $p in OFF) "$PCTL" send keypad led off;; ON) "$PCTL" send keypad led auto;; esac;;
	keypad/brightness/set)
		case $p in *[!0-9]*|'') return;; esac
		[ "${#p}" -le 3 ] || return
		if [ "$p" -le 0 ]; then "$PCTL" send keypad led off
		else [ "$p" -le 255 ] || p=255; "$PCTL" send keypad led "$p"; fi;;
	volume/set)
		p=${p%%.*}; case $p in *[!0-9]*|'') return;; esac
		[ "$p" -le 100 ] || p=100
		"$PCTL" send volume "$p";;
	als_auto/set)
		case $p in ON) "$PCTL" send als auto on;; OFF) "$PCTL" send als auto off;; esac;;
	screen/set)
		case $p in ON) "$PCTL" send blank off;; OFF) "$PCTL" send blank on;; esac;;
	backlight/set)
		p=${p%%.*}; case $p in *[!0-9]*|'') return;; esac
		[ "${#p}" -le 5 ] || return
		[ "$p" -ge 1 ] || p=1; [ "$p" -le "$BL_MAX" ] || p=$BL_MAX; [ "$p" -le 31 ] || p=31
		"$PCTL" send backlight "$p";;      # the base system sets the tsx-idled override and the device
	blank_timeout/set)
		p=${p%%.*}; case $p in *[!0-9]*|'') return;; esac
		[ "${#p}" -le 5 ] && [ "$p" -le 86400 ] || return
		"$PCTL" send blank-timeout "$p";;
	update/set)
		"$PCTL" send update-install;;
	*) return;;
	esac
	: > "$M/poke"
}

# ---- key events --------------------------------------------------------------
P_KEY=
check_keys() {
	v=$(field "$R/buttons.state" last)
	[ "$v" = "$P_KEY" ] && return
	old=$P_KEY; P_KEY=$v
	[ -n "$old" ] || return 0            # first read after start: no event
	set -- $v; [ $# -ge 2 ] || return 0
	case $1 in none) return 0;; esac
	pub "$BASE/key/$1" "{\"event_type\":\"$2\"}"
	case $2 in short|long) pub "$BASE/trigger/$1/$2" "$2";; esac
}

# ---- main ------------------------------------------------------------------
if [ "$DRY" = 1 ]; then
	discovery; publish_states force
	while read -r topic payload; do handle "$topic" "$payload"; done
	P_KEY=${TSX_MQTT_PREV_KEY:-}; check_keys
	exit 0
fi

rm -f "$M/pending" "$M/poke" "$M/republish" "$M/pub.pids"
mkfifo "$M/sub.fifo" 2>/dev/null || { rm -f "$M/sub.fifo"; mkfifo "$M/sub.fifo"; }
mosquitto_sub -i "$NODE-sub" -q 1 -v -t "$BASE/+/set" -t "$BASE/+/+/set" -t "$DP/status" \
	--will-topic "$BASE/availability" --will-payload offline --will-retain > "$M/sub.fifo" &
SUB=$!
HANDLER=   # set below. A signal that lands before that must not hit set -u

stop() {
	kill $SUB 2>/dev/null
	[ -n "$HANDLER" ] && kill $HANDLER 2>/dev/null
	# Kill any publisher that is still stuck in connect (the whole setsid group: timeout + mosquitto_pub)
	if [ -s "$M/pub.pids" ]; then
		while read -r pp; do [ -n "$pp" ] && kill -TERM -- "-$pp" 2>/dev/null; done < "$M/pub.pids"
		# That publish is dead, not finished. Its own pub() never got back to
		# set LASTPUBOK (this code runs from inside its wait, through the trap).
		LASTPUBOK=0
	fi
	[ "$LASTPUBOK" = 0 ] || pub -r "$BASE/availability" offline
	rm -f "$M/sub.fifo" "$M/pub.pids"
	exit 0
}
trap stop INT TERM

( while read -r topic payload; do
	if [ "$topic" = "$DP/status" ]; then [ "$payload" = online ] && : > "$M/republish"; continue; fi
	handle "$topic" "$payload" 2>&1 | sed 's/^/cmd: /'
  done < "$M/sub.fifo" ) &
HANDLER=$!

sleep 1
kill -0 $SUB 2>/dev/null || { log "cannot connect to $BROKER:$PORT"; exit 1; }
discovery
pub -r "$BASE/availability" online
publish_states force
P_KEY=$(field "$R/buttons.state" last)
log "connected to $BROKER:$PORT as $BASE ($(keys | wc -l) keys)"

i=0
while kill -0 $SUB 2>/dev/null; do
	check_keys
	i=$((i + 1))
	if [ -e "$M/republish" ]; then rm -f "$M/republish"; sleep 1; discovery; pub -r "$BASE/availability" online; publish_states force
	elif [ -e "$M/poke" ] || [ $i -ge 8 ]; then rm -f "$M/poke"; i=0; publish_states
	fi
	sleep 0.25
done
log "subscriber ended (broker gone?). Restarting"
kill $HANDLER 2>/dev/null
exit 1
