#!/bin/sh
# tsx-config: read and write the one configuration file of the panel, and
# apply it to the running services. The same script runs on the panel, in
# host-side installer tooling (TSX_CONF pointed at a build-time file), and
# in the on-panel setup page (tsx-setupd, docs/rootfs.md "Setup page"). It
# uses busybox ash and plain POSIX sh only (`busybox sh -n`), no bash syntax.
#
#   tsx-config get KEY            print the value (empty + exit 1 if unset)
#   tsx-config set KEY VALUE      validate + write (creates the file/dir)
#   tsx-config validate KEY VALUE same checks as set, exit status only, never
#                                  writes. The setup page validates a field
#                                  before it submits it. A stray or unknown
#                                  key is also "invalid" and never dies.
#   tsx-config unset KEY          remove a key
#   tsx-config show               print every set key (secrets masked)
#   tsx-config apply              (panel, root) regenerate the small
#                                  /run/tsx/*.conf overrides that the services
#                                  read after their own defaults, and act on
#                                  the settings that are not only a file
#                                  (hostname, root password, ssh key, voice
#                                  enable/disable). The tsx-config OpenRC
#                                  service runs it early at boot.
#   tsx-config setup               (panel, root) show the on-panel setup page
#                                  for one ~15 min window even if KIOSK_URL is
#                                  already set. It touches /run/tsx/setup-open
#                                  and restarts the kiosk service if it is up.
#
# File: $TSX_CONF (default /data/tsx/panel.conf). It has KEY="value" lines,
# one setting per line, '#' comments and blank lines. No service ever `.`
# sources it. The parser reads only literal text after the first '=', and
# nothing in the file is executed. The file has mode 600, because several
# keys are secrets (HA_TOKEN, HA_API_KEY, MQTT_PASSWORD, ROOT_PASSWORD_HASH,
# SSH_AUTHORIZED_KEY).
#
# Keys:
# PANEL_NAME, KIOSK_URL, HA_LOGIN_METHOD (token|trusted), HA_TOKEN, TZ_NAME,
# VOICE (on|off), WAKE_WORD.
# HA_TRANSPORT (esphome|mqtt|both), see docs/ha.md "One Home Assistant device":
#   esphome = one zero-config Home Assistant device over the ESPHome native
#             API, with no broker. It is tsx-esphome, or the voice satellite
#             itself when VOICE=on.
#   mqtt    = the tsx-mqtt bridge only. It needs MQTT_HOST.
#   both    = run whichever of the two are configured.
# HA_API_KEY: the ESPHome API encryption key. It is 32 random bytes, base64,
#   like `api: encryption: key:` of ESPHome. The same text goes into Home
#   Assistant. Empty = plaintext, the zero-config default -- docs/ha.md
#   "Security".
# HA_ALLOW_FROM: comma list of IPv4/IPv6 addresses or CIDRs that can use the
#   ESPHome API. Empty = allow any, the zero-config default.
# MQTT_HOST, MQTT_PORT, MQTT_USER, MQTT_PASSWORD, KERNEL_FLAVOR (lts|stable).
# APK_URL: base URL of the apk repositories of this project (tsx-aports).
#   apply rewrites the two lines <APK_URL>/<alpine-branch>/common and
#   .../xx60 (the repository category of the board) at the top of /etc/apk/repositories. Unset = the build default
#   in /etc/tsx/apk-url.default. "off" = leave them out.
# BLANK_TIMEOUT: seconds without input before the screen goes dark, 0 =
#   never. It replaces BLANK_TIMEOUT of kiosk.conf through
#   /run/tsx/blank-timeout, which tsx-idled watches. It is the Home
#   Assistant "Blank timeout" number.
# BOOT_VERBOSE: 1 = kernel and boot text on the LCD instead of the boot
#   splash, from the next boot on. Apply keeps the flag file
#   /etc/tsx/boot-verbose on the root file system. The initramfs reads it,
#   because it cannot read /data.
# ORIENTATION (landscape | portrait | landscape-flipped | portrait-flipped):
#   how the panel hangs, see tsx-orientation. Apply keeps
#   /etc/tsx/orientation on the root file system for the initramfs, the
#   splash, the kiosk and tsx-buttons, and turns the running kiosk at once.
# BT_PROXY (on|off|empty, default empty = the board default, off on the
#   xx60): the Bluetooth proxy for Home
#   Assistant (docs/ha.md "Bluetooth proxy"). The board default comes from
#   TSX_BT_PROXY_DEFAULT (a board file sets it). Apply writes /run/tsx/bt.conf
#   (world-readable, no secret) for tsx-bt and both ESPHome front ends, and
#   starts or stops the tsx-bt service when the value changes.
# BT_ACTIVE (on|off, default off): with BT_PROXY=on, also active connections:
#   Home Assistant can connect to BLE devices through the panel (GATT).
#   Apply writes it to bt.conf and restarts the ESPHome front end, so that
#   Home Assistant reads the new feature flags.
# BT_MAC: the Bluetooth address that tsx-bt loads into the chip. Empty = the
#   eth0 MAC, the same value as the vendor firmware.
# AUTO_BRIGHTNESS (on|off, default on): the backlight follows the ambient
#   light sensor (tsx-als). Apply writes it to /run/tsx/als.panel, which
#   tsx-als reads in place of ALS_AUTO of /etc/tsx/als.conf. `tsx-als auto`
#   and the Home Assistant "Auto brightness" switch write this key.
# ALS_SCALE (lux = sensor lux x this; 0.01-1000; empty = 1.0, for example
#   a factor for the front glass). Apply writes it to /run/tsx/als.panel. The curve and the timing stay in
#   /etc/tsx/als.conf.
# A panel without a microphone or a Bluetooth module (government=1, the
# TSW-760-NC: /run/tsx/hw.conf, written by tsx-hw at boot) accepts VOICE=on,
# BT_PROXY=on and BT_ACTIVE=on, so that a panel.conf from another panel
# still loads. set and show print a warning, and apply treats them as off.
# ROOT_PASSWORD_HASH, SSH_AUTHORIZED_KEY.
# See installer/panel.conf.example and docs/rootfs.md "Panel configuration"
# for what each key does.
set -eu
TSX_CONF=${TSX_CONF:-/data/tsx/panel.conf}
RUN=${TSX_RUN:-/run}/tsx
STATE=${TSX_STATE_DIR:-/var/lib/tsx}
SEED=${TSX_CONF_SEED:-/etc/tsx/panel.conf.seed}
# PREFIX: hook for host tests only (rootfs/tests/, ci/). `apply` writes every
# real system path outside $TSX_CONF/$RUN/$STATE/$SEED (already overridable
# above) as "$PREFIX/etc/shadow" and so on. So a test can point a whole
# fixture tree at it. If PREFIX is empty (the panel default), the paths stay
# absolute.
PREFIX=${TSX_APPLY_PREFIX:-}
# The hardware facts of the panel (tsx-hw detect, at boot). A missing file
# (host tooling, an early boot) means a panel with all parts.
HW_CONF=${TSX_HW_CONF:-$RUN/hw.conf}
# The board values (TSX_FAMILY, TSX_APK_CATEGORY, TSX_BT_PROXY_DEFAULT,
# TSX_BT_MAC_SETTABLE). Test hook: TSX_BOARD_CONF. The installer runs this
# script from a checkout of the repository on a host. There the board file is
# next to it.
BOARD=${TSX_BOARD_CONF:-/usr/local/lib/tsx/board.sh}
[ -r "$BOARD" ] || BOARD=$(dirname "$0")/../lib/tsx/board.sh
. "$BOARD"

KNOWN_KEYS="PANEL_NAME KIOSK_URL HA_LOGIN_METHOD HA_TOKEN TZ_NAME VOICE WAKE_WORD HA_TRANSPORT HA_API_KEY HA_ALLOW_FROM MQTT_HOST MQTT_PORT MQTT_USER MQTT_PASSWORD KERNEL_FLAVOR APK_URL BLANK_TIMEOUT BOOT_VERBOSE ORIENTATION BT_PROXY BT_ACTIVE BT_MAC AUTO_BRIGHTNESS ALS_SCALE ROOT_PASSWORD_HASH SSH_AUTHORIZED_KEY"
SECRET_KEYS="HA_TOKEN HA_API_KEY MQTT_PASSWORD ROOT_PASSWORD_HASH SSH_AUTHORIZED_KEY"

usage() { sed -n '2,91p' "$0" >&2; exit 2; }
die() { echo "tsx-config: ERROR: $*" >&2; exit 2; }
log() { echo "tsx-config: $*" >&2; }

key_known() {
	case " $KNOWN_KEYS " in *" $1 "*) return 0;; esac
	return 1
}
is_secret() {
	case " $SECRET_KEYS " in *" $1 "*) return 0;; esac
	return 1
}

hw_get() { sed -n "s/^$1=//p" "$HW_CONF" 2>/dev/null | tail -n 1; }

# hw_missing KEY: if KEY=on cannot work on this panel, print why and
# succeed. Else fail and print nothing.
hw_missing() {
	case "$1" in
	VOICE) [ "$(hw_get MIC)" = no ] || return 1
		echo "this panel has no microphone (government=$(hw_get GOVERNMENT))";;
	BT_PROXY|BT_ACTIVE) [ "$(hw_get BT)" = no ] || return 1
		echo "this panel has no Bluetooth module (government=$(hw_get GOVERNMENT))";;
	BT_MAC) [ "$TSX_BT_MAC_SETTABLE" = no ] || return 1
		echo "this board takes the Bluetooth address from the controller";;
	AUTO_BRIGHTNESS|ALS_SCALE) [ "$(hw_get ALS)" = no ] || return 1
		echo "this panel has no ambient light sensor";;
	*) return 1;;
	esac
}

# hw_warn KEY VALUE [VERB]: the warning for an "on" that the panel cannot use
hw_warn() {
	[ "$2" = on ] || return 0
	why=$(hw_missing "$1") || return 0
	log "WARNING: $1=on ${3:-is set}, but $why. apply treats it as off"
}

# Escape a value for the OWN panel.conf storage of this script (unquote()
# below reverses it). Escape only the backslash and the double quote. No
# service ever `.` sources panel.conf, so `$` and backtick need no special
# handling here.
store_esc() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# Escape a value for embedding in double quotes in a file that this script
# generates and WILL later `.` source itself (the run/tsx/*.conf overrides,
# apply() below). Backslash, double quote, `$` and backtick are the four
# characters that are special inside POSIX double quotes.
shq() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\$/\\$/g; s/`/\\`/g'
}

val_ok() {
	k=$1; v=$2
	# Reject a value that contains a literal embedded newline. Command
	# substitution would strip a trailing one, so this is a real newline
	# written into the script, not $(printf '\n').
	nl='
'
	case "$v" in *"$nl"*) return 1;; esac
	case "$k" in
	PANEL_NAME) printf '%s' "$v" | grep -Eq '^[A-Za-z0-9-]{1,63}$';;
	KIOSK_URL) printf '%s' "$v" | grep -Eq '^https?://[^[:space:]]+$';;
	HA_LOGIN_METHOD) case "$v" in token|trusted) return 0;; esac; return 1;;
	HA_TOKEN) printf '%s' "$v" | grep -Eq '^[A-Za-z0-9._-]{20,}$';;
	TZ_NAME) printf '%s' "$v" | grep -Eq '^[A-Za-z0-9_+/-]{1,64}$';;
	VOICE) case "$v" in on|off) return 0;; esac; return 1;;
	WAKE_WORD) printf '%s' "$v" | grep -Eq '^[a-z0-9_]{1,32}$';;
	HA_TRANSPORT) case "$v" in esphome|mqtt|both) return 0;; esac; return 1;;
	# Canonical base64 of exactly 32 bytes (44 characters, one '='). The last
	# data character carries only 2 bits, so only 16 values are valid.
	HA_API_KEY) [ -z "$v" ] && return 0; printf '%s' "$v" | grep -Eq '^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$';;
	HA_ALLOW_FROM)
		[ -z "$v" ] && return 0   # empty = allow any (zero-config default)
		# Peel the list apart with parameter expansion, not with `set -- $v`
		# or IFS field splitting. An unquoted `set --` here would also
		# pathname-expand any glob metacharacter in a comma-separated item.
		rest=$v
		while [ -n "$rest" ]; do
			case "$rest" in *,*) item=${rest%%,*}; rest=${rest#*,};; *) item=$rest; rest=;; esac
			item=$(trim "$item")
			[ -n "$item" ] || return 1
			addr=$item; pfx=
			case "$item" in
			*/*) addr=${item%/*}; pfx=${item#*/}
				printf '%s' "$pfx" | grep -Eq '^[0-9]{1,3}$' || return 1;;
			esac
			case "$addr" in
			*:*)
				printf '%s' "$addr" | grep -Eq '^[0-9A-Fa-f:]+$' || return 1
				[ -z "$pfx" ] || [ "$pfx" -le 128 ] || return 1;;
			*)
				printf '%s' "$addr" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
				for oct in $(printf '%s' "$addr" | tr '.' ' '); do
					[ "$oct" -le 255 ] || return 1
				done
				[ -z "$pfx" ] || [ "$pfx" -le 32 ] || return 1;;
			esac
		done
		return 0;;
	MQTT_HOST) [ -z "$v" ] && return 0; printf '%s' "$v" | grep -Eq '^[A-Za-z0-9.:_-]+$';;
	MQTT_PORT) [ -z "$v" ] && return 0; printf '%s' "$v" | grep -Eq '^[0-9]{1,5}$';;
	MQTT_USER) [ -z "$v" ] && return 0; printf '%s' "$v" | grep -Eq '^[A-Za-z0-9_.@-]+$';;
	MQTT_PASSWORD) return 0;;
	KERNEL_FLAVOR) case "$v" in lts|stable) return 0;; esac; return 1;;
	# An http(s) mirror, a local directory (a LAN copy on a USB stick), or off
	APK_URL) [ "$v" = off ] && return 0; printf '%s' "$v" | grep -Eq '^(https?://[A-Za-z0-9.:@_~%+-]+(/[^[:space:]]*)?|/[^[:space:]]*)$';;
	# seconds, 0 = never, at most a day
	BLANK_TIMEOUT) printf '%s' "$v" | grep -Eq '^[0-9]{1,5}$' && [ "$v" -le 86400 ];;
	BOOT_VERBOSE) case "$v" in 0|1) return 0;; esac; return 1;;
	ORIENTATION) case "$v" in landscape|portrait|landscape-flipped|portrait-flipped) return 0;; esac; return 1;;
	BT_PROXY) case "$v" in on|off|"") return 0;; esac; return 1;;
	BT_ACTIVE) case "$v" in on|off) return 0;; esac; return 1;;
	AUTO_BRIGHTNESS) case "$v" in on|off|"") return 0;; esac; return 1;;
	# lux = sensor lux x ALS_SCALE; empty = 1.0
	ALS_SCALE) [ -z "$v" ] && return 0; printf '%s' "$v" | grep -Eq '^[0-9]{1,4}(\.[0-9]{1,3})?$' && awk -v x="$v" 'BEGIN{exit !(x >= 0.01 && x <= 1000)}';;
	# empty = derived from eth0. A unicast address, not all zeros
	BT_MAC) [ -z "$v" ] && return 0; printf '%s' "$v" | grep -Eq '^[0-9A-Fa-f][02468ACEace](:[0-9A-Fa-f]{2}){5}$' \
		&& [ "$v" != 00:00:00:00:00:00 ];;
	ROOT_PASSWORD_HASH) printf '%s' "$v" | grep -Eq '^\$[0-9A-Za-z$./]{10,}$';;
	SSH_AUTHORIZED_KEY) printf '%s' "$v" | grep -Eq '^(ssh-[a-z0-9]+|ecdsa-sha2-[a-z0-9-]+) [A-Za-z0-9+/]+=*([[:space:]].*)?$';;
	*) return 1;;
	esac
}

# Strip one layer of surrounding quotes from an already-trimmed value. For
# double quotes, unescape \" and \\. For single quotes, keep the text
# literal, with no escapes.
unquote() {
	v=$1
	case "$v" in
	\"*\") v=${v#\"}; v=${v%\"}; v=$(printf '%s' "$v" | sed 's/\\"/"/g; s/\\\\/\\/g');;
	\'*\') v=${v#\'}; v=${v%\'};;
	esac
	printf '%s' "$v"
}
trim() { printf '%s' "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | tr -d '\r'; }

# cfg_get KEY: print the value on stdout. Exit 1 (nothing printed) if the
# file is missing or the key is not set. It tolerates stray or unknown lines
# elsewhere in the file (an older tsx-config can read a newer panel.conf),
# and blank lines and comments. It reads only text after the first '=', and
# never executes anything in the file.
cfg_get() {
	k=$1
	[ -r "$TSX_CONF" ] || return 1
	found=1
	while IFS= read -r rawline || [ -n "$rawline" ]; do
		line=$(trim "$rawline")
		[ -n "$line" ] || continue
		case "$line" in \#*) continue;; esac
		case "$line" in "$k"=*) ;; *) continue;; esac
		v=$(trim "${line#*=}")
		v=$(unquote "$v")
		found=0
	done < "$TSX_CONF"
	[ $found = 0 ] || return 1
	printf '%s\n' "$v"
}

cfg_set() {
	k=$1; v=$2
	key_known "$k" || die "unknown key: $k"
	val_ok "$k" "$v" || die "invalid value for $k"
	d=$(dirname "$TSX_CONF")
	mkdir -p "$d"; chmod 700 "$d" 2>/dev/null || true
	if [ ! -f "$TSX_CONF" ]; then
		{ echo "# /data/tsx/panel.conf: $TSX_FAMILY panel configuration (tsx-config)."
		  echo "# One KEY=\"value\" setting per line. Never sourced directly by any"
		  echo "# service -- edit only with tsx-config get/set/show, or a factory"
		  echo "# reinstall/upgrade may not read a hand-broken line."
		} > "$TSX_CONF"
		chmod 600 "$TSX_CONF"
	fi
	esc=$(store_esc "$v")
	tmp="$TSX_CONF.tmp.$$"
	if grep -Eq "^[[:space:]]*$k=" "$TSX_CONF" 2>/dev/null; then
		awk -v k="$k" -v line="$k=\"$esc\"" '
			{ if ($0 ~ "^[[:space:]]*" k "=") { if (!done) { print line; done = 1 } } else print }
		' "$TSX_CONF" > "$tmp"
	else
		cat "$TSX_CONF" > "$tmp" 2>/dev/null || : > "$tmp"
		printf '%s\n' "$k=\"$esc\"" >> "$tmp"
	fi
	mv "$tmp" "$TSX_CONF"; chmod 600 "$TSX_CONF"
	hw_warn "$k" "$v" "is saved"
}

cfg_unset() {
	k=$1
	[ -f "$TSX_CONF" ] || return 0
	tmp="$TSX_CONF.tmp.$$"
	awk -v k="$k" '$0 !~ "^[[:space:]]*" k "="' "$TSX_CONF" > "$tmp" && mv "$tmp" "$TSX_CONF" && chmod 600 "$TSX_CONF"
}

cfg_show() {
	# Always exit 0. If the last known key is not set, that must not leak
	# through as the exit status of this function (and of `tsx-config show`).
	# A caller that pipes the output (for example `tsx-config show | grep ...`)
	# must see the exit status of grep, not an unrelated "last key was unset".
	for k in $KNOWN_KEYS; do
		v=$(cfg_get "$k") || continue
		is_secret "$k" && v="********"
		printf '%s=%s\n' "$k" "$v"
	done
	for k in VOICE BT_PROXY BT_ACTIVE AUTO_BRIGHTNESS; do
		v=$(cfg_get "$k") || continue
		hw_warn "$k" "$v" 2>&1 | sed 's/^tsx-config: /# /' >&2
	done
	warn_open_api
	clock_status
	return 0
}

# The NTP state of the clock, for people (stderr, like the warning below).
# The panel has no RTC. Until chrony has synced, the time is the last saved one.
clock_status() {
	command -v "${TSX_CHRONYC:-chronyc}" >/dev/null 2>&1 || return 0
	now=$(date '+%F %T %Z')
	t=$("${TSX_CHRONYC:-chronyc}" -n tracking 2>/dev/null) || { echo "# clock: $now, chronyd not running" >&2; return 0; }
	if echo "$t" | grep -q '^Leap status *: Normal'; then
		ref=$(echo "$t" | sed -n 's/^Reference ID *: [0-9A-Fa-f]* (\(.*\))$/\1/p')
		echo "# clock: $now, NTP synced (${ref:-?})" >&2
	else
		echo "# clock: $now, NOT synced yet (the time is the last saved one)" >&2
	fi
}

# Warn when the ESPHome API has neither a key nor an allow-list. Then anyone
# on the LAN can use it (docs/ha.md "Security").
warn_open_api() {
	key=$(cfg_get HA_API_KEY) || key=
	allow=$(cfg_get HA_ALLOW_FROM) || allow=
	[ -z "$key" ] && [ -z "$allow" ] || return 0
	echo "# WARNING: the ESPHome API (port 6053) is open: no HA_API_KEY and" >&2
	echo "#   HA_ALLOW_FROM is empty, so any host on the LAN can reboot this panel" >&2
	echo "#   or change its kiosk URL. Set HA_API_KEY (encryption key, made with" >&2
	echo "#   head -c 32 /dev/urandom | base64) and/or HA_ALLOW_FROM (the address" >&2
	echo "#   of your Home Assistant host) -- docs/ha.md \"Security\"." >&2
}

# ---- apply: boot-time materialisation (panel only) -------------------------
write_override() {  # write_override PATH [MODE] < lines (empty stdin -> remove PATH); MODE default 600
	path=$1; mode=${2:-600}; tmp="$path.tmp.$$"
	cat > "$tmp"
	if [ -s "$tmp" ]; then chmod "$mode" "$tmp"; mv "$tmp" "$path"
	else rm -f "$tmp" "$path"; fi
}

seed_promote() {
	[ -s "$SEED" ] || return 0
	[ -s "$TSX_CONF" ] && return 0
	case "$TSX_CONF" in /data/*) mountpoint -q /data 2>/dev/null || return 0;; esac
	d=$(dirname "$TSX_CONF"); mkdir -p "$d"; chmod 700 "$d" 2>/dev/null || true
	cp "$SEED" "$TSX_CONF" && chmod 600 "$TSX_CONF" && rm -f "$SEED" \
		&& log "promoted $SEED to $TSX_CONF (installer-provided config, first boot with /data available)"
}

# APK_URL: the two apk repositories of this project (tsx-aports common +
# xx60). They are always listed FIRST in /etc/apk/repositories, because
# tsx-xx60-chromium must win the tie with the own chromium of Alpine (see
# "Which chromium wins" in the tsx-aports README). The script rewrites only
# the marked block, and only when it changes. The Alpine lines and anything
# else that a user added stay as they are.
APK_MARK="# tsx-aports (tsx-config apply; panel.conf APK_URL)"
apk_repos() {
	repos=$PREFIX/etc/apk/repositories
	[ -f "$repos" ] || return 0
	url=$(cfg_get APK_URL) || url=
	[ -n "$url" ] || url=$(head -n 1 "$PREFIX/etc/tsx/apk-url.default" 2>/dev/null) || url=
	[ -n "$url" ] || url=https://tsx-aports.unexceptional.net
	url=${url%/}
	# Take the Alpine branch from the Alpine main line (v3.24, edge), else from alpine-release.
	br=$(sed -nE 's#^[[:space:]]*[^#].*/(v[0-9][0-9.]*|edge)/main/*[[:space:]]*$#\1#p' "$repos" | head -n 1)
	[ -n "$br" ] || br=v$(cut -d. -f1-2 "$PREFIX/etc/alpine-release" 2>/dev/null)
	[ "$br" != v ] || { log "WARNING: APK_URL: cannot tell the Alpine branch; $repos left as it is"; return 0; }
	tmp="$repos.tmp.$$"
	{
		echo "$APK_MARK"
		if [ "$url" = off ]; then
			echo "#   APK_URL=off: this project's repositories are not used"
		else
			echo "$url/$br/common"
			echo "$url/$br/$TSX_APK_CATEGORY"
		fi
		# Everything else, minus an earlier block and any other copy of the
		# two repositories of this project (/<branch>/common, /<branch>/$TSX_APK_CATEGORY)
		grep -vE '^# tsx-aports |^#   APK_URL=off|/(v[0-9][0-9.]*|edge)/(common|'"$TSX_APK_CATEGORY"')/*[[:space:]]*$' "$repos"
	} > "$tmp"
	if cmp -s "$tmp" "$repos"; then rm -f "$tmp"; return 0; fi
	chmod 644 "$tmp" && mv "$tmp" "$repos" && log "apk repositories: tsx-aports at $url ($br). The next apk update / tsx-autoupdate check uses it"
}

apply() {
	[ "${TSX_APPLY_ALLOW_NONROOT:-0}" = 1 ] || [ "$(id -u)" = 0 ] || die "apply must run as root"
	mkdir -p "$RUN"
	seed_promote
	if [ ! -r "$TSX_CONF" ]; then log "no $TSX_CONF: nothing to apply"; return 0; fi

	name=$(cfg_get PANEL_NAME) || name=
	if [ -n "$name" ]; then printf '%s\n' "$name" > "$RUN/panel-name"; else rm -f "$RUN/panel-name"; fi

	{
		url=$(cfg_get KIOSK_URL) || url=
		[ -n "$url" ] && printf 'KIOSK_URL="%s"\n' "$(shq "$url")"
		tz=$(cfg_get TZ_NAME) || tz=
		[ -n "$tz" ] && printf 'TZ_NAME="%s"\n' "$(shq "$tz")"
	} | write_override "$RUN/kiosk.conf" 644   # read by kiosk-session as the kiosk user (no secrets in it)

	{ [ -n "$name" ] && printf 'SENDSPIN_NAME="%s"\n' "$(shq "$name")"; } | write_override "$RUN/sendspin.conf"

	# BLANK_TIMEOUT: a plain number for tsx-idled (inotify, so it applies at
	# once). Unset = BLANK_TIMEOUT of kiosk.conf again. The script rewrites it
	# only when it changed, because every write wakes tsx-idled.
	bt=$(cfg_get BLANK_TIMEOUT) || bt=
	if [ -n "$bt" ]; then
		[ "$(cat "$RUN/blank-timeout" 2>/dev/null)" = "$bt" ] || printf '%s\n' "$bt" | write_override "$RUN/blank-timeout" 644
	else
		rm -f "$RUN/blank-timeout"
	fi

	{
		[ -n "$name" ] && printf 'NAME="%s"\n' "$(shq "$name")"
		ww=$(cfg_get WAKE_WORD) || ww=
		[ -n "$ww" ] && printf 'WAKE_WORD="%s"\n' "$(shq "$ww")"
	} | write_override "$RUN/voice.conf"

	{
		h=$(cfg_get MQTT_HOST) || h=
		[ -n "$h" ] && printf 'BROKER="%s"\n' "$(shq "$h")"
		p=$(cfg_get MQTT_PORT) || p=
		[ -n "$p" ] && printf 'PORT="%s"\n' "$(shq "$p")"
		u=$(cfg_get MQTT_USER) || u=
		[ -n "$u" ] && printf 'USER="%s"\n' "$(shq "$u")"
		pw=$(cfg_get MQTT_PASSWORD) || pw=
		[ -n "$pw" ] && printf 'PASSWORD="%s"\n' "$(shq "$pw")"
	} | write_override "$RUN/mqtt.conf"

	voice=$(cfg_get VOICE) || voice=
	# No microphone: the voice satellite never runs, whatever VOICE says.
	if hw_missing VOICE >/dev/null; then hw_warn VOICE "$voice"; voice=off; fi
	if command -v tsx-audio >/dev/null 2>&1; then
		case "$voice" in
		on) tsx-audio enable voice >/dev/null 2>&1 || true;;
		off) tsx-audio disable voice >/dev/null 2>&1 || true;;
		esac
	fi

	# HA_API_KEY: /run/tsx/esphome.key, mode 640 group kiosk. tsx-esphome
	# (root) and the voice satellite (user kiosk) read it at start. If the
	# file exists but cannot be read, both refuse to start rather than
	# serve plaintext (rootfs/voice/shim/tsx_panel/security.py). The script
	# writes it under umask 077 first, so it is never world-readable, not
	# even briefly.
	key=$(cfg_get HA_API_KEY) || key=
	keysum=
	if [ -n "$key" ]; then
		tmp="$RUN/esphome.key.tmp.$$"
		(umask 077; printf '%s\n' "$key" > "$tmp")
		if ! chgrp kiosk "$tmp" 2>/dev/null && [ "$(id -u)" = 0 ]; then
			log "WARNING: could not give group kiosk read access to $RUN/esphome.key: the voice satellite (VOICE=on) will refuse to start"
		fi
		chmod 640 "$tmp" && mv "$tmp" "$RUN/esphome.key"
		keysum=$(printf '%s' "$key" | sha256sum | cut -d' ' -f1)
	else
		rm -f "$RUN/esphome.key"
	fi

	# HA_TRANSPORT/HA_ALLOW_FROM: world-readable (neither has a secret,
	# unlike the other overrides above). The own ESPHome plugin of the voice
	# satellite (rootfs/voice/shim/tsx_lva) reads this file directly. It runs
	# as kiosk:audio and cannot read $TSX_CONF (mode 600). tsx-esphome (root)
	# reads the same file too, so there is one code path instead of two (see
	# rootfs/voice/shim/tsx_panel/security.py).
	transport=$(cfg_get HA_TRANSPORT) || transport=esphome
	allow=$(cfg_get HA_ALLOW_FROM) || allow=
	tmp="$RUN/esphome.conf.tmp.$$"
	{
		printf 'TRANSPORT="%s"\n' "$(shq "$transport")"
		printf 'ALLOW_FROM="%s"\n' "$(shq "$allow")"
	} > "$tmp" && mv "$tmp" "$RUN/esphome.conf" && chmod 644 "$RUN/esphome.conf"
	# AUTO_BRIGHTNESS and ALS_SCALE: /run/tsx/als.panel for tsx-als (shell-style
	# KEY="value" lines, only the keys that are set). tsx-als reads it every
	# few seconds, so it needs no restart. AUTO_BRIGHTNESS goes in as
	# ALS_AUTO=1|0, the name that als.conf uses.
	{
		ab=$(cfg_get AUTO_BRIGHTNESS) || ab=
		if hw_missing AUTO_BRIGHTNESS >/dev/null; then hw_warn AUTO_BRIGHTNESS "$ab"; ab=; fi
		case "$ab" in on) printf 'ALS_AUTO="1"\n';; off) printf 'ALS_AUTO="0"\n';; esac
		sv=$(cfg_get ALS_SCALE) || sv=
		[ -n "$sv" ] && printf 'ALS_SCALE="%s"\n' "$(shq "$sv")"
		true
	} | write_override "$RUN/als.panel" 644

	# BT_PROXY/BT_ACTIVE/BT_MAC: /run/tsx/bt.conf, world-readable (no
	# secret). tsx-bt (root), tsx-btscan (it connects only with ACTIVE=on)
	# and the Bluetooth proxy of both ESPHome front ends
	# (rootfs/voice/shim/tsx_panel/bluetooth.py) read it. The voice satellite
	# runs as kiosk and cannot read $TSX_CONF.
	btp=$(cfg_get BT_PROXY) || btp=
	[ -n "$btp" ] || btp=$TSX_BT_PROXY_DEFAULT
	bta=$(cfg_get BT_ACTIVE) || bta=off
	# No Bluetooth module: bt.conf says off, so tsx-bt and both ESPHome
	# front ends never offer the proxy.
	if hw_missing BT_PROXY >/dev/null; then
		hw_warn BT_PROXY "$btp"; hw_warn BT_ACTIVE "$bta"; btp=off bta=off
	fi
	btm=$(cfg_get BT_MAC) || btm=
	if [ -n "$btm" ] && why=$(hw_missing BT_MAC); then log "WARNING: BT_MAC=$btm is set, but $why. apply leaves it out"; btm=; fi
	tmp="$RUN/bt.conf.tmp.$$"
	{
		printf 'PROXY="%s"\n' "$(shq "$btp")"
		printf 'ACTIVE="%s"\n' "$(shq "$bta")"
		printf 'MAC="%s"\n' "$(shq "$btm")"
	} > "$tmp" && mv "$tmp" "$RUN/bt.conf" && chmod 644 "$RUN/bt.conf"
	# The tsx-bt service (the Bluetooth controller and the scanner) follows
	# BT_PROXY and BT_MAC. At boot this apply runs before tsx-bt starts, and
	# there is no signature yet: do nothing then. The restart of tsx-bt also
	# reloads a changed BT_MAC. It runs before the ESPHome restarts below, so
	# that they find the new /run/tsx/bt.mac.
	bsig="$btp|$btm"
	oldbsig=; [ -r "$RUN/.bt-sig" ] && oldbsig=$(cat "$RUN/.bt-sig")
	printf '%s\n' "$bsig" > "$RUN/.bt-sig"
	if [ -n "$oldbsig" ] && [ "$bsig" != "$oldbsig" ] && command -v rc-service >/dev/null 2>&1; then
		if [ "$btp" = on ]; then
			rc-service tsx-bt restart >/dev/null 2>&1 || true
		else
			rc-service tsx-bt stop >/dev/null 2>&1 || true
		fi
		log "BT_PROXY=$btp: tsx-bt $([ "$btp" = on ] && echo restarted || echo stopped)"
	fi

	# The same warning as `show` (docs/ha.md "Security"). Not with HA_TRANSPORT=mqtt.
	[ "$transport" = mqtt ] || warn_open_api

	# HA_TRANSPORT and VOICE together decide whether tsx-esphome (the
	# standalone ESPHome device) must run. Its own start()
	# makes the same check. It is always in the default runlevel (like
	# tsx-mqtt), so restart it only if it is already up. At boot, this
	# apply() runs before the runlevel entry of tsx-esphome starts it. Then
	# there is nothing to restart yet, and the restart does nothing.
	# Restart it only when something that it reads changed (esphome.conf, the
	# panel name, VOICE, the API key, BT_PROXY, BT_ACTIVE: Home Assistant reads
	# the Bluetooth feature flags only when it connects). tsx-esphome itself runs `tsx-config
	# apply` for its Kiosk URL entity. An unconditional restart killed it in
	# the middle of that command (and dropped the connection of Home Assistant
	# each time).
	sig="$(cat "$RUN/esphome.conf" 2>/dev/null)|$name|$voice|$keysum|$btp|$bta"
	oldsig=; [ -r "$RUN/.esphome-sig" ] && oldsig=$(cat "$RUN/.esphome-sig")
	printf '%s\n' "$sig" > "$RUN/.esphome-sig"
	if [ "$sig" != "$oldsig" ] && command -v rc-service >/dev/null 2>&1 && rc-service tsx-esphome status >/dev/null 2>&1; then
		rc-service tsx-esphome restart >/dev/null 2>&1 || true
	fi
	# The voice satellite also reads the panel name (device name) and the API
	# key at start, and it announces the Bluetooth feature flags. Restart it
	# when one of them changed and it is running. Do not
	# restart it on the first apply after boot (no signature yet), because that
	# apply runs before tsx-voice starts. Its kiosk URL entity runs `apply`
	# through tsx-panelctl, which changes neither, so that never restarts it.
	vsig="$name|$keysum|$btp|$bta"
	oldvsig=; [ -r "$RUN/.voice-sig" ] && oldvsig=$(cat "$RUN/.voice-sig")
	printf '%s\n' "$vsig" > "$RUN/.voice-sig"
	if [ -n "$oldvsig" ] && [ "$vsig" != "$oldvsig" ] && command -v rc-service >/dev/null 2>&1 \
		&& rc-service tsx-voice status >/dev/null 2>&1; then
		rc-service tsx-voice restart >/dev/null 2>&1 || true
	fi
	# tsx-buttons reads the kiosk URL (front-key "home", its HA origin) from
	# kiosk.conf + this override only at start and reload. Reload it when the
	# override changed (for example at the first save of the setup page). Do
	# not reload it on the first apply after boot (no signature yet, and
	# tsx-buttons has not started).
	ksig=$(cat "$RUN/kiosk.conf" 2>/dev/null) || ksig=   # no override (no KIOSK_URL/TZ_NAME): set -e
	kfirst=1; oldksig=; [ -e "$RUN/.kiosk-sig" ] && { kfirst=0; oldksig=$(cat "$RUN/.kiosk-sig"); }
	printf '%s\n' "$ksig" > "$RUN/.kiosk-sig"
	if [ "$kfirst" = 0 ] && [ "$ksig" != "$oldksig" ] && command -v rc-service >/dev/null 2>&1 \
		&& rc-service tsx-buttons status >/dev/null 2>&1; then
		rc-service tsx-buttons reload >/dev/null 2>&1 || true
	fi

	apk_repos

	# BOOT_VERBOSE=1: boot text on the LCD instead of the splash, from the
	# next boot on (rootfs/initramfs/overlay/init reads the flag file).
	bv=$(cfg_get BOOT_VERBOSE) || bv=
	if [ "$bv" = 1 ]; then
		if [ ! -e "$PREFIX/etc/tsx/boot-verbose" ]; then
			mkdir -p "$PREFIX/etc/tsx" && : > "$PREFIX/etc/tsx/boot-verbose" \
				&& log "BOOT_VERBOSE=1: boot text on the screen from the next boot on"
		fi
	elif [ -e "$PREFIX/etc/tsx/boot-verbose" ] && [ "$(cat "$PREFIX/etc/tsx/profile" 2>/dev/null)" != console ]; then
		# The console profile (/etc/tsx/profile) always shows the text console
		# and keeps the flag file. It never shows the splash.
		rm -f "$PREFIX/etc/tsx/boot-verbose" && log "BOOT_VERBOSE off: boot splash from the next boot on"
	fi

	# ORIENTATION: /etc/tsx/orientation on the root file system (read by the
	# initramfs, tsx-splash, kiosk-session and tsx-buttons. Absent =
	# landscape). Only written when it changes. A change turns the running
	# kiosk at once (tsx-orientation apply: sway transform + touch mapping).
	or=$(cfg_get ORIENTATION) || or=
	[ "$or" = landscape ] && or=
	orf=$PREFIX/etc/tsx/orientation
	orcur=$(cat "$orf" 2>/dev/null) || orcur=
	if [ "$or" != "$orcur" ]; then
		if [ -n "$or" ]; then
			mkdir -p "$PREFIX/etc/tsx" && printf '%s\n' "$or" > "$orf.tmp.$$" \
				&& chmod 644 "$orf.tmp.$$" && mv "$orf.tmp.$$" "$orf"
		else
			rm -f "$orf"
		fi
		log "ORIENTATION=${or:-landscape}: the kiosk now, the boot splash and boot text from the next boot on"
		if command -v "${TSX_ORIENTATION_BIN:-tsx-orientation}" >/dev/null 2>&1; then
			TSX_ORIENTATION_FILE=$orf "${TSX_ORIENTATION_BIN:-tsx-orientation}" apply || true
		fi
	fi

	method=$(cfg_get HA_LOGIN_METHOD) || method=
	tok=$(cfg_get HA_TOKEN) || tok=
	if [ "$method" = token ] && [ -n "$tok" ]; then
		mkdir -p "$STATE"
		newsum=$(printf '%s' "$tok" | sha256sum | cut -d' ' -f1)
		oldsum=; [ -r "$STATE/.ha-token-applied" ] && oldsum=$(cat "$STATE/.ha-token-applied")
		if [ "$newsum" != "$oldsum" ]; then
			mkdir -p "$PREFIX/var/lib/kiosk"
			umask 077; printf '%s' "$tok" > "$PREFIX/var/lib/kiosk/pending-token"
			printf '%s' "$newsum" > "$STATE/.ha-token-applied"
			log "HA_TOKEN changed: staged as $PREFIX/var/lib/kiosk/pending-token (seeded at the next kiosk start)"
		fi
	fi

	# ROOT_PASSWORD_HASH (set by the installer or the setup page) goes into
	# /etc/shadow when it is new to this panel, or when root has no usable
	# password (an empty or locked field: a fresh image, or a reinstall).
	# After that, a password that a person sets on the console with `passwd`
	# stays: the next boot does not put the old hash back. The state file
	# keeps the checksum of the hash that apply used last. It never holds
	# the hash itself.
	hash=$(cfg_get ROOT_PASSWORD_HASH) || hash=
	if [ -n "$hash" ] && [ -r "$PREFIX/etc/shadow" ]; then
		cur=$(awk -F: '$1=="root"{print $2}' "$PREFIX/etc/shadow")
		hsum=$(printf '%s' "$hash" | sha256sum | cut -d' ' -f1)
		hold=; [ -r "$STATE/.root-hash-applied" ] && hold=$(cat "$STATE/.root-hash-applied")
		usable=1; case "$cur" in ''|'!'*|'*'*) usable=0;; esac
		if [ "$cur" != "$hash" ] && { [ "$hsum" != "$hold" ] || [ "$usable" = 0 ]; }; then
			tmp="$PREFIX/etc/shadow.tmp.$$"
			(umask 077; awk -F: -v h="$hash" 'BEGIN{OFS=":"} { if ($1=="root") $2=h; print }' "$PREFIX/etc/shadow" > "$tmp") \
				&& cat "$tmp" > "$PREFIX/etc/shadow" && rm -f "$tmp" \
				&& log "root password hash updated from panel.conf"
		fi
		if [ "$hsum" != "$hold" ]; then
			mkdir -p "$STATE" && (umask 077; printf '%s' "$hsum" > "$STATE/.root-hash-applied")
		fi
	fi

	key=$(cfg_get SSH_AUTHORIZED_KEY) || key=
	if [ -n "$key" ]; then
		mkdir -p "$PREFIX/root/.ssh"; chmod 700 "$PREFIX/root/.ssh"
		if ! grep -qxF "$key" "$PREFIX/root/.ssh/authorized_keys" 2>/dev/null; then
			printf '%s\n' "$key" >> "$PREFIX/root/.ssh/authorized_keys"
			chmod 600 "$PREFIX/root/.ssh/authorized_keys"
			log "SSH_AUTHORIZED_KEY added to $PREFIX/root/.ssh/authorized_keys (existing keys are kept. panel.conf never removes a key)"
		fi
	fi
	log "apply done"
}

# setup: show the on-panel setup page (tsx-setupd) for one ~15 min window,
# even if the panel is already configured. This is the CLI form of the
# "Setup" overlay entry (the "setup" command of tsx-panelctl,
# docs/rootfs.md "Setup page"). It touches only a runtime flag. kiosk-session,
# tsx-kiosk-url and tsx-setupd all read the age of the flag. It never edits
# panel.conf.
#
# The flag holds monotonic time (seconds since boot, /proc/uptime), NOT
# date +%s. The panel has no RTC, so it boots with a stale clock, and NTP
# steps that clock by months once chrony syncs (docs/boot.md). A wall-clock
# timestamp written just before that step would read as expired at once, or
# as good for months. Both are wrong. /run is tmpfs, so a reboot (a new boot,
# a new uptime epoch) always clears this file anyway.
setup() {
	[ "${TSX_APPLY_ALLOW_NONROOT:-0}" = 1 ] || [ "$(id -u)" = 0 ] || die "setup must run as root"
	mkdir -p "$RUN"
	(awk '{print int($1)}' /proc/uptime 2>/dev/null || echo 0) > "$RUN/setup-open"
	log "local setup page enabled for about 15 minutes (/run/tsx/setup-open)"
	if command -v rc-service >/dev/null 2>&1 && rc-service kiosk status >/dev/null 2>&1; then
		rc-service kiosk restart >/dev/null 2>&1 \
			&& log "kiosk restarted: showing it now" \
			|| log "kiosk restart failed. It will show at the next kiosk (re)start"
	fi
}

CMD=${1:-}
[ $# -ge 1 ] && shift || true
case "$CMD" in
get) [ $# = 1 ] || usage; key_known "$1" || die "unknown key: $1"; cfg_get "$1" || exit 1;;
set) [ $# = 2 ] || usage; cfg_set "$1" "$2";;
validate) [ $# = 2 ] || usage; key_known "$1" && val_ok "$1" "$2" || exit 1;;
unset) [ $# = 1 ] || usage; key_known "$1" || die "unknown key: $1"; cfg_unset "$1";;
show) [ $# = 0 ] || usage; cfg_show;;
apply) [ $# = 0 ] || usage; apply;;
setup) [ $# = 0 ] || usage; setup;;
*) usage;;
esac
