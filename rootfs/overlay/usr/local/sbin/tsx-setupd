#!/usr/bin/env python3
"""tsx-setupd: the on-panel first-boot setup page (PLAN.md section 16 item 3,
docs/rootfs.md "Setup page").

Runs as the UNPRIVILEGED "tsx-setup" system user, always, in the default
runlevel -- not root: unlike tsx-mqtt/tsx-esphome, this daemon parses HTTP
from the LAN before any pairing has happened, so it is given no privilege at
all. Serves a small dark, touch-friendly page:

  * on the panel itself, over loopback (http://127.0.0.1:PORT/setup) --
    kiosk-session loads this instead of Home Assistant whenever no KIOSK_URL
    is configured, or for one ~15 minute window after `tsx-config setup` /
    the overlay "Setup" entry. Loopback never needs a pairing code.
  * from a laptop/phone on the LAN (http://<panel-ip>:PORT/setup) -- only
    while unconfigured or during that same ~15 minute window (lan_allowed()
    below), and only after typing the pairing code shown on the panel's own
    screen (never sent to a LAN client any other way). A correct code pairs
    that browser (a session cookie) for the rest of the window. Outside
    that window the process does not even listen on a LAN-reachable address
    (ServerManager below rebinds to loopback-only), not just refuse at the
    HTTP layer.

Every privileged action -- reading or writing panel.conf (mode 600,
root-owned), applying it, restarting the kiosk, changing the root password
-- goes through tsx-setup-helper, a small root daemon with a fixed,
line-based command set (rootfs/overlay/usr/local/sbin/tsx-setup-helper);
this process never runs a shell built from form input, and the one
privilege-free check (`tsx-config validate KEY VALUE`, the exact same regex
table `tsx-config set` itself uses) runs directly, since it touches no file.

Secrets (HA_TOKEN, MQTT_PASSWORD, SSH_AUTHORIZED_KEY, the root password) are
never echoed back to a client or written to this process's own log: the
state API reports only whether such a key is already set, never its value
(the same masking `tsx-config show` does, reused here rather than
reimplemented), and nothing about a POST body is ever logged.

Env overrides for host tests (rootfs/tests/test-setup.sh): TSX_SETUP_PORT,
TSX_SETUP_CONF, TSX_RUN_DIR, TSX_CONFIG_BIN, TSX_SETUP_HELPER_REQ,
TSX_SETUP_HELPER_RESP, TSX_ZONEINFO_DIR, TSX_SETUP_NO_ZEROCONF=1.
"""
import json
import os
import re
import secrets
import select
import socket
import ssl
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

TSX_CONFIG_BIN = os.environ.get("TSX_CONFIG_BIN", "tsx-config")
ZONEINFO_DIR = os.environ.get("TSX_ZONEINFO_DIR", "/usr/share/zoneinfo")
RUN_DIR = os.environ.get("TSX_RUN_DIR", "/run/tsx")
CONF_PATH = os.environ.get("TSX_SETUP_CONF", "/etc/tsx/setup.conf")
NO_ZEROCONF = os.environ.get("TSX_SETUP_NO_ZEROCONF", "0") == "1"


def load_conf(path):
    cfg = {}
    try:
        with open(path, "r", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                k, v = k.strip(), v.strip()
                if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
                    v = v[1:-1]
                cfg[k] = v
    except OSError:
        pass
    return cfg


_conf = load_conf(CONF_PATH)
try:
    PORT = int(_conf.get("TSX_SETUP_PORT") or "8080")
except ValueError:
    PORT = 8080
LAN_ON = (_conf.get("TSX_SETUP_LAN") or "on").strip().lower() != "off"
try:
    WINDOW = int(_conf.get("TSX_SETUP_WINDOW") or "900")
except ValueError:
    WINDOW = 900


# ---- tsx-config validate (needs no privilege: key_known/val_ok touch no
# file, so this runs directly, unprivileged -- no need to bother root for a
# pure yes/no check) --------------------------------------------------------

def _run(argv, **kw):
    kw.setdefault("capture_output", True)
    kw.setdefault("timeout", 10)
    try:
        return subprocess.run(argv, **kw)
    except (OSError, subprocess.SubprocessError) as e:
        class _Fake:
            returncode = 1
            stdout = b""
            stderr = str(e).encode()
        return _Fake()


def tcfg_validate(key, val):
    if "\n" in val or "\r" in val:
        return False
    return _run([TSX_CONFIG_BIN, "validate", key, val]).returncode == 0


# ---- tsx-setup-helper: the ONLY way this (unprivileged) process ever reads
# or writes panel.conf, applies it, restarts the kiosk, or changes the root
# password. rootfs/overlay/usr/local/sbin/tsx-setup-helper, its own root
# daemon, is the one process with that privilege; every request here is one
# line, argv-shaped ("CMD KEY VALUE"), never a shell string. ----------------

HELPER_REQ = os.environ.get("TSX_SETUP_HELPER_REQ", os.path.join(RUN_DIR, "setup-helper"))
HELPER_RESP = os.environ.get("TSX_SETUP_HELPER_RESP", os.path.join(RUN_DIR, "setup-helper.resp"))
HELPER_TIMEOUT = float(os.environ.get("TSX_SETUP_HELPER_TIMEOUT", "8"))
_helper_lock = threading.Lock()


def _helper_drain(path):
    """Best-effort: discard any bytes already sitting in RESP before sending
    a new request, in case an earlier transaction's reader gave up early
    (tsx-setup-helper's own writes never block -- see its comments -- so a
    stale reply can otherwise sit there for the next, unrelated request)."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
        return
    try:
        while True:
            try:
                if not os.read(fd, 4096):
                    break
            except (BlockingIOError, OSError):
                break
    finally:
        os.close(fd)


def helper_call(line):
    """One request, one reply. Returns (ok, text). Never raises: any failure
    (helper not running, timeout, closed channel) comes back as (False,
    message) so a caller can turn it into a normal HTTP error instead of a
    crash."""
    with _helper_lock:
        _helper_drain(HELPER_RESP)
        try:
            wfd = os.open(HELPER_REQ, os.O_WRONLY | os.O_NONBLOCK)
        except OSError as e:
            return False, "tsx-setup-helper not listening: %s" % e
        try:
            os.write(wfd, (line + "\n").encode())
        except OSError as e:
            os.close(wfd)
            return False, "tsx-setup-helper: write failed: %s" % e
        os.close(wfd)
        try:
            rfd = os.open(HELPER_RESP, os.O_RDONLY | os.O_NONBLOCK)
        except OSError as e:
            return False, "tsx-setup-helper response channel: %s" % e
        try:
            buf = b""
            deadline = time.monotonic() + HELPER_TIMEOUT
            while b"\n" not in buf:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    return False, "tsx-setup-helper did not answer in time"
                r, _w, _x = select.select([rfd], [], [], remaining)
                if not r:
                    continue
                chunk = os.read(rfd, 4096)
                if not chunk:
                    return False, "tsx-setup-helper closed the response channel"
                buf += chunk
        finally:
            os.close(rfd)
    resp = buf.split(b"\n", 1)[0].decode(errors="replace")
    if resp.startswith("ok"):
        return True, resp[2:].lstrip()
    if resp.startswith("err "):
        return False, resp[4:]
    return False, "unexpected reply from tsx-setup-helper"


def tcfg_show():
    ok, text = helper_call("show")
    if not ok:
        sys.stderr.write("tsx-setupd: tsx-config show via helper failed: %s\n" % text)
        return {}
    fields = {}
    for line in text.replace("\x01", "\n").splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            fields[k] = v
    return fields


def tcfg_set(key, val):
    if "\n" in val or "\r" in val:
        return False, "value cannot contain a newline"
    return helper_call("set %s %s" % (key, val))


def tcfg_unset(key):
    helper_call("unset %s" % key)


def tcfg_apply():
    return helper_call("apply")


# is_configured() is polled forever (ServerManager.watch_forever, every
# POLL_S) as well as once per request (lan_allowed()); a short cache keeps
# an idle, already-configured panel from forking tsx-config/reading
# panel.conf over the helper every single second for the rest of its life.
# A save (handle_submit) calls restart_kiosk()/clear_setup_open() directly
# anyway, so the only effect of this cache is a few extra seconds before a
# freshly-configured panel's LAN listener closes, not before HA loads.
_CONFIGURED_CACHE_S = 4.0
_configured_cache = {"at": float("-inf"), "val": False}
_configured_cache_lock = threading.Lock()


def is_configured():
    with _configured_cache_lock:
        now = time.monotonic()
        if now - _configured_cache["at"] > _CONFIGURED_CACHE_S:
            v = tcfg_show().get("KIOSK_URL")
            _configured_cache["val"] = bool(v and v.strip())
            _configured_cache["at"] = now
        return _configured_cache["val"]


def _invalidate_configured_cache():
    """Called right after a successful save: is_configured() otherwise
    might not notice for up to _CONFIGURED_CACHE_S, which would make the
    state API's own response to that same save look stale."""
    with _configured_cache_lock:
        _configured_cache["at"] = float("-inf")


def _run_flag_path():
    return os.path.join(RUN_DIR, "setup-open")


def _uptime_seconds():
    """Monotonic (seconds since boot), never wall-clock: the panel has no
    RTC, so it boots with a stale clock that NTP steps by months once
    chrony syncs; a wall-clock comparison spanning that step would read a
    just-opened window as instantly expired or good for months. /run is
    tmpfs, so a reboot always starts both the flag and this clock fresh
    together. Matches tsx-kiosk-url and tsx-config setup, which read the
    same file the same way in shell (awk over /proc/uptime)."""
    try:
        with open("/proc/uptime") as f:
            return int(float(f.read().split()[0]))
    except (OSError, ValueError, IndexError):
        return 0


def setup_open_fresh():
    try:
        with open(_run_flag_path(), "r") as f:
            opened_at = int(f.read().strip())
    except (OSError, ValueError):
        return False
    now = _uptime_seconds()
    return 0 <= now - opened_at <= WINDOW


def clear_setup_open():
    helper_call("clear-setup-open")


def lan_allowed():
    return LAN_ON and (not is_configured() or setup_open_fresh())


def restart_kiosk():
    helper_call("kiosk-restart")


def set_root_password(pw):
    if "\n" in pw or "\r" in pw or len(pw) < 8:
        return False
    ok, _text = helper_call("rootpw %s" % pw)
    return ok


# ---- time zone list ---------------------------------------------------

_TZ_FALLBACK = ["UTC", "America/New_York", "America/Chicago", "America/Denver",
                "America/Los_Angeles", "America/Anchorage", "Europe/London",
                "Europe/Berlin", "Europe/Madrid", "Asia/Tokyo", "Asia/Shanghai",
                "Asia/Kolkata", "Australia/Sydney", "Pacific/Auckland"]
_TZ_SKIP_DIRS = {"posix", "right", "SystemV"}
_TZ_SKIP_FILES = {"posixrules", "leapseconds", "tzdata.zi", "iso3166.tab",
                   "zone.tab", "zone1970.tab", "leap-seconds.list", "Factory"}


def zone_list():
    try:
        zones = []
        for root, dirs, files in os.walk(ZONEINFO_DIR):
            dirs[:] = [d for d in dirs if d not in _TZ_SKIP_DIRS and not d.startswith(".")]
            rel = os.path.relpath(root, ZONEINFO_DIR)
            for fn in files:
                if fn in _TZ_SKIP_FILES or fn.endswith(".tab") or "." in fn:
                    continue
                zones.append(fn if rel == "." else "%s/%s" % (rel, fn))
        zones = sorted(set(zones))
        if zones:
            return zones
    except OSError:
        pass
    return _TZ_FALLBACK


# ---- Home Assistant discovery (best effort) --------------------------

def discover_ha(timeout=1.8):
    if NO_ZEROCONF:
        return None
    try:
        from zeroconf import Zeroconf, ServiceBrowser
    except ImportError:
        return None
    found = {}

    class _Listener:
        def add_service(self, zc, type_, name):
            try:
                info = zc.get_service_info(type_, name, timeout=1200)
            except Exception:
                info = None
            if info is not None:
                found["info"] = info

        def remove_service(self, *a, **k):
            pass

        def update_service(self, *a, **k):
            pass

    zc = None
    try:
        zc = Zeroconf()
        ServiceBrowser(zc, "_home-assistant._tcp.local.", _Listener())
        time.sleep(timeout)
    except Exception:
        return None
    finally:
        if zc is not None:
            try:
                zc.close()
            except Exception:
                pass
    info = found.get("info")
    if info is None:
        return None
    props = {}
    try:
        for k, v in (info.properties or {}).items():
            k = k.decode(errors="replace") if isinstance(k, bytes) else k
            v = v.decode(errors="replace") if isinstance(v, bytes) else v
            props[k] = v
    except Exception:
        pass
    base = props.get("base_url") or props.get("internal_url") or props.get("external_url")
    if base:
        return base
    try:
        addr = None
        if hasattr(info, "parsed_addresses"):
            addrs = info.parsed_addresses()
            addr = addrs[0] if addrs else None
        if not addr and getattr(info, "addresses", None):
            addr = socket.inet_ntoa(info.addresses[0])
        if addr:
            return "http://%s:%s" % (addr, info.port)
    except Exception:
        pass
    return None


# ---- checking a Home Assistant URL from the panel ----------------------

class _SchemeLockedRedirect(urllib.request.HTTPRedirectHandler):
    """Follow at most a few redirects, and never to a scheme other than
    http/https (a plain urllib opener has no handler installed for
    file:/ftp:/etc. anyway, so those already fail -- this also refuses a
    redirect to something like data: or a custom scheme some server might
    offer, and caps the hop count tighter than urllib's default of 10)."""
    max_redirections = 4

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        scheme = urllib.parse.urlsplit(newurl).scheme.lower()
        if scheme not in ("http", "https"):
            raise urllib.error.HTTPError(newurl, code, "refusing a redirect to a non-http(s) URL", headers, fp)
        return super().redirect_request(req, fp, code, msg, headers, newurl)


_HA_CHECK_OPENER = urllib.request.build_opener(_SchemeLockedRedirect)


def check_ha_url(url):
    url = (url or "").strip()
    if not re.match(r"^https?://[^\s]+$", url):
        return {"ok": False, "kind": "invalid", "message": "must start with http:// or https://"}
    target = url.rstrip("/") + "/manifest.json"
    req = urllib.request.Request(target, headers={"User-Agent": "tsx-setupd"})
    try:
        with _HA_CHECK_OPENER.open(req, timeout=5) as resp:
            # a small cap regardless of what Content-Length claims: read()
            # on an HTTPResponse stops at n bytes even if the server keeps
            # sending, so this can never be tricked into buffering more
            body = resp.read(4096)
            looks_like_ha = b"Home Assistant" in body
            msg = "Reachable" if looks_like_ha else \
                "Reachable, but the response did not look like Home Assistant's manifest"
            return {"ok": True, "kind": "ok", "matched_ha": looks_like_ha, "message": msg}
    except ssl.SSLError as e:
        return {"ok": False, "kind": "tls", "message": "TLS error: %s" % e}
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            return {"ok": True, "kind": "ok", "matched_ha": False,
                    "message": "Reachable (HTTP %d); it asked for auth, which is normal" % e.code}
        return {"ok": False, "kind": "http", "message": "HTTP %d from the server" % e.code}
    except urllib.error.URLError as e:
        reason = e.reason
        if isinstance(reason, ssl.SSLError):
            return {"ok": False, "kind": "tls", "message": "TLS error: %s" % reason}
        if isinstance(reason, socket.gaierror):
            return {"ok": False, "kind": "dns", "message": "could not resolve that host name"}
        if isinstance(reason, socket.timeout):
            return {"ok": False, "kind": "timeout", "message": "timed out waiting for a response"}
        if isinstance(reason, ConnectionRefusedError) or "refused" in str(reason).lower():
            return {"ok": False, "kind": "refused", "message": "connection refused: nothing is listening there"}
        return {"ok": False, "kind": "network", "message": str(reason)[:200]}
    except socket.timeout:
        return {"ok": False, "kind": "timeout", "message": "timed out waiting for a response"}
    except ValueError as e:
        return {"ok": False, "kind": "invalid", "message": str(e)[:200]}
    except Exception as e:  # never let a check crash the request handler
        return {"ok": False, "kind": "error", "message": str(e)[:200]}


# ---- LAN pairing (loopback never needs any of this) --------------------

class Pairing:
    def __init__(self):
        self.lock = threading.Lock()
        self.code = None
        self.code_at = 0.0
        self.sessions = {}   # token -> expires_at (time.monotonic())
        self.attempts = {}   # ip -> [count, first_attempt_at]

    def current_code(self):
        with self.lock:
            now = time.monotonic()
            if self.code is None or now - self.code_at > WINDOW:
                self.code = "%06d" % secrets.randbelow(1000000)
                self.code_at = now
            return self.code, self.code_at

    def allow_attempt(self, ip):
        with self.lock:
            now = time.monotonic()
            rec = self.attempts.get(ip)
            if rec is None or now - rec[1] > WINDOW:
                self.attempts[ip] = [1, now]
                return True
            rec[0] += 1
            rec[1] = now
            return rec[0] <= 10   # 10 tries per window per source address

    def check_and_pair(self, code):
        with self.lock:
            now = time.monotonic()
            if self.code is None or now - self.code_at > WINDOW:
                return None
            if not code or code != self.code:
                return None
            token = secrets.token_urlsafe(24)
            self.sessions = {t: e for t, e in self.sessions.items() if e > now}
            self.sessions[token] = now + WINDOW
            return token

    def session_valid(self, token):
        if not token:
            return False
        with self.lock:
            exp = self.sessions.get(token)
            return exp is not None and exp > time.monotonic()


PAIRING = Pairing()

# fields tsx-config itself owns; blank means "leave as it is" unless the key
# is in CLEARABLE_BLANK, where tsx-config's own validation already treats an
# empty value as meaningful ("off" / "allow any"). KIOSK_URL and
# HA_LOGIN_METHOD/HA_TOKEN are handled separately below (required / a client
# side choice, "form", that is not a real panel.conf value).
SIMPLE_KEYS = ["PANEL_NAME", "TZ_NAME", "VOICE", "WAKE_WORD", "MQTT_HOST",
               "MQTT_PORT", "MQTT_USER", "MQTT_PASSWORD", "SSH_AUTHORIZED_KEY",
               "KERNEL_FLAVOR", "BLANK_TIMEOUT", "ORIENTATION"]
CLEARABLE_BLANK = {"MQTT_HOST", "MQTT_PORT", "MQTT_USER", "MQTT_PASSWORD"}


def handle_submit(fields):
    errors = {}
    to_set = {}

    url = fields.get("KIOSK_URL")
    if not isinstance(url, str) or not url.strip():
        errors["KIOSK_URL"] = "the Home Assistant URL is required"
    elif not tcfg_validate("KIOSK_URL", url.strip()):
        errors["KIOSK_URL"] = "must be a valid http(s) URL with no spaces"
    else:
        to_set["KIOSK_URL"] = url.strip()

    method = fields.get("HA_LOGIN_METHOD")
    if method not in ("form", "token", "trusted"):
        errors["HA_LOGIN_METHOD"] = "choose a login method"
    elif method in ("token", "trusted"):
        to_set["HA_LOGIN_METHOD"] = method
        if method == "token":
            tok = fields.get("HA_TOKEN") or ""
            if tok:
                if tcfg_validate("HA_TOKEN", tok):
                    to_set["HA_TOKEN"] = tok
                else:
                    errors["HA_TOKEN"] = "does not look like a long-lived access token"
            elif not tcfg_show().get("HA_TOKEN"):
                errors["HA_TOKEN"] = "a long-lived access token is required for this login method"

    for key in SIMPLE_KEYS:
        if key not in fields:
            continue
        val = fields[key]
        if not isinstance(val, str):
            errors[key] = "invalid value"
            continue
        if val == "":
            if key in CLEARABLE_BLANK:
                to_set[key] = val
            continue
        if not tcfg_validate(key, val):
            errors[key] = "invalid value"
            continue
        to_set[key] = val

    rootpw = fields.get("ROOT_PASSWORD") or ""
    if rootpw and ("\n" in rootpw or "\r" in rootpw):
        errors["ROOT_PASSWORD"] = "cannot contain a newline"
    elif rootpw and len(rootpw) < 8:
        errors["ROOT_PASSWORD"] = "must be at least 8 characters"

    if errors:
        return 400, {"errors": errors}

    for key, val in to_set.items():
        ok, err = tcfg_set(key, val)
        if not ok:
            errors[key] = err or "failed to save"
    if method == "form":
        tcfg_unset("HA_LOGIN_METHOD")
        tcfg_unset("HA_TOKEN")
    if errors:
        return 400, {"errors": errors}

    if rootpw:
        if not set_root_password(rootpw):
            return 500, {"errors": {"ROOT_PASSWORD": "failed to change the root password"}}

    ok, err = tcfg_apply()
    if not ok:
        return 500, {"errors": {"_apply": err or "tsx-config apply failed"}}

    _invalidate_configured_cache()
    clear_setup_open()
    restart_kiosk()
    return 200, {"ok": True}


# ---- HTTP -----------------------------------------------------------------

class Handler(BaseHTTPRequestHandler):
    server_version = "tsx-setupd"
    sys_version = ""

    def _loopback(self):
        ip = self.client_address[0]
        return ip in ("127.0.0.1", "::1") or ip.startswith("127.")

    def _session_token(self):
        cookie = self.headers.get("Cookie", "") or ""
        for part in cookie.split(";"):
            part = part.strip()
            if part.startswith("tsxsetup="):
                return part[len("tsxsetup="):]
        return None

    def _authorized(self):
        if self._loopback():
            return True
        if not lan_allowed():
            return False
        return PAIRING.session_valid(self._session_token())

    def _send_json(self, code, obj, set_cookie=None):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        if set_cookie:
            self.send_header("Set-Cookie", set_cookie)
        self.end_headers()
        self.wfile.write(body)

    def _send_html(self, code, html):
        body = html.encode()
        self.send_response(code)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, fmt, *args):
        # never the request body (POST payloads, which may carry secrets) --
        # only the request line itself, like the default logger.
        sys.stderr.write("tsx-setupd: %s %s\n" % (self.address_string(), fmt % args))

    def _read_json_body(self):
        try:
            length = int(self.headers.get("Content-Length", "0") or "0")
        except ValueError:
            length = 0
        if length > 65536:
            return None, 413
        raw = self.rfile.read(length) if length else b""
        if not raw:
            return {}, 200
        try:
            data = json.loads(raw)
        except ValueError:
            return None, 400
        if not isinstance(data, dict):
            return None, 400
        return data, 200

    # ---- routes ----
    def do_GET(self):
        path = urllib.parse.urlsplit(self.path).path
        if path in ("/setup", "/setup/"):
            if not self._loopback() and not lan_allowed():
                self._send_html(403, PAGE_UNAVAILABLE)
                return
            self._send_html(200, PAGE_MAIN)
            return
        if path == "/setup/api/state":
            self._api_state()
            return
        if path == "/setup/api/discover":
            self._api_discover()
            return
        self.send_error(404)

    def do_POST(self):
        path = urllib.parse.urlsplit(self.path).path
        if path not in ("/setup/api/pair", "/setup/api/check-url", "/setup/api/submit"):
            self.send_error(404)
            return
        data, code = self._read_json_body()
        if data is None:
            self._send_json(code, {"error": "bad request body"})
            return
        if path == "/setup/api/pair":
            self._api_pair(data)
        elif path == "/setup/api/check-url":
            self._api_check_url(data)
        else:
            self._api_submit(data)

    def _api_state(self):
        loop = self._loopback()
        if not loop and not lan_allowed():
            self._send_json(403, {"error": "setup is not reachable over the network right now"})
            return
        if not self._authorized():
            self._send_json(200, {"need_pairing": True, "window_seconds": WINDOW})
            return
        shown = tcfg_show()
        fields = {}
        for k, v in shown.items():
            if v == "********":
                fields[k] = None
                fields[k + "__set"] = True
            else:
                fields[k] = v
        resp = {
            "need_pairing": False,
            "configured": is_configured(),
            "loopback": loop,
            "lan_allowed": lan_allowed(),
            "window_seconds": WINDOW,
            "fields": fields,
            "tz_list": zone_list(),
        }
        if loop:
            code, code_at = PAIRING.current_code()
            resp["pairing_code"] = code
            resp["pairing_code_remaining"] = max(0, int(WINDOW - (time.monotonic() - code_at)))
        self._send_json(200, resp)

    def _api_discover(self):
        if not self._authorized():
            self._send_json(403, {"error": "not authorized"})
            return
        try:
            url = discover_ha()
        except Exception:
            url = None
        self._send_json(200, {"url": url})

    def _api_pair(self, data):
        if self._loopback():
            self._send_json(200, {"ok": True})
            return
        if not lan_allowed():
            self._send_json(403, {"error": "setup is not reachable over the network right now"})
            return
        ip = self.client_address[0]
        if not PAIRING.allow_attempt(ip):
            self._send_json(429, {"error": "too many attempts; wait a few minutes"})
            return
        code = str(data.get("code", "")).strip()
        token = PAIRING.check_and_pair(code)
        if not token:
            self._send_json(403, {"error": "wrong or expired pairing code"})
            return
        cookie = "tsxsetup=%s; Path=/setup; HttpOnly; SameSite=Strict; Max-Age=%d" % (token, WINDOW)
        self._send_json(200, {"ok": True}, set_cookie=cookie)

    def _api_check_url(self, data):
        if not self._authorized():
            self._send_json(403, {"error": "not authorized"})
            return
        self._send_json(200, check_ha_url(str(data.get("url", ""))))

    def _api_submit(self, data):
        if not self._authorized():
            self._send_json(403, {"error": "not authorized"})
            return
        fields = {k: v for k, v in data.items() if isinstance(k, str)}
        code, obj = handle_submit(fields)
        self._send_json(code, obj)


