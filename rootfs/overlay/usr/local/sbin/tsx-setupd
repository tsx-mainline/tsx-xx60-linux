    if (!url) { setUrlStatus("bad", "enter a URL first"); return; }
    setUrlStatus("", "Checking...");
    api("POST", "/setup/api/check-url", {url: url}).then(function(r){
      var b = r.body || {};
      setUrlStatus(b.ok ? "ok" : "bad", b.message || "unknown error");
    });
  });

  $("form").addEventListener("submit", function(ev){
    ev.preventDefault();
    var btn = $("submit-btn");
    btn.disabled = true;
    document.querySelectorAll(".status.bad").forEach(function(e){ e.textContent=""; e.className="status"; });
    var method = (document.querySelector('input[name=HA_LOGIN_METHOD]:checked') || {}).value;
    var payload = {
      KIOSK_URL: $("f-url").value.trim(),
      HA_LOGIN_METHOD: method,
      HA_TOKEN: $("f-token").value,
      PANEL_NAME: $("f-name").value.trim(),
      TZ_NAME: $("f-tz").value,
      ORIENTATION: $("f-orient").value,
      VOICE: $("f-voice").checked ? "on" : "off",
      WAKE_WORD: $("f-wake").value.trim(),
      MQTT_HOST: $("f-mqtt-host").value.trim(),
      MQTT_PORT: $("f-mqtt-port").value.trim(),
      MQTT_USER: $("f-mqtt-user").value.trim(),
      MQTT_PASSWORD: $("f-mqtt-pass").value,
      ROOT_PASSWORD: $("f-rootpw").value,
      SSH_AUTHORIZED_KEY: $("f-sshkey").value.trim(),
      KERNEL_FLAVOR: $("f-kernel").value,
      BLANK_TIMEOUT: $("f-blank").value.trim()
    };
    api("POST", "/setup/api/submit", payload).then(function(r){
      btn.disabled = false;
      if (r.status === 200) {
        $("form").style.display = "none";
        $("done").style.display = "block";
        return;
      }
      var errs = (r.body && r.body.errors) || {};
      var first = null;
      Object.keys(errs).forEach(function(k){
        var input = document.querySelector('[name="'+k+'"]');
        var msg = errs[k];
        if (input) {
          var wrap = input.closest(".card") || input.parentElement;
          var el = wrap.querySelector(".status") || (function(){
            var d = document.createElement("div"); d.className="status"; wrap.appendChild(d); return d;
          })();
          el.className = "status bad"; el.textContent = msg;
          if (!first) first = input;
        } else {
          $("submit-status").className = "status bad";
          $("submit-status").textContent = ($("submit-status").textContent + " " + msg).trim();
        }
      });
      if (first) first.scrollIntoView({behavior:"smooth", block:"center"});
    }).catch(function(){
      btn.disabled = false;
      $("submit-status").className = "status bad";
      $("submit-status").textContent = "network error saving; try again";
    });
  });

  loadState();
  setInterval(function(){
    if (!state || state.need_pairing || (state.loopback && $("code-banner").style.display === "block")) {
      loadState();
    }
  }, 20000);
})();
</script>
</body></html>
"""


# ---- listening address: loopback-only unless a LAN window is open --------
#
# The HTTP handler already refuses a non-loopback request once !lan_allowed()
# (a defensive second layer), but the process should not even ACCEPT a LAN
# connection outside that window: no listening socket on a LAN-reachable
# address at all means nothing to probe, fingerprint or attempt an exploit
# against from the network while the panel is configured and no one has
# opened Setup on the glass. ServerManager rebinds between "0.0.0.0" (LAN
# allowed -- this also serves loopback) and "127.0.0.1" (LAN not allowed) as
# lan_allowed() changes, polling POLL_S seconds apart; a submit or an
# externally-triggered setup-open change take effect on the next poll, at
# most POLL_S seconds later.
#
# A rebind briefly closes the old socket before the new one is listening
# (the two addresses overlap -- "0.0.0.0" includes "127.0.0.1" -- so both
# cannot be bound at once on the same port): a request that lands in that
# gap, including from the kiosk itself over loopback, gets a connection
# reset/refused rather than an answer. This is the same class of transient
# failure as tsx-setupd not having started yet (kiosk-session already waits
# and retries for that, docs/rootfs.md "Setup page"), not a new one; a
# client is expected to retry rather than treat one reset as final.
POLL_S = 1.0


class ServerManager:
    def __init__(self):
        self.lock = threading.Lock()
        self.server = None
        self.host = None

    def _desired_host(self):
        return "0.0.0.0" if lan_allowed() else "127.0.0.1"

    def ensure(self):
        with self.lock:
            want = self._desired_host()
            if want == self.host and self.server is not None:
                return
            if self.server is not None:
                # release the old socket FIRST: binding "0.0.0.0:PORT" while
                # "127.0.0.1:PORT" is still held (or vice versa) is the same
                # address as far as the kernel is concerned and fails with
                # EADDRINUSE. shutdown() (from here, not from inside its own
                # serve_forever thread -- BaseServer's own requirement) stops
                # the accept loop; server_close() then frees the port.
                self.server.shutdown()
                self.server.server_close()
                self.server = None
            self.server = ThreadingHTTPServer((want, PORT), Handler)
            self.host = want
            threading.Thread(target=self.server.serve_forever, daemon=True, name="tsx-setupd-http").start()
            sys.stderr.write("tsx-setupd: listening on %s:%d (lan=%s window=%ds)\n"
                              % (want, PORT, "on" if LAN_ON else "off", WINDOW))

    def watch_forever(self):
        while True:
            try:
                self.ensure()
            except OSError as e:
                sys.stderr.write("tsx-setupd: bind failed: %s (retrying)\n" % e)
            time.sleep(POLL_S)


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        sys.stdout.write(__doc__)
        return 0
    mgr = ServerManager()
    mgr.ensure()
    try:
        mgr.watch_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
