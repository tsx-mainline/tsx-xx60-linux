        $("f-url").value = r.body.url;
        setUrlStatus("ok", "Found " + r.body.url);
      } else {
        setUrlStatus("warn", "Nothing found automatically; type the URL.");
      }
    });
  });

  $("check-btn").addEventListener("click", function(){
