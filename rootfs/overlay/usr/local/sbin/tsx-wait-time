#!/bin/sh
# tsx-wait-time [SECONDS]: wait until chrony has synced (leap status normal),
# at most SECONDS (default 20). Exit 0 if synced, 1 on timeout.
max=${1:-20}; i=0
while [ $i -lt "$max" ]; do
	chronyc -n tracking 2>/dev/null | grep -q '^Leap status *: Normal' && exit 0
	sleep 1; i=$((i + 1))
done
echo "tsx-wait-time: no NTP sync after ${max}s, clock is $(date -Iseconds)" >&2
exit 1
