#!/bin/sh
# tsx-esphome-run: start tsx_panel.esphome_server with /etc/tsx/esphome.conf.
# /etc/init.d/tsx-esphome runs it as root, like tsx-mqtt. Reboot, tsx-config
# apply and the LED, backlight and screen CLIs all need root -- see
# rootfs/voice/shim/tsx_panel/backend.py. --print: show the command.
CONF=${TSX_ESPHOME_CONF:-/etc/tsx/esphome.conf}
LVA_ROOT=${TSX_LVA_ROOT:-/opt/lva}
NAME= PORT=6053 IFACE= HOST= ARGS=
PRINT=${TSX_ESPHOME_PRINT:-0}; [ "${1-}" = --print ] && PRINT=1
[ -r "$CONF" ] && . "$CONF"
# The PANEL_NAME override of panel.conf. `tsx-config apply` always writes it
# to /run/tsx/voice.conf, and tsx-voice-run shares that file. A panel name
# applies whether VOICE is on or off -- docs/rootfs.md "Panel configuration".
RUNCONF=${TSX_ESPHOME_RUN_CONF:-/run/tsx/voice.conf}
[ -r "$RUNCONF" ] && . "$RUNCONF"
# tsx_panel is vendored next to the shim of the voice satellite. Both come
# from rootfs/voice/shim/ at build time (see rootfs/voice/install-lva.sh).
# The same PYTHONPATH lets tsx-esphome reuse LEDLightEntity and the
# aioesphomeapi, zeroconf and getmac packages. It needs no package of its own,
# because the "voice" section of rootfs/packages.txt already covers them.
export PYTHONPATH="$LVA_ROOT/shim:$LVA_ROOT/app:$LVA_ROOT/lib${PYTHONPATH:+:$PYTHONPATH}"
set -- --name "${NAME:-$(hostname)}" --port "$PORT"
[ -n "$IFACE" ] && set -- "$@" --network-interface "$IFACE"
[ -n "$HOST" ] && set -- "$@" --host "$HOST"
if [ "$PRINT" = 1 ]; then
	echo "PYTHONPATH=$PYTHONPATH python3 -m tsx_panel.esphome_server $* $ARGS"
	exit 0
fi
# shellcheck disable=SC2086
exec python3 -m tsx_panel.esphome_server "$@" $ARGS
