#!/bin/sh
# tsx-voice-hook EVENT: the voice satellite (tsx-voice, linux-voice-assistant
# through /opt/lva/shim/tsx_lva) calls it on these events:
#   detection  (wake word)                    -> duck "Media", LED on
#   listen     (streaming to HA, push-to-talk) -> duck "Media", LED on
#   think      (HA processes the request)     -> state
#   speak      (TTS response starts)          -> keep ducked
#   error      (pipeline error)               -> state
#   done       (idle, disconnected)           -> restore Media, LED off
# You can also call it by hand: duck [PERCENT] | unduck.
# The ducking ends after 60 s at the latest (a lost connection may never
# send "done").
CONF=${TSX_VOICE_CONF:-/etc/tsx/voice.conf}
RUN=${TSX_VOICE_RUN:-/run/tsx/voice}
AMIXER=${AMIXER:-amixer}
CARD=${TSX_SOUND_CARD:-TSW1060}
DUCK_MEDIA=20 LED=none LED_COLOR="0 40 100"
[ -r "$CONF" ] && . "$CONF"
SAVED=$RUN/voice-duck

media() { $AMIXER -c "$CARD" sget Media 2>/dev/null | sed -n 's/.*\[\([0-9]\{1,3\}\)%\].*/\1/p' | head -1; }
state() { echo "state=$1 time=$(date +%s)" > "$RUN/voice.state" 2>/dev/null; }

duck() {
	p=${1:-$DUCK_MEDIA}; [ -n "$p" ] || return 0
	if [ ! -s "$SAVED" ]; then
		cur=$(media); [ -n "$cur" ] || return 0
		echo "$cur $$" > "$SAVED"
	fi
	$AMIXER -q -c "$CARD" sset Media "$p%" 2>/dev/null
	stamp=$(cat "$SAVED")
	( sleep 60; [ "$(cat "$SAVED" 2>/dev/null)" = "$stamp" ] && "$0" unduck ) >/dev/null 2>&1 &
}

unduck() {
	[ -s "$SAVED" ] || return 0
	set -- $(cat "$SAVED"); rm -f "$SAVED"
	$AMIXER -q -c "$CARD" sset Media "$1%" 2>/dev/null
}

led() {
	[ "$LED" = bar ] && command -v tsx-ledbar >/dev/null || return 0
	if [ "$1" = on ]; then tsx-ledbar set $LED_COLOR >/dev/null 2>&1
	else tsx-ledbar apply >/dev/null 2>&1; fi
	return 0
}

case ${1:-} in
detection) state awake; duck; led on;;
listen) state listening; duck; led on;;
think) state thinking;;
error) state error;;
speak) state speaking; duck;;
done) state idle; unduck; led off;;
duck) duck "${2:-}";;
unduck) unduck;;
*) sed -n '2,12p' "$0"; exit 1;;
esac
exit 0
