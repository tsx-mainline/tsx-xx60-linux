#!/bin/sh
# tsx-keypad: control tsx-buttons (front-panel keys and key LEDs) from a shell,
# e.g. from Home Assistant over ssh:  ssh root@panel tsx-keypad led 40
R=${TSX_RUN_DIR:-/run/tsx}
CTL=$R/buttons.ctl
STATE=$R/buttons.state
usage() {
	cat >&2 <<U
usage: tsx-keypad led N|+N|-N|on|off|toggle|auto   key LED level 0..255 (auto = schedule)
       tsx-keypad key 1..5|NAME on|off|auto        one key's LED
       tsx-keypad press NAME [short|long|hold]     run a key's actions (test / remote)
       tsx-keypad reload                           reread /etc/tsx/buttons.conf
       tsx-keypad status
U
	exit 2
}
send() {
	[ -p "$CTL" ] || { echo "tsx-keypad: tsx-buttons is not running" >&2; exit 1; }
	timeout 2 sh -c 'echo "$1" > "$2"' sh "$*" "$CTL" || { echo "tsx-keypad: no answer from tsx-buttons" >&2; exit 1; }
}
case "${1:-status}" in
led)    [ -n "${2:-}" ] || usage; send "led $2";;
key)    [ -n "${3:-}" ] || usage; send "key $2 $3";;
press)  [ -n "${2:-}" ] || usage; send "press $2 ${3:-short}";;
reload) send reload;;
status) send status; sleep 0.3; cat "$STATE";;
*) usage;;
esac
