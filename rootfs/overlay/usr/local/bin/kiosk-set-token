#!/bin/sh
# kiosk-set-token: seed a Home Assistant long-lived access token into the kiosk
# browser profile, so the dashboard opens logged in without a keyboard.
#
#   kiosk-set-token <long-lived-token>     seed (or replace) the token
#   kiosk-set-token --file <path>          read the token from a file
#   kiosk-set-token --show                 print the stored entry (token masked)
#   kiosk-set-token --clear                remove it
#
# How: it stops the kiosk service and starts Chromium headless on the same
# profile with --remote-debugging-pipe. Chromium opens <origin>/manifest.json
# (a same-origin page that runs no HA code) and sets localStorage["hassTokens"]
# as the HA frontend stores it after a normal login. "expires" is 2100, so the
# frontend never tries to refresh (a long-lived token has no refresh token).
# Environment: KIOSK_CONF (default /etc/kiosk.conf), NO_RESTART=1,
# NO_SERVICE=1 (do not stop or start the kiosk service. Its start_pre uses it).
set -eu
CONF=${KIOSK_CONF:-/etc/kiosk.conf}
. "$CONF"
[ -r /run/tsx/kiosk.conf ] && . /run/tsx/kiosk.conf   # panel.conf overrides (tsx-config apply)
: "${KIOSK_PROFILE:=/var/lib/kiosk/chromium}"
KIOSK_USER=${KIOSK_USER:-kiosk}
origin=$(printf '%s' "$KIOSK_URL" | sed -E 's#^(https?://[^/?#]+).*#\1#')
case "$origin" in http://*|https://*) ;; *) echo "bad KIOSK_URL: $KIOSK_URL" >&2; exit 2;; esac

mode=set tok=
case "${1:-}" in
--show) mode=show;;
--clear) mode=clear;;
--file) tok=$(tr -d ' \r\n' < "$2");;
""|-h|--help) sed -n '2,17p' "$0"; exit 2;;
*) tok=$1;;
esac
if [ $mode = set ]; then
	printf '%s' "$tok" | grep -Eq '^[A-Za-z0-9._-]{20,}$' || { echo "token looks wrong (expect a JWT)" >&2; exit 2; }
	js="localStorage.setItem('hassTokens',JSON.stringify({access_token:'$tok',token_type:'Bearer',expires_in:1800,hassUrl:'$origin',clientId:'$origin/',expires:4102444800000,refresh_token:''}));'stored:'+localStorage.getItem('hassTokens').length"
elif [ $mode = clear ]; then
	js="localStorage.removeItem('hassTokens');'cleared'"
else
	js="(function(){var t=localStorage.getItem('hassTokens');if(!t)return 'none';var o=JSON.parse(t);o.access_token=o.access_token.slice(0,12)+'...';return JSON.stringify(o)})()"
fi

was_running=0
if [ "${NO_SERVICE:-0}" != 1 ] && [ -x /etc/init.d/kiosk ] && rc-service kiosk status >/dev/null 2>&1; then
	was_running=1; rc-service kiosk stop >/dev/null 2>&1 || true
fi
# Nothing may use the profile. Wait for the kiosk browser to exit.
i=0; while pgrep -u "$KIOSK_USER" -x chromium >/dev/null && [ $i -lt 20 ]; do sleep 1; i=$((i + 1)); done
pkill -9 -u "$KIOSK_USER" -x chromium 2>/dev/null || true
T=$(mktemp -d); chmod 700 "$T"; chown "$KIOSK_USER" "$T" 2>/dev/null || chmod 777 "$T"
cleanup() {
	set +e   # with -e, a failing last command of an && list would end the trap early
	[ -n "${CPID:-}" ] && kill "$CPID" 2>/dev/null
	[ -n "${RPID:-}" ] && kill "$RPID" 2>/dev/null
	[ -n "${KIOSK_DEBUG:-}" ] && { echo "debug: responses:" >&2; cut -c1-300 "$T/resp" >&2; tail -20 "$T/chromium.log" >&2; }
	rm -rf "$T"
	[ $was_running = 1 ] && [ "${NO_RESTART:-0}" != 1 ] && rc-service kiosk start >/dev/null
	return 0
}
trap cleanup EXIT INT TERM
trap '' PIPE
mkfifo "$T/in" "$T/out"; chown "$KIOSK_USER" "$T/in" "$T/out" 2>/dev/null || true
mkdir -p "$KIOSK_PROFILE"; chown -R "$KIOSK_USER:" "$KIOSK_PROFILE" 2>/dev/null || true
rm -f "$KIOSK_PROFILE"/Singleton*

sandbox=--no-sandbox
{ [ -e /proc/self/ns/user ] || { [ -e /proc/self/ns/pid ] && [ -e /proc/self/ns/net ] && [ -u /usr/lib/chromium/chrome-sandbox ]; }; } && sandbox=
[ "${KIOSK_NO_SANDBOX:-0}" = 1 ] && sandbox=--no-sandbox
cmd="exec chromium-browser --headless=new --remote-debugging-pipe $sandbox --user-data-dir='$KIOSK_PROFILE' --no-first-run --disable-gpu --password-store=basic about:blank 3<'$T/in' 4>'$T/out' 2>'$T/chromium.log'"
if [ "$(id -un)" = "$KIOSK_USER" ]; then sh -c "$cmd" & else su -s /bin/sh "$KIOSK_USER" -c "$cmd" & fi
CPID=$!
tr '\0' '\n' < "$T/out" > "$T/resp" & RPID=$!
exec 5>"$T/in"
n=0
send() { n=$((n + 1)); printf '{"id":%d,%s}\0' $n "$1" >&5; }
waitid() { # waitid ID [timeout]: print the response line for request ID
	i=0; while [ $i -lt $((${2:-60} * 5)) ]; do
		l=$(grep "^{\"id\":$1," "$T/resp" 2>/dev/null | head -1) && [ -n "$l" ] && { printf '%s\n' "$l"; return 0; }
		kill -0 $CPID 2>/dev/null || { echo "chromium exited:" >&2; tail -5 "$T/chromium.log" >&2; return 1; }
		sleep 0.2; i=$((i + 1))
	done; echo "timeout waiting for reply $1" >&2; return 1; }
value() { sed -n 's/.*"result":{"result":{"type":"[a-z]*","value":"\(.*\)"}}.*/\1/p'; }

send "\"method\":\"Target.createTarget\",\"params\":{\"url\":\"$origin/manifest.json\"}"
tid=$(waitid $n 120 | sed -n 's/.*"targetId":"\([^"]*\)".*/\1/p')
[ -n "$tid" ] || { echo "createTarget failed" >&2; exit 1; }
send "\"method\":\"Target.attachToTarget\",\"params\":{\"targetId\":\"$tid\",\"flatten\":true}"
sid=$(waitid $n | sed -n 's/.*"sessionId":"\([^"]*\)".*/\1/p')
[ -n "$sid" ] || { echo "attach failed" >&2; exit 1; }
# Evaluate JS in the page. The result is in $EV. It runs in this shell, so the ids stay unique.
evaluate() { send "\"sessionId\":\"$sid\",\"method\":\"Runtime.evaluate\",\"params\":{\"expression\":\"$1\",\"returnByValue\":true}"
	EV=$(waitid $n | value); }
k=0; o=
while [ $k -lt 90 ]; do
	evaluate "document.readyState=='complete'?location.origin:''" || true; o=$EV
	[ "$o" = "$origin" ] && break
	sleep 1; k=$((k + 1))
done
[ "$o" = "$origin" ] || { echo "could not load $origin/manifest.json (network? TLS? clock is $(date))" >&2; exit 1; }
evaluate "$js"; res=$(printf '%s' "$EV" | sed 's/\\"/"/g')
send '"method":"Browser.close"'
wait $CPID 2>/dev/null || true; CPID=
echo "kiosk-set-token: $mode for $origin -> $res"
