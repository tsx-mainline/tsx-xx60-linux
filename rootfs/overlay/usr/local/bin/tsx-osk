#!/bin/sh
# tsx-osk show|hide|toggle|status: control the on-screen keyboard of the kiosk
# (KIOSK_OSK in /etc/kiosk.conf). Run as root or as the kiosk user.
#   squeekboard: shows itself when a text field gets focus and hides when the
#                field loses it. This script forces it through the D-Bus API
#                (sm.puri.OSK0).
#   wvkbd:       has no automatic mode. This script sends signals (SIGUSR2
#                show, SIGUSR1 hide, SIGRTMIN toggle) to the running wvkbd-*
#                process.
# tsx-idled runs "tsx-osk toggle" on a three-finger tap (OSK_GESTURE).
. /etc/kiosk.conf
cmd=${1:-status}
U=kiosk; UID_K=$(id -u $U)
BUS=unix:path=/run/user/$UID_K/bus
as_kiosk() {
	if [ "$(id -u)" = "$UID_K" ]; then "$@"; else su -s /bin/sh $U -c "$(printf '%s ' "$@")"; fi
}
sq() {  # sq <dbus-send args>
	as_kiosk env DBUS_SESSION_BUS_ADDRESS=$BUS dbus-send --session --print-reply=literal \
		--dest=sm.puri.OSK0 /sm/puri/OSK0 "$@" 2>/dev/null
}
case "${KIOSK_OSK:-squeekboard}" in
squeekboard)
	vis=$(sq org.freedesktop.DBus.Properties.Get string:sm.puri.OSK0 string:Visible | awk '{print $NF}')
	[ -n "$vis" ] || { echo "squeekboard not running"; exit 1; }
	case "$cmd" in
	show) sq sm.puri.OSK0.SetVisible boolean:true >/dev/null;;
	hide) sq sm.puri.OSK0.SetVisible boolean:false >/dev/null;;
	toggle) [ "$vis" = true ] && v=false || v=true; sq sm.puri.OSK0.SetVisible boolean:$v >/dev/null;;
	status) echo "squeekboard visible=$vis";;
	*) echo "usage: tsx-osk show|hide|toggle|status"; exit 2;;
	esac;;
wvkbd)
	pid=$(pgrep -u $U -f '^wvkbd' | head -1)
	[ -n "$pid" ] || { echo "wvkbd not running"; exit 1; }
	case "$cmd" in
	show) kill -USR2 $pid;; hide) kill -USR1 $pid;; toggle) kill -35 $pid;;   # 35 = SIGRTMIN (musl)
	status) echo "wvkbd pid $pid (visibility not queryable)";;
	*) echo "usage: tsx-osk show|hide|toggle|status"; exit 2;;
	esac;;
*) echo "on-screen keyboard is off (KIOSK_OSK=${KIOSK_OSK:-})"; exit 1;;
esac
