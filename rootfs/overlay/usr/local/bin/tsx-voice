#!/bin/sh
# tsx-voice: Assist voice satellite helper (linux-voice-assistant)
#   tsx-voice ptt       push-to-talk: start a conversation, or stop the running
#                       one (reply, timer). For tsx-buttons:
#                       "on lights long exec tsx-voice ptt"
#   tsx-voice stop|mute|unmute|volume_up|volume_down   same as the HA controls
#   tsx-voice cmd NAME  any peripheral API command (start_listening, ...)
#   tsx-voice status    service, state, last log lines
FIFO=${TSX_VOICE_PTT:-/run/tsx/voice/ptt}
RUN=${TSX_VOICE_RUN:-/run/tsx/voice}
send() {
	[ -p "$FIFO" ] || { echo "tsx-voice: satellite not running (no $FIFO)" >&2; exit 2; }
	# A FIFO write blocks when no process reads it. Give up after 2 s.
	timeout 2 sh -c "echo '$1' > '$FIFO'" || { echo "tsx-voice: command not taken (satellite not running?)" >&2; exit 2; }
}
case ${1:-} in
ptt) send ptt;;
stop) send stop_pipeline;;
mute) send mute_mic;;
unmute) send unmute_mic;;
volume_up|volume_down|stop_timer_ringing|start_listening|stop_pipeline) send "$1";;
cmd) [ -n "${2:-}" ] || { echo "usage: tsx-voice cmd COMMAND" >&2; exit 1; }
	case $2 in *[!a-z_]*) echo "tsx-voice: bad command name" >&2; exit 1;; esac
	send "$2";;
status)
	rc-service tsx-voice status 2>/dev/null
	[ -r "$RUN/voice.state" ] && cat "$RUN/voice.state"
	tail -n 5 /var/log/tsx-voice.log 2>/dev/null
	;;
*) sed -n '2,8p' "$0"; exit 1;;
esac
