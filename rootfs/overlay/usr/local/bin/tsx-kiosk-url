#!/bin/sh
# tsx-kiosk-url CURRENT_URL: print the URL that kiosk-session must load.
#
# CURRENT_URL is the URL that kiosk-session has already resolved from
# /etc/kiosk.conf, the KIOSK_URL override of panel.conf (tsx-config apply)
# and a front-key choice (/run/tsx/kiosk-url). This script reads none of
# those itself. It prints CURRENT_URL back unchanged UNLESS one of these is
# true:
#
#   - CURRENT_URL is empty (nothing is configured at all: /etc/kiosk.conf
#     ships with an empty KIOSK_URL on purpose, docs/rootfs.md "Setup page").
#   - /run/tsx/setup-open is fresh (`tsx-config setup` or the overlay "Setup"
#     entry, for one ~15 min window, even on an already-configured panel).
#
# In those cases it prints the URL of the local setup page (tsx-setupd)
# instead. It never touches panel.conf or any other state. It is a pure
# function of its argument and /run/tsx/setup-open. So a test can run it
# standalone (rootfs/tests/test-setup.sh) without the rest of kiosk-session
# (compositor, GPU probing, Chromium flags...).
#
# Env overrides for tests: TSX_RUN_DIR, TSX_SETUP_CONF. tsx-config and
# tsx-setupd also use both, so one test fixture directory works for all
# three.
#
# The script compares the age of the flag in monotonic time (seconds since
# boot, /proc/uptime), never with date +%s. The panel has no RTC, so it boots
# with a stale clock, and NTP steps it by months once chrony syncs. A
# wall-clock comparison across that step would read as expired at once, or as
# good for months. /run is tmpfs, so a reboot always resets the flag and the
# uptime clock together.
set -u
cur=${1:-}
conf=${TSX_SETUP_CONF:-/etc/tsx/setup.conf}
[ -r "$conf" ] && . "$conf"
: "${TSX_SETUP_PORT:=8080}" "${TSX_SETUP_WINDOW:=900}"
flag=${TSX_RUN_DIR:-/run/tsx}/setup-open
open=0
if [ -s "$flag" ]; then
	at=$(cat "$flag" 2>/dev/null); at=${at:-0}
	case "$at" in *[!0-9]*|'') at=0;; esac
	now=$(awk '{print int($1)}' /proc/uptime 2>/dev/null || echo 0)
	if [ "$at" != 0 ] && [ $((now - at)) -ge 0 ] && [ $((now - at)) -le "$TSX_SETUP_WINDOW" ]; then
		open=1
	fi
fi
if [ -z "$cur" ] || [ "$open" = 1 ]; then
	printf 'http://127.0.0.1:%s/setup\n' "$TSX_SETUP_PORT"
else
	printf '%s\n' "$cur"
fi
