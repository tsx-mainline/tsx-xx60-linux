#!/bin/sh
# tsx-audio: sound card helper of the xx60 (the TSW-1060 and the TSW-760). Config /etc/tsx/audio.conf.
#
#   tsx-audio init                  card setup at boot: amplifier inputs, ZL38051
#                                   mic/AEC, softvol controls, saved or default levels
#   tsx-audio card                  print the ALSA card name (TSX_SOUND_CARD of the board file)
#   tsx-audio store                 save the mixer state (STATE)
#   tsx-audio status                card, controls, speaker enable, open streams
#   tsx-audio volume [N|+N|-N]      Master in % (0..100 of -50..-6 dB). No arg = print
#   tsx-audio mute on|off|toggle    Master mute (softvol has no switch, so it
#                                   sets 0 % and keeps the level in RUN/audio-mute)
#   tsx-audio speaker hold|release  keep the amplifiers and SPK_EN on (plays silence)
#   tsx-audio mic-check [SECONDS]   record the raw microphone beside the processed
#                                   capture and print both levels (default 5 s)
#   tsx-audio enable|disable sendspin|voice
#                                   runlevel + start/stop (sendspin also uses dbus
#                                   and avahi-daemon. Voice = tsx-voice)
#
# Without a card, init and store exit 0, so the boot never fails. Other
# commands exit 2 without a card.
CONF=${TSX_AUDIO_CONF:-/etc/tsx/audio.conf}
ASOUND=${TSX_ASOUND_DIR:-/proc/asound}
RUN=${TSX_RUN_DIR:-/run/tsx}
AMIXER=${AMIXER:-amixer}
ALSACTL=${ALSACTL:-alsactl}
APLAY=${APLAY:-aplay}
ARECORD=${ARECORD:-arecord}
I2CTRANSFER=${I2CTRANSFER:-i2ctransfer}
PYTHON3=${PYTHON3:-python3}
ZL_SYSFS=${TSX_ZL_SYSFS:-/sys/bus/i2c/drivers/zl38060}

. "${TSX_BOARD_CONF:-/usr/local/lib/tsx/board.sh}"
CARD=$TSX_SOUND_CARD CARD_WAIT=15 STATE=/var/lib/tsx/asound.state
MASTER_DEFAULT=100 MEDIA_DEFAULT=100 LEFT_AMP_INPUT=Left RIGHT_AMP_INPUT=Right
MIC=on AEC=on MIC_VOLUME=
[ -r "$CONF" ] && . "$CONF"

log() { echo "tsx-audio: $*"; command -v logger >/dev/null && logger -t tsx-audio "$*"; return 0; }
have_card() { [ -e "$ASOUND/$CARD" ]; }
need_card() { have_card || { echo "tsx-audio: no sound card $CARD" >&2; exit 2; }; }
mixer() { $AMIXER -q -c "$CARD" "$@" 2>/dev/null; }
has_ctl() { $AMIXER -c "$CARD" controls 2>/dev/null | grep -q "name='$1'"; }
onoff() { case $1 in on|1|yes|ON) echo on;; *) echo off;; esac; }

# Create the alsa-lib softvol controls without opening the hardware.
make_softvols() {
	for p in tsx_master_ctl tsx_media_ctl; do
		$APLAY -q -D "$p" -t raw -f S16_LE -r 48000 -c 2 /dev/null 2>/dev/null ||
			log "could not create the softvol of $p"
	done
}

cmd_init() {
	i=0
	while ! have_card && [ "$i" -lt "$CARD_WAIT" ]; do sleep 1; i=$((i + 1)); done
	have_card || { log "no sound card $CARD, nothing to do"; return 0; }

	make_softvols
	if [ -s "$STATE" ] && $ALSACTL -f "$STATE" restore "$CARD" 2>/dev/null; then
		log "restored $STATE"
	else
		mixer sset Master "${MASTER_DEFAULT}%"
		mixer sset Media "${MEDIA_DEFAULT}%"
		log "defaults: Master ${MASTER_DEFAULT}%, Media ${MEDIA_DEFAULT}%"
	fi

	# Always apply the amplifier slots and the ZL38051 settings of audio.conf.
	# Leave "Amp Input" alone if tsx-tfa-dsp already set it to DSP during
	# this boot (marker $RUN/tfa-dsp.ok). Otherwise apply the plain
	# Left/Right bypass defaults below. tsx-tfa-dsp runs after tsx-audio and,
	# after a successful load, switches Amp Input to DSP itself.
	if [ -s "$RUN/tfa-dsp.ok" ]; then
		log "TFA9890 DSP active ($RUN/tfa-dsp.ok): leaving Amp Input alone"
	else
		mixer cset name='Left Amp Input' "$LEFT_AMP_INPUT" || log "no 'Left Amp Input'"
		mixer cset name='Right Amp Input' "$RIGHT_AMP_INPUT" || log "no 'Right Amp Input'"
	fi
	if has_ctl 'ZL Mic Capture Switch'; then
		mixer cset name='ZL Mic Capture Switch' "$(onoff "$MIC")"
		[ "$(onoff "$AEC")" = "$( $AMIXER -c "$CARD" cget name='ZL AEC Switch' 2>/dev/null |
			sed -n 's/.*: values=//p')" ] || mixer cset name='ZL AEC Switch' "$(onoff "$AEC")"
		[ -n "$MIC_VOLUME" ] && mixer cset name='ZL Mic Capture Volume' "$MIC_VOLUME"
	else
		log "no ZL38051 controls (flash-boot codec driver not bound?)"
	fi
	log "ready: Master $(get_volume)%"
	return 0
}

cmd_store() {
	have_card || return 0
	mkdir -p "$(dirname "$STATE")"
	$ALSACTL -f "$STATE" store "$CARD" 2>/dev/null && log "stored $STATE"
	return 0
}

get_volume() {
	$AMIXER -c "$CARD" sget Master 2>/dev/null | sed -n 's/.*\[\([0-9]\{1,3\}\)%\].*/\1/p' | head -1
}

cmd_volume() {
	need_card
	case ${1:-} in
	'') get_volume; return;;
	+[0-9]*|-[0-9]*) v=$(( $(get_volume) ${1%%[0-9]*} ${1#[+-]} ));;
	[0-9]*) v=$1;;
	*) echo "usage: tsx-audio volume [N|+N|-N]" >&2; exit 1;;
	esac
	[ "$v" -lt 0 ] && v=0; [ "$v" -gt 100 ] && v=100
	mixer sset Master "$v%" && echo "$v"
}

cmd_mute() {
	need_card; mkdir -p "$RUN"; mf=$RUN/audio-mute
	a=${1:-}; [ "$a" = toggle ] && { [ -s "$mf" ] && a=off || a=on; }
	case $a in
	on) [ -s "$mf" ] || get_volume > "$mf"; mixer sset Master 0%;;
	off) [ -s "$mf" ] && mixer sset Master "$(cat "$mf")%"; rm -f "$mf";;
	*) echo "usage: tsx-audio mute on|off|toggle" >&2; exit 1;;
	esac
}

cmd_speaker() {
	need_card; mkdir -p "$RUN"; pf=$RUN/audio-hold.pid
	case ${1:-} in
	hold)
		if [ -s "$pf" ] && kill -0 "$(cat "$pf")" 2>/dev/null; then echo "already held"; return; fi
		$APLAY -q -D speaker -t raw -f S16_LE -r 48000 -c 2 /dev/zero >/dev/null 2>&1 &
		echo $! > "$pf"; echo "speaker held (pid $!)";;
	release)
		[ -s "$pf" ] && kill "$(cat "$pf")" 2>/dev/null; rm -f "$pf"; echo "speaker released";;
	*) echo "usage: tsx-audio speaker hold|release" >&2; exit 1;;
	esac
}

cmd_status() {
	if ! have_card; then echo "card: $CARD missing"; grep . "$ASOUND/cards" 2>/dev/null; return 2; fi
	echo "card: $(sed -n 1p "$ASOUND/$CARD/id" 2>/dev/null) ($(grep -m1 "$CARD" "$ASOUND/cards" | sed 's/^ *//'))"
	for d in "$ASOUND/$CARD"/pcm*; do
		[ -d "$d" ] || continue
		echo "$(basename "$d"): $(sed -n 's/^name: //p' "$d/info" 2>/dev/null) $(cat "$d"/sub0/status 2>/dev/null | head -1)"
	done
	echo "Master: $(get_volume)%  Media: $($AMIXER -c "$CARD" sget Media 2>/dev/null | sed -n 's/.*\[\([0-9]\{1,3\}\)%\].*/\1/p' | head -1)%"
	$AMIXER -c "$CARD" contents 2>/dev/null | awk '/^numid=/{n=$0; sub(/.*name=/, "", n)} /: values=/{v=$0; sub(/.*: values=/, "", v); print "  " n " = " v}'
	g=$(grep -h ' enable ' /sys/kernel/debug/gpio 2>/dev/null | head -1)
	echo "speaker enable: ${g:-(see /sys/kernel/debug/gpio; debugfs mounted?)}"
	[ -s "$RUN/audio-hold.pid" ] && echo "speaker hold: pid $(cat "$RUN/audio-hold.pid")"
	return 0
}

# The ZL38051 echo canceller gates a quiet room to digital silence or to a
# low comfort noise. A plain capture can then not show if the microphones
# work. mic-check sends the raw microphone MIC3 to the right slot of the
# capture (crosspoint TDMA-2, register 0x0216) for the time of the check.
# The left slot keeps the processed signal. The "mic" PCM and the voice
# satellite use only the left slot. The check restores the original routing
# at the end, also after an error or a signal.
ZL_XP_TDMA2=0x0216 ZL_SRC_MIC3=0x0003

zl_dev() {  # print "BUS ADDR" of the bound ZL38051, for example "1 0x45"
	for d in "$ZL_SYSFS"/*-*; do
		[ -e "$d" ] || continue
		b=${d##*/}
		case $b in [0-9]*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;; *) continue;; esac
		printf '%s 0x%02x\n' "${b%%-*}" "$((0x${b#*-}))"
		return 0
	done
	return 1
}

# HBI access to a register of page 1 or higher (0x0100..0x0fff)
zl_hdr() { printf '0xfe 0x%02x 0x%02x' $((($1 >> 8) - 1)) $((($1 & 0xff) >> 1)); }
zl_read() {  # REG: print the value as 0xNNNN
	v=$($I2CTRANSFER -f -y "$ZL_BUS" w4@"$ZL_ADDR" $(zl_hdr "$1") 0x00 r2) || return 1
	set -- $v
	[ $# = 2 ] || return 1
	printf '0x%04x\n' $((($1 << 8) | $2))
}
zl_write() {  # REG VALUE
	$I2CTRANSFER -f -y "$ZL_BUS" w6@"$ZL_ADDR" $(zl_hdr "$1") 0x80 \
		"$(printf '0x%02x' $((($2 >> 8) & 0xff)))" "$(printf '0x%02x' $(($2 & 0xff)))"
}

zl_restore() {
	[ -n "${ZL_OLD:-}" ] || return 0
	if zl_write $ZL_XP_TDMA2 "$ZL_OLD" && [ "$(zl_read $ZL_XP_TDMA2)" = "$ZL_OLD" ]; then
		ZL_OLD=
	else
		echo "tsx-audio: could not restore ZL38051 register $ZL_XP_TDMA2 to $ZL_OLD" >&2
		return 1
	fi
}

cmd_mic_check() {
	need_card
	s=${1:-5}
	case $s in ''|*[!0-9]*) echo "usage: tsx-audio mic-check [SECONDS]" >&2; exit 1;; esac
	if [ "$s" -lt 2 ] || [ "$s" -gt 60 ]; then echo "tsx-audio: mic-check takes 2 to 60 seconds" >&2; exit 1; fi
	zl=$(zl_dev) || { echo "tsx-audio: no ZL38051 on I2C (driver zl38060 not bound)" >&2; exit 2; }
	ZL_BUS=${zl% *} ZL_ADDR=${zl#* }
	ZL_OLD=$(zl_read $ZL_XP_TDMA2) || { echo "tsx-audio: cannot read the ZL38051 at $ZL_BUS-$ZL_ADDR" >&2; exit 2; }
	wav=$(mktemp "${TMPDIR:-/tmp}/tsx-mic-check.XXXXXX") || exit 2
	trap 'zl_restore; rm -f "$wav"' EXIT
	trap 'exit 130' INT TERM HUP
	zl_write $ZL_XP_TDMA2 $ZL_SRC_MIC3 || { echo "tsx-audio: cannot route the raw microphone" >&2; exit 2; }
	echo "recording $s s: left = processed capture (echo canceller output), right = raw microphone (MIC3)"
	$ARECORD -q -D tsx_dsnoop -t wav -f S16_LE -r 48000 -c 2 -d "$s" "$wav" || { echo "tsx-audio: arecord failed" >&2; exit 2; }
	zl_restore || exit 2
	mic=$(sed -n 's/^MIC=//p' "$RUN/hw.conf" 2>/dev/null)
	$PYTHON3 - "$wav" "${mic:-yes}" <<'EOF'
import math, struct, sys, wave
w = wave.open(sys.argv[1])
n, fs = w.getnframes(), w.getframerate()
d = struct.unpack('<%dh' % (2 * n), w.readframes(n))
skip, win = fs // 2, fs // 2          # skip the first 0.5 s, then 0.5 s windows
def rms(x):
    return math.sqrt(sum(v * v for v in x) / len(x)) if x else 0.0
def db(r):
    return 20 * math.log10(r / 32768) if r > 0 else -150.0
out = []
for c, name in ((0, 'processed (left, echo canceller output)'), (1, 'raw microphone (right, MIC3)')):
    x = d[c::2][skip:]
    wins = [rms(x[i:i + win]) for i in range(0, len(x) - win + 1, win)]
    quiet = sum(1 for r in wins if r < 1.0)
    r = rms(x)
    out.append(r)
    print('%s: rms %.1f (%.1f dBFS), %d of %d windows below rms 1' % (name, r, db(r), quiet, len(wins)))
if out[1] < 2.0:
    if sys.argv[2] == 'no':
        print('result: no microphone signal. This panel has no microphone (/run/tsx/hw.conf MIC=no)')
        sys.exit(0)
    print('result: FAIL, no signal from the raw microphone')
    sys.exit(1)
print('result: microphone OK')
if out[0] < out[1] / 4:
    print('note: the echo canceller gates a quiet room to silence or comfort noise. Speech near the panel passes.')
EOF
}

svc_enable() {  # $1 = add|del, services...
	a=$1; shift
	for s in "$@"; do
		if [ "$a" = add ]; then rc-update add "$s" default >/dev/null && rc-service "$s" start
		else rc-service "$s" stop; rc-update del "$s" default >/dev/null; fi
	done
}

# The voice satellite and tsx-esphome both serve the ESPHome API on port 6053.
# Exactly one of them may run. Enable stops tsx-esphome before it starts the
# satellite. Disable starts tsx-esphome again, but only when the satellite was
# enabled before: apply runs "disable voice" at every boot with VOICE=off,
# and that must not start tsx-esphome ahead of its own place in the boot order.
# Inside an OpenRC service (RC_SVCNAME is set: the boot apply of the tsx-config
# service), enable only puts the satellite into the default runlevel. A start
# there waits for tsx-config itself (tsx-voice starts after it) until the
# OpenRC timeout, about 60 s, and the network comes up that much later. The
# default runlevel starts the satellite in its own place.
voice_enabled() { [ -e "${TSX_RUNLEVEL_DIR:-/etc/runlevels/default}/tsx-voice" ]; }

voice_handover() {  # $1 = add|del
	if [ "$1" = add ]; then
		rc-update add tsx-voice default >/dev/null || return 1
		[ -n "${RC_SVCNAME:-}" ] && return 0
		rc-service tsx-esphome stop >/dev/null 2>&1
		rc-service tsx-voice start
	else
		was=no; voice_enabled && was=yes
		rc-service tsx-voice stop
		rc-update del tsx-voice default >/dev/null
		# restart, not start: after a boot with the satellite, tsx-esphome is
		# "started" with no daemon, and start would do nothing. Its own start
		# decides whether it runs (HA_TRANSPORT).
		[ "$was" = yes ] && rc-service tsx-esphome restart >/dev/null 2>&1
	fi
	return 0
}

cmd_enable() {  # $1 = add|del, $2 = sendspin|voice
	# Sendspin and the voice satellite belong to the Home Assistant layer
	# (docs/rootfs.md "Profiles"). An image without it has no such service.
	# Then "disable" has nothing to do, and "enable" says why it cannot.
	case ${2:-} in
	sendspin|voice)
		if [ ! -e "${TSX_INITD:-/etc/init.d}/tsx-$2" ]; then
			[ "$1" = del ] && return 0
			echo "tsx-audio: no tsx-$2 service in this image (it is not in this profile)" >&2; exit 1
		fi;;
	esac
	case ${2:-} in
	sendspin) if [ "$1" = add ]; then svc_enable add dbus avahi-daemon tsx-sendspin
		  else svc_enable del tsx-sendspin; fi;;
	voice) voice_handover "$1";;
	*) echo "usage: tsx-audio enable|disable sendspin|voice" >&2; exit 1;;
	esac
}

case ${1:-} in
init) cmd_init;;
store) cmd_store;;
status) cmd_status;;
card) echo "$CARD";;
volume) shift; cmd_volume "$@";;
mute) shift; cmd_mute "$@";;
speaker) shift; cmd_speaker "$@";;
mic-check) shift; cmd_mic_check "$@";;
enable) cmd_enable add "${2:-}";;
disable) cmd_enable del "${2:-}";;
*) sed -n '2,20p' "$0"; exit 1;;
esac
