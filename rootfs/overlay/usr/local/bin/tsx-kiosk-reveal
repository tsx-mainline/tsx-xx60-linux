#!/usr/bin/env python3
"""tsx-kiosk-reveal: show the kiosk browser only once its page has painted.

Started by kiosk-session (sway session, boot splash on) next to Chromium. The
generated sway config makes the browser window fully transparent
(`for_window [app_id="^chrome-"] opacity 0`), so the output shows sway's
background, the boot splash, while Chromium starts and loads the page: no
white window, no half-drawn page. This helper watches the page over the
DevTools protocol (KIOSK_DEVTOOLS=1, 127.0.0.1:9222) and sets the window
opaque when the page has painted:

  document.readyState is "complete", the first contentful paint happened,
  Home Assistant's own loading screen (#ha-launch-screen) is gone and the
  largest contentful paint has settled (700 ms without a bigger element, at
  most 4 s after the first paint); then two animation frames, so the painted
  frame is on the glass.

A browser error page (chrome-error://, e.g. a TLS "clock is behind" error
while NTP has not synced yet, or no network yet) is retried: wait for the
clock (chronyc, at most TIME_WAIT s), load the kiosk URL again, at most
once every 5 s. After TIMEOUT s it reveals whatever is there, so a page that
never finishes (or keeps failing) still shows up. Without DevTools it reveals DELAY s after the
browser window appeared.

With the window revealed, sway's background (still the splash) is replaced by
a solid colour: the page's own background colour (read over DevTools), else
black. The background shows wherever the window does not cover the output for
a moment, e.g. while Chromium repaints at its new size when the on-screen
keyboard hides; it must not be the splash any more then.

Usage: tsx-kiosk-reveal URL [--devtools 0|1] [--timeout S] [--time-wait S]
Env: SWAYSOCK (from sway), TSX_REVEAL_DEVTOOLS (host:port, tests).
Logs one line per step to stderr (the kiosk log), with the uptime.
"""
import base64
import json
import os
import re
import socket
import struct
import subprocess
import sys
import time
import urllib.error
import urllib.request

RULE = '[app_id="^chrome-"]'
RETRY_GAP = 5.0
DEVTOOLS = os.environ.get('TSX_REVEAL_DEVTOOLS', '127.0.0.1:9222')
PAINTED = r'''new Promise(r => {
  const t0 = performance.now();
  let lcp = 0;
  try {
    new PerformanceObserver(l => { for (const e of l.getEntries()) lcp = Math.max(lcp, e.startTime); })
      .observe({type: "largest-contentful-paint", buffered: true});
  } catch (e) {}
  (function f() {
    if (location.protocol === "chrome-error:") return r("error");
    const fcp = performance.getEntriesByType("paint").find(e => e.name === "first-contentful-paint");
    const now = performance.now();
    // painted: loaded, first contentful paint done, no HA loading screen, and
    // the largest paint has settled (no bigger element for 700 ms, at most
    // 4 s after the first paint): the login form or the dashboard, not the
    // empty card HA paints first
    if (document.readyState === "complete" && fcp && !document.getElementById("ha-launch-screen")
        && (now - Math.max(lcp, fcp.startTime) > 700 || now - fcp.startTime > 4000))
      return requestAnimationFrame(() => requestAnimationFrame(() => r("painted")));
    if (now - t0 > 4000) return r("wait");
    setTimeout(f, 100);
  })();
})'''
# the page's background colour as #rrggbb ('' if transparent): body first,
# else the root element (Home Assistant colours <html>)
BACKGROUND = r'''(() => {
  for (const e of [document.body, document.documentElement]) {
    if (!e) continue;
    const m = getComputedStyle(e).backgroundColor.match(/^rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([\d.]+))?\)$/);
    if (m && (m[4] === undefined || parseFloat(m[4]) > 0))
      return "#" + [m[1], m[2], m[3]].map(x => (+x).toString(16).padStart(2, "0")).join("");
  }
  return "";
})()'''


def uptime():
    with open('/proc/uptime') as f:
        return f.read().split()[0]


def log(msg):
    sys.stderr.write('tsx-kiosk-reveal: %s (uptime %s)\n' % (msg, uptime()))
    sys.stderr.flush()


def swaymsg(cmd):
    return subprocess.call(['swaymsg', cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def reveal(why, bg=None):
    # the later rule wins for windows that map from now on; then the open one
    swaymsg('for_window %s opacity 1' % RULE)
    swaymsg('%s opacity 1' % RULE)
    # no splash behind the page from now on (see the module docstring)
    bg = bg if isinstance(bg, str) and re.fullmatch(r'#[0-9a-f]{6}', bg) else '#000000'
    swaymsg('output * bg %s solid_color' % bg)
    log('revealed: %s (background %s)' % (why, bg))


class Ws:
    """Minimal RFC 6455 client: text frames, masked, no extensions."""

    def __init__(self, url, timeout=10):
        hp, path = url[len('ws://'):].split('/', 1)
        host, port = hp.rsplit(':', 1)
        self.s = socket.create_connection((host, int(port)), timeout=timeout)
        key = base64.b64encode(os.urandom(16)).decode()
        self.s.sendall(('GET /%s HTTP/1.1\r\nHost: %s\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n'
                        'Sec-WebSocket-Key: %s\r\nSec-WebSocket-Version: 13\r\n\r\n' % (path, hp, key)).encode())
        buf = b''
        while b'\r\n\r\n' not in buf:
            c = self.s.recv(4096)
            if not c:
                raise EOFError('handshake')
            buf += c
        if b' 101 ' not in buf.split(b'\r\n', 1)[0]:
            raise EOFError('handshake refused')
        self.buf = buf.split(b'\r\n\r\n', 1)[1]

    def send(self, txt):
        d = txt.encode()
        m = os.urandom(4)
        n = len(d)
        hdr = b'\x81' + (bytes([0x80 | n]) if n < 126 else b'\xfe' + struct.pack('>H', n))
        self.s.sendall(hdr + m + bytes(b ^ m[i % 4] for i, b in enumerate(d)))

    def _need(self, n):
        while len(self.buf) < n:
            c = self.s.recv(65536)
            if not c:
                raise EOFError('closed')
            self.buf += c

    def recv(self):
        msg = b''
        while True:
            self._need(2)
            b1, b2 = self.buf[0], self.buf[1]
            n, o = b2 & 0x7f, 2
            if n == 126:
                self._need(4)
                n, o = struct.unpack('>H', self.buf[2:4])[0], 4
            elif n == 127:
                self._need(10)
                n, o = struct.unpack('>Q', self.buf[2:10])[0], 10
            self._need(o + n)
            msg += self.buf[o:o + n]
            self.buf = self.buf[o + n:]
            if b1 & 0x80:
                return msg.decode('utf-8', 'replace')

    def call(self, method, params, cid):
        self.send(json.dumps({'id': cid, 'method': method, 'params': params}))
        while True:
            j = json.loads(self.recv())
            if j.get('id') == cid:
                return j

    def close(self):
        try:
            self.s.close()
        except OSError:
            pass


def page_target():
    with urllib.request.urlopen('http://%s/json/list' % DEVTOOLS, timeout=2) as r:
        for t in json.load(r):
            if t.get('type') == 'page' and not t.get('url', '').startswith('devtools://') \
                    and t.get('webSocketDebuggerUrl'):
                return t
    return None


def clock_synced():
    try:
        out = subprocess.run(['chronyc', '-n', 'tracking'], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    return any(line.startswith('Leap status') and line.rstrip().endswith('Normal') for line in out.splitlines())


def window_mapped():
    try:
        out = subprocess.run(['swaymsg', '-t', 'get_tree'], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    return '"app_id": "chrome-' in out


def main():
    args = sys.argv[1:]
    if not args or args[0].startswith('-'):
        sys.stderr.write(__doc__)
        return 2
    url, opts = args[0], {'--devtools': '1', '--timeout': '60', '--time-wait': '30', '--delay': '4'}
    i = 1
    while i < len(args):
        if args[i] not in opts or i + 1 >= len(args):
            sys.stderr.write(__doc__)
            return 2
        opts[args[i]] = args[i + 1]
        i += 2
    deadline = time.monotonic() + float(opts['--timeout'])

    if opts['--devtools'] != '1':
        while time.monotonic() < deadline and not window_mapped():
            time.sleep(0.25)
        time.sleep(min(float(opts['--delay']), max(0.0, deadline - time.monotonic())))
        reveal('no DevTools (KIOSK_DEVTOOLS=0): %s s after the window appeared' % opts['--delay'])
        return 0

    retries, cid, seen, last_try = 0, 0, None, 0.0
    while time.monotonic() < deadline:
        ws = None
        try:
            t = page_target()
            if not t:
                time.sleep(0.25)
                continue
            if t.get('url') and t.get('url') != seen:
                seen = t.get('url')
                log('page %s' % seen.split('?')[0][:80])
            ws = Ws(t['webSocketDebuggerUrl'])
            cid += 1
            res = ws.call('Runtime.evaluate', {'expression': PAINTED, 'awaitPromise': True, 'returnByValue': True}, cid)
            state = res.get('result', {}).get('result', {}).get('value')
            if state == 'painted':
                cid += 1
                bg = ws.call('Runtime.evaluate', {'expression': BACKGROUND, 'returnByValue': True}, cid)
                reveal('page painted', bg.get('result', {}).get('result', {}).get('value'))
                return 0
            if state == 'error':
                # the clock first (TLS), then at most one new try per RETRY_GAP s
                end = min(deadline, time.monotonic() + float(opts['--time-wait']))
                while not clock_synced() and time.monotonic() < end:
                    time.sleep(1)
                time.sleep(max(0.0, last_try + RETRY_GAP - time.monotonic()))
                if time.monotonic() >= deadline:
                    break
                retries += 1
                log('browser error page: loading %s again (try %d, clock %s)'
                    % (url.split('?')[0][:80], retries, 'synced' if clock_synced() else 'NOT synced'))
                cid += 1
                ws.call('Page.navigate', {'url': url}, cid)
                last_try = time.monotonic()
        except (OSError, EOFError, ValueError) as e:
            # DevTools not up yet, or the page navigated while we waited
            # (its execution context went away): look again
            if not isinstance(e, (ConnectionRefusedError, urllib.error.URLError)):
                log('retrying: %s' % str(e)[:80])
            time.sleep(0.25)
        finally:
            if ws:
                ws.close()
    reveal('timeout (%s s) without a painted page' % opts['--timeout'])
    return 0


if __name__ == '__main__':
    sys.exit(main())
