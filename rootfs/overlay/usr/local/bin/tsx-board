#!/bin/sh
# tsx-board: one value of the board file (board.sh), for programs that cannot
# source it (the Python parts of the panel software).
#   tsx-board get NAME   print the value of the variable NAME (TSX_SOUND_CARD)
#   tsx-board call NAME  print the output of the function NAME (tsx_board_model).
#                        For the functions that read the U-Boot env (model,
#                        stock_fw, unit_id, mac, hostname_hint) it reads the
#                        env first (tsx_board_load).
# A name that the board does not define prints nothing and returns 1.
# Test hook: TSX_BOARD_CONF replaces /usr/local/lib/tsx/board.sh.
set -u
BOARD=${TSX_BOARD_CONF:-/usr/local/lib/tsx/board.sh}
usage() { sed -n '2,10p' "$0" >&2; exit 2; }
[ $# = 2 ] || usage
case "$2" in ''|*[!A-Za-z0-9_]*) echo "tsx-board: bad name" >&2; exit 2;; esac
[ -r "$BOARD" ] || { echo "tsx-board: no $BOARD" >&2; exit 1; }
. "$BOARD"
case "$1" in
get)
	case "$2" in tsx_*) exit 1;; esac
	eval "[ -n \"\${$2:-}\" ]" || exit 1
	eval "printf '%s\\n' \"\${$2}\""
	;;
call)
	case "$2" in tsx_board_*) ;; *) exit 1;; esac
	type "$2" >/dev/null 2>&1 || exit 1
	# The functions that read the U-Boot env print nothing until tsx_board_load
	# has read it. This is a new process, so load it here. A failed load keeps
	# the output empty, and the function then prints nothing (the load says why).
	case "$2" in
	tsx_board_model|tsx_board_stock_fw|tsx_board_unit_id|tsx_board_mac|tsx_board_hostname_hint)
		tsx_board_load || true;;
	esac
	"$2"
	;;
*) usage;;
esac
