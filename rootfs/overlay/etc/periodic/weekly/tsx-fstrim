#!/bin/sh
# Weekly fstrim of the root and data file systems (the eMMC frees the
# blocks, which keeps its write speed and wear level). Run by crond through
# /etc/periodic/weekly. A file system that is not mounted, or a device that
# does not discard, is skipped. The result goes to the system log.
for m in / /data; do
	mountpoint -q "$m" || continue
	out=$(fstrim -v "$m" 2>&1) && logger -t tsx-fstrim "$out" || logger -t tsx-fstrim "$m: fstrim failed: $out"
done
exit 0
