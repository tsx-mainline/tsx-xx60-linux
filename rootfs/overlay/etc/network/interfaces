auto lo
iface lo inet loopback

# ifupdown-ng's dhcp executor defaults to use_hostname_for_dhcp=1 (queries the
# live hostname itself; no "hostname" property needed here), so udhcpc sends
# whatever /etc/init.d/tsx-hostname set (it runs before this) as the DHCP
# hostname option.
auto eth0
iface eth0 inet dhcp
