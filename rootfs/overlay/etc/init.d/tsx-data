#!/sbin/openrc-run
# On the card stage, p2 is a fixed 800 MiB, and the packages alone use ~786
# MiB of it. That leaves almost no room for writable growth (Chromium
# profile and cache, logs). /data (p4, label tsxdata) is formatted by the
# first mainline boot. If it is present and mounted, this service moves each
# directory below off the rootfs onto /data once. Then it bind-mounts the
# directory back onto its old path at every boot.
# On the stock layout (no p4, or the first-boot mkfs failed), /data stays a
# bare empty mount point. The service logs that and does nothing else, so
# stock panels are not affected.
#
# First run per directory:
# 1. cp -a into /data/<name>.
# 2. Verify the sha256 of every file against the source (symlinks by target).
# 3. Write a marker file inside /data/<name>.
# 4. Clear the rootfs copy.
# The marker exists before the service clears the rootfs copy. So a boot
# that dies between steps 3 and 4 is safe to resume. The next boot sees the
# marker and goes straight to the bind mount. It leaves whatever is still on
# the rootfs alone (wasted space, never lost data). The service uses only
# busybox applets (no findmnt, and no util-linux blkid -s/-o, because the
# rootfs has neither). It never fails the boot: every path through start()
# ends in `eend 0`.
description="TSX: move writable state onto /data (tsxdata) once, bind-mount it every boot"
depend() {
	need localmount
	before bootmisc syslog tsx-setup
}

DIRS="var/lib/kiosk var/log var/lib/tsx var/lib/sendspin root home"
LOG=/run/tsx-data.log

# stdout: "file <sha256> <relpath>" per regular file and "link <target>
# <relpath>" per symlink under $1, sorted. This way, a test can compare two
# calls with =.
tree_digest() {
	( cd "$1" 2>/dev/null || exit 0
	  find . \( -type f -o -type l \) 2>/dev/null | while read -r p; do
		if [ -L "$p" ]; then echo "link $(readlink "$p") $p"
		else echo "file $(sha256sum "$p" 2>/dev/null | cut -d' ' -f1) $p"; fi
	  done ) | sort
}

move_one() {
	d=$1 src="/$1" tgt="/data/$1"
	mountpoint -q "$src" 2>/dev/null && return 0   # already bind-mounted (e.g. service restarted)
	mkdir -p "$tgt" 2>/dev/null
	if [ ! -e "$tgt/.tsx-moved" ]; then
		einfo "tsx-data: moving /$d to $tgt"
		[ -e "$src" ] || mkdir -p "$src"
		own=$(stat -c '%u:%g' "$src" 2>/dev/null)
		mod=$(stat -c '%a' "$src" 2>/dev/null)
		if ! cp -a "$src/." "$tgt/" >>"$LOG" 2>&1; then
			eerror "tsx-data: copy of /$d to $tgt failed (see $LOG). Leaving /$d on the rootfs"
			return 1
		fi
		a=$(tree_digest "$src"); b=$(tree_digest "$tgt")
		if [ "$a" != "$b" ]; then
			{ echo "verify mismatch under /$d:"; echo "$a" > /run/tsx-data-src.$$; echo "$b" > /run/tsx-data-tgt.$$
			  diff /run/tsx-data-src.$$ /run/tsx-data-tgt.$$; rm -f /run/tsx-data-src.$$ /run/tsx-data-tgt.$$; } >>"$LOG" 2>&1
			eerror "tsx-data: verify of /$d against $tgt failed (see $LOG). Not touching /$d, not bind-mounting"
			return 1
		fi
		[ -n "$own" ] && chown "$own" "$tgt" 2>/dev/null
		[ -n "$mod" ] && chmod "$mod" "$tgt" 2>/dev/null
		: > "$tgt/.tsx-moved"          # marker written before the rootfs copy is cleared
		find "$src" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>>"$LOG" || true
	fi
	mount --bind "$tgt" "$src" || { eerror "tsx-data: bind mount /$d failed"; return 1; }
	return 0
}

start() {
	ebegin "TSX data (/data)"
	: > "$LOG"
	if ! mountpoint -q /data 2>/dev/null; then
		einfo "tsx-data: /data not mounted (stock layout, or the first-boot mkfs has not run): nothing to do"
		eend 0; return 0
	fi
	# This rootfs has no findmnt. Read the source device and fstype directly
	# from /proc/mounts, and the label from the fixed-format output of the
	# busybox blkid. It ignores -s/-o, so a plain parse works for it and for
	# util-linux.
	set -- $(awk '$2=="/data"{print $1, $3; exit}' /proc/mounts)
	src=$1 fstype=$2
	label=$(blkid "$src" 2>/dev/null | sed -n 's/.*LABEL="\([^"]*\)".*/\1/p')
	if [ "$label" != tsxdata ] || [ "$fstype" != ext4 ]; then
		einfo "tsx-data: /data is mounted but not the expected ext4 LABEL=tsxdata (got ${fstype:-?}/${label:-?}): nothing to do"
		eend 0; return 0
	fi
	for d in $DIRS; do
		move_one "$d" || true   # a failure on one directory must not stop the others or the boot
	done
	eend 0
}
