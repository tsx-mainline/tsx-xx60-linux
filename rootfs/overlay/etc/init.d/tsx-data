#!/sbin/openrc-run
# Layout R1's p2 is a fixed 800 MiB and ships ~786 MiB used by packages alone,
# leaving almost no room for writable growth (Chromium profile/cache, logs).
# If /data (p4, label tsxdata, formatted by the first mainline boot; see
# installer/r1/tsx-r1-migrate) is present and mounted, move each of the
# directories below off the rootfs and onto it once, then bind-mount it back
# onto its old path on every boot. On layout r0 (no p4, or the first-boot
# mkfs failed) /data stays a bare empty mount point: this service logs that
# and does nothing else, so r0 panels are unaffected.
#
# First run per directory: cp -a into /data/<name>, verify every file's
# sha256 (symlinks by target) against the source, THEN write a marker file
# inside /data/<name>, THEN clear the rootfs copy. The marker is written
# before the rootfs copy is cleared, so a boot that dies between those two
# steps is still safe to resume: next boot sees the marker and goes straight
# to the bind mount, leaving whatever is still on the rootfs alone (wasted
# space, never lost data). Uses only busybox applets (no findmnt, no
# util-linux blkid -s/-o: neither is in the rootfs). Never fails boot: every
# path through start() ends in `eend 0`.
description="TSX: move writable state onto /data (tsxdata) once, bind-mount it every boot"
depend() {
	need localmount
	before bootmisc syslog tsx-setup
}

DIRS="var/lib/kiosk var/log var/lib/tsx var/lib/sendspin root home"
LOG=/run/tsx-data.log

# stdout: "file <sha256> <relpath>" / "link <target> <relpath>" per regular
# file / symlink under $1, sorted, so two calls can be compared with =.
tree_digest() {
	( cd "$1" 2>/dev/null || exit 0
	  find . \( -type f -o -type l \) 2>/dev/null | while read -r p; do
		if [ -L "$p" ]; then echo "link $(readlink "$p") $p"
		else echo "file $(sha256sum "$p" 2>/dev/null | cut -d' ' -f1) $p"; fi
	  done ) | sort
}

move_one() {
	d=$1 src="/$1" tgt="/data/$1"
	mountpoint -q "$src" 2>/dev/null && return 0   # already bind-mounted (e.g. service restarted)
	mkdir -p "$tgt" 2>/dev/null
	if [ ! -e "$tgt/.tsx-moved" ]; then
		einfo "tsx-data: moving /$d to $tgt"
		[ -e "$src" ] || mkdir -p "$src"
		own=$(stat -c '%u:%g' "$src" 2>/dev/null)
		mod=$(stat -c '%a' "$src" 2>/dev/null)
		if ! cp -a "$src/." "$tgt/" >>"$LOG" 2>&1; then
			eerror "tsx-data: copy of /$d to $tgt failed (see $LOG); leaving /$d on the rootfs"
			return 1
		fi
		a=$(tree_digest "$src"); b=$(tree_digest "$tgt")
		if [ "$a" != "$b" ]; then
			{ echo "verify mismatch under /$d:"; echo "$a" > /run/tsx-data-src.$$; echo "$b" > /run/tsx-data-tgt.$$
			  diff /run/tsx-data-src.$$ /run/tsx-data-tgt.$$; rm -f /run/tsx-data-src.$$ /run/tsx-data-tgt.$$; } >>"$LOG" 2>&1
			eerror "tsx-data: verify of /$d against $tgt failed (see $LOG); not touching /$d, not bind-mounting"
			return 1
		fi
		[ -n "$own" ] && chown "$own" "$tgt" 2>/dev/null
		[ -n "$mod" ] && chmod "$mod" "$tgt" 2>/dev/null
		: > "$tgt/.tsx-moved"          # marker written before the rootfs copy is cleared
		find "$src" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>>"$LOG" || true
	fi
	mount --bind "$tgt" "$src" || { eerror "tsx-data: bind mount /$d failed"; return 1; }
	return 0
}

start() {
	ebegin "TSX data (/data)"
	: > "$LOG"
	if ! mountpoint -q /data 2>/dev/null; then
		einfo "tsx-data: /data not mounted (layout r0, or the first-boot mkfs hasn't run): nothing to do"
		eend 0; return 0
	fi
	# no findmnt in this rootfs: read the source device + fstype straight out
	# of /proc/mounts, and the label out of busybox's fixed-format blkid
	# (it ignores -s/-o, so a plain parse works for it and util-linux alike).
	set -- $(awk '$2=="/data"{print $1, $3; exit}' /proc/mounts)
	src=$1 fstype=$2
	label=$(blkid "$src" 2>/dev/null | sed -n 's/.*LABEL="\([^"]*\)".*/\1/p')
	if [ "$label" != tsxdata ] || [ "$fstype" != ext4 ]; then
		einfo "tsx-data: /data is mounted but not the expected ext4 LABEL=tsxdata (got ${fstype:-?}/${label:-?}): nothing to do"
		eend 0; return 0
	fi
	for d in $DIRS; do
		move_one "$d" || true   # a failure on one directory must not stop the others, or boot
	done
	eend 0
}
