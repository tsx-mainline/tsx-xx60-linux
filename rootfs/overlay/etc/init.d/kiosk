#!/sbin/openrc-run
# Browser kiosk: cage (single-app Wayland compositor) + Chromium. The service
# restarts it after a crash.
description="TSX kiosk (cage + browser)"
supervisor=supervise-daemon
command=/usr/local/bin/kiosk-session
command_user="kiosk:kiosk"
respawn_delay=3
respawn_max=0
output_log=/var/log/kiosk.log
error_log=/var/log/kiosk.log
extra_started_commands="reload"

depend() {
	need seatd localmount
	want tsx-setup
	after udev-settle networking chronyd tsx-idled
}

start_pre() {
	uid=$(id -u kiosk)
	checkpath -d -m 0755 /run/user
	checkpath -d -m 0700 -o kiosk:kiosk /run/user/$uid
	checkpath -d -m 0755 -o kiosk:kiosk /var/lib/kiosk
	checkpath -f -m 0644 -o kiosk:kiosk /var/log/kiosk.log
	. /etc/kiosk.conf
	[ -r /run/tsx/kiosk.conf ] && . /run/tsx/kiosk.conf   # panel.conf overrides (tsx-config apply)
	[ -n "${KIOSK_CACHE_DIR:-}" ] && checkpath -d -m 0700 -o kiosk:kiosk "$KIOSK_CACHE_DIR"
	# Boot splash status line. It does nothing once sway has the screen, or
	# when the text console has it. The address helps if the kiosk never
	# comes up.
	ip=$(ip -4 -o addr show eth0 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n 1)
	/usr/local/bin/tsx-splash -s "starting the kiosk  ${ip:-(no network address yet)}" -p 70 status 2>/dev/null
	# TLS needs a correct clock (the panel has no RTC). If KIOSK_TIME_WAIT is
	# empty (default), there is no wait when tsx-kiosk-reveal watches the page
	# (sway, DevTools on, KIOSK_SPLASH on). It loads the page again after NTP
	# has synced if the first load failed because of the clock. Otherwise
	# wait up to 20 s as before.
	tw=${KIOSK_TIME_WAIT:-}
	if [ -z "$tw" ]; then
		if [ "${KIOSK_OSK:-squeekboard}" != off ] && [ "${KIOSK_DEVTOOLS:-1}" = 1 ] && [ "${KIOSK_SPLASH:-on}" != off ]; then
			tw=0
		else
			tw=20
		fi
	fi
	if [ "$tw" -gt 0 ]; then
		/usr/local/sbin/tsx-wait-time "$tw" || ewarn "starting without NTP sync"
	fi
	# install.sh --token-file hands over a token. Seed it once.
	if [ -s /var/lib/kiosk/pending-token ]; then
		if NO_SERVICE=1 /usr/local/bin/kiosk-set-token --file /var/lib/kiosk/pending-token; then
			rm -f /var/lib/kiosk/pending-token
		else
			ewarn "kiosk-set-token failed, will retry at the next start"
		fi
	fi
	# daily restart entry in root's crontab
	sed -i '/# tsx-kiosk-restart$/d' /etc/crontabs/root
	if [ -n "${KIOSK_RESTART_AT:-}" ]; then
		h=${KIOSK_RESTART_AT%%:*}; m=${KIOSK_RESTART_AT##*:}; h=${h#0}; m=${m#0}
		echo "$m $h * * * /sbin/rc-service kiosk restart >/dev/null 2>&1 # tsx-kiosk-restart" >> /etc/crontabs/root
	fi
	# Marker on the serial console (boot timing). The dmesg service of OpenRC
	# sets the console loglevel to 1, so also write to the serial port
	# directly.
	m="tsx: starting kiosk (KIOSK_GPU=${KIOSK_GPU:-auto}) uptime $(cut -d' ' -f1 /proc/uptime)"
	echo "$m" > /dev/kmsg 2>/dev/null; [ -c /dev/ttyAML0 ] && echo "$m" > /dev/ttyAML0 2>/dev/null
	return 0
}

reload() {
	ebegin "Reloading kiosk (restarting browser)"
	supervise-daemon "$RC_SVCNAME" --signal TERM
	eend $?
}
