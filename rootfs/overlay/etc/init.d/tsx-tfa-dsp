#!/sbin/openrc-run
# TSW-1060 TFA9890 CoolFlux DSP loader. It runs the userspace loader
# (tsx-tfa-dsp start) once at boot, after tsx-audio has configured the sound
# card. It needs a kernel built with snd_soc_tfa989x.dsp=1.
# It does nothing, and never fails the boot, in three cases: the kernel lacks
# that option, the TSW1060 sound card is missing, or the load itself fails.
# After a failed load, the amplifiers stay in the own bypass setup of the
# kernel. Variant, vstep and profile: /etc/tsx/tfa-dsp.conf.
# Log: /var/log/tsx-tfa-dsp.log.
#
# On success, it writes /run/tsx/tfa-dsp.ok. With that file, tsx-audio knows
# that the "Amp Input" mixer controls are already set to DSP. On a later
# "tsx-audio init" (for example a manual re-init after an edit of
# audio.conf), tsx-audio leaves them alone. It does not reset them to the
# plain Left/Right bypass.
description="Load the TFA9890 CoolFlux DSP once at boot (see /etc/tsx/tfa-dsp.conf)"
depend() {
	after tsx-audio
	need localmount
}
start() {
	ebegin "Loading the TFA9890 CoolFlux DSP"
	rm -f /run/tsx/tfa-dsp.ok
	if [ "$(cat /sys/module/snd_soc_tfa989x/parameters/dsp 2>/dev/null)" != Y ]; then
		einfo "kernel not built with snd_soc_tfa989x.dsp=1: nothing to do"
		eend 0
		return 0
	fi
	if [ ! -e /proc/asound/TSW1060 ]; then
		einfo "no sound card TSW1060: nothing to do"
		eend 0
		return 0
	fi
	mkdir -p /run/tsx "$(dirname /var/log/tsx-tfa-dsp.log)"
	if /usr/local/sbin/tsx-tfa-dsp start >>/var/log/tsx-tfa-dsp.log 2>&1; then
		date > /run/tsx/tfa-dsp.ok
	else
		echo "$(date): tsx-tfa-dsp start failed, amplifiers stay in bypass" >>/var/log/tsx-tfa-dsp.log
	fi
	eend 0
}
