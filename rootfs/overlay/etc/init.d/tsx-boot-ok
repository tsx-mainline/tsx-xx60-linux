#!/sbin/openrc-run
# After a good boot (the kiosk runs for BOOT_OK_DELAY s), reset the boot_retry
# counter of U-Boot. Without the reset, U-Boot falls back to the golden image
# after about 10 boots. This service also keeps DataRecoveryDone=1. It runs
# in the background, so it does not delay the boot.
description="Reset U-Boot boot_retry after a successful boot"
BOOT_OK_DELAY=${BOOT_OK_DELAY:-60}
depend() { after kiosk sshd; }
start() {
	ebegin "Scheduling tsx-boot-ok in ${BOOT_OK_DELAY}s"
	( sleep "$BOOT_OK_DELAY"
	  if rc-service kiosk status >/dev/null 2>&1 || rc-service sshd status >/dev/null 2>&1; then
		/usr/local/sbin/tsx-boot-ok 2>&1 | logger -t tsx-boot-ok
	  else
		logger -t tsx-boot-ok "neither kiosk nor sshd running: not marking boot as good"
	  fi ) >/dev/null 2>&1 &
	eend 0
}
