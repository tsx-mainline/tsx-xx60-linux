#!/sbin/openrc-run
# On-panel first-boot setup page (docs/rootfs.md "Setup page"). It runs as
# the unprivileged "tsx-setup" system user (mkrootfs.sh creates it next to
# "kiosk"), NOT as root. tsx-mqtt and tsx-esphome differ: this daemon parses
# HTTP from the LAN before any pairing has happened, so it gets no root at
# all. Every privileged action (read or write panel.conf, chpasswd) goes
# through tsx-setup-helper. That is the one root process, and it has a fixed,
# validated command set (rootfs/overlay/usr/local/sbin/tsx-setup-helper).
description="On-panel setup page (tsx-setupd)"
supervisor=supervise-daemon
command=/usr/local/sbin/tsx-setupd
command_user="tsx-setup:tsx-setup"
respawn_delay=3
respawn_max=0
output_log=/var/log/tsx-setupd.log
error_log=/var/log/tsx-setupd.log
depend() {
	need net
	after tsx-idled tsx-config tsx-setup-helper
	before kiosk
}
# supervise-daemon opens output_log as command_user. /var/log belongs to
# root, so without a log file that this user can write, the daemon exits 1
# before it runs.
start_pre() {
	checkpath -d -m 0755 /run/tsx
	checkpath -f -o tsx-setup:tsx-setup -m 0640 /var/log/tsx-setupd.log
}
