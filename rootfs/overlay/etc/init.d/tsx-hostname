#!/sbin/openrc-run
# tsx-hostname: name the panel like the factory firmware does,
# <model>-<MAC uppercase, no colons> (for example TSW-1060-XXXXXXXXXXXX),
# before anything on the network needs the name. The order of the sources:
#   1. lan_hostname from the U-Boot env. The script reads it with fw_printenv
#      (read only). It is the same env that tsx-boot-ok writes to (see
#      /etc/tsx/uboot-env.conf). The factory firmware itself used this exact
#      string.
#   2. <model>-<MAC>. The model is product_name up to "_[" (for example
#      "TSW-1060" from "TSW-1060_[v3.002.1055,_#XXXXXXXX]"), also from the
#      env. The MAC is the one of eth0. tsx-setup sets it and must run first,
#      because the MAC of the kernel is random on this board.
#   3. tsx-kiosk.
# PANEL_NAME in the panel config (tsx-config, docs/rootfs.md "Panel
# configuration") overrides all of the above. If it is set, tsx-config apply
# writes it to /run/tsx/panel-name before this service runs (it already
# validated the name against the same charset). It wins outright. It also
# names the sendspin player and the voice satellite, so the panel has one
# name everywhere.
# The script checks every candidate against ^[A-Za-z0-9-]{1,63}$ before it
# uses it. The script only READS the U-Boot env (fw_printenv). It never
# calls fw_setenv.
#
# It must run before "networking". The dhcp executor of ifupdown-ng defaults
# to use_hostname_for_dhcp=1. It reads the live hostname itself, so the
# interfaces file needs no change. udhcpc sends the hostname that this script
# sets as soon as it starts. It must also run before "syslog". The busybox
# syslogd stamps every line with the hostname that it saw at its start. A
# syslogd that starts first would log the default name of the image
# (tsx-kiosk, from /etc/hostname) for the whole first boot.
description="TSX hostname: PANEL_NAME from panel.conf, else lan_hostname from the U-Boot env, else <model>-<MAC>, else tsx-kiosk"
depend() { need localmount; after tsx-setup tsx-config; before networking syslog; }

start() {
	ebegin "TSX hostname"
	valid() { printf '%s' "$1" | grep -qE '^[A-Za-z0-9-]{1,63}$'; }

	name=
	if [ -r /run/tsx/panel-name ]; then
		pname=$(head -n1 /run/tsx/panel-name)
		valid "$pname" && name=$pname
	fi

	lh= pn=
	CONF=${TSX_ENV_CONF:-/etc/tsx/uboot-env.conf}
	if [ -r "$CONF" ]; then
		ENV_DISK= ENV_OFFSET= ENV_SIZE=
		. "$CONF"
		# Same disk detection as /usr/local/sbin/tsx-boot-ok (read only here)
		disk=
		for d in /sys/block/mmcblk[0-9]; do
			[ -e "$d" ] || continue
			t=$(cat "$d/device/type" 2>/dev/null || true)
			case "$ENV_DISK" in
			emmc) [ "$t" = MMC ] && [ -e "${d}boot0" ] && disk=/dev/${d##*/};;
			sd) [ -e "$d/${d##*/}p2" ] && [ "$(cat "$d/${d##*/}p1/start" 2>/dev/null)" = 81920 ] && \
				[ "$(cat "$d/${d##*/}p2/start" 2>/dev/null)" = 206849 ] && disk=/dev/${d##*/};;
			/dev/*) disk=$ENV_DISK;;
			esac
			[ -n "$disk" ] && break
		done
		case "$ENV_DISK" in /dev/*) disk=$ENV_DISK;; esac
		if [ -n "$disk" ] && [ -b "$disk" ] && [ -n "${ENV_OFFSET:-}" ] && [ "$ENV_OFFSET" != TODO ]; then
			cfg=${TSX_RUN:-/run}/tsx-fw_env.config
			echo "$disk $ENV_OFFSET ${ENV_SIZE:-0x10000}" > "$cfg"
			# Limit the run time. This service runs before networking and
			# syslog in the main boot sequence (see "depend" above), so a
			# hang here would stall the WHOLE boot. The read loop in
			# fw_env.c of u-boot-tools spins at 100% CPU forever on a
			# config/size mismatch, and does not report an error
			# (docs/boot.md "fw_printenv can hang"). Fail soft instead of
			# hanging the boot: fall through to <model>-<MAC>, or tsx-kiosk.
			fwto=${TSX_FWENV_TIMEOUT:-10}
			fwto_cmd=; command -v timeout >/dev/null 2>&1 && fwto_cmd="timeout -s KILL $fwto"
			out=$($fwto_cmd fw_printenv -c "$cfg" 2>/dev/null) || { out=; ewarn "fw_printenv failed or timed out after ${fwto}s: falling back to <model>-<MAC>/tsx-kiosk"; }
			lh=$(printf '%s\n' "$out" | sed -n 's/^lan_hostname=//p')
			pn=$(printf '%s\n' "$out" | sed -n 's/^product_name=//p')
		fi
	fi

	if [ -z "$name" ]; then
		valid "$lh" && name=$lh
	fi

	if [ -z "$name" ]; then
		model=${pn%%_\[*}
		mac=$(cat /sys/class/net/eth0/address 2>/dev/null || true)
		mac=$(printf '%s' "$mac" | tr -d ':' | tr 'a-z' 'A-Z')
		if [ -n "$model" ] && printf '%s' "$mac" | grep -qE '^[0-9A-F]{12}$'; then
			valid "$model-$mac" && name="$model-$mac"
		fi
	fi

	name=${name:-tsx-kiosk}
	echo "$name" > /etc/hostname
	hostname "$name" 2>/dev/null
	sed -i "s/^127\.0\.0\.1.*/127.0.0.1\tlocalhost $name/" /etc/hosts 2>/dev/null || true
	einfo "hostname: $name (panel_name='${pname:-}' lan_hostname='$lh' product_name='$pn')"
	eend 0
}
