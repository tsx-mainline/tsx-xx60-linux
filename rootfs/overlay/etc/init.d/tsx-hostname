#!/sbin/openrc-run
# tsx-hostname: name the panel like the factory firmware, <model>-<MAC uppercase
# no colons> (e.g. TSW-1060-XXXXXXXXXXXX), before anything on the network cares:
#   1. lan_hostname from the U-Boot env (read only, via fw_printenv; the same
#      env tsx-boot-ok writes to, see /etc/tsx/uboot-env.conf). This is the
#      exact string the factory firmware itself used.
#   2. <model>-<MAC>: model = product_name up to "_[" (e.g. "TSW-1060" from
#      "TSW-1060_[v3.002.1055,_#XXXXXXXX]"), also from the env; MAC = eth0's
#      (set by tsx-setup, which must run first: the kernel's own MAC is
#      random on this board).
#   3. tsx-kiosk.
# Every candidate is checked against ^[A-Za-z0-9-]{1,63}$ before use. This
# script only ever READS the U-Boot env (fw_printenv); it never calls
# fw_setenv.
#
# Must run before "networking": ifupdown-ng's dhcp executor defaults to
# use_hostname_for_dhcp=1 (queries the live hostname itself, no interfaces
# file change needed), so udhcpc sends whatever hostname is set here as soon
# as it starts.
description="TSX hostname: lan_hostname from the U-Boot env, else <model>-<MAC>, else tsx-kiosk"
depend() { need localmount; after tsx-setup; before networking; }

start() {
	ebegin "TSX hostname"
	valid() { printf '%s' "$1" | grep -qE '^[A-Za-z0-9-]{1,63}$'; }

	lh= pn=
	CONF=${TSX_ENV_CONF:-/etc/tsx/uboot-env.conf}
	if [ -r "$CONF" ]; then
		ENV_DISK= ENV_OFFSET= ENV_SIZE=
		. "$CONF"
		# same disk-detection logic as /usr/local/sbin/tsx-boot-ok (read only here)
		disk=
		for d in /sys/block/mmcblk[0-9]; do
			[ -e "$d" ] || continue
			t=$(cat "$d/device/type" 2>/dev/null || true)
			case "$ENV_DISK" in
			emmc) [ "$t" = MMC ] && [ -e "${d}boot0" ] && disk=/dev/${d##*/};;
			sd) [ -e "$d/${d##*/}p2" ] && [ "$(cat "$d/${d##*/}p1/start" 2>/dev/null)" = 81920 ] && \
				[ "$(cat "$d/${d##*/}p2/start" 2>/dev/null)" = 206849 ] && disk=/dev/${d##*/};;
			/dev/*) disk=$ENV_DISK;;
			esac
			[ -n "$disk" ] && break
		done
		case "$ENV_DISK" in /dev/*) disk=$ENV_DISK;; esac
		if [ -n "$disk" ] && [ -b "$disk" ] && [ -n "${ENV_OFFSET:-}" ] && [ "$ENV_OFFSET" != TODO ]; then
			cfg=${TSX_RUN:-/run}/tsx-fw_env.config
			echo "$disk $ENV_OFFSET ${ENV_SIZE:-0x10000}" > "$cfg"
			out=$(fw_printenv -c "$cfg" 2>/dev/null) || out=
			lh=$(printf '%s\n' "$out" | sed -n 's/^lan_hostname=//p')
			pn=$(printf '%s\n' "$out" | sed -n 's/^product_name=//p')
		fi
	fi

	name=
	valid "$lh" && name=$lh

	if [ -z "$name" ]; then
		model=${pn%%_\[*}
		mac=$(cat /sys/class/net/eth0/address 2>/dev/null || true)
		mac=$(printf '%s' "$mac" | tr -d ':' | tr 'a-z' 'A-Z')
		if [ -n "$model" ] && printf '%s' "$mac" | grep -qE '^[0-9A-F]{12}$'; then
			valid "$model-$mac" && name="$model-$mac"
		fi
	fi

	name=${name:-tsx-kiosk}
	echo "$name" > /etc/hostname
	hostname "$name" 2>/dev/null
	sed -i "s/^127\.0\.0\.1.*/127.0.0.1\tlocalhost $name/" /etc/hosts 2>/dev/null || true
	einfo "hostname: $name (lan_hostname='$lh' product_name='$pn')"
	eend 0
}
