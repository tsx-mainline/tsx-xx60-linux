#!/sbin/openrc-run
description="TSX early setup: time zone, eth0 MAC, zram swap, CPU governor"
depend() { need localmount; before networking kiosk; }

# select_eth0_mac: print the MAC eth0 should use, on stdout, and keep
# TSX_ETH0_MAC_FILE in step with it. Split out of start() so a host test
# (rootfs/tests/test-tsx-setup-mac.sh) can call just this, without the zram/
# cpufreq/timezone side effects the rest of start() has on a real host.
#
# mainline has no MAC source on this board (stmmac picks a random one each
# boot, so the DHCP address changed every boot). The U-Boot env "ethaddr"
# (the MAC U-Boot itself uses for DHCP, read only from mmcblk0 at 1 MiB, the
# live env, verified 2026-09-26) ALWAYS wins when it is present and valid,
# matching the rescue system's own priority
# (rootfs/initramfs/overlay/etc/init.d/rcS) -- a stateless RAM system that
# re-derives it from the same env every boot, with no file to fall out of
# sync. TSX_ETH0_MAC_FILE (/etc/tsx/eth0.mac) is only the fallback for a
# board with no ethaddr in its env, and is kept in step with a valid ethaddr
# whenever one is seen (docs/recovery.md "Random MAC in the rescue, and
# the fix").
#
# TSX_MMCBLK0/TSX_ETH0_MAC_FILE: host-test hooks only (rootfs/tests/), same
# idea as tsx-config's TSX_APPLY_PREFIX -- empty/unset leaves the panel's
# real paths.
select_eth0_mac() {
	blk=${TSX_MMCBLK0:-/dev/mmcblk0}
	macf=${TSX_ETH0_MAC_FILE:-/etc/tsx/eth0.mac}
	mac=
	if [ -b "$blk" ] || [ -f "$blk" ]; then
		mac=$(dd if="$blk" bs=64k skip=16 count=1 2>/dev/null | tr '\0' '\n' | sed -n 's/^ethaddr=//p' | head -1)
	fi
	echo "$mac" | grep -qiE '^[0-9a-f]{2}(:[0-9a-f]{2}){5}$' || mac=
	if [ -n "$mac" ]; then
		cur=
		[ -s "$macf" ] && cur=$(head -1 "$macf")
		if [ "$cur" != "$mac" ]; then
			mkdir -p "$(dirname "$macf")" && echo "$mac" > "$macf"
			# stderr: stdout is this function's answer (OpenRC's einfo prints
			# to stdout; on a fresh install this line made mac= two lines and
			# `ip link set` failed, leaving the random MAC)
			einfo "eth0 MAC $mac (from U-Boot env; $macf was '${cur:-unset}', now back in sync)" >&2
		fi
	else
		[ -s "$macf" ] && mac=$(head -1 "$macf")
		echo "$mac" | grep -qiE '^[0-9a-f]{2}(:[0-9a-f]{2}){5}$' || mac=
		if [ -z "$mac" ]; then
			mac=$(od -An -N5 -tx1 /dev/urandom | tr -s ' ' ':' | sed 's/^:/02:/; s/:$//')
			mkdir -p "$(dirname "$macf")" && echo "$mac" > "$macf"
		fi
	fi
	printf '%s\n' "$mac"
}

start() {
	ebegin "TSX setup"
	# boot splash status line (no-op when the text console has the screen)
	/usr/local/bin/tsx-splash -s "starting services" -p 30 status 2>/dev/null
	. /etc/kiosk.conf
	[ -r /run/tsx/kiosk.conf ] && . /run/tsx/kiosk.conf   # panel.conf overrides (tsx-config apply)
	if [ -n "${TZ_NAME:-}" ] && [ -f "/usr/share/zoneinfo/$TZ_NAME" ]; then
		ln -sf "/usr/share/zoneinfo/$TZ_NAME" /etc/localtime
		echo "$TZ_NAME" > /etc/timezone
	fi
	mac=$(select_eth0_mac)
	if ip link set dev eth0 address "$mac" 2>/dev/null; then einfo "eth0 MAC $mac"
	else ewarn "eth0 MAC '$mac' could not be set: eth0 keeps $(cat /sys/class/net/eth0/address 2>/dev/null)"; fi
	# compressed swap in RAM (needs CONFIG_ZRAM; the panel kernel lacks it today)
	if [ ! -e /sys/block/zram0 ]; then modprobe zram num_devices=1 2>/dev/null || true; fi
	if [ -e /sys/block/zram0/disksize ] && ! grep -q zram0 /proc/swaps; then
		mem=$(awk '/MemTotal/{print $2}' /proc/meminfo)
		for a in zstd lz4 lzo-rle lzo; do grep -qw "$a" /sys/block/zram0/comp_algorithm && { echo $a > /sys/block/zram0/comp_algorithm; break; }; done
		echo $((mem / 2))K > /sys/block/zram0/disksize && mkswap /dev/zram0 >/dev/null && swapon -p 100 /dev/zram0
	fi
	for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
		[ -w "$g" ] && { grep -qw schedutil "${g%/*}/scaling_available_governors" && echo schedutil > "$g" || echo ondemand > "$g"; } 2>/dev/null
	done
	eend 0
}
