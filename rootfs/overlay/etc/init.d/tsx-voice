#!/sbin/openrc-run
# Home Assistant Assist voice satellite: linux-voice-assistant (ESPHome native
# API, port 6053), /etc/tsx/voice.conf.
# Not in a runlevel by default: "tsx-audio enable voice".
# It does not start on a panel without a microphone (MIC=no in
# /run/tsx/hw.conf, government=1).
description="Assist voice satellite (linux-voice-assistant, ESPHome API)"
supervisor=supervise-daemon
command=/usr/local/bin/tsx-voice-run
# The primary group is kiosk (the /run/tsx/panelctl FIFO is root:kiosk 0660,
# see tsx-panelctl). The audio group and others come from the /etc/group
# memberships of kiosk. With "kiosk:audio", the process had no kiosk group
# and every panel entity write failed ("tsx-panelctl not listening").
command_user="kiosk:kiosk"
output_log=/var/log/tsx-voice.log
error_log=/var/log/tsx-voice.log
respawn_delay=10
respawn_max=0
# Start after tsx-config. Its apply writes /run/tsx/esphome.key (HA_API_KEY)
# and esphome.conf (HA_ALLOW_FROM), and the satellite reads them once at
# start. If it started earlier, it would serve the ESPHome API without them.
depend() { need net; after tsx-audio tsx-setup tsx-config; }
start_pre() {
	if [ "$(sed -n 's/^MIC=//p' /run/tsx/hw.conf 2>/dev/null)" = no ]; then
		eerror "No microphone on this panel ($(sed -n 's/^REASON=//p' /run/tsx/hw.conf)). The voice satellite does not start"
		return 1
	fi
	# supervise-daemon opens the log after it switches to command_user. The log
	# must exist, and kiosk must be able to write it.
	checkpath -f -m 0644 -o kiosk:audio /var/log/tsx-voice.log
	STATE_DIR=/var/lib/tsx-voice
	[ -r /etc/tsx/voice.conf ] && . /etc/tsx/voice.conf
	[ -r /run/tsx/voice.conf ] && . /run/tsx/voice.conf   # panel.conf NAME/WAKE_WORD (tsx-config apply)
	[ -x /usr/local/bin/linux-voice-assistant ] || { eerror "linux-voice-assistant not installed"; return 1; }
	[ -e /proc/asound/TSW1060 ] || ewarn "no TSW1060 sound card"
	checkpath -d -m 0755 -o kiosk:audio "$STATE_DIR"
	# State, ducking and the push-to-talk FIFO (the satellite runs as kiosk)
	checkpath -d -m 0755 /run/tsx
	checkpath -d -m 0755 -o kiosk:audio /run/tsx/voice
	[ -p /run/tsx/voice/ptt ] || { rm -f /run/tsx/voice/ptt; mkfifo /run/tsx/voice/ptt; }
	chown kiosk:audio /run/tsx/voice/ptt; chmod 0660 /run/tsx/voice/ptt
	return 0
}
stop_post() { su -s /bin/sh kiosk -c '/usr/local/bin/tsx-voice-hook done' >/dev/null 2>&1; return 0; }
