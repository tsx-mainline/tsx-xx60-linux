#!/sbin/openrc-run
description="Front-panel keys and key LEDs (actions from /etc/tsx/buttons.conf)"
supervisor=supervise-daemon
command=/usr/local/sbin/tsx-buttons
command_args="-c /etc/tsx/buttons.conf"
respawn_delay=2
respawn_max=0
output_log=/var/log/tsx-buttons.log
error_log=/var/log/tsx-buttons.log
extra_started_commands="reload"
depend() { after udev-settle tsx-idled; }
start_pre() { checkpath -d -m 0755 /run/tsx; }
reload() {
	ebegin "Reloading tsx-buttons config"
	supervise-daemon "$RC_SVCNAME" --signal HUP
	eend $?
}
