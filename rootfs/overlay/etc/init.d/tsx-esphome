#!/sbin/openrc-run
description="Standalone Home Assistant ESPHome device for the panel (VOICE=off; see docs/ha.md)"
supervisor=supervise-daemon
command=/usr/local/bin/tsx-esphome-run
respawn_delay=5
respawn_max=0
output_log=/var/log/tsx-esphome.log
error_log=/var/log/tsx-esphome.log
depend() { need net; after tsx-idled tsx-buttons tsx-ledbar tsx-als tsx-config avahi-daemon; }
start() {
	# Do not run in two cases. HA_TRANSPORT=mqtt means the panel config opted
	# out of ESPHome entirely. VOICE=on means the voice satellite serves the
	# same entities itself, and two ESPHome devices would confuse Home
	# Assistant. Like tsx-mqtt when unconfigured: exit quietly and do not
	# fail the runlevel.
	transport=$(tsx-config get HA_TRANSPORT 2>/dev/null) || transport=esphome
	voice=$(tsx-config get VOICE 2>/dev/null) || voice=
	if [ "$transport" = mqtt ]; then
		einfo "tsx-esphome: HA_TRANSPORT=mqtt, not started"
		return 0
	fi
	if [ "$voice" = on ]; then
		einfo "tsx-esphome: VOICE=on, the voice satellite serves these entities instead"
		return 0
	fi
	checkpath -d -m 0755 /run/tsx
	default_start
}
stop() {
	# started unconfigured (or not wanted): no daemon to stop
	[ -e "/run/supervise-$RC_SVCNAME.pid" ] || return 0
	default_stop
}
