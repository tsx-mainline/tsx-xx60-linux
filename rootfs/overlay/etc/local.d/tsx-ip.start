#!/bin/sh
# Print the DHCP address on the serial console (kernel log). The host TFTP
# boot loop (tools/bench/tftpboot.sh) looks for this format: "eth0: A.B.C.D/NN".
(
for i in $(seq 1 60); do
	a=$(ip -4 -o addr show dev eth0 2>/dev/null | awk '{print $4; exit}')
	if [ -n "$a" ]; then
		m="tsx: eth0: $a $(cat /sys/class/net/eth0/address) uptime $(cut -d' ' -f1 /proc/uptime)"
		echo "$m" > /dev/kmsg; [ -c /dev/ttyAML0 ] && echo "$m" > /dev/ttyAML0
		exit 0
	fi
	sleep 1
done
) &
