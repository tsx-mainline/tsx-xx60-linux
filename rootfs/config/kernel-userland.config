# Recommended additions to the kernel fork's tsx-xx60.config fragment for the rootfs
# userland (NOT applied by rootfs; the kernel owner merges them).
#
# Chromium's sandbox uses user/PID/net namespaces. Without them the kiosk runs
# Chromium with --no-sandbox (kiosk-session detects /proc/self/ns/user).
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
# Compressed swap in RAM: helps a browser on the 1 GB TSW-760 (tsx-setup enables it).
CONFIG_ZRAM=m
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_LZ4=y
# Kiosk input tests (ydotool/evemu), optional
CONFIG_INPUT_UINPUT=m
# Meson watchdog is already =y in multi_v7; keep it built in.
CONFIG_MESON_WATCHDOG=y
# Needed in the board DT, not in Kconfig: the SD-class boot disk controller
# (install.sh, rootfs) and, for tsx-boot-ok, the eMMC controller (U-Boot env).
